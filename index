let _ftPanelOpen = true;
let _ftHideTimer = null;
const FT_HIDE_DELAY = 3500; // ms de inactividad antes de colapsar

// Colapsa la barra suavemente
function _ftCollapse() {
  _ftPanelOpen = false;
  document.getElementById('float-toolbar')?.classList.add('bar-hidden');
}

// Expande la barra y reinicia el timer
function _ftExpand() {
  _ftPanelOpen = true;
  document.getElementById('float-toolbar')?.classList.remove('bar-hidden');
  _ftResetTimer();
}

// Reinicia el temporizador de auto-colapso
function _ftResetTimer() {
  _setTimer('ftHide', _ftCollapse, FT_HIDE_DELAY);
}

// Cancela el timer (para cuando el cursor está encima)
function _ftCancelTimer() {
  _clearTimer('ftHide');
}

function buildFontSelect(){
  const sel = document.getElementById('ft-font-select');
  if(!sel) return;
  sel.innerHTML = _fontGroups().map(([cat,list])=>`<optgroup label="${cat}">`+list.map(f=>`<option value="${f.id}" style="font-family:${f.family.replace(/"/g,'')}">${f.name}${f.custom?' ★':''}</option>`).join('')+'</optgroup>').join('');

  // Auto-hide: cualquier interacción con la barra reinicia el timer
  const toolbar = document.getElementById('float-toolbar');
  if(toolbar){
    // En desktop: pausar al pasar el cursor encima
    toolbar.addEventListener('mouseenter', _ftCancelTimer);
    toolbar.addEventListener('mouseleave', _ftResetTimer);
    // En móvil: cualquier toque reinicia el timer
    toolbar.addEventListener('pointerdown', _ftResetTimer, { passive: true });
  }
}

function ftTogglePanel(){
  if(_ftPanelOpen) _ftCollapse();
  else _ftExpand();
}

function positionFloatToolbar(){ if(window.innerWidth<=900) return;
  const toolbar = document.getElementById('float-toolbar');
  if(!toolbar || !selectedId) return;
  const obj = getObject(selectedId);
  if(!obj || obj.type !== 'text'){ toolbar.classList.remove('show'); return; }

  const el = document.querySelector(`[data-id="${selectedId}"]`);
  if(!el){ toolbar.classList.remove('show'); return; }

  // Mostrar y expandir automáticamente al seleccionar un texto
  toolbar.classList.add('show');
  _ftExpand();

  const elRect = el.getBoundingClientRect();
  const centerX = elRect.left + elRect.width / 2;
  let topY = elRect.top - toolbar.offsetHeight - 10;
  if(topY < 60) topY = elRect.bottom + 10;

  toolbar.style.left = centerX + 'px';
  toolbar.style.top = topY + 'px';

  syncFloatToolbar(obj);
}

function syncFloatToolbar(obj){
  if(!obj || obj.type !== 'text') return;
  const hex = colorToHex(obj.color) || '#ffffff';
  const colorBtn = document.getElementById('ft-color-btn');
  const colorInput = document.getElementById('ft-color-input');
  if(colorBtn) colorBtn.style.background = hex;
  if(colorInput) colorInput.value = hex;

  const fontSel = document.getElementById('ft-font-select');
