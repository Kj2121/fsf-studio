.add-pane .lottie-cat.on,.add-pane [class*="cat"].on:not(.add-chip),.add-pane [class*="cat"][style*="1E7BFF"]{background:linear-gradient(180deg,var(--k-blue1),var(--k-blue2) 52%,var(--k-blue3))!important;border-color:#8CBBFF!important;border-bottom-color:var(--k-blueedge)!important;color:#fff!important;}
.add-pane .shp-btn,.add-pane button[onclick^="addDesignCard"],.add-pane button[onclick^="addShape"]{text-align:left;width:100%!important;display:flex!important;align-items:center;gap:10px;margin:0 0 8px!important;padding:10px 12px!important;}
.add-pane #shp-grid,.add-pane .shp-grid{gap:8px;}
.add-pane .imgdrop{border-style:dashed!important;}

/* ══ RESTO DE LA APP · tarjetas con volumen ══ */
.k-sec{font-size:10px;font-weight:800;letter-spacing:1.6px;text-transform:uppercase;color:#7F93BD;margin:14px 2px 8px;font-family:var(--ui-font)}
