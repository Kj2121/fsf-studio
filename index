function colorToHex(c){
  if(!c) return '#ffffff';
  if(c.startsWith('#')) return c;
  // rgba/rgb → approximate
  const m=c.match(/[\d.]+/g);
  if(m&&m.length>=3){
    const hex=v=>Math.round(parseFloat(v)).toString(16).padStart(2,'0');
    return '#'+hex(m[0])+hex(m[1])+hex(m[2]);
  }
  return '#ffffff';
}

