.k-grid{display:grid;grid-template-columns:1fr 1fr;gap:9px}
.k-card,.k-btn,.k-hero{font-family:var(--ui-font);cursor:pointer;color:#E8EEFF;background:linear-gradient(180deg,#2B3858,#1B2540);border:1px solid #3B4A6E;box-shadow:0 3px 0 #09101F,inset 0 1px 0 rgba(255,255,255,.12);transition:transform .08s,box-shadow .08s}
.k-card:active,.k-btn:active,.k-hero:active{transform:translateY(3px);box-shadow:0 0 0 #09101F,inset 0 1px 0 rgba(255,255,255,.12)}
