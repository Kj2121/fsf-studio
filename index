  for(let i=0;i<frames.length;i++){
    if(_lexCancel)throw new Error('cancelado');
    await ff.writeFile('f'+String(i).padStart(4,'0')+'.jpg',new Uint8Array(await frames[i].arrayBuffer()));
  }
  await ff.exec(['-framerate',String(FPS),'-i','f%04d.jpg','-c:v','libx264','-preset','veryfast','-crf','17','-pix_fmt','yuv420p','-movflags','+faststart','-y','out.mp4']);
  const data=await ff.readFile('out.mp4');
  _lexSave(new Blob([data.buffer],{type:'video/mp4'}),'mp4');
}
async function _lexWebM(frames,out,ctx,OW,OH,FPS){
  if(!window.MediaRecorder)throw new Error('Tu navegador no soporta grabación de video');
  const mime=MediaRecorder.isTypeSupported('video/mp4')?'video/mp4':(MediaRecorder.isTypeSupported('video/webm;codecs=vp9')?'video/webm;codecs=vp9':'video/webm');
  const stream=out.captureStream(0);const track=stream.getVideoTracks()[0];
  const chunks=[];const rec=new MediaRecorder(stream,{mimeType:mime,videoBitsPerSecond:14000000});
  rec.ondataavailable=e=>{if(e.data.size)chunks.push(e.data);};
  const stopped=new Promise(r=>rec.onstop=r);
  rec.start();
  const t0=performance.now();
  for(let i=0;i<frames.length;i++){
    if(_lexCancel){rec.stop();throw new Error('cancelado');}
    const bmp=await createImageBitmap(frames[i]);ctx.drawImage(bmp,0,0,OW,OH);bmp.close&&bmp.close();
    if(track.requestFrame)track.requestFrame();
    const wait=t0+(i+1)*1000/FPS-performance.now();if(wait>0)await new Promise(r=>setTimeout(r,wait));
    _lexSet(.7+.28*(i+1)/frames.length,'Grabando video…');
  }
  rec.stop();await stopped;
  _lexSave(new Blob(chunks,{type:mime.split(';')[0]}),mime.startsWith('video/mp4')?'mp4':'webm');
}
function _lexSave(blob,ext){
  const url=URL.createObjectURL(blob);const a=document.createElement('a');
  a.href=url;a.download='fsf-animacion.'+ext;document.body.appendChild(a);a.click();a.remove();
  setTimeout(()=>URL.revokeObjectURL(url),4000);
  showUndoToast('✦ Video listo ('+ext.toUpperCase()+') — '+(blob.size/1048576).toFixed(1)+' MB');
}

