function mobRenderLayers(container){
  if(!container) container = document.getElementById('mob-drawer-content');
  if(!container) return;

  const sorted = [...objects].sort((a,b) => b.zIndex - a.zIndex);

  const typeIcon = o => {
    if(o.type==='lottie')  return '▶';
    if(o.type==='sticker') return '⭐';
    if(o.type==='shape')   return '◼';
    if(o.type==='imgZone') return '🖼';
    if(o.subtype==='vector') return '◈';
    if(o.subtype==='verse')  return '📖';
    if(o.subtype==='ref')    return '📌';
    if(o.subtype==='title')  return '✏';
    if(o.subtype==='hashtag') return '#';
    return '📝';
  };

  const typeName = o => {
    if(o._layerName) return o._layerName;
    if(o.type==='lottie')  return o.lottieName||'Animación';
    if(o.type==='sticker') return o.label||'Sticker';
    if(o.type==='shape')   return ({rect:'Rectángulo',circle:'Círculo',triangle:'Triángulo','line-h':'Línea H','line-v':'Línea V',diamond:'Rombo',cross:'Cruz',ellipse:'Óvalo',roundrect:'Redondeado'})[o.shapeType]||'Forma';
    if(o.type==='imgZone') return o.label||'Imagen';
    if(o.subtype==='vector') return 'Vector SVG';
    return (o.text||'Texto').replace(/<[^>]*>/g,'').substring(0,24);
  };

  container.innerHTML = `
    <div style="font-size:9px;font-weight:800;letter-spacing:2px;text-transform:uppercase;color:rgba(255,255,255,0.25);margin-bottom:10px;font-family:var(--ui-font);">
      ☰ Capas — toca una para editar
    </div>

    ${!sorted.length ? `<div style="text-align:center;padding:24px 0;font-size:11px;color:rgba(255,255,255,0.2);font-family:var(--ui-font);">Sin elementos aún.<br>Agrega texto, formas o imágenes.</div>` :
      sorted.map(o => `
        <div id="mob-layer-row-${o.id}"
          style="border-radius:12px;margin-bottom:4px;overflow:hidden;border:1.5px solid ${o.id===selectedId?'rgba(30,123,255,0.5)':'rgba(255,255,255,0.07)'};background:${o.id===selectedId?'rgba(30,123,255,0.08)':'rgba(255,255,255,0.03)'};transition:all .15s;">

          <!-- Cabecera de capa -->
          <div style="display:flex;align-items:center;gap:8px;padding:9px 10px;cursor:pointer;"
            onclick="mobLayerToggle('${o.id}')">
            <span style="font-size:12px;opacity:${o.visible?1:0.3};">${typeIcon(o)}</span>
            <span style="flex:1;font-size:11px;font-weight:600;color:rgba(255,255,255,${o.visible?'0.8':'0.3'});font-family:var(--ui-font);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">${typeName(o)}</span>
            <!-- Opacidad rápida como badge -->
            <span style="font-size:9px;color:rgba(255,255,255,0.3);font-family:var(--ui-font);flex-shrink:0;">${Math.round((o.opacity||1)*100)}%</span>
            <!-- Controles rápidos -->
            <button onclick="event.stopPropagation();toggleVis('${o.id}');mobRenderLayers()"
              style="background:none;border:none;cursor:pointer;font-size:12px;padding:0 2px;opacity:${o.visible?1:0.4};" title="${o.visible?'Ocultar':'Mostrar'}">👁</button>
            <button onclick="event.stopPropagation();toggleLock('${o.id}');mobRenderLayers()"
              style="background:none;border:none;cursor:pointer;font-size:11px;padding:0 2px;color:${o.locked?'rgba(251,191,36,0.8)':'rgba(255,255,255,0.2)'};" title="${o.locked?'Desbloquear':'Bloquear'}">🔒</button>
            <span style="font-size:10px;color:rgba(255,255,255,0.2);transition:transform .2s;" id="mob-layer-chevron-${o.id}">${o.id===selectedId?'▲':'▼'}</span>
          </div>

          <!-- Editor inline — solo visible si está seleccionada -->
          <div id="mob-layer-editor-${o.id}"
            style="display:${o.id===selectedId?'block':'none'};border-top:1px solid rgba(255,255,255,0.06);padding:10px;">
            ${mobLayerEditorHTML(o)}
          </div>
        </div>`).join('')}

    <!-- Orden de capas -->
    ${sorted.length > 1 ? `
    <div style="font-size:9px;font-weight:800;letter-spacing:2px;text-transform:uppercase;color:rgba(255,255,255,0.2);margin:12px 0 8px;font-family:var(--ui-font);">Reordenar</div>
    <div style="display:flex;flex-direction:column;gap:3px;" id="mob-layer-order">
      ${sorted.map((o,i)=>`
        <div style="display:flex;align-items:center;gap:8px;background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.06);border-radius:8px;padding:6px 8px;">
          <span style="font-size:11px;">${typeIcon(o)}</span>
          <span style="flex:1;font-size:10px;color:rgba(255,255,255,0.5);font-family:var(--ui-font);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">${typeName(o)}</span>
          <div style="display:flex;flex-direction:column;gap:2px;">
            ${i>0?`<button onclick="mobLayerMoveUp('${o.id}')" style="background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.1);border-radius:4px;width:24px;height:18px;cursor:pointer;color:rgba(255,255,255,0.5);font-size:10px;display:flex;align-items:center;justify-content:center;">↑</button>`:'<div style="width:24px;height:18px;"></div>'}
