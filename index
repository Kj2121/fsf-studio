  (design.objects||[]).filter(o=>o.type==='text').forEach(o=>{
    if(o.fontId)_fsfLearnIncr(p.fuentes,o.fontId);
    if(o.align)_fsfLearnIncr(p.alineacion,o.align);
    if((o.subtype==='ref'||o.subtype==='verse')&&o.text)p.versiculos_usados=_fsfLearnList(p.versiculos_usados,o.text.substring(0,60),20);
