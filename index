function _fsfLearnList(arr,value,max){if(!value)return arr;const f=arr.filter(v=>v!==value);f.unshift(value);return f.slice(0,max||20);}

function _fsfExtractTema(design){
  if(!design)return null;
  const combined=((design.message||'')+' '+(design.objects||[]).map(o=>o.text||'').join(' ')).toLowerCase();
  const map=[
    ['guerra_espiritual',['guerra','vencedor','espiritual','armadura','victoria','autoridad']],
    ['alabanza',['alabanza','adoracion','adoración','gloria','digno','alaba']],
    ['familia',['familia','hogar','hijo','madre','padre','matrimonio']],
    ['fe',['fe','creer','confianza','confiar']],
    ['esperanza',['esperanza','futuro','promesa','nuevo']],
    ['paz',['paz','tranquil','descanso','quietud']],
    ['sanidad',['sanidad','sana','restaura','salud']],
    ['proposito',['propósito','proposito','llamado','destino']],
    ['salvacion',['salvación','gracia','perdon','perdón']],
    ['evento',['evento','noche','domingo','servicio','culto','conferencia']],
  ];
  for(const[tema,keys]of map){if(keys.some(k=>combined.includes(k)))return tema;}
  return null;
}

function fsfLearnDesignApplied(design){
  if(!design)return;
  const p={..._fsfProfileDefault(),..._fsfProfileGet()};
  p.disenos_aplicados=(p.disenos_aplicados||0)+1;
  _fsfLearnIncr(p.formatos,design.fmt||'square');
  _fsfLearnIncr(p.temas_idx,'t'+design.themeIdx);
  const oscuros=[1,3,4,6,8,9,10,11];
  if(oscuros.includes(design.themeIdx))p.oscuro_claro.oscuro++;
