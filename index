    const svg=el.querySelector('svg');
    if(!svg) return;
    // Use data-fondo-bg="1" rect if exists, else fall back to first rect
    const rect = svg.querySelector('[data-fondo-bg="1"]') || svg.querySelector('rect');
    if(!rect) return;
    if(t){
      rect.setAttribute('fill', t);
    } else {
      // Restore original color: re-parse from obj.decoSvg
      const tmp=document.createElement('div');
