.k-tx i{font-style:normal;font-size:10px;color:#8E9FC4;margin-top:1px}
.k-row3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px}
.k-btn{border-radius:12px;padding:11px 6px;font-size:11px;font-weight:700;margin-bottom:3px}
.k-hero{display:flex;align-items:center;gap:12px;width:100%;margin-top:14px;border-radius:16px;padding:13px;text-align:left;background:linear-gradient(180deg,#5AA2FF,#1E7BFF 55%,#1257D1);border-color:#7DB6FF;box-shadow:0 4px 0 #0B3A99,0 8px 18px rgba(30,123,255,.35),inset 0 1px 0 rgba(255,255,255,.35)}
.k-hero .k-ico{background:rgba(255,255,255,.18);border-color:rgba(255,255,255,.3)}
.k-hero .k-ico svg{stroke:#fff!important}
.k-hero .k-tx i{color:#DCEAFF}

/* ══ RESTO · exportar / selección / menú / panel izquierdo con volumen ══ */
:root{--kf:linear-gradient(180deg,#2B3858,#1B2540);--kb:#3B4A6E;--ke:#09101F}
#export-panel>div:first-child{background:#0F1729!important;border:1px solid #26334F!important;box-shadow:0 4px 0 #070C18,inset 0 1px 0 rgba(255,255,255,.06)!important}
#export-panel button:not(.dl-btn):not(.efmt-btn),.efmt-btn{background:var(--kf)!important;border:1px solid var(--kb)!important;color:#E8EEFF!important;box-shadow:0 3px 0 var(--ke),inset 0 1px 0 rgba(255,255,255,.12)!important;border-radius:12px!important;transition:transform .08s,box-shadow .08s!important}
#export-panel button:not(.dl-btn):not(.efmt-btn):active,.efmt-btn:active{transform:translateY(3px)!important;box-shadow:0 0 0 var(--ke)!important}
.efmt-btn{color:#A9B9DC!important;padding:7px 14px!important}
.efmt-btn.on{background:linear-gradient(180deg,#5AA2FF,#1E7BFF 55%,#1257D1)!important;border-color:#7DB6FF!important;color:#fff!important;box-shadow:0 3px 0 #0B3A99,0 0 14px rgba(30,123,255,.4),inset 0 1px 0 rgba(255,255,255,.3)!important}
