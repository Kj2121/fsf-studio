      if(typeof objects!=='undefined'&&objects.length>0) mnImportFromCanvas();
      else mnLoadDemo();
    }
    mnRenderFrame(MN.t);
    mnDrawTimeline();
    mnDrawRuler();
  });
}

// ── IMPORT FROM CANVAS ──
async function mnImportFromCanvas(){
  MN.layers=[];MN.nid=1;MN.t=0;

  // Set canvas size based on fmt
  const F=FMTS[fmt]||FMTS.square;
  MN.CW=F.W; MN.CH=F.H;
  mnResizeCanvas();

  // Import background as image layer
  try{
    const bgCv=await captureCanvas(F.W,F.H,1);
    if(bgCv){
      const bgImg=new Image();
      bgImg.src=bgCv.toDataURL('image/jpeg',0.9);
      await new Promise(r=>{bgImg.onload=r;bgImg.onerror=r;});
      MN.bgType='image'; MN.bgImg=bgImg;
    }
  }catch(e){}

  // Import text objects as animated layers
  const textObjs=[...objects].filter(o=>o.type==='text'&&o.visible!==false)
    .sort((a,b)=>a.zIndex-b.zIndex);

  const anims=['fadeUp','fadeIn','slideLeft','slideRight','scaleIn','glitch'];
  const durations=[MN.duration,MN.duration-1,MN.duration-2];

  textObjs.forEach((o,i)=>{
    const f=FONTS.find(ff=>ff.id===o.fontId)||FONTS[0];
    MN.layers.push({
      id:'mn'+(MN.nid++),
      type:'text',
      name:o.subtype||'Texto',
      visible:true,
      startTime:Math.min(i*0.4, MN.duration*0.3),
      duration:durations[i%3]||MN.duration,
      x:o.x+(o.w/2),
      y:o.y+(o.fontSize*0.5),
      scale:1,rotation:o.rotation||0,opacity:1,
      text:o.text||(o.uppercase?(o.text||'').toUpperCase():(o.text||'')),
      fontSize:o.fontSize||60,
      font:f.family.replace(/['"]/g,'').split(',')[0].trim(),
      color:o.color||'#ffffff',
      shadow:!!o.textShadow,
      bold:o.bold,italic:o.italic,uppercase:o.uppercase,
      animIn:anims[i%anims.length],
      animInDur:0.5,
      animOut:i===0?'none':'fadeOut',
      animOutDur:0.3,
    });
  });

  if(MN.layers.length===0) mnLoadDemo();
  showUndoToast('✦ Diseño importado al editor de Motion');
}

