// SELECTION BAR
function showSelBar(show, obj) {
  const bar = document.getElementById('sel-bar');
  if (!show) { bar.classList.remove('show'); return; }
  bar.classList.add('show');
  if (!obj) return;

  const ico = document.getElementById('sb-type-ico');
  const lbl = document.getElementById('sel-bar-lbl');
  const types = {
    text:      { i:'T',  l: obj.subtype==='verse'?'Versículo':obj.subtype==='title'?'Título':'Texto' },
    arctext:   { i:'⌒', l:'Texto curvo' },
    imgZone:   { i:'🖼', l:'Foto' },
    shape:     { i:'◼', l:'Forma' },
    glassCard: { i:'◻', l:'Tarjeta Vidrio' },
    sticker:   { i:'✦', l: obj.label||'Sticker' },
    deco:      { i:'✦', l: obj._isFondoBg?'Fondo':'Deco' },
    lottie:    { i:'▶', l: obj.lottieName||'Animación' },
  };
  const td = types[obj.type] || { i:'◉', l:'Elemento' };
  if (ico) ico.textContent = td.i;
  if (lbl) lbl.textContent = obj._isFondoBg ? 'Fondo' : td.l;

  const sl = document.getElementById('sb-op-sl');
  const vl = document.getElementById('sb-op-v');
  if (sl && vl) {
    const pct = Math.round((obj.opacity ?? 1) * 100);
    sl.value = pct; sl.style.setProperty('--v', pct+'%'); vl.textContent = pct+'%';
  }

  const lockBtn = document.getElementById('sel-lock-btn');
  const lockIco = document.getElementById('sel-lock-ico');
  if (lockBtn && lockIco) {
    lockBtn.classList.toggle('on', !!obj.locked);
    lockIco.innerHTML = obj.locked
      ? '<rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0110 0v4"/>'
      : '<rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 019.9-1"/>';
  }

  const isText = obj.type === 'text';
  const isArc  = obj.type === 'arctext';
  const isGlass = obj.type === 'glassCard';
  const isShape = obj.type === 'shape';
  const sh = (id, v) => { const e=document.getElementById(id); if(e) e.style.display=v?'flex':'none'; };
  sh('sel-size-wrap', isText);
  sh('sel-font-wrap', isText);
  sh('sel-style-wrap', isText);
  sh('sel-style-sep', isText);
  sh('sel-align-wrap', isText);
  sh('sel-text-effects-sep', isText);
  sh('sel-shadow-btn', isText);
  sh('sel-stroke-btn', isText);
  { document.querySelectorAll('.cv-el.sel-lottie').forEach(e=>e.classList.remove('sel-lottie')); if(obj.type==='lottie') document.querySelector('[data-id="'+obj.id+'"]')?.classList.add('sel-lottie'); }
  { const mb=document.getElementById('sel-lmat-btn'); if(mb){ mb.style.display = obj.type==='lottie' ? '' : 'none'; } if(obj.type==='lottie') _lottieMatUI(); }
  { const lb=document.getElementById('sel-lspeed-btn'); if(lb){ lb.style.display = obj.type==='lottie' ? '' : 'none'; lb.textContent='⏱ '+(obj.lottieSpeed||1)+'×'; } }
  const gradBtn = document.getElementById('sel-grad-btn');
  const vbBtn   = document.getElementById('sel-verse-bank-btn');
  if (gradBtn) gradBtn.style.display = isText ? '' : 'none';
  if (vbBtn)   vbBtn.style.display   = isText ? '' : 'none';
  document.getElementById('sel-shadow-btn')?.classList.toggle('on', !!obj.textShadow);
  document.getElementById('sel-stroke-btn')?.classList.toggle('on', !!(obj._strokeIdx&&obj._strokeIdx>0));

