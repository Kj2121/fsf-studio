async function exportCardAsPng(){
  const members=objects.filter(o=>o.visible&&!o._isFondoBg);
  if(members.length===0){showUndoToast('No hay elementos');return;}
  showUndoToast('Generando PNG HD...');
  const RS=3, {W,H}=getFmtSize();
  const bx=Math.min(...members.map(o=>o.x)), by=Math.min(...members.map(o=>o.y));
  const bw=Math.max(...members.map(o=>o.x+(o.w||100)))-bx;
  const bh=Math.max(...members.map(o=>o.y+(o.h==='auto'?50:(o.h||100))))-by;
  const pad=Math.round(Math.min(bw,bh)*0.04);
  const cv=document.createElement('canvas'); cv.width=W*RS; cv.height=H*RS;
  const ctx=cv.getContext('2d'); ctx.scale(RS,RS);
  ctx.imageSmoothingEnabled=true; ctx.imageSmoothingQuality='high';
  const sorted=[...objects].filter(o=>o.visible&&!o._isFondoBg).sort((a,b)=>(a.zIndex||0)-(b.zIndex||0));
  for(const obj of sorted){
    ctx.save(); ctx.globalAlpha=obj.opacity??1;
    const cx2=obj.x+(obj.w||0)/2, cy2=obj.y+(obj.h==='auto'?20:(obj.h||0)/2);
    ctx.translate(cx2,cy2); ctx.rotate((obj.rotation||0)*Math.PI/180); ctx.translate(-cx2,-cy2);
    if(obj.type==='shape'){ try{_drawShapeToCanvas(ctx,obj);}catch(e){} }
    else if(obj.type==='text'){
      try{
        const f=FONTS.find(ff=>ff.id===obj.fontId)||FONTS[0];
        const fs=obj.fontSize||20;
        ctx.font=`${obj.italic?'italic ':''}${obj.bold?'bold ':''}${fs}px ${f.family.replace(/['"]/g,'')}`;
        ctx.fillStyle=obj.color||'#000'; ctx.textBaseline='top';
        ctx.textAlign=obj.align==='center'?'center':obj.align==='right'?'right':'left';
        const ax=obj.align==='center'?obj.x+obj.w/2:obj.align==='right'?obj.x+obj.w:obj.x;
        const lines=wrapTextCanvas(ctx,obj.uppercase?(obj.text||'').toUpperCase():(obj.text||''),obj.w,obj.letterSpacing||0);
        lines.forEach((line,i)=>ctx.fillText(line,ax,obj.y+i*fs*1.4,obj.w));
      }catch(e){}
    } else if(obj.type==='imgZone'&&obj.imgSrc){
      const w=obj.w,h=obj.h==='auto'?100:obj.h;
      await new Promise(res=>{
        const img=new Image(); img.crossOrigin='anonymous';
        img.onload=()=>{
          ctx.save();
          const r=Math.min(obj.radius||0,Math.min(w,h)/2);
          if(r>0){
            ctx.beginPath();
            if(obj.radiusTop){
              // Only round top corners
              ctx.moveTo(obj.x+r,obj.y);
              ctx.lineTo(obj.x+w-r,obj.y);
              ctx.arcTo(obj.x+w,obj.y,obj.x+w,obj.y+r,r);
              ctx.lineTo(obj.x+w,obj.y+h);
              ctx.lineTo(obj.x,obj.y+h);
              ctx.lineTo(obj.x,obj.y+r);
              ctx.arcTo(obj.x,obj.y,obj.x+r,obj.y,r);
              ctx.closePath();
            } else if(ctx.roundRect){
              ctx.roundRect(obj.x,obj.y,w,h,r);
            } else {
              ctx.moveTo(obj.x+r,obj.y);ctx.lineTo(obj.x+w-r,obj.y);ctx.arcTo(obj.x+w,obj.y,obj.x+w,obj.y+r,r);ctx.lineTo(obj.x+w,obj.y+h-r);ctx.arcTo(obj.x+w,obj.y+h,obj.x+w-r,obj.y+h,r);ctx.lineTo(obj.x+r,obj.y+h);ctx.arcTo(obj.x,obj.y+h,obj.x,obj.y+h-r,r);ctx.lineTo(obj.x,obj.y+r);ctx.arcTo(obj.x,obj.y,obj.x+r,obj.y,r);ctx.closePath();
            }
            ctx.clip();
          }
          const sc=Math.max(w/img.naturalWidth,h/img.naturalHeight);
          ctx.drawImage(img,obj.x+(w-img.naturalWidth*sc)/2,obj.y+(h-img.naturalHeight*sc)/2,img.naturalWidth*sc,img.naturalHeight*sc);
          ctx.restore(); res();
        };
        img.onerror=res; img.src=obj.imgSrc;
      });
    } else if(obj.type==='deco'&&obj.decoSvg){
      await new Promise(res=>{
        const blob=new Blob([obj.decoSvg],{type:'image/svg+xml'});
        const url=URL.createObjectURL(blob);
        const img=new Image(); img.onload=()=>{ctx.drawImage(img,obj.x,obj.y,obj.w,obj.h||obj.w);URL.revokeObjectURL(url);res();};
        img.onerror=()=>{URL.revokeObjectURL(url);res();}; img.src=url;
      });
    }
    ctx.restore();
  }
  const cpx=Math.max(0,bx-pad),cpy=Math.max(0,by-pad);
  const cpw=Math.min(W-cpx,bw+pad*2),cph=Math.min(H-cpy,bh+pad*2);
  const crop=document.createElement('canvas');
  crop.width=Math.round(cpw*RS); crop.height=Math.round(cph*RS);
  crop.getContext('2d').drawImage(cv,cpx*RS,cpy*RS,cpw*RS,cph*RS,0,0,crop.width,crop.height);
  showDownloadOverlay(crop.toDataURL('image/png'),'card_fsf_hd.png');
}

