      })
    });
    if(!resp.ok){ const e=await resp.json().catch(()=>({})); throw new Error(`Gemini (${model}): ${e.error?.message||resp.status}`); }
    text = (await resp.json()).candidates?.[0]?.content?.parts?.[0]?.text || '';
  }

  // ── CLAUDE (Anthropic) ──
  else {
