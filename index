// ── USE ELEMENT: add to canvas ──
function myElUse(id){
  const el = myElGetAll().find(e=>e.id===id);
  if(!el) return;
  pushUndo();
  const {W,H} = getFmtSize();

  if(el.cat === 'fondo'){
    // Set as background image
    if(el.type === 'svg'){
      const blob = new Blob([el.data], {type:'image/svg+xml'});
      const url = URL.createObjectURL(blob);
      const img = new Image();
      img.onload = () => {
        const cv = document.createElement('canvas');
        cv.width=W; cv.height=H;
        const ctx = cv.getContext('2d');
        ctx.drawImage(img, 0, 0, W, H);
        setBgImage(cv.toDataURL('image/png'));
        URL.revokeObjectURL(url);
      };
      img.src = url;
    } else {
      setBgImage(el.data);
    }
    showUndoToast('✦ "'+el.name+'" aplicado como fondo');
  } else {
    // Add as canvas element (marco or sticker)
    const sz = Math.round(Math.min(W,H) * (el.cat==='marco' ? 1.0 : 0.4));
    const cx = Math.round(W/2 - sz/2);
    const cy = Math.round(H/2 - sz/2);

    if(el.type === 'svg'){
      objects.push({
        id: genId(),
        type: 'deco',
        subtype: 'myel',
        decoSvg: el.data,
        x: cx, y: cy,
        w: sz, h: sz,
        opacity: 1, rotation: 0,
        zIndex: objects.length + 2,
        visible: true,
      });
    } else {
      objects.push({
        id: genId(),
        type: 'imgZone',
        imgSrc: el.data,
        x: cx, y: cy,
        w: sz, h: sz,
        radius: 0,
        opacity: 1, rotation: 0,
        zIndex: objects.length + 2,
        visible: true,
        label: el.name,
      });
    }
    renderObjects();
    renderLayersPanel();
    updateEmptyHint();
    showUndoToast('✦ "'+el.name+'" añadido al canvas');
  }
}

