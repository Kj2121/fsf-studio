// Called from move-handle (already selected, no selectObject call)
function onMoveHandlePointerDown(e){
  if(!selectedId) return;
  e.stopPropagation(); e.preventDefault();
  _startDrag(e.pointerId, e.clientX, e.clientY, selectedId, e.target);
}

function _applyMoveFrame(){
  _movRaf=null;
  if(!moveState) return;
  const {id, curDx, curDy, boxStartLeft, boxStartTop, sc,
         origX, origY, elW, elH, snapTargetsX, snapTargetsY} = moveState;
  const obj=getObject(id); if(!obj) return;
  const rot = obj.rotation||0;

  const rawX = origX + curDx;
  const rawY = origY + curDy;

  // Snap using pre-cached targets — no DOM reads
  const THRESH = 8;
  let bestX=rawX, bestY=rawY, snapH=null, snapV=null;
  let bestDx=THRESH+1, bestDy=THRESH+1;

  const objPtsX = [rawX, rawX+elW/2, rawX+elW];
  const objPtsY = [rawY, rawY+elH/2, rawY+elH];

  for(const px of objPtsX) for(const tx of snapTargetsX){
    const d=Math.abs(px-tx);
    if(d<bestDx){ bestDx=d; bestX=tx-(px-rawX); snapV=tx; }
  }
  for(const py of objPtsY) for(const ty of snapTargetsY){
    const d=Math.abs(py-ty);
    if(d<bestDy){ bestDy=d; bestY=ty-(py-rawY); snapH=ty; }
  }

  if(bestDx>THRESH) snapV=null;
  if(bestDy>THRESH) snapH=null;

  const snappedDx = bestX - origX;
  const snappedDy = bestY - origY;
  moveState._snappedDx = snappedDx;
  moveState._snappedDy = snappedDy;

  // Show guides
  const gh=document.getElementById('snap-h');
  const gv=document.getElementById('snap-v');
  if(gh){ if(snapH!==null){gh.style.display='block';gh.style.top=snapH+'px';}else gh.style.display='none'; }
  if(gv){ if(snapV!==null){gv.style.display='block';gv.style.left=snapV+'px';}else gv.style.display='none'; }

  // Move: translate3d only — pure compositor, zero layout
  const el = moveState.elNode;
  if(el) el.style.transform=`translate3d(${snappedDx*sc}px,${snappedDy*sc}px,0) rotate(${rot}deg)`;
  const box = moveState.boxNode;
  if(box){
    box.style.left=(boxStartLeft+snappedDx*sc)+'px';
    box.style.top =(boxStartTop +snappedDy*sc)+'px';
  }
}

function _commitMove(){
  if(!moveState) return;
  const {id, origX, origY, elNode} = moveState;
  const dx = moveState._snappedDx !== undefined ? moveState._snappedDx : moveState.curDx;
  const dy = moveState._snappedDy !== undefined ? moveState._snappedDy : moveState.curDy;
  const obj=getObject(id);
  if(obj){ obj.x=Math.round(origX+dx); obj.y=Math.round(origY+dy); }
  const el = elNode || document.querySelector(`[data-id="${id}"]`);
  if(el && obj){
    el.style.transform=`rotate(${obj.rotation||0}deg)`;
    el.style.left=obj.x+'px';
    el.style.top=obj.y+'px';
    el.style.willChange='transform';
    el.style.transition='';
  }
  if(_hideSnapGuides) _hideSnapGuides();
  moveState=null;
  updateSelectionBox();
  if(selectedId){ const o=getObject(selectedId); if(o&&o.type==='text') requestAnimationFrame(positionFloatToolbar); }
}

// ── Unified pointer move (covers both mouse and touch via pointer events)
window.addEventListener('pointermove', e=>{
  if(moveState && (e.pointerId===moveState.pointerId || moveState.pointerId===null)){
    moveState.curDx=(e.clientX-moveState.startX)/moveState.sc;
    moveState.curDy=(e.clientY-moveState.startY)/moveState.sc;
    if(!_movRaf) _movRaf=requestAnimationFrame(_applyMoveFrame);
    e.preventDefault();
  }
  if(resizeState) doResize(e.clientX,e.clientY);
  if(rotState)    doRotate(e.clientX,e.clientY);
},{passive:false});

window.addEventListener('pointerup', e=>{
  document.body.classList.remove('fsf-interact');
  _commitMove();
  if(resizeState||rotState){ resizeState=null; rotState=null;
    if(selectedId){ const o=getObject(selectedId); if(o&&o.type==='text') requestAnimationFrame(positionFloatToolbar); }
  }
});
window.addEventListener('pointercancel', ()=>{ document.body.classList.remove('fsf-interact'); _commitMove(); resizeState=null; rotState=null; });

// Keep legacy touch listeners for Android scroll prevention
window.addEventListener('touchmove', e=>{
  if(moveState||resizeState||rotState) e.preventDefault();
},{passive:false});

document.addEventListener('DOMContentLoaded', ()=>{
  const bg=document.getElementById('canvas-bg');
  if(bg) bg.addEventListener('touchmove', e=>{
    if(moveState||resizeState||rotState) e.preventDefault();
  },{passive:false});
});

// RESIZE
let resizeState=null;

function onHandleMouseDown(e,handle){
  e.stopPropagation(); e.preventDefault();
  if(!selectedId) return;
  const obj=getObject(selectedId); if(!obj) return;
  const sc=getScale();
  const el=document.querySelector(`[data-id="${selectedId}"]`);
  const elRect=el?el.getBoundingClientRect():null;
  pushUndo();
  document.body.classList.add('fsf-interact');
  resizeState={
    handle, startX:e.clientX, startY:e.clientY, sc,
    origX:obj.x, origY:obj.y, origW:obj.w,
    origH:obj.h==='auto'?(elRect?elRect.height/sc:100):obj.h,
    id:selectedId
  };
}



function doResize(clientX, clientY){
  if(!resizeState) return;
  const obj=getObject(resizeState.id); if(!obj) return;
  const sc=resizeState.sc;
  // sel-overlay is position:fixed (screen coords), so delta is in screen pixels.
  // Divide by sc to convert to canvas pixels.
  const dx=(clientX-resizeState.startX)/sc;
  const dy=(clientY-resizeState.startY)/sc;
  const h=resizeState.handle;
  const MIN=30;

  let newX=resizeState.origX, newY=resizeState.origY;
  let newW=resizeState.origW, newH=resizeState.origH;

  if(h.includes('r')||h==='mr') newW=Math.max(MIN,resizeState.origW+dx);
  if(h.includes('l')) { newW=Math.max(MIN,resizeState.origW-dx); newX=resizeState.origX+resizeState.origW-newW; }
  if(h.includes('b')||h==='bm') newH=Math.max(MIN,resizeState.origH+dy);
  if(h.includes('t')&&h!=='tr'&&h!=='tl'&&h!=='tm'||h==='tl'||h==='tr'||h==='tm'){
    newH=Math.max(MIN,resizeState.origH-dy); newY=resizeState.origY+resizeState.origH-newH;
  }

  obj.x=Math.round(newX); obj.y=Math.round(newY);
  obj.w=Math.round(newW);
  if(obj.type!=='text') obj.h=Math.round(newH);

  const el=document.querySelector(`[data-id="${resizeState.id}"]`);
  if(el){
    el.style.left=obj.x+'px';
    el.style.top=obj.y+'px';
    el.style.width=obj.w+'px';
    if(obj.type!=='text') el.style.height=obj.h+'px';
  }
  updateSelectionBox();
  // live font size update for stickers: scale proportionally
  if(obj.type==='sticker') obj.h=Math.round(newH);
}

// ROTATE
let rotState=null;

function onRotateMouseDown(e){
  e.stopPropagation(); e.preventDefault();
  if(!selectedId) return;
  const obj=getObject(selectedId); if(!obj) return;
  const el=document.querySelector(`[data-id="${selectedId}"]`);
  const rect=el?el.getBoundingClientRect():{left:0,top:0,width:0,height:0};
  const cx=rect.left+rect.width/2;
  const cy=rect.top+rect.height/2;
  pushUndo();
  document.body.classList.add('fsf-interact');
  rotState={id:selectedId, cx, cy, startAngle:obj.rotation||0, startMouseAngle:Math.atan2(e.clientY-cy,e.clientX-cx)*180/Math.PI};
}



function doRotate(clientX,clientY){
  if(!rotState) return;
  const obj=getObject(rotState.id); if(!obj) return;
  const angle=Math.atan2(clientY-rotState.cy,clientX-rotState.cx)*180/Math.PI;
  let rot=rotState.startAngle+(angle-rotState.startMouseAngle);
  if(rot<-180) rot+=360;
  if(rot>180) rot-=360;
  obj.rotation=Math.round(rot);
  const el=document.querySelector(`[data-id="${rotState.id}"]`);
  if(el) el.style.transform=`rotate(${obj.rotation}deg)`;
  // Just update the rotation of the existing sel-box — no DOM rebuild
  const box=document.querySelector('.sel-box');
  if(box) box.style.transform=`rotate(${obj.rotation}deg)`;
}

// DOUBLE CLICK → INLINE EDIT
function onElDblClick(e,id){
  const obj=getObject(id); if(!obj||obj.type!=='text') return;
  e.stopPropagation();
  const el=document.querySelector(`[data-id="${id}"]`);
  if(!el) return;
  el.setAttribute('contenteditable','true');
  el.focus();
  // place cursor at end
  const range=document.createRange();
  range.selectNodeContents(el);
  range.collapse(false);
  const sel=window.getSelection();
  sel.removeAllRanges();
  sel.addRange(range);
  el.style.cursor='text';
  el.style.outline='2px solid rgba(30,123,255,0.6)';
  el.style.outlineOffset='2px';
  // exit on blur or Enter+Ctrl
  const stopEdit=()=>{
    el.removeAttribute('contenteditable');
    el.style.cursor='move';
    el.style.outline='none';
    // BUG FIX: usar innerText para capturar texto plano, no innerHTML con etiquetas
    obj.text=el.innerText;
  };
  el.addEventListener('blur',stopEdit,{once:true});
  el.addEventListener('keydown',ev=>{
    if(ev.key==='Escape'){ stopEdit(); el.blur(); }
  });
}

// LAYERS PANEL
function renderLayersPanel(){
  const el=document.getElementById('layers-panel'); if(!el) return;
  const sorted=[...objects].sort((a,b)=>b.zIndex-a.zIndex);
  if(!sorted.length){
    el.innerHTML='<div style="font-size:9px;color:var(--txt3);text-align:center;padding:10px 0;">Sin elementos aún.</div>';
    return;
  }

  const typeIcon = o => {
    if(o.type==='lottie') return '▶';
    if(o.type==='sticker') return '⭐';
    if(o.type==='shape') return '◼';
    if(o.type==='imgZone') return '🖼';
    if(o.subtype==='vector') return '◈';
    if(o.subtype==='verse') return '📖';
    if(o.subtype==='ref') return '📌';
    if(o.subtype==='title') return '✏';
    if(o.subtype==='hashtag') return '#';
    return '📝';
  };
  const typeName = o => {
    if(o.type==='lottie') return o.lottieName||'Animación';
    if(o.type==='sticker') return o.label||'Sticker';
    if(o.type==='shape') return ({rect:'Rectángulo',circle:'Círculo',triangle:'Triángulo',line:'Línea',diamond:'Rombo',cross:'Cruz'})[o.shapeType]||'Forma';
    if(o.type==='imgZone') return o.label||'Imagen';
    if(o.subtype==='vector') return 'Vector SVG';
    return (o.text||'Texto').replace(/<[^>]*>/g,'').substring(0,20);
  };

  el.innerHTML = sorted.map((o,i)=>`
    <div class="layer-item ${o.id===selectedId?'active':''} ${o.locked?'layer-locked':''} ${!o.visible?'layer-hidden':''}"
      onclick="layerSelect('${o.id}')"
      draggable="true"
      ondragstart="layerDragStart(event,'${o.id}')"
      ondragover="layerDragOver(event)"
      ondrop="layerDrop(event,'${o.id}')"
      data-layer-id="${o.id}">
      <span style="font-size:9px;cursor:grab;color:rgba(255,255,255,0.2);padding:0 2px;user-select:none;" title="Arrastra para reordenar">⠿</span>
      <span class="layer-icon" style="font-size:11px;">${typeIcon(o)}</span>
      <span class="layer-name" style="flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:10px;"
        ondblclick="layerRename(event,'${o.id}')"
        title="Doble toque para renombrar">${typeName(o)}</span>
      <div style="display:flex;gap:2px;flex-shrink:0;">
        <button class="layer-vis" onclick="event.stopPropagation();toggleVis('${o.id}')"
          title="${o.visible?'Ocultar':'Mostrar'}"
          style="opacity:${o.visible?'1':'0.4'}">👁</button>
        <button onclick="event.stopPropagation();toggleLock('${o.id}')"
          title="${o.locked?'Desbloquear':'Bloquear'}"
          style="background:transparent;border:none;cursor:pointer;font-size:10px;padding:0 2px;color:${o.locked?'rgba(251,191,36,0.8)':'rgba(255,255,255,0.2)'};">🔒</button>
        <button class="layer-del" onclick="event.stopPropagation();deleteObj('${o.id}')" title="Eliminar">✕</button>
      </div>
    </div>`).join('');

  // Add CSS for hidden/locked layers
  if(!document.getElementById('layer-extra-css')){
    const s=document.createElement('style');
    s.id='layer-extra-css';
    s.textContent='.layer-hidden{opacity:0.4;}.layer-locked{border-left:2px solid rgba(251,191,36,0.4)!important;}.layer-item{user-select:none;}';
    document.head.appendChild(s);
  }
}

