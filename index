        <div class="ai-result-ref" style="color:rgba(220,120,120,0.9);">No se pudo generar</div>
        <div class="ai-result-phrase" style="font-size:10px;">${err.message}. Intenta de nuevo.</div>
      </div>`;
    }
  }
}

function _applyAiDesign(design){
  pushUndo();
  // Limpiar diseño actual (excepto fondo)
  objects = objects.filter(o=>false); // limpiar todo
  selectedId = null;

  const estilo = design.estilo || 'quote';
  // Crear la card base del estilo elegido
  addDesignCard(estilo);

  // Rellenar los textos de la card con el contenido de la IA
  const titulo = design.titulo || '';
  const verso = design.verso || '';
  const ref = design.referencia || '';

  // Buscar los objetos de texto de la card recién creada y actualizar
  const textos = objects.filter(o=>o.type==='text');
  // Heurística: el texto más grande = título, el mediano = verso, el de mayúsculas corto = ref
  textos.sort((a,b)=>(b.fontSize||0)-(a.fontSize||0));

  // Título (puede tener 2 líneas con |)
  if(titulo && textos.length){
    const partes = titulo.split('|').map(s=>s.trim());
    if(partes.length>=2 && textos.length>=2){
      textos[0].text = partes[0];
      textos[1].text = partes[1];
    } else {
      textos[0].text = titulo.replace('|',' ');
    }
  }
  // Verso — buscar texto italic o el de tamaño mediano
  const versoObj = textos.find(o=>o.italic && o.fontSize < textos[0].fontSize) 
                || textos.find(o=>(o.text||'').length > 30);
  if(versoObj && verso) versoObj.text = verso;

  // Referencia — buscar el texto en mayúsculas corto
  const refObj = textos.find(o=>o.uppercase && (o.text||'').length < 25);
  if(refObj && ref) refObj.text = ref;

  renderObjects();
  renderLayersPanel();
}


