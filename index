/* ══════════════════════════════════════════════════════════
   UI v2 — FSF «Negro & Azul» · orden, jerarquía y limpieza
   (solo estética y estructura; ninguna función modificada)
══════════════════════════════════════════════════════════ */
html,body{
  background:#04070D;
  background-image:
    radial-gradient(ellipse 55% 60% at 12% -6%, rgba(30,123,255,.34), transparent 66%),
    radial-gradient(ellipse 45% 50% at 100% 105%, rgba(30,123,255,.22), transparent 66%),
    radial-gradient(ellipse 35% 30% at 55% 50%, rgba(125,176,255,.05), transparent 70%);
  background-attachment:fixed;
}
/* cristal oscuro sobre el resplandor azul */
.dl-btn,.hbtn.on{border-radius:999px;}
.dl-btn{box-shadow:0 8px 28px rgba(30,123,255,.45), inset 0 1px 0 rgba(255,255,255,.25)!important;}
.ptab.on,.fmt-cat.on,.tpl-cat.on{box-shadow:0 0 18px rgba(30,123,255,.25), inset 0 0 0 1px rgba(30,123,255,.5);}
.fbtn,.fmt-cat,.tpl-cat,.hbtn{backdrop-filter:blur(6px);}
*{scrollbar-width:thin;scrollbar-color:rgba(235,242,255,.14) transparent;}
::-webkit-scrollbar{width:8px;height:8px;}
::-webkit-scrollbar-thumb{background:rgba(235,242,255,.12);border-radius:8px;border:2px solid transparent;background-clip:padding-box;}
::-webkit-scrollbar-thumb:hover{background:rgba(235,242,255,.22);background-clip:padding-box;border:2px solid transparent;}
::selection{background:rgba(30,123,255,.45);color:#fff;}

/* — cabecera — */
.hdr{background:rgba(4,8,16,.92);border-bottom:1px solid rgba(235,242,255,.07);box-shadow:none;}
.hdr::after{background:linear-gradient(90deg,transparent,rgba(30,123,255,.45) 50%,transparent);opacity:.55;}
.hbtn{background:rgba(235,242,255,.045);border:1px solid rgba(235,242,255,.08);border-radius:10px;color:rgba(235,242,255,.62);}
.hbtn:hover{background:rgba(30,123,255,.14);border-color:rgba(30,123,255,.45);color:var(--gold2);transform:none;box-shadow:none;}
.dl-btn{background:linear-gradient(135deg,#3D8BFF 0%,#1E7BFF 55%,#1259D6 100%);color:#FFFFFF;border:1px solid rgba(160,200,255,.28);box-shadow:0 6px 20px rgba(30,123,255,.32), inset 0 1px 0 rgba(255,255,255,.18);}
.dl-btn:hover{transform:translateY(-1px);box-shadow:0 10px 28px rgba(30,123,255,.45), inset 0 1px 0 rgba(255,255,255,.22);}

/* — etiquetas de sección unificadas — */
.plbl,.elbl{
  display:flex;align-items:center;gap:7px;
  font-family:var(--ui-font);font-size:10px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;
  color:rgba(235,242,255,.42);margin:22px 0 10px;padding-bottom:8px;
  border-bottom:1px solid rgba(235,242,255,.06);
}
.plbl:first-child,.elbl:first-child{margin-top:2px;}
.plbl svg,.elbl svg{width:12px;height:12px;flex:0 0 12px;opacity:.7;color:var(--gold);}

/* — pestañas segmentadas — */
.ptabs{background:rgba(235,242,255,.035);border:1px solid rgba(235,242,255,.07);border-radius:11px;padding:3px;gap:3px;margin-bottom:6px;}
.ptab{border-radius:8px;font-size:11px;font-weight:600;padding:8px 6px;color:rgba(235,242,255,.46);}
.ptab:hover:not(.on){background:rgba(235,242,255,.05);color:rgba(235,242,255,.8);}
.ptab.on{background:rgba(30,123,255,.18);color:var(--gold2);box-shadow:inset 0 0 0 1px rgba(30,123,255,.35);}

/* — formatos — */
.fmt-grid{display:flex;flex-direction:column;gap:6px;}
.fmt-cats{gap:5px;margin-bottom:10px;}
.fmt-cat{padding:5px 11px;font-size:9.5px;border-radius:999px;}
.fbtn{margin-bottom:0;border-radius:11px;padding:8px 10px;box-shadow:none;background:rgba(235,242,255,.03);}
.fbtn:hover,.fbtn.on{transform:none;}
.fbtn.on{background:rgba(30,123,255,.12);border-color:rgba(30,123,255,.5);}
.fi{width:34px;height:34px;border-radius:9px;color:var(--gold);}
.fbtn.on .fi{background:rgba(30,123,255,.2);border-color:rgba(30,123,255,.45);}
.fn{font-size:12px;font-weight:600;}
.fs{font-size:10px;opacity:.55;}

/* — plantillas / categorías — */
.tpl-cat{border-radius:999px;}

