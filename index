<script>
// ── Helper: choose black or white text based on bg luminance ──
function _cpTextColor(hex){
  const h = (hex||'#888').replace('#','');
  if(h.length<6) return '#fff';
  const r=parseInt(h.slice(0,2),16),g=parseInt(h.slice(2,4),16),b=parseInt(h.slice(4,6),16);
  return (r*299+g*587+b*114)/1000 > 140 ? '#1a1206' : '#ffffff';
}

// ── Sync a color button's background after color change ──
function _cpSyncBtn(btnId, hex){
  const btn = document.getElementById(btnId);
  if(!btn) return;
  btn.style.background = hex;
  // update hex label if exists
  const hexSpan = btn.querySelector('span');
  if(hexSpan){ hexSpan.style.color = _cpTextColor(hex); hexSpan.textContent = hex; }
  // update preview div if exists (desktop panel)
  const preview = document.getElementById('sel-color-preview');
  if(preview) preview.style.background = hex;
  const hexLabel = document.getElementById('sel-color-hex');
  if(hexLabel) hexLabel.textContent = hex;
}

// ── Main function: open color popup ──
// mode: 'bg' | 'element'
// anchor: button element or id string
// customFn: optional override callback(hex) instead of default updateSelColor/applyCustomBgColor
function _cpOpen(mode, anchor, customFn){
