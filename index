// Detecta si el dispositivo es iOS (iPhone / iPad)
function _isIOS() {
  return /iPad|iPhone|iPod/.test(navigator.userAgent) ||
    (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
}

// Detecta si el navegador soporta Web Share API con archivos (iOS 15+, Chrome Android)
function _canShareFile() {
  return !!(navigator.share && navigator.canShare);
}

/**
 * showDownloadOverlay(dataUrl, filename)
 * Muestra el overlay de descarga con la estrategia correcta:
 *   iOS + Web Share API  → Abre el menú nativo de compartir (Guardar en Fotos, WhatsApp, etc.)
 *   iOS sin Share API    → Muestra la imagen a pantalla completa para que el usuario la guarde
 *   Android / Desktop   → Descarga directa con <a download>
 */
async function showDownloadOverlay(dataUrl, filename) {
  const old = document.getElementById('_dl_ov');
  if (old) old.remove();

  const isIOS = _isIOS();
  const isFile = location.protocol === 'file:';

  // Convert dataUrl to blob directly
  function dataUrlToBlob(url) {
    const arr = url.split(',');
    const mime = arr[0].match(/:(.*?);/)[1];
    const bstr = atob(arr[1]);
    const u8 = new Uint8Array(bstr.length);
    for(let i=0;i<bstr.length;i++) u8[i]=bstr.charCodeAt(i);
    return new Blob([u8],{type:mime});
  }

  // ── Web Share API — only works from https://, not file:// ──
  if (_canShareFile() && !isFile) {
    try {
      const blob = dataUrlToBlob(dataUrl);
      const file = new File([blob], filename, {type: blob.type});
      if (navigator.canShare({files:[file]})) {
        await navigator.share({files:[file], title:'Fe Sin Fronteras'});
        return;
      }
    } catch(e) {
      if (e.name === 'AbortError') return;
    }
  }

  // ── Android / Desktop desde file:// → descarga directa ──
  if (!isIOS) {
    const a = document.createElement('a');
    a.href = dataUrl;
    a.download = filename;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    _showDownloadToast('✓ Imagen guardada en Descargas');
    return;
  }

  // ── iOS → overlay visual para guardar ──
  _showIosDownloadOverlay(dataUrl, filename);
}

