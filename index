async function _carPrevRender(idx){
  const slide = _CAR.slides[idx];
  if(!slide) return;
  const wrap = document.getElementById('car-prev-wrap');
  const lbl  = document.getElementById('car-prev-lbl');
  const dots = document.getElementById('car-prev-dots');
  if(!wrap) return;

  // Draw slide to canvas
  const F = FMTS[slide.fmt||'square']||FMTS.square;
  const maxW = Math.min(480, window.innerWidth*0.88);
  const sc = maxW / F.W;

  wrap.innerHTML = '<div style="text-align:center;font-size:11px;color:rgba(255,255,255,0.3);padding:20px;">Generando vista previa…</div>';

  // Temporarily restore slide to canvas state for captureCanvas
  const savedObjects = JSON.parse(JSON.stringify(objects));
  const savedTheme = themeIdx, savedBg = bgImgSrc, savedCC = customBgColor;
  const savedBgPos = bgImgPos, savedBgF = {...bgFilters}, savedOv = overlayOpacity, savedFmt = fmt;

  objects = JSON.parse(JSON.stringify(slide.objects));
  themeIdx = slide.themeIdx??0;
  customBgColor = slide.customBgColor||null;
  bgImgSrc = slide.bgImgSrc||null;
  bgImgPos = slide.bgImgPos||'center';
  bgFilters = {...(slide.bgFilters||{})};
  overlayOpacity = slide.overlayOpacity??0.45;

  try{
    const cv = await captureCanvas(F.W, F.H, sc);
    wrap.innerHTML = '';
    cv.style.cssText = `width:100%;border-radius:14px;box-shadow:0 8px 40px rgba(0,0,0,0.6);display:block;`;
    wrap.appendChild(cv);
  }catch(e){
    wrap.innerHTML = `<div style="aspect-ratio:1;background:#0A0F1C;border-radius:14px;display:flex;align-items:center;justify-content:center;color:rgba(255,255,255,0.3);font-size:12px;">Error al generar vista previa</div>`;
  }

  // Restore
  objects = savedObjects; themeIdx = savedTheme; customBgColor = savedCC;
  bgImgSrc = savedBg; bgImgPos = savedBgPos; bgFilters = savedBgF; overlayOpacity = savedOv;
  if(savedFmt!==fmt){ fmt=savedFmt; updateCanvasSize(); }
  applyBackground(); renderObjects();

  if(lbl) lbl.textContent = `${idx+1} / ${_CAR.slides.length}  ·  ${slide.label}`;
  if(dots){
    dots.innerHTML = _CAR.slides.map((_,i)=>`<div style="width:${i===idx?'20':'7'}px;height:7px;border-radius:4px;background:${i===idx?'#4ade80':'rgba(255,255,255,0.2)'};transition:all .2s;cursor:pointer;" onclick="_carPrevCur=${i};_carPrevRender(${i})"></div>`).join('');
  }
}

