async function handleVectorUpload(event) {
  // Visible debug — shows on screen so we can see what's happening
  function _dbg(msg) {
    showUndoToast(msg);
  }

  _dbg('Procesando archivo...');
  const files = [...(event.target.files || [])];
  if (!files.length) { _dbg('ERROR: No se recibió archivo'); return; }
  _dbg('Archivo: ' + files[0].name + ' (' + files[0].size + 'b)');

  for (const file of files) {
    const ext = file.name.split('.').pop().toLowerCase();

    // Accept SVG by extension OR by MIME type
    const isSvg = ext === 'svg' || file.type === 'image/svg+xml';
    const isEps = ext === 'eps';
    const isAi  = ext === 'ai';

    if (!isSvg && !isAi && !isEps) {
      showUndoToast('⚠ Usa .svg, .ai o .eps');
      continue;
    }

    // EPS: handle with dedicated converter
    if (isEps) {
      await _handleEpsFile(file);
      continue;
    }

    try {
      showUndoToast('✦ Cargando ' + file.name + '...');
      const text = await file.text();

      let svgString;

      if (isSvg) {
        svgString = text.replace(/<\?xml[^?]*\?>/gi, '').replace(/<!DOCTYPE[^>]*>/gi, '').trim();
        showUndoToast('SVG leído: ' + text.length + ' chars, tiene svg: ' + svgString.includes('<svg'));
      } else {
        svgString = _extractSVG(text, 'ai');
      }

      if (!svgString || !svgString.includes('<svg')) {
        console.warn('[SVG] No SVG found, trying image fallback');
        // FALLBACK: render as raster image if file can be read as image
        try {
          const blob = new Blob([file], {type: file.type || 'image/svg+xml'});
          const url = URL.createObjectURL(blob);
          const img = new Image();
          img.onload = () => {
            addImageObj(url, 'rect');
            showUndoToast('✦ Importado como imagen: ' + file.name);
            URL.revokeObjectURL(url);
          };
          img.onerror = () => {
            URL.revokeObjectURL(url);
            showUndoToast('⚠ No se pudo leer. En Illustrator: Archivo → Exportar como → SVG');
          };
          img.src = url;
        } catch(fe) {
          showUndoToast('⚠ En Illustrator usa: Archivo → Exportar como → SVG');
        }
        continue;
      }

      _addVectorToCanvas(svgString, file.name);

    } catch(e) {
      console.error('[SVG] Error:', e);
      showUndoToast('⚠ Error: ' + e.message);
    }
  }
  // Restore drawer after upload
  try {
    document.getElementById('svg-upload-section').style.display = 'none';
    const dc = document.getElementById('mob-drawer-content');
    if(dc) dc.style.display = '';
    const drawer = document.getElementById('mob-drawer');
    if(drawer) drawer.classList.remove('open');
  } catch(e){}
}

// ── EXTRACT SVG FROM DIFFERENT FORMATS ──
function _extractSVG(text, ext) {
  if (ext === 'svg') {
    // Clean and validate SVG
    const clean = text.trim();
    if (!clean.includes('<svg')) return null;
    // Remove XML declaration and DOCTYPE
    return clean
      .replace(/<\?xml[^?]*\?>/gi, '')
      .replace(/<!DOCTYPE[^>]*>/gi, '')
      .replace(/<!--.*?-->/gs, '')
      .trim();
  }

  if (ext === 'ai') {
    // Modern AI files are SVG-compatible — extract SVG section
    if (text.includes('<svg') || text.includes('<SVG')) {
      // Find SVG block
      const svgStart = text.search(/<svg/i);
      const svgEnd = text.lastIndexOf('</svg>') + 6;
      if (svgStart >= 0 && svgEnd > svgStart) {
        return text.slice(svgStart, svgEnd);
      }
    }
    // Legacy AI: try to parse as PostScript — fallback to placeholder
    showUndoToast('⚠ Archivo .ai antiguo — guárdalo como SVG en Illustrator');
    return null;
  }

  if (ext === 'eps') {
    // EPS: look for embedded SVG (some tools embed it)
    if (text.includes('<svg')) {
      const svgStart = text.search(/<svg/i);
      const svgEnd = text.lastIndexOf('</svg>') + 6;
      if (svgStart >= 0 && svgEnd > svgStart) {
        return text.slice(svgStart, svgEnd);
      }
    }
    showUndoToast('⚠ EPS sin SVG embebido — exporta como SVG desde tu programa');
    return null;
  }

  return null;
}

// ── ADD VECTOR TO CANVAS ──
// ── CSS TO INLINE CONVERTER ──
// Converts Illustrator's CSS class-based colors to inline fill/stroke attributes
// so _svgReplaceColorInSvg can target individual elements
function _svgInlineStyles(svgString) {
  try {
    // Extract all CSS rules from <style> blocks
    const styleMatches = svgString.match(/<style[^>]*>([\s\S]*?)<\/style>/gi) || [];
    if (!styleMatches.length) return svgString; // No style block = already inline

    // Build map: className -> {fill, stroke, opacity, ...}
    const classMap = {};
    styleMatches.forEach(styleBlock => {
      const css = styleBlock.replace(/<\/?style[^>]*>/gi, '');
      // Match .classname { properties }
      const ruleRe = /\.([\w-]+)\s*\{([^}]+)\}/g;
      let m;
      while ((m = ruleRe.exec(css)) !== null) {
        const cls = m[1];
        const props = m[2];
        classMap[cls] = {};
        // Extract fill
        const fillM = props.match(/fill\s*:\s*([^;}"'\s]+)/i);
        if (fillM) classMap[cls].fill = fillM[1];
        // Extract stroke
        const strokeM = props.match(/stroke\s*:\s*([^;}"'\s]+)/i);
        if (strokeM) classMap[cls].stroke = strokeM[1];
        // Extract opacity
        const opM = props.match(/opacity\s*:\s*([^;}"'\s]+)/i);
        if (opM) classMap[cls].opacity = opM[1];
        // Extract fill-opacity
        const foM = props.match(/fill-opacity\s*:\s*([^;}"'\s]+)/i);
        if (foM) classMap[cls]['fill-opacity'] = foM[1];
        // Extract stroke-width
        const swM = props.match(/stroke-width\s*:\s*([^;}"'\s]+)/i);
        if (swM) classMap[cls]['stroke-width'] = swM[1];
      }
    });

    if (!Object.keys(classMap).length) return svgString;

    // Now inline the styles into each element that uses a class
    let result = svgString;

    // For each element with a class attribute, inject inline attributes
    result = result.replace(/<(path|circle|rect|ellipse|polygon|polyline|line|g|use)([^>]*)class="([^"]+)"([^>]*)>/gi,
      (match, tag, before, classAttr, after) => {
        const classes = classAttr.split(/\s+/);
        const merged = {};

        // Merge all matching class rules
        classes.forEach(cls => {
          if (classMap[cls]) {
            Object.assign(merged, classMap[cls]);
          }
        });

        if (!Object.keys(merged).length) return match;

        // Build inline attribute string, skipping already-present attrs
        let extras = '';
        const fullAttrs = before + after;
        Object.entries(merged).forEach(([prop, val]) => {
          // Don't override existing inline attributes
          const alreadyHas = new RegExp('\b' + prop + '\s*=', 'i').test(fullAttrs);
          if (!alreadyHas) {
            extras += ' ' + prop + '="' + val + '"';
          }
        });

        return '<' + tag + before + ' class="' + classAttr + '"' + extras + after + '>';
      }
    );

    // Remove the <style> block now that everything is inlined
    // This prevents CSS from overriding our inline fill/stroke attributes
    result = result.replace(/<style[^>]*>[\s\S]*?<\/style>/gi, '');

    return result;
  } catch(e) {
    console.warn('[SVG inline]', e);
    return svgString;
  }
}

function _addVectorToCanvas(svgString, fileName) {
  showUndoToast('✦ Agregando al canvas...');
  pushUndo();
  const { W, H } = getFmtSize();

  // ── STEP 1: Clean Illustrator-specific cruft ──
  let cleaned = svgString
    .replace(/<\?xml[^?]*\?>/gi, '')
    .replace(/<!DOCTYPE[^>]*>/gi, '')
    .replace(/<!--[\s\S]*?-->/g, '')  // remove all comments (AI puts metadata here)
    .replace(/\s+xmlns:a="[^"]*"/g, '')  // remove AI-specific namespaces that break parser
    .trim();

  // Make sure it starts with <svg
  const svgStart = cleaned.search(/<svg/i);
  if (svgStart > 0) cleaned = cleaned.slice(svgStart);
  if (svgStart < 0) { showUndoToast('⚠ SVG inválido — no se encontró elemento <svg>'); return; }

  // ── STEP 1.5: Convert CSS classes to inline attributes (Illustrator SVGs) ──
  // Illustrator puts colors in <style>.st0{fill:#xxx}</style> and uses class="st0"
  // We need to inline these so color replacement works on individual elements
  cleaned = _svgInlineStyles(cleaned);

  // ── STEP 2: Parse and extract dimensions ──
  let natW = 400, natH = 400, cleanSvg = cleaned;

  try {
    const parser = new DOMParser();
    const doc = parser.parseFromString(cleaned, 'image/svg+xml');
    const parseErr = doc.querySelector('parsererror');
    if (parseErr) {
      console.warn('[SVG] Parser error, using regex fallback:', parseErr.textContent?.slice(0,100));
      // Fallback: extract dimensions with regex
      const wMatch = cleaned.match(/width="([^"]+)"/);
      const hMatch = cleaned.match(/height="([^"]+)"/);
      const vbMatch = cleaned.match(/viewBox="([^"]+)"/);
      if (wMatch) natW = parseFloat(wMatch[1]) || 400;
      if (hMatch) natH = parseFloat(hMatch[1]) || 400;
      if (vbMatch && (!natW || !natH)) {
        const p = vbMatch[1].trim().split(/[\s,]+/);
        natW = parseFloat(p[2]) || 400;
        natH = parseFloat(p[3]) || 400;
      }
      // Use cleaned string directly — remove width/height attrs for scaling
      cleanSvg = cleaned
        .replace(/(<svg[^>]*)\s+width="[^"]*"/, '$1')
        .replace(/(<svg[^>]*)\s+height="[^"]*"/, '$1');
      // Add viewBox if missing
      if (!cleanSvg.includes('viewBox') && natW && natH) {
        cleanSvg = cleanSvg.replace('<svg', `<svg viewBox="0 0 ${natW} ${natH}"`);
      }
    } else {
      const svgEl = doc.querySelector('svg');
      natW = parseFloat(svgEl.getAttribute('width')) || 0;
      natH = parseFloat(svgEl.getAttribute('height')) || 0;
      const vb = svgEl.getAttribute('viewBox');
      if ((!natW || !natH) && vb) {
        const p = vb.trim().split(/[\s,]+/);
        natW = parseFloat(p[2]) || 400;
        natH = parseFloat(p[3]) || 400;
      }
      if (!natW) natW = 400;
      if (!natH) natH = 400;
      if (!svgEl.getAttribute('viewBox')) svgEl.setAttribute('viewBox', `0 0 ${natW} ${natH}`);
      svgEl.removeAttribute('width');
      svgEl.removeAttribute('height');
      cleanSvg = svgEl.outerHTML;
    }
  } catch(e) {
    console.warn('[SVG] Parse exception:', e.message);
    // Use raw string with basic cleanup
    cleanSvg = cleaned;
  }


  // ── STEP 3: Scale to canvas ──
  const maxSz = Math.min(W, H) * 0.45;
  const scale = Math.min(maxSz / natW, maxSz / natH, 1);
  const objW = Math.max(50, Math.round(natW * scale));
  const objH = Math.max(50, Math.round(natH * scale));

  const id = genId();
  const obj = {
    id,
    type: 'deco',
    subtype: 'vector',
    x: Math.round(W / 2 - objW / 2),
    y: Math.round(H / 2 - objH / 2),
    w: objW,
    h: objH,
    rotation: 0,
    opacity: 1,
    zIndex: objects.length + 2,
    visible: true,
    locked: false,
    decoSvg: cleanSvg,
    _originalSvg: cleanSvg,  // for color reset
    _fileName: fileName,
  };

  objects.push(obj);
  renderObjects();
  selectObject(id);
  showUndoToast('✦ Vector añadido: ' + fileName.replace(/\.[^.]+$/, ''));
  // Close mobile drawer so user can see the canvas
  try {
    document.getElementById('svg-upload-section').style.display = 'none';
    const dc = document.getElementById('mob-drawer-content');
    if(dc) dc.style.display = '';
    const drawer = document.getElementById('mob-drawer');
    if(drawer) drawer.classList.remove('open');
    if(typeof activeMobTab !== 'undefined') activeMobTab = '';
    document.querySelectorAll('.mob-tab').forEach(b => b.classList.remove('on'));
  } catch(e){}

  // Show color editor
  _svgEditId = id;
  _svgOriginalColors[id] = cleanSvg;
  _svgUpdateColorPanel(obj);
}

// ── COLOR EXTRACTION & EDITING ──
function _svgGetColors(svgString) {
  const colors = new Set();
  const skip = new Set(['none','transparent','inherit','currentcolor',
    '#fff','#ffffff','white','#000','#000000','black',
    '#fefefe','#fdfdfd','#010101','#020202']);

  // 1. All hex colors anywhere in the string (covers style blocks + attributes)
  const hexRe = /#([0-9a-fA-F]{6}|[0-9a-fA-F]{3})/g;
  let m;
  while ((m = hexRe.exec(svgString)) !== null) {
    const c = m[0].toLowerCase();
    if (!skip.has(c)) colors.add(c);
  }

  // 2. rgb() and rgba()
  const rgbRe = /rgba?\([^)]+\)/g;
  while ((m = rgbRe.exec(svgString)) !== null) {
    const c = m[0].toLowerCase().replace(/\s/g,'');
    if (!c.includes('0,0,0') && !c.includes('255,255,255')) colors.add(c);
  }

  // 3. Named colors in fill/stroke attributes
  const namedRe = /(?:fill|stroke)="([a-z]+)"/gi;
  const namedColors = new Set(['red','blue','green','yellow','orange','purple',
    'pink','cyan','magenta','brown','gray','grey','navy','teal','maroon',
    'olive','lime','aqua','fuchsia','silver','coral','salmon','gold','violet']);
  while ((m = namedRe.exec(svgString)) !== null) {
    if (namedColors.has(m[1].toLowerCase())) colors.add(m[1].toLowerCase());
  }

  return [...colors].slice(0, 16);
}


function _svgUpdateColorPanel(obj) {
  const panel = document.getElementById('svg-color-panel');
  if (!panel) return;

  if (!obj || obj.subtype !== 'vector') {
    panel.style.display = 'none';
    return;
  }

  panel.style.display = 'block';
  const swatches = document.getElementById('svg-color-swatches');
  const colors = _svgGetColors(obj.decoSvg);

  if (colors.length === 0) {
    swatches.innerHTML = '<div style="font-size:9px;color:rgba(255,255,255,0.3);font-family:var(--ui-font);">Vector monocromo — usa los botones de abajo</div>';
  } else {
    swatches.innerHTML = colors.map(c =>
      `<div onclick="document.getElementById('svg-color-picker').value='${_colorToHex(c)}';_svgSelectColor('${c}')"
        title="${c}"
        style="width:24px;height:24px;border-radius:5px;background:${c};cursor:pointer;border:2px solid rgba(255,255,255,0.15);transition:transform .15s;flex-shrink:0;"
        onmouseover="this.style.transform='scale(1.2)'" onmouseout="this.style.transform='scale(1)'">
      </div>`
    ).join('');
  }
}

let _svgTargetColor = null;
function _svgSelectColor(c) {
  _svgTargetColor = c;
