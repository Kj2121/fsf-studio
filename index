          el.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="13" height="13"><path d="M1 1l22 22M16.72 11.06A10.94 10.94 0 0 1 19 12.55M5 12.55a10.94 10.94 0 0 1 5.17-2.39M10.71 5.05A16 16 0 0 1 22.56 9M1.42 9a15.91 15.91 0 0 1 4.7-2.88M8.53 16.11a6 6 0 0 1 6.95 0M12 20h.01"/></svg> Modo sin conexión';
          document.body.appendChild(el);
        }
      } else {
        if (toast) toast.remove();
      }
    }
    window.addEventListener('online',  _fsfNetworkStatus);
    window.addEventListener('offline', _fsfNetworkStatus);
    _fsfNetworkStatus();
  }

  // ── 3. INSTALL PROMPT (A2HS) ─────────────────────────────
  let _deferredInstall = null;

  window.addEventListener('beforeinstallprompt', e => {
    e.preventDefault();
    _deferredInstall = e;

