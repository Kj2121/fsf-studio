const _CAR = {
  slides: [],       // [{id, objects, themeIdx, customBgColor, bgImgSrc, bgImgPos, bgFilters, overlayOpacity, fmt, label}]
  current: 0,       // index of active slide
  open: false,
};

function _carId(){ return 'slide_'+Date.now()+'_'+Math.random().toString(36).slice(2,6); }

function _carBlankSlide(label){
  return {
    id: _carId(),
    label: label || 'Slide',
    objects: [],
    themeIdx: themeIdx,
    customBgColor: null,
    bgImgSrc: null,
    bgImgPos: 'center',
    bgFilters: {brightness:100,contrast:100,saturate:100,grayscale:0},
    overlayOpacity: overlayOpacity,
    fmt: fmt,
  };
}

// Snapshot current canvas into slide data
function _carSnapshotCurrent(){
  return {
    objects: JSON.parse(JSON.stringify(objects)),
    themeIdx,
    customBgColor,
    bgImgSrc,
    bgImgPos,
    bgFilters: {...bgFilters},
    overlayOpacity,
    fmt,
  };
}

// Restore a slide's data into the canvas
function _carRestoreSlide(slide){
  objects = JSON.parse(JSON.stringify(slide.objects));
  themeIdx = slide.themeIdx ?? 0;
  customBgColor = slide.customBgColor || null;
  bgImgSrc = slide.bgImgSrc || null;
  bgImgPos = slide.bgImgPos || 'center';
  bgFilters = {...(slide.bgFilters || {brightness:100,contrast:100,saturate:100,grayscale:0})};
  overlayOpacity = slide.overlayOpacity ?? 0.45;
  if(slide.fmt && slide.fmt !== fmt){ fmt = slide.fmt; updateCanvasSize(); }
  selectedId = null;
  applyBackground();
  renderObjects();
  renderLayersPanel();
}

// Save current canvas state back into _CAR.slides[_CAR.current]
function _carSaveCurrent(){
  if(!_CAR.slides.length) return;
  const s = _CAR.slides[_CAR.current];
  const snap = _carSnapshotCurrent();
  Object.assign(s, snap);
}

// ── Open carousel studio ──
function openCarouselStudio(){
  // If no slides yet, init with current canvas as slide 1
  if(!_CAR.slides.length){
    const s = _carBlankSlide('Slide 1');
    Object.assign(s, _carSnapshotCurrent());
    _CAR.slides.push(s);
    _CAR.current = 0;
  }
  _CAR.open = true;
  _carRenderModal();
}

function closeCarouselStudio(){
  _CAR.open = false;
  const m = document.getElementById('carousel-modal');
  if(m) m.remove();
}

