function toggleLock(id){
  const o=getObject(id); if(!o) return;
  pushUndo();
  o.locked=!o.locked;
  renderObjects();
  renderLayersPanel();
  showUndoToast(o.locked?'🔒 Capa bloqueada':'🔓 Capa desbloqueada');
}

function layerRename(e, id){
  e.stopPropagation();
  const nameEl = e.target;
  const obj = getObject(id); if(!obj) return;
  const input = document.createElement('input');
  input.value = nameEl.textContent;
  input.style.cssText='background:rgba(255,255,255,0.08);border:1px solid rgba(30,123,255,0.4);border-radius:5px;padding:2px 6px;color:#fff;font-family:var(--ui-font);font-size:10px;width:100%;outline:none;';
  nameEl.replaceWith(input);
  input.focus(); input.select();
  const done = ()=>{
    const val = input.value.trim();
    if(val){ obj._layerName = val; }
    renderLayersPanel();
  };
  input.onblur = done;
  input.onkeydown = e=>{ if(e.key==='Enter') done(); if(e.key==='Escape') renderLayersPanel(); };
}

// ── Drag to reorder layers ──
let _layerDragId = null;
function layerDragStart(e, id){
  _layerDragId = id;
  e.dataTransfer.effectAllowed = 'move';
}
function layerDragOver(e){
  e.preventDefault();
  e.dataTransfer.dropEffect = 'move';
}
function layerDrop(e, targetId){
  e.preventDefault();
  if(!_layerDragId || _layerDragId === targetId) return;
  const dragObj = getObject(_layerDragId);
  const targetObj = getObject(targetId);
  if(!dragObj || !targetObj) return;
  pushUndo();
  // Swap zIndex values
  const tmp = dragObj.zIndex;
  dragObj.zIndex = targetObj.zIndex;
  targetObj.zIndex = tmp;
  renderObjects();
  renderLayersPanel();
  _layerDragId = null;
}

function toggleVis(id){
  const o=getObject(id); if(!o) return;
  // BUG FIX: guardar estado para poder deshacer la visibilidad
  pushUndo();
  o.visible=!o.visible;
  renderObjects();
  renderLayersPanel();
}

function deleteObj(id){
  pushUndo();
  objects=objects.filter(o=>o.id!==id);
  if(selectedId===id){ selectedId=null; clearSelection(); showSelBar(false); hidePropPanel(); }
  renderObjects();
  renderLayersPanel();
}

