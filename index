// DRAG TO MOVE  —  Pointer Events API (mouse + touch unified)
let moveState=null;
let _movRaf=null;

function _startDrag(pointerId, clientX, clientY, id, captureTarget){
  const obj=getObject(id); if(!obj) return;
  const sc=getScale();
  const el=document.querySelector(`[data-id="${id}"]`);
  if(el){ el.style.willChange='transform'; el.style.transition='none'; }
  if(captureTarget && captureTarget.setPointerCapture){
    try{ captureTarget.setPointerCapture(pointerId); }catch(e){}
  }
  const box=document.querySelector('.sel-box');

  // Cache element dimensions NOW (before any drag frames) to avoid layout reads per frame
  const elW = el ? el.offsetWidth  : (obj.w||100);
  const elH = el ? el.offsetHeight : (obj.h||100);

  // Cache other objects' snap points too
  const {W,H}=getFmtSize();
  const snapTargetsX = [0, W/2, W];
  const snapTargetsY = [0, H/2, H];
  for(const other of objects){
    if(other.id===id||!other.visible) continue;
    const oEl=document.querySelector(`[data-id="${other.id}"]`);
    const oW=oEl?oEl.offsetWidth:(other.w||100);
    const oH=oEl?oEl.offsetHeight:(other.h||100);
    snapTargetsX.push(other.x, other.x+oW/2, other.x+oW);
    snapTargetsY.push(other.y, other.y+oH/2, other.y+oH);
  }

  document.body.classList.add('fsf-interact');
  moveState={
    id, pointerId,
    startX:clientX, startY:clientY,
    origX:obj.x, origY:obj.y, sc,
    curDx:0, curDy:0,
    elW, elH,
    elNode: el,
    boxNode: box,
    snapTargetsX, snapTargetsY,
    boxStartLeft: box ? parseFloat(box.style.left)||0 : 0,
    boxStartTop:  box ? parseFloat(box.style.top)||0  : 0,
  };
  pushUndo();
}

// Called from element mousedown (click on text directly)
function onElMouseDown(e, id){
  if(e.button!==0) return;
  e.stopPropagation(); e.preventDefault();
  selectObject(id);
  _startDrag(e.pointerId, e.clientX, e.clientY, id, e.target);
}

