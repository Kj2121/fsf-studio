const _CV3_SLOTS={"poster": {"4": "W", "5": "V"}, "versoFoto": {"0": "R", "1": "V", "2": "x"}, "cita": {"3": "V", "4": "R"}, "arco": {"0": "R", "1": "W", "2": "x", "3": "V"}, "split": {"1": "W", "2": "x", "3": "V", "4": "R"}, "devocional": {"2": "W", "3": "x", "4": "x", "5": "V", "6": "R"}, "oracion": {"3": "W", "4": "V"}, "oracionFoto": {"2": "W", "3": "V"}, "polaroid": {"0": "W"}, "banda": {"0": "W", "1": "x", "2": "V", "3": "R"}, "eclipse": {"0": "W", "3": "R", "4": "V"}, "collage": {"0": "W", "2": "R", "3": "V"}, "manifiesto": {"0": "R", "1": "W", "2": "x", "3": "x", "4": "x"}, "galeria": {"0": "R", "1": "V", "4": "N"}, "horizonte": {"1": "R", "2": "W", "3": "V", "5": "n"}, "lente": {"0": "B", "1": "N", "2": "V"}, "mosaico": {"3": "V", "4": "W"}, "portal": {"0": "W", "1": "V"}, "triptico": {"2": "W"}, "bloque": {"0": "R", "1": "V"}, "arcoMin": {"0": "V", "1": "R"}, "dosBloques": {"1": "V", "2": "R"}, "marco": {"2": "R", "3": "V", "4": "x"}, "marcoV": {"2": "W", "3": "R"}, "marcoBanda": {"2": "W", "3": "V", "4": "R"}, "sello": {"2": "W", "3": "V", "4": "R"}, "selloTipo": {"0": "W", "1": "x", "2": "x", "3": "R"}, "selloH": {"0": "W", "1": "V", "2": "x", "3": "R"}};
let _fsfCatCur='Todos';
function _fsfSlotVal(role,m){
  switch(role){
    case 'W': return m[3]; case 'V': return m[2]; case 'R': return m[1];
    case 'B': return m[1].replace(/\s*\d+[:\-–\d]*\s*$/,'');
    case 'N': { const x=/(\d+:[\d\-–]+)\s*$/.exec(m[1]); return x?x[1]:m[1]; }
    case 'n': { const x=/:(\d+)/.exec(m[1]); return x?x[1]:''; }
    default: return '';
  }
}
function _fsfCardTexts(cid){ return objects.filter(o=>o.cardId===cid&&o.type==='text'&&!o._cardTex); }
/* Calcula (y si commit, aplica) el mensaje en las ranuras de la card. Devuelve la escala mínima usada (1 = tamaño original) o 0 si no hay ranuras. */
function _fsfFillCard(cid,m,commit){
  const txt=_fsfCardTexts(cid); if(!txt.length) return 0;
  const style=txt[0].cardStyle, map=_CV3_SLOTS[style]; if(!map) return 0;
  txt.forEach(o=>{ if(!o._s0) o._s0={fs:o.fontSize,h:o.h,y:o.y,op:o.opacity==null?1:o.opacity}; });
  let worst=1; const plan=[];
  Object.keys(map).forEach(k=>{
    const i=+k, o=txt[i], role=map[k]; if(!o) return;
    const val=_fsfSlotVal(role,m);
    if(role==='x'||!val){ plan.push({o,val:'',hide:true}); return; }
    let budget=o._s0.h;
    for(let j=i+1;map[j]==='x'&&txt[j];j++){ budget=Math.max(budget,(txt[j]._s0.y+txt[j]._s0.h)-o._s0.y); }
    const kind=o.fontId==='spacemono'?'mono':(o.uppercase?'caps':'serif'), lh=o.lineHeight||1.3, ls=parseFloat(o.letterSpacing)||0, kf=kind==='mono'?.62:kind==='caps'?.7:.5;
    const longest=Math.max.apply(null,val.split(/\s+/).map(w=>w.length)); let sc=1, fs=o._s0.fs, est=0;
    for(;sc>=0.3;sc-=0.04){ fs=o._s0.fs*sc; const wE=kind==='mono'?o.w*0.92:o.w; est=_cv3Est(val,fs,wE,lh,kind,ls); if(est<=budget*1.03&&longest*(fs*kf+ls)<=wE) break; }
    if(sc<0.3) sc=0.3;
    worst=Math.min(worst,sc); plan.push({o,val,fs:Math.round(fs*100)/100,est});
  });
  if(commit){
    plan.forEach(p=>{
      const o=p.o; o.text=p.val;
      if(p.hide){ o.visible=false; o.opacity=0; } else { o.visible=true; o.opacity=o._s0.op; o.fontSize=p.fs; o.h=Math.max(p.est,Math.round(p.fs*1.2)); }
      const e=document.querySelector('#canvas-bg [data-id="'+o.id+'"]'); if(e) e.remove();
    });
    renderObjects(); try{ renderLayersPanel(); }catch(e){}
  }
  return worst;
}
function _fsfPick(cid,minScale){
  const pool=_FSF_MSGS.filter(m=>_fsfCatCur==='Todos'||m[0]===_fsfCatCur);
  const arr=pool.length?pool:_FSF_MSGS, idx=arr.map((_,i)=>i).sort(()=>Math.random()-.5);
  let best=null,bs=-1;
  for(const i of idx.slice(0,12)){ const sc=_fsfFillCard(cid,arr[i],false); if(sc>=minScale) return arr[i]; if(sc>bs){bs=sc;best=arr[i];} }
  return best||arr[0];
}
function _fsfAutoFill(cid,style){
  if(window._fsfNoAuto||!_CV3_SLOTS[style]) return;
  const m=_fsfPick(cid,0.72); _fsfFillCard(cid,m,true);
}


/* ══ SOMBRAS de cards · dos capas (ambiente + contacto) ══ */
let _shKind='elevada';
const _SH_PRE={
  ninguna:{b:null,c:null},
  suave:{b:{y:10,blur:30,spread:0,a:.22},c:null},
  elevada:{b:{y:26,blur:64,spread:0,a:.34},c:{y:3,blur:9,spread:0,a:.38}},
  flotante:{b:{y:64,blur:84,spread:-18,a:.42},c:null},
  dramatica:{b:{y:44,blur:100,spread:0,a:.55},c:{y:6,blur:14,spread:0,a:.5}}
};
function _shUI(){ document.querySelectorAll('.cv-tex-chip[data-s]').forEach(b=>b.classList.toggle('on',b.dataset.s===_shKind)); }
function _cardShadowApply(kind,cid){
  const body=objects.find(o=>o.cardId===cid&&o.cardRole==='body'); if(!body) return;
  const P=_SH_PRE[kind]||_SH_PRE.elevada, sc=Math.max(.45,body.w/760), col=a=>'rgba(28,18,8,'+a+')';
  const mk=d=>d?{shadow:{active:true,x:0,y:Math.round(d.y*sc),blur:Math.round(d.blur*sc),spread:Math.round(d.spread*sc),color:col(d.a)}}:undefined;
  // quitar sombra de contacto previa de esta card
  objects.filter(o=>o.cardId===cid&&o._cardSh).forEach(o=>{ const e=document.querySelector('#canvas-bg [data-id="'+o.id+'"]'); if(e) e.remove(); });
  objects=objects.filter(o=>!(o.cardId===cid&&o._cardSh));
  try{ APP.objects=objects; }catch(e){}
  if(P.b){ body._fx=Object.assign({},body._fx||{},mk(P.b)); } else if(body._fx){ delete body._fx.shadow; }
  if(P.c){
    const z0=body.zIndex; objects.forEach(o=>{ if(o!==body&&o.zIndex>=z0) o.zIndex+=1; }); 
    const cs={id:genId(),type:'shape',shapeType:'roundrect',x:body.x,y:body.y,w:body.w,h:body.h,fillColor:body.fillColor,strokeColor:'none',strokeWidth:0,fillMode:'fill',cornerRadius:body.cornerRadius,cr:'paper',
      rotation:body.rotation||0,opacity:1,zIndex:z0,visible:true,cardId:cid,cardStyle:body.cardStyle,_cardSh:true,_fx:mk(P.c)};
    body.zIndex=z0+1; objects.push(cs);
  }
  const e=document.querySelector('#canvas-bg [data-id="'+body.id+'"]'); if(e) e.remove();
  renderObjects(); try{ renderLayersPanel(); }catch(e){}
}
function cardShadow(kind){ const cid=_cardGroupId(); _shKind=kind; _shUI(); if(!cid) return; pushUndo(); _cardShadowApply(kind,cid); }

/* ══ CARDS · lienzo Facebook/Instagram cuadrado (1080×1080) + ajuste automático al tamaño del lienzo ══ */
function _cardFit(n0,boost){
  const {W,H}=getFmtSize(); const nw=objects.slice(n0); if(!nw.length) return;
  let x0=1e9,y0=1e9,x1=-1e9,y1=-1e9;
  nw.forEach(o=>{ if(o.w==null) return; x0=Math.min(x0,o.x);y0=Math.min(y0,o.y);x1=Math.max(x1,o.x+o.w);y1=Math.max(y1,o.y+o.h); });
  const bw=x1-x0,bh=y1-y0; if(bw<=0||bh<=0) return;
  const f=Math.min(W*0.94/bw,H*0.94/bh,2.2); const ox=W/2-(x0+bw/2)*f, oy=H/2-(y0+bh/2)*f;
  nw.forEach(o=>{
    if(o.w==null) return;
    o.x=Math.round(o.x*f+ox); o.y=Math.round(o.y*f+oy); o.w=Math.round(o.w*f); o.h=Math.round(o.h*f);
    ['fontSize','cornerRadius','radius','strokeWidth'].forEach(k=>{ if(typeof o[k]==='number') o[k]=Math.round(o[k]*f*100)/100; });
    if(typeof o.letterSpacing==='string'&&/px$/.test(o.letterSpacing)) o.letterSpacing=Math.round(parseFloat(o.letterSpacing)*f)+'px';
    else if(typeof o.letterSpacing==='number') o.letterSpacing=o.letterSpacing*f;
    if(boost&&o.type==='text'&&typeof o.fontSize==='number'){ const fs=o.fontSize; o.fontSize=Math.round(fs<18?Math.max(fs*1.7,22):fs<36?fs*1.4:fs*1.08); }
    const sh=o._fx&&o._fx.shadow; if(sh){ ['x','y','blur','spread'].forEach(k=>{ if(typeof sh[k]==='number') sh[k]=Math.round(sh[k]*f); }); }
  });
  nw.forEach(o=>{ const e=document.querySelector('#canvas-bg [data-id="'+o.id+'"]'); if(e) e.remove(); });
  renderObjects(); updateCanvasSize(); renderLayersPanel();
}

/* quita las "puntas": piezas cuadradas pegadas a una esquina redondeada de la card */
function _cardTrimCorners(){
  const body=_cardBody(); if(!body) return; const br=body.cornerRadius||body.radius||0; if(br<6) return;
  objects.forEach(o=>{
    if(o===body||o.type==='text'||o.type==='deco'||o._cardTex||o.w==null) return;
    const cr=o.cornerRadius||o.radius||0; if(cr>=br*0.9&&o.h>=br*1.6) return;
    const L=Math.abs(o.x-body.x)<4, R=Math.abs(o.x+o.w-body.x-body.w)<4;
    const T=o.y<body.y+br && o.y+o.h>body.y-2, B=o.y+o.h>body.y+body.h-br && o.y<body.y+body.h+2;
    if((L||R)&&(T||B)&&o.h<br*1.6){ o.x=Math.round(body.x+br); o.w=Math.round(body.w-br*2); const e=document.querySelector('#canvas-bg [data-id="'+o.id+'"]'); if(e) e.remove(); }
  });
}
function _cardPre(){
  try{ const sz=getFmtSize(); if(!(sz.W===1080&&sz.H===1080)) setFmt('fbsquare'); }catch(e){}
}
['addDesignCard','addPhotoCard','addCardV2'].forEach(function(nm){
  const orig=window[nm]; if(typeof orig!=='function') return;
  window[nm]=function(st){ _cardPre(); const n0=objects.length; const r=orig.apply(this,arguments); _cardFit(n0,nm!=='addCardV2'); try{ _cardTrimCorners(); }catch(e){} try{ const st=arguments[0]; _texKind=(_TEX_DEFAULT[st]||(nm==='addPhotoCard'?'grano':'papel')); _cardTexApply(_texKind); _cardTexUI(); }catch(e){console.warn('tex',e);} return r; };
});
</script>
