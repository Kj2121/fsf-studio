  panel.id = 'img-frame-panel';
  panel.style.cssText = 'position:fixed;inset:0;z-index:99999;display:flex;flex-direction:column;justify-content:flex-end;';

  const aspect = (obj.w)/(obj.h||obj.w);
  const previewW = Math.min(280, window.innerWidth-80);
  const previewH = previewW/aspect;

  panel.innerHTML = `
    <div onclick="_closeImgFramePanel()" style="flex:1;background:rgba(0,0,0,0.6);backdrop-filter:blur(6px);"></div>
    <div style="background:#111116;border-radius:22px 22px 0 0;padding:18px 16px;display:flex;flex-direction:column;gap:14px;border-top:1px solid rgba(255,255,255,0.08);">
      <div style="width:36px;height:4px;background:rgba(255,255,255,0.15);border-radius:2px;margin:0 auto;"></div>
      <div style="font-size:11px;font-weight:800;letter-spacing:2px;text-transform:uppercase;color:rgba(255,255,255,0.3);text-align:center;font-family:var(--ui-font);">Ajustar encuadre</div>

      <div style="font-size:10px;color:rgba(255,255,255,0.4);text-align:center;font-family:var(--ui-font);">Arrastra la imagen para elegir qué parte se ve</div>

      <!-- Preview interactivo -->
      <div id="frame-preview" style="width:${previewW}px;height:${previewH}px;margin:0 auto;border-radius:12px;overflow:hidden;position:relative;border:2px solid rgba(30,123,255,0.4);cursor:grab;touch-action:none;background:#000;">
        <div id="frame-preview-img" style="position:absolute;inset:0;background:url('${obj.imgSrc}') ${obj.imgOffsetX}% ${obj.imgOffsetY}%/${obj.imgScale<=100?'cover':obj.imgScale+'%'} no-repeat;"></div>
      </div>

      <!-- Zoom slider -->
      <div style="display:flex;align-items:center;gap:12px;padding:0 4px;">
        <svg viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,0.5)" stroke-width="2" width="18" height="18"><circle cx="11" cy="11" r="7"/><line x1="8" y1="11" x2="14" y2="11"/></svg>
        <input type="range" id="frame-zoom" min="100" max="250" value="${obj.imgScale}" style="flex:1;accent-color:#7C5BF0;" oninput="_updateImgFrame('${objId}','zoom',this.value)">
        <svg viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,0.5)" stroke-width="2" width="18" height="18"><circle cx="11" cy="11" r="7"/><line x1="8" y1="11" x2="14" y2="11"/><line x1="11" y1="8" x2="11" y2="14"/></svg>
      </div>

      <div style="display:flex;gap:8px;">
        <button onclick="_resetImgFrame('${objId}')" style="flex:1;padding:12px;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:12px;color:rgba(255,255,255,0.7);font-size:12px;font-weight:700;cursor:pointer;font-family:var(--ui-font);">Restablecer</button>
        <button onclick="_closeImgFramePanel()" style="flex:2;padding:12px;background:linear-gradient(135deg,#7C5BF0,#9F7AEA);border:none;border-radius:12px;color:#fff;font-size:12px;font-weight:700;cursor:pointer;font-family:var(--ui-font);">Listo</button>
      </div>
      <div style="height:max(env(safe-area-inset-bottom),8px);"></div>
    </div>
  `;
  document.body.appendChild(panel);

  // Drag interaction on preview
  const preview = document.getElementById('frame-preview');
  let dragging=false, startX=0, startY=0, startOX=obj.imgOffsetX, startOY=obj.imgOffsetY;

  function onStart(e){
    dragging=true; preview.style.cursor='grabbing';
    const pt = e.touches?e.touches[0]:e;
    startX=pt.clientX; startY=pt.clientY;
    startOX=obj.imgOffsetX; startOY=obj.imgOffsetY;
    e.preventDefault();
  }
  function onMove(e){
    if(!dragging) return;
    const pt = e.touches?e.touches[0]:e;
    const dx=pt.clientX-startX, dy=pt.clientY-startY;
    // Convert pixel drag to % offset (inverted: drag right → show left part)
    const sensX = 100/previewW * 1.5;
    const sensY = 100/previewH * 1.5;
    obj.imgOffsetX = Math.max(0, Math.min(100, startOX - dx*sensX));
    obj.imgOffsetY = Math.max(0, Math.min(100, startOY - dy*sensY));
    _syncFramePreview(obj);
    renderObjects();
    e.preventDefault();
  }
  function onEnd(){ dragging=false; if(preview) preview.style.cursor='grab'; }

  preview.addEventListener('mousedown', onStart);
  preview.addEventListener('touchstart', onStart, {passive:false});
  document.addEventListener('mousemove', onMove);
  document.addEventListener('touchmove', onMove, {passive:false});
  document.addEventListener('mouseup', onEnd);
  document.addEventListener('touchend', onEnd);
  panel._cleanup = () => {
    document.removeEventListener('mousemove', onMove);
    document.removeEventListener('touchmove', onMove);
    document.removeEventListener('mouseup', onEnd);
    document.removeEventListener('touchend', onEnd);
  };
}

function _syncFramePreview(obj){
  const pimg = document.getElementById('frame-preview-img');
  if(pimg){
    const sz = obj.imgScale<=100?'cover':obj.imgScale+'%';
    pimg.style.backgroundPosition = `${obj.imgOffsetX}% ${obj.imgOffsetY}%`;
    pimg.style.backgroundSize = sz;
  }
}

function _updateImgFrame(objId, prop, val){
  const obj = getObject(objId); if(!obj) return;
  if(prop==='zoom') obj.imgScale = parseInt(val);
  _syncFramePreview(obj);
