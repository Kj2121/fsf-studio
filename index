.cv2 span{font-size:11px;font-weight:800;text-align:center}
.cv2-lbl{font-size:10px;font-weight:800;letter-spacing:1.6px;text-transform:uppercase;color:#7F93BD;margin:6px 2px 8px;font-family:var(--ui-font)}
.cv-tex{display:grid;grid-template-columns:repeat(3,1fr);gap:6px;margin-bottom:10px}
.cv-tex-chip{padding:9px 2px;border-radius:11px;font-family:var(--ui-font);font-size:11px;font-weight:800;cursor:pointer;color:#E8EEFF;background:linear-gradient(180deg,#2B3858,#1B2540);border:1px solid #3B4A6E;box-shadow:0 3px 0 #09101F,inset 0 1px 0 rgba(255,255,255,.12)}
.cv-tex-chip:active{transform:translateY(3px);box-shadow:none}
.add-pane .cv-tex .cv-tex-chip.on.on.on.on,.cv-tex-chip.on{background:linear-gradient(180deg,#5AA2FF,#1E7BFF 55%,#1257D1)!important;border-color:#7DB6FF!important;color:#fff!important;box-shadow:0 3px 0 #0B3A99,0 0 12px rgba(30,123,255,.4)!important}
.cv-tex-row{display:flex;align-items:center;gap:10px;margin-bottom:14px;font-family:var(--ui-font);font-size:11px;font-weight:700;color:#8E9FC4}
.cv-tex-row input{flex:1;accent-color:#1E7BFF}
.cv-pal{display:grid;grid-template-columns:repeat(6,1fr);gap:8px;margin-bottom:12px}
.cv-pal-dot{aspect-ratio:1/1;border-radius:50%;border:2px solid #3B4A6E;cursor:pointer;padding:0;box-shadow:0 3px 0 #09101F,inset 0 0 0 2px rgba(255,255,255,.35)}
.add-pane .cv-pal .cv-pal-dot.on.on.on.on{border-color:#7DB6FF!important;box-shadow:0 3px 0 #0B3A99,0 0 0 3px #1E7BFF,inset 0 0 0 2px rgba(255,255,255,.5)!important}
.add-pane .cv-pal .cv-pal-dot{min-height:0;height:auto;padding:0!important;width:100%!important;background-clip:padding-box}
.msg-cats{grid-template-columns:repeat(4,1fr)}
.msg-rand{width:100%;margin:0 0 8px;padding:11px 8px;border-radius:12px;font-family:var(--ui-font);font-size:12px;font-weight:800;cursor:pointer;color:#fff;background:linear-gradient(180deg,#5AA2FF,#1E7BFF 55%,#1257D1);border:1px solid #7DB6FF;box-shadow:0 3px 0 #0B3A99,0 0 12px rgba(30,123,255,.35)}
.msg-rand:active{transform:translateY(3px);box-shadow:none}
.msg-list{max-height:230px;overflow:auto;display:flex;flex-direction:column;gap:6px;margin-bottom:14px;padding-right:2px}
.msg-row{text-align:left;padding:9px 11px;border-radius:11px;cursor:pointer;font-family:var(--ui-font);color:#E8EEFF;background:linear-gradient(180deg,#2B3858,#1B2540);border:1px solid #3B4A6E;box-shadow:0 3px 0 #09101F,inset 0 1px 0 rgba(255,255,255,.12);display:block;width:100%}
.msg-row:active{transform:translateY(3px);box-shadow:none}
.msg-row b{display:block;font-size:10px;letter-spacing:1px;text-transform:uppercase;color:#7DB6FF;margin-bottom:3px}
.msg-row span{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;font-size:12px;font-weight:600;line-height:1.35;color:#D5DEF5}
</style>
