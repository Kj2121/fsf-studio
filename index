// Generate real canvas thumbnail as dataURL
async function _projThumb(W=180){
  const F=FMTS[fmt]||FMTS.square;
  const H=Math.round(F.H/F.W*W);
  const cv=document.createElement('canvas');
  cv.width=W;cv.height=H;
  const ctx=cv.getContext('2d');
  const th=THEMES[themeIdx]||THEMES[0];
  if(th.g&&th.g!=='transparent'){try{drawCSSGradient(ctx,th.g,W,H);}catch(e){ctx.fillStyle='#1a0f06';ctx.fillRect(0,0,W,H);}}
  else{ctx.fillStyle='#ffffff';ctx.fillRect(0,0,W,H);}
  const sc=W/F.W;
  // Draw deco SVGs
  const decos=objects.filter(o=>o.type==='deco'&&o.decoSvg);
  for(const deco of decos){
    try{
      const blobUrl=URL.createObjectURL(new Blob([deco.decoSvg],{type:'image/svg+xml'}));
      await new Promise(resolve=>{
        const img=new Image();
        const done=()=>{URL.revokeObjectURL(blobUrl);resolve();};
        img.onload=()=>{try{ctx.save();ctx.globalAlpha=deco.opacity??1;ctx.drawImage(img,deco.x*sc,deco.y*sc,deco.w*sc,(deco.h||deco.w)*sc);ctx.restore();}catch(e){}done();};
        img.onerror=done;img.src=blobUrl;setTimeout(done,400);
      });
    }catch(e){}
  }
  // Overlay
  if(overlayOpacity>0){const ov=(th.ov||'20,10,4').split(',').map(Number);ctx.fillStyle=`rgba(${ov[0]},${ov[1]},${ov[2]},${overlayOpacity})`;ctx.fillRect(0,0,W,H);}
  // Text
  objects.filter(o=>o.type==='text'&&o.visible!==false).forEach(o=>{
    const fs=Math.max(4,o.fontSize*sc);
    ctx.save();ctx.font=`${o.italic?'italic ':''}${o.bold?'bold ':''}${fs}px sans-serif`;
    ctx.fillStyle=o.color||'#fff';ctx.globalAlpha=o.opacity??0.92;
    ctx.textAlign=o.align==='center'?'center':o.align==='right'?'right':'left';
    ctx.textBaseline='top';ctx.shadowColor='rgba(0,0,0,0.5)';ctx.shadowBlur=2;
    const ax=o.align==='center'?(o.x+o.w/2)*sc:o.align==='right'?(o.x+o.w)*sc:o.x*sc;
    (o.text||'').split('\n').slice(0,3).forEach((line,i)=>{
      ctx.fillText((o.uppercase?line.toUpperCase():line).substring(0,28),ax,o.y*sc+i*fs*1.3,o.w*sc);
    });
    ctx.restore();
  });
  return cv.toDataURL('image/jpeg',0.82);
}

// Save current design as a named project
async function saveToHistory(customName){
  if(!objects.length&&!bgImgSrc){showUndoToast('⚠ Canvas vacío');return;}
  const projects=_projLoad();
  // Auto-generate name from main text or date
  const mainText=objects.find(o=>o.type==='text'&&(o.subtype==='title'||o.subtype==='verse'));
  const defaultName=customName||(mainText?.text?.replace(/\n/g,' ').substring(0,28)||'Diseño sin título');
  const now=new Date();
  const thumb=await _projThumb();
  const proj={
    id:'proj_'+Date.now(),
    name:defaultName,
    fmt,themeIdx,overlayOpacity,
    objects:JSON.parse(JSON.stringify(objects)),
    bgImgSrc: bgImgSrc&&!bgImgSrc.startsWith('http')?bgImgSrc:null,
    thumb,
    createdAt:now.toISOString(),
    updatedAt:now.toISOString(),
    fmtLabel:FMTS[fmt]?.lbl?.split('·')[0]?.trim()||fmt,
  };
  projects.unshift(proj);
  if(projects.length>PROJ_MAX)projects.splice(PROJ_MAX);
  _projSave(projects);
  renderHistory();
  showUndoToast('💾 Guardado: '+defaultName.substring(0,20));
}

// Auto-save every 90 seconds if canvas has content
function _projScheduleAutosave(){
  clearTimeout(_projAutoSaveTimer);
  if(!objects.length)return;
  _setTimer('autosave', async()=>{
    const thumb=await _projThumb();
    const data={fmt,themeIdx,overlayOpacity,objects:JSON.parse(JSON.stringify(objects)),bgImgSrc:bgImgSrc&&!bgImgSrc.startsWith('http')?bgImgSrc:null,thumb,updatedAt:new Date().toISOString()};
    _storage.set(PROJ_AUTOSAVE_KEY, JSON.stringify(data));
  }, 90000);
}

function openProjects(){
  renderProjects();
  document.getElementById('projects-screen').classList.add('open');
}
function closeProjects(){
  document.getElementById('projects-screen').classList.remove('open');
}
function projNewDesign(){
  closeProjects();
  // Clear canvas
  pushUndo();objects=[];bgImgSrc=null;_customGradient=null;
  fmt='square';themeIdx=1;overlayOpacity=0;
  updateCanvasSize();applyBackground();renderObjects();renderLayersPanel();
}

function renderProjects(search=''){
  const grid=document.getElementById('proj-grid');
  const empty=document.getElementById('proj-empty');
  if(!grid)return;
  let projects=_projLoad();
  if(search){const q=search.toLowerCase();projects=projects.filter(p=>p.name.toLowerCase().includes(q));}
  if(!projects.length){grid.innerHTML='';if(empty)empty.style.display='flex';return;}
  if(empty)empty.style.display='none';

  // Group by date
  const today=new Date().toDateString();
  const yesterday=new Date(Date.now()-86400000).toDateString();
  const groups={};
  projects.forEach(p=>{
    const d=new Date(p.createdAt||p.updatedAt||Date.now()).toDateString();
    const lbl=d===today?'Hoy':d===yesterday?'Ayer':new Date(p.createdAt||Date.now()).toLocaleDateString('es',{day:'numeric',month:'short'});
    if(!groups[lbl])groups[lbl]=[];
    groups[lbl].push(p);
  });

  grid.innerHTML='';
  Object.entries(groups).forEach(([lbl,projs])=>{
    const section=document.createElement('div');
    section.style.cssText='margin-bottom:20px;';
    section.innerHTML=`<div class="proj-section-lbl">${lbl}</div>`;
    const g=document.createElement('div');
    g.style.cssText='display:grid;grid-template-columns:repeat(2,1fr);gap:10px;';
    projs.forEach(p=>{
      const card=document.createElement('div');
      card.className='proj-card';
      const timeStr=new Date(p.updatedAt||p.createdAt||Date.now()).toLocaleTimeString('es',{hour:'2-digit',minute:'2-digit'});
      const fmtBadge=p.fmtLabel||p.fmt||'Post';
      card.innerHTML=`
        <div class="proj-card-thumb">${p.thumb?`<img src="${p.thumb}" loading="lazy">`:'<div style="width:100%;height:100%;background:linear-gradient(135deg,#0A0F1C,#141D33);"></div>'}</div>
        <div class="proj-card-body">
          <div class="proj-card-name" contenteditable="true" spellcheck="false" onblur="projRename('${p.id}',this.textContent)" onclick="event.stopPropagation()">${p.name}</div>
          <div class="proj-card-meta"><span>${timeStr}</span><span style="opacity:.5;">·</span><span>${fmtBadge}</span></div>
        </div>
        <div class="proj-card-actions">
          <button class="proj-action-btn" onclick="event.stopPropagation();projDelete('${p.id}')" title="Eliminar">🗑</button>
        </div>
      `;
      card.addEventListener('click',e=>{if(e.target.contentEditable==='true'||e.target.closest('[contenteditable]'))return;projOpen(p.id);});
      g.appendChild(card);
    });
    section.appendChild(g);
    grid.appendChild(section);
  });
}

function projOpen(id){
  const projects=_projLoad();
  const p=projects.find(x=>x.id===id);if(!p)return;
  pushUndo();
  fmt=p.fmt||'square';themeIdx=p.themeIdx??1;overlayOpacity=p.overlayOpacity??0;
  bgImgSrc=p.bgImgSrc||null;_customGradient=null;customBgColor=null;
  objects=JSON.parse(JSON.stringify(p.objects||[]));
  updateCanvasSize();applyBackground();renderObjects();renderLayersPanel();
  closeProjects();
  showUndoToast('✦ Proyecto abierto: '+p.name.substring(0,20));
}

function projRename(id,newName){
  const projects=_projLoad();
  const p=projects.find(x=>x.id===id);
  if(p&&newName.trim()){p.name=newName.trim();_projSave(projects);}
}

function projDelete(id){
  const projects=_projLoad().filter(x=>x.id!==id);
  _projSave(projects);
  renderProjects(document.getElementById('proj-search')?.value||'');
}

// Legacy compatibility
function renderHistory(){
  const el=document.getElementById('history-grid');if(!el)return;
  const projects=_projLoad().slice(0,6);
  if(!projects.length){el.innerHTML='<div style="font-size:9px;color:var(--txt3);padding:4px 0;grid-column:span 2;">Guarda diseños para verlos aquí.</div>';return;}
  el.innerHTML=projects.map((p,i)=>`
    <div class="history-card" onclick="projOpen('${p.id}')">
      <div class="history-thumb">${p.thumb?`<img src="${p.thumb}" style="width:100%;height:100%;object-fit:cover;">`:'<div style="width:100%;height:100%;background:linear-gradient(135deg,#0A0F1C,#141D33);"></div>'}</div>
      <div class="history-info">${p.name.substring(0,20)}</div>
      <button class="history-del" onclick="event.stopPropagation();projDelete('${p.id}')">✕</button>
    </div>`).join('');
}

