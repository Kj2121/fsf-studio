    {ref:'Hechos 2:38',verse:'"Arrepentíos, y bautícese cada uno de vosotros en el nombre de Jesucristo para perdón de los pecados."',body:'El arrepentimiento es el primer paso de la vida nueva.'},
    {ref:'Romanos 5:1',verse:'"Justificados, pues, por la fe, tenemos paz para con Dios."',body:'La justificación no es un proceso — es un hecho completado en la cruz.'},
    {ref:'Juan 10:10',verse:'"Yo he venido para que tengan vida, y para que la tengan en abundancia."',body:'Jesús no vino a darte religión. Vino a darte vida.'},
    {ref:'Apocalipsis 3:20',verse:'"He aquí, yo estoy a la puerta y llamo."',body:'Dios no entra por la fuerza. Espera que abras.'},
    {ref:'Marcos 1:15',verse:'"Arrepentíos, y creed en el evangelio."',body:'Dos movimientos que lo cambian todo: arrepentirse y creer.'},
    {ref:'Romanos 8:1',verse:'"Ninguna condenación hay para los que están en Cristo Jesús."',body:'En Cristo no hay culpa que no haya sido perdonada.'},
    {ref:'Hechos 16:31',verse:'"Cree en el Señor Jesucristo, y serás salvo tú y tu casa."',body:'La salvación tiene alcance familiar.'},
    {ref:'Juan 5:24',verse:'"El que oye mi palabra, y cree al que me envió, tiene vida eterna."',body:'La vida eterna no es algo que esperas — es algo que tienes ahora.'},
    {ref:'1 Juan 1:9',verse:'"Si confesamos nuestros pecados, él es fiel y justo para perdonar nuestros pecados."',body:'El perdón de Dios no depende de cuánto te esfuerces — depende de Su fidelidad.'},
  ],

  'Sanidad': [
    {ref:'Salmos 103:3',verse:'"Él es quien perdona todas tus iniquidades y sana todas tus enfermedades."',body:'Su misericordia cubre cuerpo y alma.'},
    {ref:'Isaías 53:5',verse:'"Por su llaga fuimos nosotros curados."',body:'La sanidad ya fue pagada en la cruz.'},
    {ref:'Jeremías 30:17',verse:'"Yo haré venir sanidad para ti, y te sanaré de tus heridas."',body:'Dios es especialista en restaurar lo roto.'},
    {ref:'Mateo 4:23',verse:'"Jesús recorría... sanando toda enfermedad y toda dolencia."',body:'Ayer, hoy y siempre el mismo Jesús.'},
    {ref:'Santiago 5:15',verse:'"La oración de fe salvará al enfermo, y el Señor lo levantará."',body:'La oración cambia lo que la medicina no puede.'},
    {ref:'Éxodo 15:26',verse:'"Yo soy el Señor tu sanador."',body:'Antes de que existiera la ciencia, existía el Médico.'},
    {ref:'Salmos 147:3',verse:'"Sana a los quebrantados de corazón y venda sus heridas."',body:'Dios no ignora el dolor emocional. Lo sana.'},
    {ref:'3 Juan 1:2',verse:'"Amado, deseo que seas prosperado en todo, así como prospera tu alma."',body:'La voluntad de Dios incluye tu salud integral.'},
    {ref:'Lucas 4:18',verse:'"Me ha enviado a sanar a los quebrantados de corazón."',body:'La misión de Jesús incluye sanar corazones rotos.'},
    {ref:'Hebreos 13:8',verse:'"Jesucristo es el mismo ayer, y hoy, y por los siglos."',body:'El Jesús que sanaba en Galilea sana hoy.'},
    {ref:'Salmos 41:3',verse:'"El Señor lo sustentará sobre el lecho del dolor."',body:'En la enfermedad, Dios está presente — no ausente.'},
    {ref:'Mateo 8:17',verse:'"Él mismo tomó nuestras enfermedades, y llevó nuestras dolencias."',body:'Lo que cargamos en el cuerpo, Él ya lo cargó en la cruz.'},
    {ref:'Salmos 30:2',verse:'"Señor Dios mío, a ti clamé, y me sanaste."',body:'La sanidad de Dios responde al clamor.'},
    {ref:'Marcos 5:34',verse:'"Tu fe te ha hecho salva; ve en paz, y queda sana de tu azote."',body:'La fe conecta la necesidad con el poder sanador de Dios.'},
    {ref:'Isaías 38:5',verse:'"He oído tu oración, y he visto tus lágrimas; he aquí que yo te sano."',body:'Dios ve las lágrimas de los que sufren. Responde.'},
    {ref:'Mateo 14:36',verse:'"Todos los que le tocaban quedaban sanos."',body:'El contacto con Cristo transforma.'},
    {ref:'Lucas 13:12',verse:'"Mujer, eres libre de tu enfermedad."',body:'Jesús declara libertad. Tú recibes.'},
    {ref:'Números 21:9',verse:'"Cuando alguno era mordido... miraba a la serpiente de bronce, y vivía."',body:'La mirada de fe hacia el Salvador sana.'},
    {ref:'Proverbios 4:22',verse:'"Porque son vida a los que las hallan, y medicina a todo su cuerpo."',body:'La Palabra de Dios es medicina para el cuerpo y el alma.'},
    {ref:'Salmos 6:2',verse:'"Ten misericordia de mí, oh Señor, porque estoy enfermo."',body:'Llevar la enfermedad a Dios en honestidad es el primer paso de la sanidad.'},
  ],

  'Familia': [
    {ref:'Josué 24:15',verse:'"Yo y mi casa serviremos al Señor."',body:'La decisión más importante que tomas por tu familia.'},
    {ref:'Proverbios 22:6',verse:'"Instruye al niño en su camino, y aun cuando fuere viejo no se apartará de él."',body:'Lo que siembras en casa, crecerá para siempre.'},
    {ref:'Salmos 127:3',verse:'"Los hijos son herencia del Señor; y fruto del vientre su recompensa."',body:'Cada hijo es un regalo con propósito eterno.'},
    {ref:'Génesis 2:24',verse:'"Se unirá a su mujer, y serán una sola carne."',body:'El matrimonio fue idea de Dios. Funciona a Su manera.'},
    {ref:'Proverbios 31:25',verse:'"Fuerza y honor son su vestidura; y se ríe de lo por venir."',body:'La mujer de Dios enfrenta el futuro con valor, no con miedo.'},
    {ref:'Efesios 5:25',verse:'"Maridos, amad a vuestras mujeres, así como Cristo amó a la iglesia."',body:'El modelo de amor en el matrimonio es la cruz.'},
    {ref:'Deuteronomio 6:7',verse:'"Las repetirás a tus hijos, y hablarás de ellas estando en tu casa."',body:'El mejor sermón que darás es el que viven tus hijos contigo.'},
    {ref:'Proverbios 17:6',verse:'"Corona de los viejos son los nietos, y la honra de los hijos, sus padres."',body:'La familia bien construida se convierte en legado.'},
    {ref:'Colosenses 3:19',verse:'"Maridos, amad a vuestras mujeres, y no seáis ásperos con ellas."',body:'El amor en el matrimonio requiere ternura, no solo provisión.'},
    {ref:'Efesios 6:1',verse:'"Hijos, obedeced en el Señor a vuestros padres, porque esto es justo."',body:'La obediencia a los padres es un acto de fe.'},
    {ref:'Proverbios 18:22',verse:'"El que halla esposa halla el bien, y alcanza la benevolencia del Señor."',body:'El matrimonio no es un accidente — es una bendición de Dios.'},
    {ref:'Salmos 128:1',verse:'"Bienaventurado todo aquel que teme al Señor, que anda en sus caminos."',body:'Una familia centrada en Dios es una familia protegida.'},
    {ref:'1 Corintios 7:14',verse:'"El marido incrédulo es santificado en la mujer creyente."',body:'La fe de uno puede cubrir y transformar a toda la familia.'},
    {ref:'Proverbios 13:22',verse:'"El bien del justo se traspasa a los hijos de los hijos."',body:'Las decisiones correctas de hoy construyen herencia para mañana.'},
    {ref:'Génesis 18:19',verse:'"Porque yo sé que mandará a sus hijos y a su casa después de sí, que guarden el camino del Señor."',body:'El llamado al liderazgo familiar viene desde Abraham.'},
    {ref:'Salmos 103:17',verse:'"La misericordia del Señor es desde la eternidad hasta la eternidad sobre los que le temen."',body:'La misericordia de Dios cubre generaciones enteras.'},
    {ref:'Rut 1:16',verse:'"Donde tú fueres, iré yo; tu pueblo será mi pueblo, y tu Dios mi Dios."',body:'La lealtad en la familia refleja el carácter de Dios.'},
    {ref:'Isaías 54:13',verse:'"Todos tus hijos serán enseñados por el Señor."',body:'El maestro más importante en la vida de tus hijos es Dios mismo.'},
    {ref:'Efesios 6:2',verse:'"Honra a tu padre y a tu madre."',body:'El quinto mandamiento tiene una promesa adjunta — honrar trae bien.'},
  ],

  'Misión': [
    {ref:'Mateo 28:19',verse:'"Id y haced discípulos a todas las naciones."',body:'La Gran Comisión no fue sugerencia, fue mandato.'},
    {ref:'Marcos 16:15',verse:'"Id por todo el mundo y predicad el evangelio a toda criatura."',body:'Todo el mundo. Toda criatura. Sin excusa.'},
    {ref:'Romanos 10:14',verse:'"¿Cómo creerán en aquel de quien no han oído?"',body:'Alguien fue enviado a ti. Ahora tú eres enviado.'},
    {ref:'Isaías 6:8',verse:'"¿A quién enviaré? Aquí estoy yo, envíame a mí."',body:'La misión comienza con una respuesta voluntaria.'},
    {ref:'Mateo 5:13',verse:'"Vosotros sois la sal de la tierra."',body:'Tu presencia en el mundo cambia el sabor de todo.'},
    {ref:'Mateo 5:14',verse:'"Vosotros sois la luz del mundo."',body:'No fuiste hecho para vivir en lo oscuro.'},
    {ref:'Hechos 1:8',verse:'"Recibiréis poder... y me seréis testigos hasta lo último de la tierra."',body:'El Espíritu Santo no te da poder para quedarte — para ir.'},
    {ref:'2 Corintios 5:20',verse:'"Somos embajadores en nombre de Cristo."',body:'Representas al reino más poderoso del universo.'},
    {ref:'Proverbios 11:30',verse:'"El que gana almas es sabio."',body:'No hay inversión más valiosa que una vida transformada.'},
    {ref:'1 Corintios 9:22',verse:'"Me he hecho todo a todos, para que de todos modos salve a algunos."',body:'La misión requiere adaptación, no compromiso.'},
    {ref:'Romanos 1:16',verse:'"No me avergüenzo del evangelio, porque es poder de Dios para salvación."',body:'El evangelio no necesita disculpas — necesita proclamación.'},
    {ref:'Juan 20:21',verse:'"Como me envió el Padre, así también yo os envío."',body:'El mismo tipo de misión que el Padre le dio al Hijo, el Hijo te la da a ti.'},
    {ref:'Isaías 52:7',verse:'"¡Cuán hermosos son los pies de los que anuncian la paz!"',body:'Llevar buenas noticias es uno de los actos más hermosos.'},
    {ref:'Lucas 10:2',verse:'"La mies es mucha, mas los obreros pocos."',body:'El problema no es el mundo sin Cristo. Es la falta de obreros.'},
    {ref:'Mateo 9:37',verse:'"La mies es mucha, y los obreros pocos."',body:'Dios necesita obreros dispuestos, no perfectos.'},
    {ref:'Hechos 2:41',verse:'"Los que recibieron su palabra fueron bautizados; y se añadieron aquel día como tres mil personas."',body:'Un día de predicación con unción puede cambiar miles de vidas.'},
    {ref:'Colosenses 4:3',verse:'"Que Dios nos abra puerta para la palabra."',body:'La misión no depende solo de esfuerzo — depende de puertas que Dios abre.'},
    {ref:'Filipenses 4:22',verse:'"Los de la casa de César os saludan."',body:'El evangelio puede penetrar hasta los lugares más inesperados.'},
    {ref:'1 Pedro 3:15',verse:'"Estad siempre preparados para presentar defensa ante todo el que os demande razón de la esperanza."',body:'Vivir la misión incluye estar listo para explicar tu fe.'},
  ],

  'Alabanza': [
    {ref:'Salmos 150:6',verse:'"Todo lo que respira alabe al Señor."',body:'Si respiras, tienes razón para alabar.'},
    {ref:'Salmos 34:1',verse:'"Bendeciré al Señor en todo tiempo; su alabanza estará de continuo en mi boca."',body:'Alabanza continua es fe activa.'},
    {ref:'Juan 4:24',verse:'"Dios es Espíritu; y los que le adoran, en espíritu y en verdad es necesario que adoren."',body:'La adoración verdadera va más allá del estilo.'},
    {ref:'Hechos 16:25',verse:'"A medianoche, Pablo y Silas oraban y cantaban himnos a Dios."',body:'La adoración en la cárcel es la alabanza más poderosa.'},
    {ref:'Salmos 22:3',verse:'"Tú eres santo, tú que habitas entre las alabanzas de Israel."',body:'Donde hay alabanza genuina, Dios habita.'},
    {ref:'Salmos 100:4',verse:'"Entrad por sus puertas con acción de gracias, por sus atrios con alabanza."',body:'La gratitud es la puerta de entrada a Su presencia.'},
    {ref:'Hebreos 13:15',verse:'"Ofrezcamos siempre a Dios, por medio de él, sacrificio de alabanza."',body:'Cuando no tienes ganas de adorar es cuando más lo necesitas.'},
    {ref:'Isaías 61:3',verse:'"Manto de alegría en lugar del espíritu angustiado."',body:'La adoración cambia la atmósfera de tu vida.'},
    {ref:'2 Samuel 6:14',verse:'"David danzaba con toda su fuerza delante del Señor."',body:'Algunos niveles de adoración requieren soltar la vergüenza.'},
    {ref:'Salmos 96:1',verse:'"Cantad al Señor cántico nuevo; cantad al Señor toda la tierra."',body:'Cada temporada nueva merece una canción nueva.'},
    {ref:'Apocalipsis 4:11',verse:'"Señor, digno eres de recibir la gloria y la honra y el poder."',body:'La adoración eterna ya comenzó. Únete ahora.'},
    {ref:'Habacuc 3:18',verse:'"Con todo, yo me alegraré en el Señor, y me gozaré en el Dios de mi salvación."',body:'La alabanza que nace en la crisis es la más poderosa.'},
    {ref:'Salmos 19:1',verse:'"Los cielos cuentan la gloria de Dios, y el firmamento anuncia la obra de sus manos."',body:'La creación no puede callarse ante la grandeza de Dios.'},
    {ref:'Isaías 43:21',verse:'"Este pueblo he creado para mí; mis alabanzas publicará."',body:'Fuiste creado para alabar — eso no es una exageración religiosa.'},
    {ref:'Salmos 63:3',verse:'"Porque mejor es tu misericordia que la vida; mis labios te alabarán."',body:'La misericordia de Dios vale más que la vida misma.'},
    {ref:'Salmos 8:2',verse:'"De la boca de los niños y de los que maman fundaste la fortaleza."',body:'La alabanza más poderosa a veces viene de la boca más inocente.'},
    {ref:'1 Crónicas 16:34',verse:'"Aclamad al Señor, porque él es bueno; porque su misericordia es eterna."',body:'La bondad de Dios es suficiente razón para alabar todos los días.'},
    {ref:'Salmos 103:1',verse:'"Bendice, alma mía, al Señor, y bendiga todo mi ser su santo nombre."',body:'La adoración comprometida involucra todo tu ser, no solo tu voz.'},
    {ref:'Apocalipsis 5:12',verse:'"El Cordero que fue inmolado es digno de tomar el poder, las riquezas, la sabiduría, la fortaleza, la honra, la gloria y la alabanza."',body:'La alabanza eterna que ya suena en el cielo tiene lugar para tu voz.'},
  ],

  'Oración': [
    {ref:'Mateo 6:6',verse:'"Entra en tu aposento, y cerrada la puerta, ora a tu Padre que está en secreto."',body:'La oración más poderosa nadie la ve — solo Dios.'},
    {ref:'Filipenses 4:6',verse:'"Por nada estéis afanosos, sino sean conocidas vuestras peticiones delante de Dios."',body:'El antídoto para la ansiedad es la oración.'},
    {ref:'1 Tesalonicenses 5:17',verse:'"Orad sin cesar."',body:'La oración no es un evento. Es un estilo de vida.'},
    {ref:'Lucas 18:1',verse:'"Es necesario orar siempre, y no desmayar."',body:'Persistir en oración no es falta de fe — es fe en acción.'},
    {ref:'Santiago 5:16',verse:'"La oración eficaz del justo puede mucho."',body:'Tu oración tiene un peso que no puedes medir.'},
    {ref:'Juan 15:7',verse:'"Si permanecéis en mí... pedid todo lo que queréis, y os será hecho."',body:'La conexión con Dios es el secreto de la oración respondida.'},
    {ref:'Jeremías 33:3',verse:'"Clama a mí, y yo te responderé, y te enseñaré cosas grandes."',body:'Dios responde. Y además enseña.'},
    {ref:'Salmos 46:10',verse:'"Quedaos quietos y sabed que yo soy Dios."',body:'El silencio es donde Dios más habla.'},
    {ref:'Romanos 8:26',verse:'"El Espíritu mismo intercede por nosotros con gemidos indecibles."',body:'Cuando no sabes qué orar, el Espíritu ora por ti.'},
    {ref:'Mateo 7:7',verse:'"Pedid, y se os dará; buscad, y hallaréis; llamad, y se os abrirá."',body:'Tres verbos activos. Tres promesas activas.'},
    {ref:'1 Juan 5:14',verse:'"Si pedimos alguna cosa conforme a su voluntad, él nos oye."',body:'La clave no es el volumen de tu oración — es la alineación con Su voluntad.'},
    {ref:'Nehemías 2:4',verse:'"Entonces oré al Dios de los cielos."',body:'Las oraciones más poderosas a veces duran segundos — pero cambian todo.'},
    {ref:'Mateo 18:19',verse:'"Si dos de vosotros se pusieren de acuerdo en la tierra acerca de cualquiera cosa que pidieren, les será hecho."',body:'La oración en acuerdo tiene una dimensión especial de poder.'},
    {ref:'Daniel 6:10',verse:'"Cuando Daniel supo que el edicto había sido firmado, entró en su casa, y... oraba... tres veces al día."',body:'La presión no interrumpió la oración de Daniel. Ni la tuya debería.'},
    {ref:'Lucas 11:9',verse:'"Pedid, y se os dará; buscad, y hallaréis."',body:'La oración persistente no cansa a Dios — lo complace.'},
    {ref:'Apocalipsis 8:4',verse:'"El humo del incienso con las oraciones de los santos subió de la mano del ángel a la presencia de Dios."',body:'Tus oraciones llegan a la presencia de Dios. Ninguna se pierde.'},
    {ref:'Salmos 17:6',verse:'"Yo te he invocado, por cuanto tú me oirás, oh Dios."',body:'La certeza de ser escuchado da valentía para orar.'},
    {ref:'2 Crónicas 7:15',verse:'"Ahora estarán abiertos mis ojos y atentos mis oídos a la oración en este lugar."',body:'Hay lugares y momentos donde Dios está especialmente atento.'},
    {ref:'Marcos 1:35',verse:'"Levantándose muy de mañana, siendo aún muy oscuro, salió y se fue a un lugar desierto, y allí oraba."',body:'Si Jesús necesitaba apartar tiempo para orar, nosotros más.'},
  ],

  'Ayuno': [
    {ref:'Mateo 6:17',verse:'"Pero tú, cuando ayunes, unge tu cabeza y lava tu rostro."',body:'El ayuno genuino no busca reconocimiento.'},
    {ref:'Isaías 58:6',verse:'"¿No es más bien el ayuno que yo escogí desatar las ligaduras de impiedad?"',body:'El ayuno correcto rompe lo que la oración sola no rompe.'},
    {ref:'Joel 2:12',verse:'"Convertíos a mí con todo vuestro corazón, con ayuno."',body:'Ayunar es una vuelta al corazón de Dios.'},
    {ref:'Daniel 10:12',verse:'"Desde el primer día... tus palabras fueron oídas."',body:'El ayuno no convence a Dios. Nos alinea con Él.'},
    {ref:'Marcos 9:29',verse:'"Este género con nada puede salir, sino con oración y ayuno."',body:'Hay victorias reservadas solo para el ayuno.'},
    {ref:'Esdras 8:23',verse:'"Ayunamos, pues, y pedimos a nuestro Dios sobre esto, y él nos fue propicio."',body:'El ayuno no es castigo. Es una petición de favor.'},
    {ref:'Mateo 4:2',verse:'"Después de haber ayunado cuarenta días... tuvo hambre."',body:'Jesús mismo ayunó. Seguimos a Cristo en todo.'},
    {ref:'Hechos 13:2',verse:'"Ministrando estos al Señor, y ayunando, dijo el Espíritu Santo: Apartadme a Bernabé y a Saulo."',body:'Los momentos de mayor dirección nacen del ayuno.'},
    {ref:'2 Samuel 12:16',verse:'"David rogó a Dios por el niño; y ayunó David."',body:'El ayuno puede ser una oración de intercesión extrema.'},
    {ref:'1 Reyes 19:8',verse:'"Y se levantó, y comió y bebió; y fortaleció aquella comida para caminar cuarenta días y cuarenta noches."',body:'Dios provee la fuerza para cada jornada que nos pide recorrer.'},
    {ref:'Ester 4:16',verse:'"Ayunad por mí, y no comáis ni bebáis en tres días."',body:'Los momentos más críticos merecen el ayuno más radical.'},
    {ref:'Jonás 3:5',verse:'"Los hombres de Nínive creyeron a Dios, y proclamaron ayuno."',body:'El ayuno colectivo puede cambiar el destino de ciudades enteras.'},
    {ref:'Zacarías 8:19',verse:'"Los ayunos... serán para la casa de Judá gozo y alegría y fiestas solemnes."',body:'El ayuno no es triste — es preparación para el gozo.'},
  ],

  'Duelo': [
    {ref:'Salmos 34:18',verse:'"El Señor está cerca de los quebrantados de corazón."',body:'En tu peor momento, Dios está más cerca.'},
    {ref:'Mateo 5:4',verse:'"Bienaventurados los que lloran, porque ellos recibirán consolación."',body:'No hay llanto que Dios no vea y no sane.'},
    {ref:'Romanos 8:18',verse:'"Las aflicciones del tiempo presente no son comparables con la gloria venidera."',body:'El peso de hoy no define el peso de la eternidad.'},
    {ref:'2 Corintios 1:4',verse:'"Nos consuela en todas nuestras tribulaciones."',body:'Dios te consuela para que tú puedas consolar.'},
    {ref:'Salmos 23:4',verse:'"Aunque ande en valle de sombra de muerte, no temeré mal alguno."',body:'En el peor valle, la presencia de Dios es suficiente.'},
    {ref:'Juan 11:35',verse:'"Jesús lloró."',body:'El Dios del universo se detuvo a llorar. Tu dolor le importa.'},
    {ref:'Salmos 30:5',verse:'"Por la noche durará el lloro, y a la mañana vendrá la alegría."',body:'El llanto tiene fecha de vencimiento.'},
    {ref:'Isaías 43:2',verse:'"Cuando pases por las aguas, yo estaré contigo."',body:'No prometió que no habría tormentas. Prometió acompañarte.'},
    {ref:'Salmos 126:5',verse:'"Los que sembraron con lágrimas, con regocijo segarán."',body:'Las lágrimas de hoy son semillas de la cosecha de mañana.'},
    {ref:'Apocalipsis 21:4',verse:'"Enjugará Dios toda lágrima de los ojos de ellos."',body:'Dios guardará cada lágrima tuya. No se pierde ninguna.'},
    {ref:'Job 19:25',verse:'"Yo sé que mi Redentor vive."',body:'En medio del dolor más profundo, Job encontró certeza. Tú también puedes.'},
    {ref:'Salmos 73:26',verse:'"Mi carne y mi corazón desfallecen; mas la roca de mi corazón y mi porción es Dios para siempre."',body:'Cuando todo falla, Dios permanece.'},
    {ref:'Isaías 61:2',verse:'"A consolar a todos los enlutados."',body:'La misión de Jesús incluye explícitamente a los que están de luto.'},
    {ref:'Salmos 55:22',verse:'"Echa sobre el Señor tu carga, y él te sustentará."',body:'El dolor que cargas solo, Dios puede cargarlo contigo.'},
    {ref:'2 Corintios 4:17',verse:'"Esta leve tribulación momentánea produce en nosotros un cada vez más excelente y eterno peso de gloria."',body:'El dolor de hoy tiene un propósito que la eternidad revelará.'},
    {ref:'Salmos 56:8',verse:'"Mis huidas tú has contado; pon mis lágrimas en tu redoma."',body:'Dios colecciona cada lágrima tuya. Ninguna es olvidada.'},
    {ref:'Romanos 15:13',verse:'"El Dios de esperanza os llene de todo gozo y paz en el creer."',body:'La esperanza de Dios puede coexistir con el dolor — no lo niega, lo transciende.'},
    {ref:'1 Tesalonicenses 4:13',verse:'"No os entristezcáis como los otros que no tienen esperanza."',body:'La muerte para el creyente no es el final — es una transición.'},
  ],

  'Finanzas': [
    {ref:'Filipenses 4:19',verse:'"Mi Dios, pues, suplirá todo lo que os falta conforme a sus riquezas."',body:'La provisión de Dios no depende de tu economía.'},
    {ref:'Malaquías 3:10',verse:'"Traed todos los diezmos al alfolí... y probadme ahora en esto."',body:'El único lugar donde Dios nos invita a probarlo.'},
    {ref:'Lucas 6:38',verse:'"Dad, y se os dará; medida buena, apretada, remecida y rebosando."',body:'La generosidad activa la provisión sobrenatural.'},
    {ref:'Proverbios 3:9',verse:'"Honra al Señor con tus bienes, y con las primicias de todos tus frutos."',body:'Lo que honras a Dios primero, Él lo multiplica.'},
    {ref:'Deuteronomio 8:18',verse:'"Él te da el poder para hacer las riquezas."',body:'El talento es tuyo. El poder de producir es de Dios.'},
    {ref:'Proverbios 10:22',verse:'"La bendición del Señor es la que enriquece, y no añade tristeza con ella."',body:'La prosperidad de Dios no viene con deuda emocional.'},
    {ref:'2 Corintios 9:8',verse:'"Dios puede hacer que abunde en vosotros toda gracia... para toda buena obra."',body:'La abundancia de Dios tiene un propósito: generosidad.'},
    {ref:'Mateo 6:33',verse:'"Buscad primeramente el reino de Dios, y todas estas cosas os serán añadidas."',body:'Cuando pones a Dios primero, el resto se ordena solo.'},
    {ref:'Proverbios 11:24',verse:'"Hay quienes reparten, y les es añadido más."',body:'La lógica del reino es inversa a la del mundo.'},
    {ref:'Génesis 26:12',verse:'"Isaac sembró en aquella tierra, y cosechó aquel año el ciento por uno."',body:'Hay temporadas en que Dios multiplica lo que siembras.'},
    {ref:'Proverbios 13:22',verse:'"El bien del justo se traspasa a los hijos de los hijos."',body:'Las finanzas ordenadas en Dios construyen herencia generacional.'},
    {ref:'Salmos 37:25',verse:'"Joven fui, y he envejecido, y no he visto justo desamparado, ni su descendencia que mendigue pan."',body:'Dios tiene un récord de fidelidad con su pueblo.'},
    {ref:'Eclesiastés 5:10',verse:'"El que ama el dinero, no se saciará de dinero."',body:'La avaricia no tiene fondo. La provisión de Dios sí tiene propósito.'},
    {ref:'1 Timoteo 6:17',verse:'"A los ricos de este siglo manda que no sean altivos, ni pongan la esperanza en las riquezas inciertas."',body:'El dinero es inestable. Dios no.'},
    {ref:'Marcos 10:27',verse:'"Para los hombres es imposible, mas para Dios, no; porque todas las cosas son posibles para Dios."',body:'Lo que tu cuenta bancaria dice que es imposible, Dios lo puede.'},
    {ref:'Salmos 24:1',verse:'"Del Señor es la tierra y su plenitud."',body:'Todo lo que posees es administración, no propiedad.'},
    {ref:'Proverbios 22:7',verse:'"El rico se enseñorea de los pobres."',body:'La libertad financiera en Dios rompe dependencias y abre puertas de influencia.'},
    {ref:'Hageo 2:8',verse:'"Mía es la plata, y mío es el oro, dice el Señor de los ejércitos."',body:'La escasez que ves no limita a Dios. Todo lo suyo está disponible para Sus planes.'},
  ],

  'Propósito': [
    {ref:'Jeremías 29:11',verse:'"Porque yo sé los planes que tengo para ustedes... planes de bienestar."',body:'Su plan supera todo lo que puedas imaginar.'},
    {ref:'Romanos 8:28',verse:'"Dios hace que todas las cosas ayuden para bien de los que le aman."',body:'Hasta lo que duele tiene propósito en Sus manos.'},
    {ref:'Efesios 2:10',verse:'"Somos hechura suya, creados en Cristo Jesús para buenas obras."',body:'Fuiste diseñado con intención, no por accidente.'},
    {ref:'Salmos 139:16',verse:'"En tu libro estaban escritas todas aquellas cosas que fueron luego formadas."',body:'Tu historia estaba escrita antes de que empezara.'},
    {ref:'Filipenses 1:6',verse:'"El que comenzó en vosotros la buena obra, la perfeccionará."',body:'Lo que Dios empieza, lo termina. Tú incluido.'},
    {ref:'1 Pedro 2:9',verse:'"Vosotros sois linaje escogido, real sacerdocio."',body:'Tu identidad no la define el mundo — la definió Dios.'},
    {ref:'Efesios 1:4',verse:'"Nos escogió en él antes de la fundación del mundo."',body:'Fuiste elegido antes de que existiera el tiempo.'},
    {ref:'2 Timoteo 1:9',verse:'"Nos salvó y llamó con llamamiento santo, no conforme a nuestras obras."',body:'Tu llamado no depende de tu historial. Depende de Su gracia.'},
    {ref:'Romanos 12:2',verse:'"Transformaos por medio de la renovación de vuestro entendimiento, para que comprobéis cuál sea la voluntad de Dios."',body:'Descubrir el propósito de Dios requiere mente transformada.'},
    {ref:'Habacuc 2:2',verse:'"Escribe la visión, y declárala en tablas."',body:'El propósito que Dios da merece ser escrito y declarado.'},
    {ref:'Salmos 57:2',verse:'"Clamaré al Dios Altísimo, al Dios que me favorece."',body:'Dios tiene un propósito favorable para ti — no en tu contra.'},
    {ref:'Proverbios 4:18',verse:'"La senda de los justos es como la luz de la aurora, que va en aumento hasta que el día es perfecto."',body:'Tu propósito no es estático — crece con el tiempo.'},
    {ref:'Salmos 138:8',verse:'"El Señor cumplirá su propósito en mí."',body:'Dios no te abandona a mitad del camino. Completa Su obra.'},
    {ref:'Hechos 13:36',verse:'"David, habiendo servido a su propia generación según la voluntad de Dios, durmió."',body:'El propósito más alto es servir a tu generación según la voluntad de Dios.'},
    {ref:'1 Corintios 2:9',verse:'"Cosas que ojo no vio, ni oído oyó... son las que Dios ha preparado para los que le aman."',body:'El propósito que Dios tiene para ti supera tu imaginación.'},
    {ref:'Mateo 5:16',verse:'"Así alumbre vuestra luz delante de los hombres, para que vean vuestras buenas obras."',body:'Tu propósito visible glorifica a Dios invisible.'},
    {ref:'Génesis 50:20',verse:'"Vosotros pensasteis mal contra mí, mas Dios lo encaminó a bien."',body:'Dios puede tomar lo que fue diseñado para destruirte y convertirlo en propósito.'},
    {ref:'Eclesiastés 3:1',verse:'"Todo tiene su tiempo, y todo lo que se quiere debajo del cielo tiene su hora."',body:'El propósito de Dios para tu vida tiene temporadas. Ninguna dura para siempre.'},
  ],

  'Liderazgo': [
    {ref:'Marcos 10:43',verse:'"El que quiera hacerse grande entre vosotros será vuestro servidor."',body:'En el reino, el mayor es el que más sirve.'},
    {ref:'1 Timoteo 4:12',verse:'"Sé ejemplo de los creyentes en palabra, conducta, amor, espíritu, fe y pureza."',body:'El liderazgo no se proclama — se demuestra.'},
    {ref:'Nehemías 6:3',verse:'"Hago una gran obra, y no puedo ir. ¿Por qué cesaría la obra?"',body:'Un líder con propósito no se deja distraer por las críticas.'},
    {ref:'Proverbios 11:14',verse:'"Donde no hay dirección sabia, el pueblo cae."',body:'Los mejores líderes no lideran solos.'},
    {ref:'1 Corintios 11:1',verse:'"Sed imitadores de mí, así como yo lo soy de Cristo."',body:'Solo puedes llevar a otros adonde tú ya has ido.'},
    {ref:'Lucas 16:10',verse:'"El que es fiel en lo muy poco, también en lo más es fiel."',body:'La fidelidad en lo pequeño abre las puertas de lo grande.'},
    {ref:'Gálatas 6:9',verse:'"No nos cansemos de hacer bien; porque a su tiempo segaremos."',body:'El liderazgo es una carrera larga — no te rindas.'},
    {ref:'Ezequiel 34:11',verse:'"Yo mismo buscaré mis ovejas."',body:'El modelo de liderazgo de Dios es buscar, no esperar.'},
    {ref:'Proverbios 27:17',verse:'"El hierro con hierro se aguza."',body:'Los líderes que crecen tienen personas que los desafían.'},
    {ref:'Juan 13:14',verse:'"Si yo, el Señor y el Maestro, he lavado vuestros pies, vosotros también debéis lavaros los pies los unos a los otros."',body:'El liderazgo de Jesús se define por servicio, no por posición.'},
    {ref:'2 Crónicas 1:10',verse:'"Dame ahora sabiduría y ciencia, para salir y entrar delante de este pueblo."',body:'El mejor pedido de un líder: sabiduría, no poder.'},
    {ref:'Proverbios 29:2',verse:'"Cuando los justos dominan, el pueblo se alegra."',body:'El liderazgo justo produce alegría en los que lidera.'},
    {ref:'Mateo 20:27',verse:'"El que quiera ser el primero entre vosotros será vuestro siervo."',body:'La cima del liderazgo en el reino es el servicio más profundo.'},
    {ref:'Hebreos 13:17',verse:'"Obedeced a vuestros pastores, y sujetaos a ellos; porque ellos velan por vuestras almas."',body:'La autoridad espiritual tiene responsabilidad y rendición de cuentas.'},
    {ref:'Isaías 32:8',verse:'"El generoso pensará generosidades, y por generosidades se sustentará."',body:'Los grandes líderes piensan en cómo dar, no en cómo tener.'},
  ],

  'Juventud': [
    {ref:'1 Timoteo 4:12',verse:'"Ninguno tenga en poco tu juventud."',body:'Dios no está esperando que crezcas para usarte. Te usa ahora.'},
    {ref:'Eclesiastés 12:1',verse:'"Acuérdate de tu Creador en los días de tu juventud."',body:'La mejor decisión que tomas joven es la que más durará.'},
    {ref:'Salmos 119:9',verse:'"¿Con qué limpiará el joven su camino? Con guardar tu palabra."',body:'La Palabra de Dios es la guía más confiable para los jóvenes.'},
    {ref:'Isaías 40:31',verse:'"Los jóvenes se fatigan... mas los que esperan en el Señor tendrán nuevas fuerzas."',body:'Incluso los más fuertes se cansan. La fuente verdadera no se agota.'},
    {ref:'Joel 2:28',verse:'"Vuestros jóvenes verán visiones."',body:'Tu generación tiene una cita con lo sobrenatural.'},
    {ref:'2 Timoteo 2:22',verse:'"Huye también de las pasiones juveniles, y sigue la justicia, la fe, el amor y la paz."',body:'La santidad no es debilidad. Es la decisión más valiente.'},
    {ref:'Daniel 1:8',verse:'"Daniel propuso en su corazón no contaminarse."',body:'Las convicciones que decides joven te protegerán de adulto.'},
    {ref:'Mateo 19:14',verse:'"Dejad a los niños venir a mí."',body:'Nunca eres demasiado joven para Dios.'},
    {ref:'Jeremías 1:7',verse:'"No digas: Soy un muchacho; porque a todo lo que te envíe irás."',body:'Dios no acepta la juventud como excusa para no responder al llamado.'},
    {ref:'Salmos 71:5',verse:'"Porque tú, oh Señor, eres mi esperanza; seguridad mía desde mi juventud."',body:'Crecer con Dios como fundamento es la mayor ventaja en la vida.'},
    {ref:'Salmos 27:14',verse:'"Aguarda al Señor; esfuérzate, y aliéntese tu corazón; sí, espera al Señor."',body:'La espera no es pasividad — es preparación.'},
    {ref:'Proverbios 23:26',verse:'"Hijo mío, dame tu corazón."',body:'Dios no pide primero tu tiempo ni tu dinero. Pide tu corazón.'},
    {ref:'Tito 2:6',verse:'"Exhorta asimismo a los jóvenes a que sean prudentes."',body:'La prudencia en la juventud no es limitación — es sabiduría avanzada.'},
    {ref:'Lamentaciones 3:27',verse:'"Bueno le es al hombre llevar el yugo desde su juventud."',body:'Aprender a caminar con Dios desde joven forma el carácter más profundo.'},
    {ref:'Génesis 37:5',verse:'"Y soñó José un sueño."',body:'Los sueños dados por Dios en la juventud a veces tardan años en cumplirse — pero se cumplen.'},
  ],

  'Avivamiento': [
    {ref:'2 Crónicas 7:14',verse:'"Si se humillare mi pueblo... y oraren... yo oiré desde los cielos."',body:'El avivamiento no lo trae una canción. Lo trae la humillación.'},
    {ref:'Habacuc 3:2',verse:'"Oh Señor, aviva tu obra en medio de los tiempos."',body:'El avivamiento comienza cuando nos impresionamos de nuevo por Dios.'},
    {ref:'Salmos 85:6',verse:'"¿No volverás a darnos vida, para que tu pueblo se regocije en ti?"',body:'El clamor por avivamiento siempre nace de la honestidad.'},
    {ref:'Hechos 2:17',verse:'"En los últimos días... derramaré de mi Espíritu sobre toda carne."',body:'El avivamiento prometido en Pentecostés sigue vigente.'},
    {ref:'Isaías 64:1',verse:'"¡Oh, si rompieses los cielos, y descendieras!"',body:'Esta es la oración que prepara el avivamiento.'},
    {ref:'Hechos 3:19',verse:'"Arrepentíos y convertíos... y vengan tiempos de refrigerio."',body:'El arrepentimiento abre la puerta al refrigerio de Dios.'},
    {ref:'Juan 7:38',verse:'"De su interior correrán ríos de agua viva."',body:'El avivamiento no viene de fuera. Brota de adentro.'},
    {ref:'Romanos 13:11',verse:'"Es ya hora de levantarnos del sueño."',body:'El momento del avivamiento no es mañana. Es ahora.'},
    {ref:'Hechos 4:31',verse:'"Cuando hubieron orado, el lugar en que estaban congregados tembló."',body:'La oración colectiva en unidad produce avivamiento.'},
    {ref:'Ezequiel 37:4',verse:'"Huesos secos, oíd palabra del Señor."',body:'El avivamiento llega donde todo parece muerto.'},
    {ref:'Hageo 2:7',verse:'"Haré temblar a todas las naciones, y vendrá el Deseado de todas las naciones."',body:'El avivamiento que Dios trae sacude lo que parecía inamovible.'},
    {ref:'Salmos 80:18',verse:'"Vuélvenos, oh Dios de los ejércitos; haz resplandecer tu rostro, y seremos salvos."',body:'El avivamiento es un regreso al rostro de Dios.'},
    {ref:'Isaías 44:3',verse:'"Derramaré aguas sobre el sequedal, y ríos sobre la tierra árida."',body:'Dios puede hacer fluir Su Espíritu donde todo parece seco.'},
  ],

  'Promesas': [
    {ref:'Números 23:19',verse:'"Dios no es hombre, para que mienta... ¿Dirá él y no lo hará?"',body:'Las promesas de Dios no tienen letra pequeña.'},
    {ref:'2 Corintios 1:20',verse:'"Todas las promesas de Dios son en él Sí, y en él Amén."',body:'Cada promesa de Dios ya tiene tu nombre.'},
    {ref:'Isaías 55:11',verse:'"Mi palabra... no volverá a mí vacía, sino que hará lo que yo quiero."',body:'La Palabra que Dios habla sobre ti siempre cumple su propósito.'},
    {ref:'Hebreos 10:23',verse:'"Retengamos firme la profesión de nuestra esperanza, porque fiel es el que prometió."',body:'La fidelidad de Dios es la razón para no soltar.'},
    {ref:'Romanos 4:20',verse:'"Tampoco dudó, por incredulidad, de la promesa de Dios."',body:'Abraham no miraba sus circunstancias. Miraba la promesa.'},
    {ref:'Josué 21:45',verse:'"No faltó palabra de todas las buenas palabras que el Señor había hablado."',body:'Históricamente, Dios tiene un récord perfecto de cumplimiento.'},
    {ref:'Lamentaciones 3:22',verse:'"Las misericordias del Señor nunca terminan. Son nuevas cada mañana."',body:'Cada amanecer es la manera de Dios de decirte: Vuelve a intentarlo.'},
    {ref:'Salmos 37:4',verse:'"Deléitate asimismo en el Señor, y él te concederá las peticiones de tu corazón."',body:'Los deseos que Dios pone en ti, Él los cumple.'},
    {ref:'2 Pedro 1:4',verse:'"Nos ha dado preciosas y grandísimas promesas, para que por ellas... fuerais participantes de la naturaleza divina."',body:'Las promesas de Dios no son solo consuelo — son transformación.'},
    {ref:'Génesis 9:15',verse:'"Me acordaré del pacto mío."',body:'Dios recuerda sus compromisos. Siempre.'},
    {ref:'Deuteronomio 7:9',verse:'"Sabe, pues, que el Señor tu Dios es Dios, Dios fiel."',body:'La fidelidad de Dios no es una opinión — es su naturaleza.'},
    {ref:'1 Tesalonicenses 5:24',verse:'"Fiel es el que os llama, el cual también lo hará."',body:'Lo que Dios inicia, Dios termina.'},
    {ref:'Génesis 22:17',verse:'"De cierto te bendeciré, y multiplicaré tu descendencia."',body:'Hay promesas de Dios que se activan en el momento de mayor obediencia.'},
    {ref:'Salmos 91:4',verse:'"Con sus plumas te cubrirá, y debajo de sus alas estarás seguro."',body:'La promesa de protección de Dios es íntima y total.'},
    {ref:'Ezequiel 36:11',verse:'"Os haré bien más que a vuestros comienzos, y sabréis que yo soy el Señor."',body:'Dios tiene reservado algo mejor que tu mejor momento anterior.'},
  ],

  'Paz': [
    {ref:'Juan 14:27',verse:'"La paz os dejo, mi paz os doy; yo no os la doy como el mundo la da."',body:'La paz del mundo depende de circunstancias. La de Dios, no.'},
    {ref:'Filipenses 4:7',verse:'"La paz de Dios, que sobrepasa todo entendimiento, guardará vuestros corazones."',body:'La paz de Dios no se entiende — se recibe.'},
    {ref:'Isaías 26:3',verse:'"Tú guardarás en completa paz a aquel cuyo pensamiento en ti persevera."',body:'El secreto de la paz perfecta es una mente puesta en Dios.'},
    {ref:'Romanos 5:1',verse:'"Justificados, pues, por la fe, tenemos paz para con Dios."',body:'La paz con Dios es el fundamento de toda paz interior.'},
    {ref:'Mateo 11:28',verse:'"Venid a mí todos los que estáis trabajados y cargados, y yo os haré descansar."',body:'No cargues solo lo que Él ya cargó por ti.'},
    {ref:'Salmos 4:8',verse:'"En paz me acostaré, y asimismo dormiré; porque solo tú, Señor, me haces vivir confiado."',body:'La confianza en Dios produce el descanso que nada más puede dar.'},
    {ref:'Números 6:26',verse:'"El Señor alce sobre ti su rostro, y ponga en ti paz."',body:'La paz de Dios sobre tu vida es una declaración del cielo.'},
    {ref:'Colosenses 3:15',verse:'"La paz de Dios gobierne en vuestros corazones."',body:'Cuando la paz de Dios toma el control, la ansiedad pierde terreno.'},
    {ref:'Isaías 9:6',verse:'"Y se llamará su nombre... Príncipe de paz."',body:'La paz no es solo un estado de ánimo — es una persona: Jesús.'},
    {ref:'Juan 16:33',verse:'"En mí tendréis paz."',body:'La paz verdadera no depende de tu situación — depende de tu posición en Cristo.'},
    {ref:'Salmos 29:11',verse:'"El Señor dará poder a su pueblo; el Señor bendecirá a su pueblo con paz."',body:'La paz de Dios viene con poder — no es resignación.'},
    {ref:'Romanos 14:17',verse:'"El reino de Dios no es comida ni bebida, sino justicia, paz y gozo en el Espíritu Santo."',body:'La paz es una de las marcas distintivas del reino de Dios.'},
    {ref:'Mateo 5:9',verse:'"Bienaventurados los pacificadores, porque ellos serán llamados hijos de Dios."',body:'Llevar paz a donde hay conflicto es un acto que nos identifica como hijos de Dios.'},
    {ref:'2 Tesalonicenses 3:16',verse:'"El Señor de paz os dé siempre paz en toda manera."',body:'La paz de Dios no es para una situación — es para toda manera.'},
    {ref:'Isaías 48:18',verse:'"¡Oh, si hubieras atendido a mis mandamientos! Fuera entonces tu paz como un río."',body:'La obediencia a Dios produce una paz que fluye continuamente.'},
  ],

  'Identidad': [
    {ref:'Génesis 1:27',verse:'"Creó Dios al hombre a su imagen, a imagen de Dios lo creó."',body:'Antes de que el mundo te definiera, Dios ya lo hizo.'},
    {ref:'Salmos 139:14',verse:'"Te alabaré; porque formidables, maravillosas son tus obras."',body:'Eres la obra maestra de Dios. No una versión fallida.'},
    {ref:'1 Juan 3:1',verse:'"Mirad cuál amor nos ha dado el Padre, para que seamos llamados hijos de Dios."',body:'Hijo de Dios no es un título religioso — es tu identidad real.'},
    {ref:'Romanos 8:15',verse:'"No habéis recibido el espíritu de esclavitud... sino el espíritu de adopción."',body:'Dios no te adoptó a distancia. Te llama Hijo.'},
    {ref:'2 Corintios 5:17',verse:'"Si alguno está en Cristo, nueva criatura es."',body:'En Cristo no se remiendan las cosas viejas. Se hacen nuevas.'},
    {ref:'Gálatas 3:26',verse:'"Pues todos sois hijos de Dios por la fe en Cristo Jesús."',body:'La filiación divina no se hereda por sangre — se recibe por fe.'},
    {ref:'Juan 1:12',verse:'"A todos los que le recibieron, les dio potestad de ser hechos hijos de Dios."',body:'Recibir a Cristo no es solo una decisión — es un cambio de identidad.'},
    {ref:'Sofonías 3:17',verse:'"El Señor tu Dios está en medio de ti... se regocijará sobre ti con alegría."',body:'Dios no solo te tolera. Se alegra por ti.'},
    {ref:'Romanos 8:37',verse:'"En todas estas cosas somos más que vencedores por medio de aquel que nos amó."',body:'Tu identidad no es víctima — es vencedor en Cristo.'},
    {ref:'Efesios 1:13',verse:'"Fuisteis sellados con el Espíritu Santo de la promesa."',body:'El Espíritu Santo es la garantía de que le perteneces a Dios.'},
    {ref:'Mateo 5:13',verse:'"Vosotros sois la sal de la tierra."',body:'No llegarás a ser sal. Ya lo eres.'},
    {ref:'Colosenses 2:10',verse:'"Vosotros estáis completos en él."',body:'En Cristo no te falta nada — ya estás completo.'},
    {ref:'Gálatas 4:7',verse:'"Ya no eres esclavo, sino hijo; y si hijo, también heredero de Dios por medio de Cristo."',body:'Tu historia pasó de esclavitud a herencia. Ese es el evangelio.'},
    {ref:'Apocalipsis 12:11',verse:'"Ellos le han vencido por medio de la sangre del Cordero."',body:'Tu identidad como vencedor no depende de tu fuerza — depende de Su sangre.'},
    {ref:'Salmos 82:6',verse:'"Yo dije: Vosotros sois dioses, y todos vosotros hijos del Altísimo."',body:'Dios te llama con nombres de dignidad. ¿Cuál te defines a ti mismo?'},
  ],

  'Gracia': [
    {ref:'Romanos 5:8',verse:'"Siendo aún pecadores, Cristo murió por nosotros."',body:'La gracia no espera que estés listo. Llega cuando más la necesitas.'},
    {ref:'Efesios 2:4',verse:'"Pero Dios, que es rico en misericordia... nos dio vida juntamente con Cristo."',body:'La riqueza de Dios no es material — es misericordia.'},
    {ref:'2 Corintios 12:9',verse:'"Te basta mi gracia; porque mi poder se perfecciona en la debilidad."',body:'Cuando tú terminas, Dios empieza.'},
    {ref:'Hebreos 4:16',verse:'"Acerquémonos confiadamente al trono de la gracia, para alcanzar misericordia."',body:'El trono de Dios no es de juicio para ti. Es de gracia.'},
    {ref:'Juan 1:16',verse:'"De su plenitud tomamos todos, y gracia sobre gracia."',body:'La gracia de Dios no se agota — se acumula.'},
    {ref:'Tito 2:11',verse:'"La gracia de Dios se ha manifestado para salvación a todos los hombres."',body:'La gracia no es exclusiva. Fue diseñada para todos.'},
    {ref:'1 Pedro 5:10',verse:'"El Dios de toda gracia... os perfeccione, afirme, fortalezca y establezca."',body:'La gracia no solo perdona — también transforma.'},
    {ref:'Romanos 6:14',verse:'"El pecado no se enseñoreará de vosotros; pues... estáis bajo la gracia."',body:'La gracia no es permiso para pecar. Es poder para no hacerlo.'},
    {ref:'Salmos 84:11',verse:'"Gracia y gloria dará el Señor."',body:'Dios da lo que necesitas para hoy y lo que necesitas para siempre.'},
    {ref:'Efesios 1:7',verse:'"En él tenemos redención... la remisión de pecados según las riquezas de su gracia."',body:'La profundidad del perdón de Dios se mide por la riqueza de Su gracia.'},
    {ref:'Zacarías 4:6',verse:'"No con ejército, ni con fuerza, sino con mi Espíritu, dice el Señor de los ejércitos."',body:'Lo que no puedes lograr con fuerza, la gracia de Dios lo hace posible.'},
    {ref:'Lamentaciones 3:23',verse:'"Nuevas son cada mañana; grande es tu fidelidad."',body:'Cada día trae gracia nueva — nunca estás operando con los restos de ayer.'},
