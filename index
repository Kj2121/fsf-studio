function _fxUpd(id, key, val) {
  var obj=getObject(selectedId); if(!obj)return;
  var fx=_fxGet(obj); if(!fx[id])return;
  // FIX: push undo so effects can be reversed with Ctrl+Z
  pushUndo();
  fx[id][key]=isNaN(val)?val:parseFloat(val);
  var el=document.querySelector('[data-id="'+selectedId+'"]');
  if(!el) return;
  // SVG-filter effects: remove cached SVG so it rebuilds with new params
  var svgPfx={risograph:'_fxriso_',halftone:'_fxht_',vintage:'_fxvint_',duotono2:'_fxdt2_'};
  if(svgPfx[id]){ var old=document.getElementById(svgPfx[id]+obj.id); if(old) old.remove(); }
  _fxApplyAll(el,obj);
}

