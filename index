        style="width:100%;accent-color:#1E7BFF;height:4px;"
        oninput="${fn};document.getElementById('mob-le-${id}-val').textContent=this.value+'${unit}'">
    </div>`;

  // FIX: avoid DOM thrashing — use pure hex conversion instead of inserting/removing divs
  const colorToH = c => {
    if(!c) return '#ffffff';
    if(/^#[0-9a-fA-F]{3,8}$/.test(c)) return c.length===4 ? '#'+c[1]+c[1]+c[2]+c[2]+c[3]+c[3] : c.slice(0,7);
    const m=c.match(/[\d.]+/g);
    if(m&&m.length>=3){ const h=v=>Math.round(parseFloat(v)).toString(16).padStart(2,'0'); return '#'+h(m[0])+h(m[1])+h(m[2]); }
    return '#ffffff';
  };

  const op = Math.round((o.opacity||1)*100);
  const rot = o.rotation||0;
  const commonControls = `
    ${SL('Opacidad','op',0,100,op,"updateSelOpacity(this.value)",'%')}
    ${SL('Rotación','rot',-180,180,rot,"spSetRotation(+this.value)",'°')}
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:5px;margin-bottom:10px;">
