function svgReplaceColor() {
  const obj = objects.find(o => o.id === _svgEditId);
  if (!obj) { showUndoToast('⚠ Selecciona un vector primero'); return; }

  const newColor = document.getElementById('mob-vec-picker')?.value
    || document.getElementById('svg-color-picker')?.value
    || '#ffffff';

  pushUndo();
  obj._colorMode = 'tint';
  obj._tintColor = newColor;

  // Apply filter directly to DOM element
  const domEl = document.querySelector('[data-id="' + obj.id + '"]');
  if (domEl) domEl.style.filter = _hexToFilter(newColor);

  showUndoToast('✦ Color aplicado');
  _svgUpdateColorPanel(obj);
}


function _svgReplaceColorInSvg(svgString, oldColor, newColor) {
  if (!svgString || !oldColor || !newColor) return svgString;

  // Normalize both colors to lowercase hex
  const oldHex = _colorToHex(oldColor).toLowerCase();
  const newHex = newColor.toLowerCase();

  let result = svgString;

  // Replace all variations of the old color
  const targets = [oldHex, oldColor.toLowerCase()];

  // Add short hex (#abc -> #aabbcc)
  if (oldHex.length === 7) {
    const sh = '#' + oldHex[1] + oldHex[3] + oldHex[5];
    targets.push(sh);
  }

  targets.forEach(t => {
    if (!t || t.length < 3) return;
    // Case-insensitive replacement in all contexts
    try {
      const escaped = t.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
      // fill="COLOR"
      result = result.replace(new RegExp('\\bfill="' + escaped + '"', 'gi'), 'fill="' + newHex + '"');
      // stroke="COLOR"  
      result = result.replace(new RegExp('\\bstroke="' + escaped + '"', 'gi'), 'stroke="' + newHex + '"');
      // fill:COLOR in style=""
      result = result.replace(new RegExp('\\bfill:\\s*' + escaped + '\\b', 'gi'), 'fill:' + newHex);
      // stroke:COLOR in style=""
      result = result.replace(new RegExp('\\bstroke:\\s*' + escaped + '\\b', 'gi'), 'stroke:' + newHex);
      // stop-color
      result = result.replace(new RegExp('\\bstop-color="' + escaped + '"', 'gi'), 'stop-color="' + newHex + '"');
    } catch(e) {}
  });

  return result;
}


function svgMakeMono(preset, customColor, objOverride) {
  const obj = objOverride || objects.find(o => o.id === _svgEditId);
  if (!obj) { showUndoToast('⚠ Selecciona un vector primero'); return; }

  if (!objOverride) pushUndo();

  // CSS filter approach — works on ANY SVG without touching its internals
  const modeMap = { white:'white', black:'black', gold:'gold', original:'original' };
  obj._colorMode = modeMap[preset] || (preset === 'custom' ? 'tint' : 'original');
  if (preset === 'custom') obj._tintColor = customColor || '#ffffff';

  // Force DOM filter update immediately
  const domEl = document.querySelector('[data-id="' + obj.id + '"]');
  if (domEl) {
    if (obj._colorMode === 'white') domEl.style.filter = 'brightness(0) invert(1)';
    else if (obj._colorMode === 'black') domEl.style.filter = 'brightness(0)';
    else if (obj._colorMode === 'gold') domEl.style.filter = 'brightness(0) sepia(1) saturate(4) hue-rotate(5deg) brightness(1.1)';
    else if (obj._colorMode === 'tint') domEl.style.filter = _hexToFilter(obj._tintColor);
    else domEl.style.filter = 'none';
  }

  if (!objOverride) {
    showUndoToast('✦ ' + (preset === 'white' ? 'Blanco' : preset === 'black' ? 'Negro' : preset === 'gold' ? 'Dorado' : 'Color aplicado'));
  }
  return obj.decoSvg;
}


function svgResetColors() {
  const obj = objects.find(o => o.id === _svgEditId);
  if (!obj) { showUndoToast('⚠ Selecciona un vector primero'); return; }
  pushUndo();
  obj._colorMode = 'original';
  obj._tintColor = null;
  const domEl = document.querySelector('[data-id="' + obj.id + '"]');
  if (domEl) domEl.style.filter = 'none';
  showUndoToast('✦ Colores originales restaurados');
  _svgUpdateColorPanel(obj);
}

