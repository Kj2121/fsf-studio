// UNDO / REDO
function getFullState(){
  return JSON.stringify({objects,themeIdx,customBgColor,bgImgSrc,bgImgPos,bgFilters,overlayOpacity,customGradient:_customGradient||null});
}

function pushUndoNow(){
  if(undoPaused) return;
  // Guarda el estado INMEDIATAMENTE (sin debounce) — para acciones discretas
  // como añadir cards, plantillas, diseños IA, etc.
  clearTimeout(_timers['pushUndo']);
  delete _timers['pushUndo'];
  undoStack.push(getFullState());
  if(undoStack.length>UNDO_MAX) undoStack.shift();
  redoStack=[];
  updateUndoBtns();
  if(typeof autoSave==='function') autoSave();
}

function pushUndo(){
  if(undoPaused) return;
  // Debounce: evita pushes repetidos en acciones rápidas (drag, slider)
  _setTimer('pushUndo', () => {
    undoStack.push(getFullState());
    if(undoStack.length>UNDO_MAX) undoStack.shift();
    redoStack=[];
    updateUndoBtns();
    if(typeof autoSave==='function') autoSave();
  }, 120);
}

function applyFullState(s){
  undoPaused=true;
  const d=JSON.parse(s);
  objects=d.objects||[];
  themeIdx=d.themeIdx||0;
  customBgColor=d.customBgColor||null;
  bgImgSrc=d.bgImgSrc||null;
  _customGradient=d.customGradient||null;
  bgImgPos=d.bgImgPos||'center';
  bgFilters=d.bgFilters||{brightness:100,contrast:100,saturate:100,grayscale:0};
  overlayOpacity=d.overlayOpacity!=null?d.overlayOpacity:0;
  const slOv=document.querySelector('#sl-ov');
  const svOv=document.getElementById('sv-ov');
  if(slOv) slOv.value=Math.round(overlayOpacity*100);
  if(svOv) svOv.textContent=Math.round(overlayOpacity*100)+'%';
  document.querySelectorAll('.sw').forEach((x,j)=>x.classList.toggle('on',j===themeIdx));
  applyBackground();
  renderObjects();
  renderLayersPanel();
  clearSelection();
  undoPaused=false;
}

function doUndo(){
  if(!undoStack.length) return;
  redoStack.push(getFullState());
  applyFullState(undoStack.pop());
  showUndoToast('Cambio deshecho');
  updateUndoBtns();
}

function doRedo(){
  if(!redoStack.length) return;
  undoStack.push(getFullState());
  applyFullState(redoStack.pop());
  showUndoToast('Cambio rehecho');
  updateUndoBtns();
}

function updateUndoBtns(){
  const u=document.getElementById('btn-undo'),r=document.getElementById('btn-redo');
  if(u){u.style.opacity=undoStack.length?'1':'0.35';u.style.pointerEvents=undoStack.length?'auto':'none';}
  if(r){r.style.opacity=redoStack.length?'1':'0.35';r.style.pointerEvents=redoStack.length?'auto':'none';}
}

