      var vgn=ctx.createRadialGradient(vX+vW/2,vY+vH/2,Math.min(vW,vH)*0.28,vX+vW/2,vY+vH/2,Math.max(vW,vH)*0.72);
      vgn.addColorStop(0,'rgba(0,0,0,0)');
      vgn.addColorStop(1,'rgba(0,0,0,'+(v.vignette/130)+')');
      ctx.fillStyle=vgn; ctx.fillRect(vX,vY,vW,vH);
    }
    // Grain
    if(v.grain>0){
      var gAmt=v.grain/100;
      var grainCv=document.createElement('canvas');
      grainCv.width=vW; grainCv.height=vH;
      var gCtx=grainCv.getContext('2d');
      var gId=gCtx.createImageData(vW,vH);
      var gd=gId.data;
      for(var gi=0;gi<gd.length;gi+=4){
        var gv=Math.floor(Math.random()*255);
        gd[gi]=gd[gi+1]=gd[gi+2]=gv;
        gd[gi+3]=Math.floor(18*gAmt);
      }
      gCtx.putImageData(gId,0,0);
      ctx.drawImage(grainCv,0,0,vW,vH,vX,vY,vW,vH);
    }
    ctx.restore();
  }

  // ── RISOGRAPH ── grain + contrast
  if(fx.risograph && fx.risograph.active) {
    var ri=fx.risograph;
    ctx.save(); ctx.resetTransform();
    var rX=Math.round(x*SC), rY=Math.round(y*SC);
    var rW=Math.ceil(w*SC), rH=Math.ceil(h*SC);
    if(ri.contrast>0){
      ctx.globalCompositeOperation='multiply';
      ctx.fillStyle='rgba(0,0,0,'+(ri.contrast/350)+')';
      ctx.fillRect(rX,rY,rW,rH);
      ctx.globalCompositeOperation='source-over';
    }
    if(ri.grain>0){
      var rg=ri.grain/100;
      var rCv=document.createElement('canvas'); rCv.width=rW; rCv.height=rH;
      var rGCtx=rCv.getContext('2d');
      var rGId=rGCtx.createImageData(rW,rH); var rd=rGId.data;
      for(var rgi=0;rgi<rd.length;rgi+=4){
        rd[rgi]=rd[rgi+1]=rd[rgi+2]=0; rd[rgi+3]=Math.floor(28*rg);
      }
      rGCtx.putImageData(rGId,0,0);
      ctx.drawImage(rCv,0,0,rW,rH,rX,rY,rW,rH);
    }
    ctx.restore();
  }

  // ── DUOTONO BÍBLICO (duotono2) ── pixel-level two-color remap
  if(fx.duotono2 && fx.duotono2.active) {
    var dt=fx.duotono2;
    function htRGB(hex){var h=(hex||'#000').replace('#','');if(h.length===3)h=h[0]+h[0]+h[1]+h[1]+h[2]+h[2];return[parseInt(h.slice(0,2),16),parseInt(h.slice(2,4),16),parseInt(h.slice(4,6),16)];}
    var c1=htRGB(dt.color1||'#C8591A'), c2=htRGB(dt.color2||'#2D3D22');
    ctx.save(); ctx.resetTransform();
    var dX=Math.round(x*SC), dY=Math.round(y*SC);
    var dW=Math.ceil(w*SC), dH=Math.ceil(h*SC);
    var srcD=out.getContext('2d').getImageData(dX,dY,dW,dH);
    var pd=srcD.data;
    for(var pi=0;pi<pd.length;pi+=4){
      var lm=(pd[pi]*0.299+pd[pi+1]*0.587+pd[pi+2]*0.114)/255;
      pd[pi]  =Math.round(c1[0]*(1-lm)+c2[0]*lm);
      pd[pi+1]=Math.round(c1[1]*(1-lm)+c2[1]*lm);
      pd[pi+2]=Math.round(c1[2]*(1-lm)+c2[2]*lm);
    }
    var tmpD=document.createElement('canvas'); tmpD.width=dW; tmpD.height=dH;
    tmpD.getContext('2d').putImageData(srcD,0,0);
    ctx.drawImage(tmpD,0,0,dW,dH,dX,dY,dW,dH);
    ctx.restore();
  }

  // ── DUOTONE (CSS filter simulation) ──
  if(fx.duotone && fx.duotone.active) {
    var dt2=fx.duotone;
    ctx.save(); ctx.resetTransform();
    var dt2X=Math.round(x*SC), dt2Y=Math.round(y*SC);
    var dt2W=Math.ceil(w*SC), dt2H=Math.ceil(h*SC);
    ctx.filter='hue-rotate('+dt2.hue+'deg) saturate('+(dt2.sat+100)+'%) brightness('+(1+dt2.bright/100)+')';
    var tmpDt=document.createElement('canvas'); tmpDt.width=dt2W; tmpDt.height=dt2H;
    tmpDt.getContext('2d').drawImage(out,dt2X,dt2Y,dt2W,dt2H,0,0,dt2W,dt2H);
    ctx.drawImage(tmpDt,0,0,dt2W,dt2H,dt2X,dt2Y,dt2W,dt2H);
    ctx.filter='none';
    ctx.restore();
  }
}



// ── GLASS CARD CANVAS RENDER ─────────────────────────────────────────
// Simulates backdropFilter:blur using a snapshot of the canvas beneath
// Refracción liquid glass sobre el fondo ya desenfocado: devuelve un canvas w×h
function _liqRefractCanvas(src, pad, w, h, r, P){
  const sw=src.width, sh=src.height;
  const sd=src.getContext('2d').getImageData(0,0,sw,sh).data;
  const out=document.createElement('canvas'); out.width=w; out.height=h;
  const oc=out.getContext('2d');
  oc.drawImage(src, pad, pad, w, h, 0, 0, w, h);
  const im=oc.getImageData(0,0,w,h), od=im.data;
  const B=P.B, S=P.S, ca=P.ca;
  const samp=(fx,fy,c)=>{
    fx=Math.max(0,Math.min(sw-1.001,fx)); fy=Math.max(0,Math.min(sh-1.001,fy));
    const x0=fx|0, y0=fy|0, tx=fx-x0, ty=fy-y0, i=(y0*sw+x0)*4+c;
    return (sd[i]*(1-tx)+sd[i+4]*tx)*(1-ty)+(sd[i+sw*4]*(1-tx)+sd[i+sw*4+4]*tx)*ty;
  };
  const edge=Math.max(B,r)+2, bx=Math.ceil(B)+1;
  for(let y=0;y<h;y++){
    const full=(y<edge||y>h-edge);
    for(let x=0;x<w;x++){
      if(!full && x>=bx && x<w-bx){ x=w-bx-1; continue; }
      const s=_liqSdf(x+.5,y+.5,w,h,r);
      if(s.d<0||s.d>=B) continue;
      const m=_liqOffset(s.d,B,S), ox=-s.nx*m, oy=-s.ny*m, sx=x+.5+pad, sy=y+.5+pad, i=(y*w+x)*4;
      od[i]  =samp(sx+ox*(1+ca), sy+oy*(1+ca), 0);
      od[i+1]=samp(sx+ox,        sy+oy,        1);
      od[i+2]=samp(sx+ox*(1-ca), sy+oy*(1-ca), 2);
    }
  }
  oc.putImageData(im,0,0);
  return out;
}

function _drawGlassToCanvas(ctx, obj, canvasSnapshot) {
  const x = obj.x, y = obj.y, w = obj.w, h = obj.h;
  const blur   = obj.glassBlur   != null ? obj.glassBlur   : 20;
  const tint   = obj.glassTint   != null ? obj.glassTint   : 0.10;
  const border = obj.glassBorder != null ? obj.glassBorder : 0.30;
  const radius = (obj.type==='glassCard') ? (obj.glassRadius != null ? obj.glassRadius : 48) : (obj.cornerRadius || 12);
  const hl     = obj.glassHighlight !== false;
  const s      = obj.shapeType || 'roundrect';

  ctx.save();

  // ── Sombra exterior suave (solo fuera del cristal) ──
  if(obj.type==='glassCard'&&!obj.glassFlat){
    const rs = Math.min(radius, w/2, h/2), ks = Math.max(1, Math.min(w,h)/400);
    ctx.save();
    ctx.beginPath(); ctx.rect(-1e5,-1e5,2e5,2e5);
    ctx.roundRect(x, y, w, h, rs);
    ctx.clip('evenodd');
    ctx.shadowColor='rgba(0,0,0,0.28)'; ctx.shadowBlur=40*ks; ctx.shadowOffsetY=10*ks;
    ctx.fillStyle='#000'; ctx.beginPath(); ctx.roundRect(x, y, w, h, rs); ctx.fill();
    ctx.restore();
  }

  // ── Clip path matching the shape ──
  function applyClip() {
    ctx.beginPath();
    if(s==='circle' || s==='ellipse'){
      ctx.ellipse(x+w/2, y+h/2, w/2, h/2, 0, 0, Math.PI*2);
    } else if(s==='triangle'){
      ctx.moveTo(x+w/2,y); ctx.lineTo(x+w,y+h); ctx.lineTo(x,y+h); ctx.closePath();
    } else if(s==='diamond'){
      ctx.moveTo(x+w/2,y); ctx.lineTo(x+w,y+h/2); ctx.lineTo(x+w/2,y+h); ctx.lineTo(x,y+h/2); ctx.closePath();
    } else {
      // rect / roundrect / glassCard
      const r = Math.min(radius, w/2, h/2);
      ctx.moveTo(x+r,y); ctx.lineTo(x+w-r,y); ctx.quadraticCurveTo(x+w,y,x+w,y+r);
      ctx.lineTo(x+w,y+h-r); ctx.quadraticCurveTo(x+w,y+h,x+w-r,y+h);
      ctx.lineTo(x+r,y+h); ctx.quadraticCurveTo(x,y+h,x,y+h-r);
      ctx.lineTo(x,y+r); ctx.quadraticCurveTo(x,y,x+r,y); ctx.closePath();
    }
  }

  applyClip(); ctx.clip();

  // ── Step 1: fondo desenfocado (+ refracción liquid glass) ──
  const _k = (obj.type==='glassCard') ? (obj.glassRefract != null ? obj.glassRefract : 60)/100 : 0;
  const _lp = _liqParams(w,h,_k,obj._sc||1);
  if(canvasSnapshot && (blur > 0 || _k > 0)) {
    const bSize = Math.ceil(blur * 2.5) + (_k>0 ? Math.ceil(_lp.S)+2 : 0);
    const bCv = document.createElement('canvas');
    bCv.width = Math.ceil(w + bSize*2); bCv.height = Math.ceil(h + bSize*2);
    const bCtx = bCv.getContext('2d');
    bCtx.filter = `blur(${blur}px) saturate(150%)`;
    if(obj.glassFlat){ bCtx.drawImage(canvasSnapshot, x, y, w, h, 0, 0, bCv.width, bCv.height); bCtx.drawImage(canvasSnapshot, x, y, w, h, bSize, bSize, w, h); }
    else bCtx.drawImage(canvasSnapshot, x - bSize, y - bSize, w + bSize*2, h + bSize*2, 0, 0, w + bSize*2, h + bSize*2);
    if(_k > 0){
      const rr = Math.min(radius, w/2, h/2);
      const lc = _liqRefractCanvas(bCv, bSize, Math.round(w), Math.round(h), rr, _lp);
      ctx.drawImage(lc, x, y, w, h);
    } else {
      ctx.drawImage(bCv, 0, 0, w + bSize*2, h + bSize*2, x - bSize, y - bSize, w + bSize*2, h + bSize*2);
    }
  }

  // ── Step 2: Glass tint ──
  ctx.fillStyle = `rgba(255,255,255,${tint})`;
  applyClip(); ctx.fill();

  if(obj.glassFlat){
    /* cristal plano: solo desenfoque */
  } else if(obj.type==='glassCard'){
    // ── Liquid glass: brillo diagonal + resplandor interior + borde especular ──
    const rs=Math.min(radius,w/2,h/2), ks=Math.max(1,Math.min(w,h)/400);
    if(hl){
      const g=ctx.createLinearGradient(x,y,x+w,y+h);
      g.addColorStop(0,`rgba(255,255,255,${(border*0.55).toFixed(2)})`);
      g.addColorStop(0.38,'rgba(255,255,255,0)'); g.addColorStop(0.62,'rgba(255,255,255,0)');
      g.addColorStop(1,`rgba(255,255,255,${(border*0.3).toFixed(2)})`);
      ctx.fillStyle=g; applyClip(); ctx.fill();
    }
    ctx.save();
    ctx.beginPath(); ctx.rect(x-1e4,y-1e4,w+2e4,h+2e4); ctx.roundRect(x,y,w,h,rs);
    ctx.shadowColor=`rgba(255,255,255,${(0.10+border*0.25).toFixed(2)})`; ctx.shadowBlur=_lp.B*0.7;
    ctx.fillStyle='#fff'; ctx.fill('evenodd');
    ctx.restore();
    const gb=ctx.createLinearGradient(x,y,x+w,y+h);
    gb.addColorStop(0,`rgba(255,255,255,${Math.min(1,border*2.6).toFixed(2)})`);
    gb.addColorStop(0.5,`rgba(255,255,255,${(border*0.9).toFixed(2)})`);
    gb.addColorStop(1,`rgba(255,255,255,${Math.min(1,border*1.8).toFixed(2)})`);
    ctx.beginPath(); ctx.roundRect(x+0.75*ks,y+0.75*ks,w-1.5*ks,h-1.5*ks,Math.max(0,rs-0.75*ks));
    ctx.strokeStyle=gb; ctx.lineWidth=1.6*ks; ctx.stroke();
  } else {
  // ── Step 3: Highlight gradient top ──
  if(hl) {
    const gradTop = ctx.createLinearGradient(x, y, x, y + h*0.38);
    gradTop.addColorStop(0, `rgba(255,255,255,${(border*0.85).toFixed(2)})`);
    gradTop.addColorStop(1, 'rgba(255,255,255,0)');
    ctx.fillStyle = gradTop;
    applyClip(); ctx.fill();

    const gradDiag = ctx.createLinearGradient(x, y, x+w, y+h);
    gradDiag.addColorStop(0, 'rgba(255,255,255,0.07)');
    gradDiag.addColorStop(0.5, 'rgba(255,255,255,0)');
    gradDiag.addColorStop(1, 'rgba(255,255,255,0.02)');
    ctx.fillStyle = gradDiag;
    applyClip(); ctx.fill();
  }

  // ── Step 4: Border ──
  applyClip();
  ctx.strokeStyle = `rgba(255,255,255,${border})`;
  ctx.lineWidth = 1.5;
  ctx.stroke();

  // ── Step 5: Inner glow top edge ──
  ctx.beginPath();
  const r2 = Math.min(radius, w/2, h/2);
  ctx.moveTo(x+r2, y+1); ctx.lineTo(x+w-r2, y+1);
  ctx.strokeStyle = `rgba(255,255,255,${(border*1.6).toFixed(2)})`;
  ctx.lineWidth = 1;
  ctx.stroke();
  }

  ctx.restore();
}

function _drawShapeToCanvas(ctx, obj) {
  const {x, y, w, h, shapeType: s} = obj;
  const fill   = obj.fillMode === 'stroke' ? null : (obj.fillColor || 'rgba(30,123,255,0.85)');
  const stroke = obj.fillMode === 'fill'   ? null : (obj.strokeColor || '#7C5BF0');
  const sw     = obj.strokeWidth || 3;

  ctx.beginPath();

  if (s === 'rect') {
    ctx.rect(x, y, w, h);
  } else if (s === 'roundrect') {
    const r = Math.min(obj.cornerRadius ?? 0, Math.min(w,h)/2);
    ctx.roundRect(x, y, w, h, r);
  } else if (s === 'circle' || s === 'ellipse') {
    ctx.ellipse(x+w/2, y+h/2, w/2, h/2, 0, 0, Math.PI*2);
  } else if (s === 'triangle') {
    ctx.moveTo(x+w/2, y);
    ctx.lineTo(x+w, y+h);
    ctx.lineTo(x, y+h);
    ctx.closePath();
  } else if (s === 'triangle-inv') {
    ctx.moveTo(x, y);
    ctx.lineTo(x+w, y);
    ctx.lineTo(x+w/2, y+h);
    ctx.closePath();
  } else if (s === 'diamond') {
    ctx.moveTo(x+w/2, y);
    ctx.lineTo(x+w, y+h/2);
    ctx.lineTo(x+w/2, y+h);
    ctx.lineTo(x, y+h/2);
    ctx.closePath();
  } else if (s === 'line-h') {
    ctx.beginPath();
    ctx.moveTo(x, y+h/2);
    ctx.lineTo(x+w, y+h/2);
    ctx.strokeStyle = obj.fillColor || '#7C5BF0';
    ctx.lineWidth   = h;
    ctx.lineCap     = 'round';
    ctx.stroke();
    return;
  } else if (s === 'line-v') {
    ctx.beginPath();
    ctx.moveTo(x+w/2, y);
    ctx.lineTo(x+w/2, y+h);
    ctx.strokeStyle = obj.fillColor || '#7C5BF0';
    ctx.lineWidth   = w;
    ctx.lineCap     = 'round';
    ctx.stroke();
    return;
  } else if (s === 'semicircle') {
    ctx.arc(x+w/2, y+h, w/2, Math.PI, 0);
    ctx.closePath();
  } else if (s === 'arc') {
    ctx.beginPath();
    ctx.moveTo(x, y+h*0.85);
    ctx.quadraticCurveTo(x+w/2, y, x+w, y+h*0.85);
    ctx.strokeStyle = obj.fillColor || '#7C5BF0';
    ctx.lineWidth   = Math.max(sw, 6);
    ctx.lineCap     = 'round';
    ctx.stroke();
    return;
  } else if (s === 'cross') {
    const t = Math.round(w * 0.28);
    const cx = x+w/2, cy = y+h/2;
    ctx.rect(cx-t/2, y, t, h);
    ctx.rect(x, cy-t/2, w, t);
  }

  if (fill)   { ctx.fillStyle = fill;     ctx.fill(); }
  if (stroke) { ctx.strokeStyle = stroke; ctx.lineWidth = sw; ctx.stroke(); }
}

async function _exportPdf(canvas, W, H) {
  const btn = document.getElementById('dl-btn');
  const SVG_DL = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="14" height="14"><path d="M12 15V3m0 12l-4-4m4 4l4-4"/><rect x="3" y="17" width="18" height="4" rx="2"/></svg>';
  try {
    if (btn) { btn.disabled = true; btn.textContent = '⏳ PDF…'; }
    if (!window.jspdf) {
      await new Promise((res, rej) => {
        const s = document.createElement('script');
        s.src = 'https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js';
        s.onload = res;
        s.onerror = () => rej(new Error('No se pudo cargar jsPDF'));
        document.head.appendChild(s);
      });
    }
    const { jsPDF } = window.jspdf;
    const orientation = W >= H ? 'landscape' : 'portrait';
    const A4_W = orientation === 'portrait' ? 210 : 297;
    const A4_H = orientation === 'portrait' ? 297 : 210;
    const ratio = Math.min(A4_W / W, A4_H / H);
    const imgW = W * ratio, imgH = H * ratio;
    const offsetX = (A4_W - imgW) / 2, offsetY = (A4_H - imgH) / 2;
    const doc = new jsPDF({ orientation, unit: 'mm', format: 'a4' });

    // Para PDF: escalar el canvas a 150dpi máximo (no necesita 3x/4K)
    // A4 a 150dpi = 1240×1754px — suficiente para impresión normal
    const PDF_MAX = 1754; // px lado mayor
    const pdfScale = Math.min(1, PDF_MAX / Math.max(canvas.width, canvas.height));
    let pdfCanvas = canvas;
    if(pdfScale < 1) {
      pdfCanvas = document.createElement('canvas');
      pdfCanvas.width  = Math.round(canvas.width  * pdfScale);
      pdfCanvas.height = Math.round(canvas.height * pdfScale);
      const pCtx = pdfCanvas.getContext('2d');
      pCtx.imageSmoothingEnabled = true;
      pCtx.imageSmoothingQuality = 'high';
      pCtx.drawImage(canvas, 0, 0, pdfCanvas.width, pdfCanvas.height);
    }

    // JPEG 88% — PNG para PDF pesa 5-10× más con resultado visual idéntico
    const imgData = pdfCanvas.toDataURL('image/jpeg', 0.88);
    doc.addImage(imgData, 'JPEG', offsetX, offsetY, imgW, imgH);
    const fname = 'FeSinFronteras_' + fmt + '_' + W + 'x' + H + '.pdf';
    doc.save(fname);
  } catch(e) {
    const d = document.createElement('div');
    d.textContent = 'Error PDF: ' + e.message;
    Object.assign(d.style, {position:'fixed',bottom:'80px',left:'50%',transform:'translateX(-50%)',zIndex:'99999',background:'rgba(180,30,30,0.95)',color:'#fff',fontSize:'12px',fontWeight:'700',padding:'10px 18px',borderRadius:'10px'});
    document.body.appendChild(d); setTimeout(() => d.remove(), 6000);
  } finally {
    if (btn) { btn.disabled = false; btn.innerHTML = SVG_DL + ' Descargar HD'; }
  }
}

