      body: JSON.stringify({
        system_instruction:{ parts:[{ text: _PHOTO2TPL_SYS }] },
        contents:[{ parts:[
          { inline_data:{ mime_type: mime, data: base64 } },
          { text: userPrompt }
        ]}],
