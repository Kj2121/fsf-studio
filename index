    const row=document.createElement('div');
    row.style.cssText='display:grid;grid-template-columns:1fr 1fr;gap:6px;margin-bottom:4px;';

    fmts.forEach(f=>{
      const dstF=FMTS[f.key];
      const scaleX=(dstF.W/srcW);
      const scaleY=(dstF.H/srcH);
      // Determine fit strategy label
      const ratio=(dstF.W/dstF.H).toFixed(2);
      const srcRatio=(srcW/srcH).toFixed(2);
      const sameRatio=ratio===srcRatio;
      const strategyLabel=sameRatio?'Escala perfecta':scaleX<1||scaleY<1?'Ajuste + relleno':'Expansión';
      const strategyColor=sameRatio?'rgba(74,222,128,0.7)':scaleX<1||scaleY<1?'rgba(30,123,255,0.7)':'rgba(30,123,255,0.7)';

      // Mini aspect ratio preview
      const previewW=36;
      const previewH=Math.round(previewW*(dstF.H/dstF.W));
      const clampedH=Math.min(previewH,54);

      const card=document.createElement('button');
      card.style.cssText=`background:rgba(255,255,255,0.03);border:1.5px solid rgba(255,255,255,0.07);border-radius:16px;padding:12px;cursor:pointer;text-align:left;display:flex;align-items:center;gap:12px;transition:all .2s;-webkit-tap-highlight-color:transparent;`;
      card.innerHTML=`
        <div style="flex-shrink:0;width:40px;display:flex;align-items:center;justify-content:center;">
          <div style="width:${previewW}px;height:${clampedH}px;background:linear-gradient(135deg,rgba(30,123,255,0.2),rgba(20,72,180,0.12));border:1.5px solid rgba(30,123,255,0.35);border-radius:4px;display:flex;align-items:center;justify-content:center;font-size:${clampedH>30?'14':'10'}px;">${f.icon}</div>
        </div>
        <div style="flex:1;min-width:0;">
          <div style="font-size:12px;font-weight:700;color:rgba(255,255,255,0.85);font-family:var(--ui-font);margin-bottom:2px;">${f.label}</div>
          <div style="font-size:10px;color:var(--txt3);font-family:var(--ui-font);">${f.sub}</div>
          <div style="font-size:9px;font-weight:700;color:${strategyColor};font-family:var(--ui-font);margin-top:3px;">${strategyLabel}</div>
        </div>
        <svg viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,0.2)" stroke-width="2" width="14" height="14" style="flex-shrink:0;"><path d="M9 18l6-6-6-6"/></svg>
      `;
      card.addEventListener('mouseenter',()=>{card.style.borderColor='rgba(30,123,255,0.4)';card.style.background='rgba(30,123,255,0.06)';});
      card.addEventListener('mouseleave',()=>{card.style.borderColor='rgba(255,255,255,0.07)';card.style.background='rgba(255,255,255,0.03)';});
      card.addEventListener('touchstart',()=>{card.style.transform='scale(0.97)';},{passive:true});
      card.addEventListener('touchend',()=>{card.style.transform='';},{passive:true});
      card.onclick=()=>_executeSmartResize(f.key);
      row.appendChild(card);
    });
    grid.appendChild(row);
  });
}

function _executeSmartResize(targetFmt){
  const srcF=FMTS[fmt]||FMTS.square;
  const dstF=FMTS[targetFmt]||FMTS.square;
  const srcW=srcF.W, srcH=srcF.H;
  const dstW=dstF.W, dstH=dstF.H;

  pushUndo();

  // Scale factors
  const scX=dstW/srcW;
  const scY=dstH/srcH;
  // Use the minimum scale to fit, then center
  const sc=Math.min(scX,scY);
  const offsetX=(dstW-srcW*sc)/2;
  const offsetY=(dstH-srcH*sc)/2;

  // Resize each object proportionally
  objects=objects.map(obj=>{
    if(obj.type==='deco'){
      // Full-canvas deco: just scale to new size
      if(obj.w===srcW&&obj.h===srcH){
        return {...obj,x:0,y:0,w:dstW,h:dstH};
      }
    }
    const newObj={...obj};
    // Scale position and size
    newObj.x=Math.round(obj.x*sc+offsetX);
    newObj.y=Math.round(obj.y*sc+offsetY);
    newObj.w=Math.round(obj.w*sc);
    if(obj.h&&obj.h!=='auto') newObj.h=Math.round(obj.h*sc);
    // Scale font sizes
    if(obj.type==='text'&&obj.fontSize){
      newObj.fontSize=Math.max(8,Math.round(obj.fontSize*sc));
    }
    // Scale arc text
    if(obj.type==='arctext'){
      newObj.w=Math.round(obj.w*sc);
      newObj.h=Math.round(obj.h*sc);
      if(obj.arcRadius) newObj.arcRadius=Math.round(obj.arcRadius*sc);
      if(obj.arcFontSize) newObj.arcFontSize=Math.max(8,Math.round(obj.arcFontSize*sc));
    }
    // Scale shapes
    if(obj.type==='shape'){
      newObj.w=Math.round(obj.w*sc);
      newObj.h=Math.round(obj.h*sc);
      if(obj.cornerRadius) newObj.cornerRadius=Math.round(obj.cornerRadius*sc);
    }
    // Clamp to canvas bounds
    newObj.x=Math.max(0,Math.min(newObj.x,dstW-20));
    newObj.y=Math.max(0,Math.min(newObj.y,dstH-20));
    return newObj;
  });

  // Apply new format
  fmt=targetFmt;
  const fc=FMTS[targetFmt];
  document.querySelectorAll('.fbtn[id^="bf-"]').forEach(b=>b.classList.toggle('on',b.id==='bf-'+targetFmt));
  document.getElementById('prev-lbl').textContent=fc.lbl;
  if(document.getElementById('dl-res')) document.getElementById('dl-res').textContent=fc.res;

  updateCanvasSize();
  applyBackground();
  selectedId=null;
  renderObjects();
  renderLayersPanel();

  closeResizeModal();
  showUndoToast(`✦ Redimensionado a ${fc.lbl.split('·')[0].trim()}`);
}

