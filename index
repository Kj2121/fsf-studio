// ── Sync opacity badge in layer row after change ──
function mobLayerSyncBadge(id){
  const obj = getObject(id); if(!obj) return;
  // Just re-render
  mobRenderLayers();
}

// ── Move layer up/down ──
function mobLayerMoveUp(id){
  // sorted desc by zIndex: index 0 = topmost
  const sorted = _sortedObjs().reverse();
  const idx = sorted.findIndex(o=>o.id===id);
  if(idx<=0) return;
  pushUndo();
  const tmp=sorted[idx].zIndex;
  sorted[idx].zIndex=sorted[idx-1].zIndex;
  sorted[idx-1].zIndex=tmp;
  renderObjects(); renderLayersPanel(); mobRenderLayers();
}

function mobLayerMoveDown(id){
  const sorted = _sortedObjs().reverse();
  const idx = sorted.findIndex(o=>o.id===id);
  if(idx<0||idx>=sorted.length-1) return;
  pushUndo();
  const tmp=sorted[idx].zIndex;
  sorted[idx].zIndex=sorted[idx+1].zIndex;
  sorted[idx+1].zIndex=tmp;
  renderObjects(); renderLayersPanel(); mobRenderLayers();
}

function sendToBack_layer(id){
  const obj = getObject(id); if(!obj) return;
  const sorted = _sortedObjs();
  const bot = sorted[0];
  if(!bot||bot.id===id) return;
  pushUndo();
  obj.zIndex = Math.max(1, bot.zIndex-1);
  renderObjects();
  mobRenderLayers();
  showUndoToast('↓↓ Al fondo total');
}

function updateSelBold(){
  const o = getObject(selectedId); if(!o||o.type!=='text') return;
  pushUndo();
  // FIX: sync both bold and fontWeight
  const isBold = !!(o.bold || o.fontWeight==='700' || o.fontWeight==='bold');
  o.bold = !isBold;
  o.fontWeight = o.bold ? '700' : '400';
  renderObjects();
}
function updateSelItalic(){
  const o = getObject(selectedId); if(!o||o.type!=='text') return;
  pushUndo();
  // FIX: sync both italic and fontStyle
  const isItalic = !!(o.italic || o.fontStyle==='italic');
  o.italic = !isItalic;
  o.fontStyle = o.italic ? 'italic' : 'normal';
  renderObjects();
}
function updateSelUppercase(){
  const o = getObject(selectedId); if(!o||o.type!=='text') return;
  pushUndo(); o.uppercase=!o.uppercase; renderObjects();
}
function updateStickerColor(c){
  const o = getObject(selectedId); if(!o) return;
  pushUndo(); o.color=c;
  const el = document.querySelector(`[data-id="${o.id}"]`);
  if(el){ el.style.fill=c; el.style.color=c; el.querySelectorAll('svg').forEach(s=>{s.style.fill=c;}); }
  renderObjects();
}

</script>

