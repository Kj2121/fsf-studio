  ['apple-icon-180','apple-icon-152','apple-icon-120'].forEach(id => {
    const el = document.getElementById(id);
    if (el) el.href = iconUrl;
  });

  // ── 2. SERVICE WORKER (Blob strategy) ────────────────────
  const SW_VERSION = 'fsf-v42';
  const CACHE_NAME = SW_VERSION + '-shell';

  const swCode = `
const CACHE = '${CACHE_NAME}';
const FONTS = [
  'https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap',
  'https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Lora:ital,wght@0,400;0,700;1,400&family=Montserrat:wght@400;700;900&family=Dancing+Script:wght@600;700&family=Oswald:wght@400;600&family=Nunito:wght@400;600;700;800&family=Raleway:wght@300;600;800&family=Crimson+Text:ital,wght@0,400;0,600;1,400&display=swap',
  'https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js',
];

self.addEventListener('install', e => {
  e.waitUntil(
    caches.open(CACHE).then(c => {
      // Cache the app shell (this page)
      return c.addAll(FONTS.filter(u => !u.includes('googleapis'))).catch(()=>{});
    }).then(() => self.skipWaiting())
  );
});

self.addEventListener('activate', e => {
  e.waitUntil(
    caches.keys().then(keys =>
      Promise.all(keys.filter(k => k !== CACHE).map(k => caches.delete(k)))
    ).then(() => self.clients.claim())
  );
});

self.addEventListener('fetch', e => {
  const url = e.request.url;

  // Network-first for API calls (IA, Pexels, etc.)
  const isApi = url.includes('api.groq.com') || url.includes('anthropic.com') ||
                url.includes('pexels.com') || url.includes('fal.run') ||
                url.includes('pollinations.ai') || url.includes('googleapis.com/upload');
  if (isApi) return; // Let through normally

  // Cache-first for fonts and static CDN
  const isCacheable = url.includes('fonts.g') || url.includes('cdnjs.cloud') ||
                      url.includes('esm.sh') || url.includes('fonts.gstatic');
  if (isCacheable) {
    e.respondWith(
      caches.match(e.request).then(cached => {
        if (cached) return cached;
        return fetch(e.request).then(res => {
          if (res.ok) {
            const clone = res.clone();
            caches.open(CACHE).then(c => c.put(e.request, clone));
          }
          return res;
        }).catch(() => cached || new Response('', {status: 503}));
      })
    );
    return;
  }

  // Stale-while-revalidate for the app HTML
  if (e.request.mode === 'navigate' || url.endsWith('.html')) {
    e.respondWith(
      caches.open(CACHE).then(cache =>
        cache.match(e.request).then(cached => {
          const fetchPromise = fetch(e.request).then(res => {
            if (res.ok) cache.put(e.request, res.clone());
            return res;
          }).catch(() => cached);
          return cached || fetchPromise;
        })
      )
    );
  }
});

// Message: force update
self.addEventListener('message', e => {
  if (e.data === 'skipWaiting') self.skipWaiting();
});
`;

  if ('serviceWorker' in navigator && location.protocol !== 'file:') {
    const swBlob = new Blob([swCode], {type:'application/javascript'});
    const swUrl  = URL.createObjectURL(swBlob);

    navigator.serviceWorker.register(swUrl, {scope: './'})
      .then(reg => {

        // Check for updates
        reg.addEventListener('updatefound', () => {
