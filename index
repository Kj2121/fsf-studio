// ── Apply color from popup ──
function _cpApply(hex, customFn, keepOpen){
  if(!keepOpen) document.getElementById('_cp_popup')?.remove();

  // Always use stored fn if none passed explicitly
  const fn = (typeof customFn === 'function') ? customFn : window._cpCurrentFn;

  // Case 1: custom callback (shape fill, stroke color, etc.)
  if(typeof fn === 'function'){
    pushUndo();
    fn(hex);
    _cpSyncAnchor(hex);
    // Save to recent colors
    if(!customColors.includes(hex)){ customColors.push(hex); if(customColors.length>10) customColors.shift(); }
    showUndoToast('✓ Color aplicado');
    return;
  }

  // Case 2: apply to selected element
  if(_colorLibMode === 'element'){
    // Use the ID captured when the picker was opened — selectedId may have cleared by now
    const targetId = window._cpSnapshotId || selectedId;
    if(!targetId){ showUndoToast('⚠ Selecciona un elemento primero'); return; }
    const obj = getObject(targetId);
    if(!obj){ showUndoToast('⚠ No hay elemento seleccionado'); return; }
    // Restore selection if it was lost
    if(selectedId !== targetId){ selectedId = targetId; }
    pushUndo();
    if(obj.type === 'shape'){
      obj.fillColor = hex;
      const el = document.querySelector(`[data-id="${targetId}"]`);
      if(el) _buildShapeEl(el, obj);
    } else {
      obj.color = hex;
      renderObjects();
    }
    // Sync all color UI
    const sc = document.getElementById('sel-color'); if(sc) sc.value = hex;
    const scb = document.getElementById('sel-color-bar'); if(scb) scb.value = hex;
    _cpSyncBtn('sel-color-btn', hex);
    _cpSyncBtn('sel-color-bar-btn', hex);
    _cpSyncAnchor(hex);
    if(keepOpen){
      const hi = document.getElementById('_cp_hex_input'); if(hi) hi.value = hex;
    }
    // Refresh mobile props panel if open
    if(typeof renderMobProps === 'function'){
      const drawer = document.getElementById('mob-drawer');
      if(drawer && drawer.classList.contains('open')) renderMobProps();
    }

  // Case 3: apply to background
  } else {
    applyCustomBgColor(hex);
    if(!customColors.includes(hex)){ customColors.push(hex); if(customColors.length>10) customColors.shift(); }
    renderCustomColors();
    _cpSyncBtn('cp-picker-btn', hex);
    _cpSyncAnchor(hex);
    const cp = document.getElementById('cp-picker'); if(cp) cp.value = hex;
  }

  showUndoToast('✓ Color aplicado');
}

// Sync the anchor button that opened the picker
function _cpSyncAnchor(hex){
  const anchor = window._cpCurrentAnchor;
  if(!anchor) return;
  anchor.style.background = hex;
  anchor.dataset.cpCurrent = hex;
  const span = anchor.querySelector('span');
  if(span){ span.style.color = _cpTextColor(hex); span.textContent = hex; }
