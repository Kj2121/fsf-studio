function _buildShapeEl(el, obj) {
  el.innerHTML = '';
  el.style.width  = obj.w + 'px';
  el.style.height = obj.h + 'px';
  el.style.overflow = 'visible';
  el.style.cursor = 'move';

  // ── GLASS MODE — any shape can be glass ──
  if (obj.glassMode) {
    _buildShapeGlass(el, obj);
    return;
  }

  const fill   = obj.fillMode === 'stroke' ? 'none' : (obj.fillColor || 'rgba(30,123,255,0.85)');
  const stroke = (obj.fillMode === 'fill')  ? 'none' : (obj.strokeColor || '#7C5BF0');
  const sw     = obj.strokeWidth || 3;
  const W = obj.w, H = obj.h;

  let svgContent = '';
  const s = obj.shapeType;

  if (s === 'rect') {
    svgContent = `<rect x="${sw/2}" y="${sw/2}" width="${W-sw}" height="${H-sw}" rx="${obj.cornerRadius||0}" fill="${fill}" stroke="${stroke}" stroke-width="${sw}"/>`;
  } else if (s === 'roundrect') {
    const r = Math.min(obj.cornerRadius ?? 40, Math.min(W,H)/2);
    svgContent = `<rect x="${sw/2}" y="${sw/2}" width="${W-sw}" height="${H-sw}" rx="${r}" fill="${fill}" stroke="${stroke}" stroke-width="${sw}"/>`;
  } else if (s === 'circle' || s === 'ellipse') {
    const rx = (W-sw)/2, ry = (H-sw)/2;
    svgContent = `<ellipse cx="${W/2}" cy="${H/2}" rx="${rx}" ry="${ry}" fill="${fill}" stroke="${stroke}" stroke-width="${sw}"/>`;
  } else if (s === 'triangle') {
    svgContent = `<polygon points="${W/2},${sw} ${W-sw},${H-sw} ${sw},${H-sw}" fill="${fill}" stroke="${stroke}" stroke-width="${sw}" stroke-linejoin="round"/>`;
  } else if (s === 'triangle-inv') {
    svgContent = `<polygon points="${sw},${sw} ${W-sw},${sw} ${W/2},${H-sw}" fill="${fill}" stroke="${stroke}" stroke-width="${sw}" stroke-linejoin="round"/>`;
  } else if (s === 'diamond') {
    svgContent = `<polygon points="${W/2},${sw} ${W-sw},${H/2} ${W/2},${H-sw} ${sw},${H/2}" fill="${fill}" stroke="${stroke}" stroke-width="${sw}" stroke-linejoin="round"/>`;
  } else if (s === 'line-h') {
    const y = H/2;
    svgContent = `<line x1="${sw}" y1="${y}" x2="${W-sw}" y2="${y}" stroke="${obj.fillColor||'#7C5BF0'}" stroke-width="${Math.max(H,4)}" stroke-linecap="round"/>`;
  } else if (s === 'line-v') {
    const x = W/2;
    svgContent = `<line x1="${x}" y1="${sw}" x2="${x}" y2="${H-sw}" stroke="${obj.fillColor||'#7C5BF0'}" stroke-width="${Math.max(W,4)}" stroke-linecap="round"/>`;
  } else if (s === 'semicircle') {
    svgContent = `<path d="M ${sw} ${H} A ${(W-sw*2)/2} ${H-sw} 0 0 1 ${W-sw} ${H}" fill="${fill}" stroke="${stroke}" stroke-width="${sw}" stroke-linecap="round"/>`;
  } else if (s === 'arc') {
    svgContent = `<path d="M ${sw} ${H*0.85} Q ${W/2} ${sw} ${W-sw} ${H*0.85}" fill="none" stroke="${obj.fillColor||'#7C5BF0'}" stroke-width="${Math.max(sw,6)}" stroke-linecap="round"/>`;
  } else if (s === 'cross') {
    const t = Math.round(W * 0.28); // thickness
    const cx = W/2, cy = H/2;
    svgContent = `<rect x="${cx-t/2}" y="${sw}" width="${t}" height="${H-sw*2}" rx="${t/4}" fill="${fill}"/>
      <rect x="${sw}" y="${cy-t/2}" width="${W-sw*2}" height="${t}" rx="${t/4}" fill="${fill}"/>`;
  }

  el.innerHTML = `<svg viewBox="0 0 ${W} ${H}" width="${W}" height="${H}" overflow="visible" style="display:block;width:100%;height:100%;">${svgContent}</svg>`;
}

function getObject(id){ return objects.find(o=>o.id===id)||null; }

// ── GLASS MODE para cualquier forma ──
function _buildShapeGlass(el, obj) {
  var W = obj.w, H = obj.h;
  var s = obj.shapeType;
  var blur   = obj.glassBlur   != null ? obj.glassBlur   : 18;
  var tint   = obj.glassTint   != null ? obj.glassTint   : 0.10;
  var border = obj.glassBorder != null ? obj.glassBorder : 0.28;
  var hl     = obj.glassHighlight !== false;

  // CSS clip-path shapes
  var clips = {
    'rect':         'inset(0 round 0px)',
    'roundrect':    'inset(0 round '+Math.min(obj.cornerRadius||40, Math.min(W,H)/2)+'px)',
    'circle':       'circle(50% at 50% 50%)',
    'ellipse':      'ellipse(50% 50% at 50% 50%)',
    'triangle':     'polygon(50% 0%, 100% 100%, 0% 100%)',
    'triangle-inv': 'polygon(0% 0%, 100% 0%, 50% 100%)',
    'diamond':      'polygon(50% 0%, 100% 50%, 50% 100%, 0% 50%)',
    'semicircle':   'ellipse(50% 100% at 50% 100%)',
    'cross':        'polygon(35% 0%,65% 0%,65% 35%,100% 35%,100% 65%,65% 65%,65% 100%,35% 100%,35% 65%,0% 65%,0% 35%,35% 35%)',
  };
  var clip = clips[s] || 'inset(0 round 12px)';

  // The key insight: apply clip-path to the OUTER element (no backdrop-filter there),
  // and backdrop-filter to an INNER div that fills 100%.
  // Chrome applies clip AFTER backdrop-filter is computed, so this works.
  el.style.width    = W + 'px';
  el.style.height   = H + 'px';
  el.style.overflow = 'hidden';
  el.style.cursor   = 'move';
  el.style.clipPath = clip;
  // Clear any leftover styles
  el.style.backdropFilter = '';
  el.style.webkitBackdropFilter = '';
  el.style.backgroundColor = '';
  el.style.border   = '';
  el.style.outline  = '';
  el.style.boxShadow = '';

  var tintRgba   = 'rgba(255,255,255,' + tint + ')';
  var borderRgba = 'rgba(255,255,255,' + border + ')';

  el.innerHTML =
    // Main glass layer — backdrop-filter on full-size inner div
    '<div style="'
    +   'position:absolute;inset:0;'
    +   'backdrop-filter:blur('+blur+'px) saturate(160%);'
    +   '-webkit-backdrop-filter:blur('+blur+'px) saturate(160%);'
    +   'background:'+tintRgba+';'
    + '"></div>'
    // Highlight shine top
    + (hl ? '<div style="position:absolute;top:0;left:0;right:0;height:40%;background:linear-gradient(180deg,rgba(255,255,255,'+(border*0.9)+') 0%,transparent 100%);pointer-events:none;"></div>'
          + '<div style="position:absolute;inset:0;background:linear-gradient(135deg,rgba(255,255,255,0.08) 0%,transparent 55%);pointer-events:none;"></div>'
          : '')
    // Border outline (SVG so it follows the shape)
    + '<svg style="position:absolute;inset:0;overflow:visible;" width="'+W+'" height="'+H+'" viewBox="0 0 '+W+' '+H+'" xmlns="http://www.w3.org/2000/svg">'
    +   '<rect x="0.75" y="0.75" width="'+(W-1.5)+'" height="'+(H-1.5)+'" fill="none" stroke="'+borderRgba+'" stroke-width="1.5" rx="0"/>'
    + '</svg>';
}

function _toggleShapeGlass() {
  const obj = getObject(selectedId); if(!obj || obj.type!=='shape') return;
  pushUndo();
  obj.glassMode = !obj.glassMode;
  if(obj.glassMode && obj.glassTint == null) {
    obj.glassBlur = 18; obj.glassTint = 0.10; obj.glassBorder = 0.28; obj.glassHighlight = true;
  }
  const el = document.querySelector('[data-id="'+selectedId+'"]');
  if(el) _buildShapeEl(el, obj);
  // Refresh prop panel
  showPropPanel(obj);
  showSelBar(true, obj);
}

function _refreshShapeGlass(key, val) {
  const obj = getObject(selectedId); if(!obj) return;
  obj[key] = parseFloat(val);
  const el = document.querySelector('[data-id="'+selectedId+'"]');
  if(el) _buildShapeEl(el, obj);
}


function deleteSelected(){
  if(!selectedId) return;
  pushUndo();
  objects=objects.filter(o=>o.id!==selectedId);
  selectedId=null;
  renderObjects();
  clearSelection();
  renderLayersPanel();
  showSelBar(false);
  hidePropPanel();
}

function duplicateSelected(){
  if(!selectedId) return;
  pushUndo();
  const src=getObject(selectedId);
  if(!src) return;
  const copy=JSON.parse(JSON.stringify(src));
  copy.id=genId();
  copy.x+=30; copy.y+=30;
  copy.zIndex=objects.length+2;
  objects.push(copy);
  renderObjects();
  selectObject(copy.id);
  renderLayersPanel();
}

// ── Layer ordering — swap with actual next/prev neighbour by zIndex ──
function _sortedObjs(){ return [...objects].sort((a,b)=>a.zIndex-b.zIndex); }

function bringForward(){
  if(!selectedId) return;
  const sorted = _sortedObjs();
  const idx = sorted.findIndex(o=>o.id===selectedId);
  if(idx<0||idx>=sorted.length-1) return;
  pushUndo();
  const tmp=sorted[idx].zIndex;
  sorted[idx].zIndex=sorted[idx+1].zIndex;
  sorted[idx+1].zIndex=tmp;
  renderObjects(); renderLayersPanel();
}

function sendBackward(){
  if(!selectedId) return;
  const sorted = _sortedObjs();
  const idx = sorted.findIndex(o=>o.id===selectedId);
  if(idx<=0) return;
  pushUndo();
  const tmp=sorted[idx].zIndex;
  sorted[idx].zIndex=sorted[idx-1].zIndex;
  sorted[idx-1].zIndex=tmp;
  renderObjects(); renderLayersPanel();
}

function bringToFront(){
  if(!selectedId) return;
  const sorted = _sortedObjs();
  const top = sorted[sorted.length-1];
  if(!top||top.id===selectedId) return;
  pushUndo();
  getObject(selectedId).zIndex = top.zIndex+1;
  renderObjects(); renderLayersPanel();
  showUndoToast('↑↑ Al frente total');
}

function sendToBack(){
  if(!selectedId) return;
  const sorted = _sortedObjs();
  const bot = sorted[0];
  if(!bot||bot.id===selectedId) return;
  pushUndo();
  getObject(selectedId).zIndex = Math.max(1, bot.zIndex-1);
  renderObjects(); renderLayersPanel();
  showUndoToast('↓↓ Al fondo total');
}



