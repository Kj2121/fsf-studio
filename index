  .pnl-nav{display:flex!important;flex-wrap:wrap;gap:4px!important;margin-bottom:14px!important;padding:3px;background:rgba(235,242,255,.035);border:1px solid rgba(235,242,255,.07);border-radius:11px;}
  .pnl-nav>div{display:contents!important;}
  .pnl-nav .ptab{flex:1 1 auto!important;font-size:11px!important;padding:8px 10px!important;background:transparent!important;border:none!important;color:rgba(235,242,255,.46)!important;border-radius:8px;}
  .pnl-nav .ptab.on{background:rgba(30,123,255,.18)!important;color:var(--gold2)!important;box-shadow:inset 0 0 0 1px rgba(30,123,255,.35);}
  .pnl-nav .ptab:hover:not(.on){background:rgba(235,242,255,.05)!important;color:rgba(235,242,255,.8)!important;}
  .pnl-nav #rtab-btn-ia{color:var(--gold)!important;}
  #tpl-grid-desk{grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;}
  .pnl-nav{flex-direction:row!important;}
  /* barra de selección: anclada abajo a la derecha como inspector, sin tapar el lienzo ni exportar */
  .sel-bar{left:auto!important;right:12px;bottom:14px!important;transform:none!important;width:324px;max-width:324px!important;max-height:62vh;overflow-y:auto;border-radius:16px;box-shadow:0 18px 50px rgba(0,0,0,.7),0 0 0 1px rgba(30,123,255,.18);}
  .sel-bar.show{animation:selBarInMob .18s cubic-bezier(.22,1,.36,1)!important;}
  .center>div[style*="translate(-50%,-50%)"]{display:none!important;} /* cruz decorativa (invisible) que falseaba el cálculo del tamaño del lienzo */
