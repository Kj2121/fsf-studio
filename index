function mnResizeCanvas(){
  const wrap=document.getElementById('mn-canvas-wrap');
  const canvas=document.getElementById('mn-canvas');
  if(!wrap||!canvas)return;
  const maxW=wrap.clientWidth,maxH=wrap.clientHeight,aspect=MN.CW/MN.CH;
  let h=maxH,w=h*aspect;
  if(w>maxW){w=maxW;h=w/aspect;}
  canvas.style.width=w+'px';canvas.style.height=h+'px';
  canvas.width=MN.CW;canvas.height=MN.CH;
}


function mnPlay(){
  if(MN.t>=MN.duration)MN.t=0;
  MN.playing=true;MN.playStartT=MN.t;MN.playStartTS=performance.now();
  document.getElementById('mn-play-btn').textContent='⏸';
  MN.raf=requestAnimationFrame(mnPlayLoop);
}
function mnPause(){
  MN.playing=false;cancelAnimationFrame(MN.raf);
  const btn=document.getElementById('mn-play-btn');if(btn)btn.textContent='▶';
}
function mnPlayLoop(ts){
  const elapsed=(ts-MN.playStartTS)/1000;
  MN.t=MN.playStartT+elapsed;
  if(MN.t>=MN.duration){MN.t=MN.duration;mnPause();}
  mnRenderFrame(MN.t);mnUpdateTimeUI();
  if(MN.playing)MN.raf=requestAnimationFrame(mnPlayLoop);
}
function mnUpdateTimeUI(){
  const m=Math.floor(MN.t/60),s=(MN.t%60).toFixed(1);
  const el=document.getElementById('mn-time');if(el)el.textContent=m+':'+((MN.t%60)<10?'0':'')+s;
