// MÓDULO DE IMPRENTA PROFESIONAL
// RGB→CMYK, DPI, sangría, marcas de corte, simulador de papel
// ══════════════════════════════════════════════════════════════

// RGB → CMYK conversion
function _rgbToCmyk(r, g, b) {
  r /= 255; g /= 255; b /= 255;
  const k = 1 - Math.max(r, g, b);
  if (k === 1) return { c: 0, m: 0, y: 0, k: 100 };
  const c = (1 - r - k) / (1 - k);
  const m = (1 - g - k) / (1 - k);
  const y = (1 - b - k) / (1 - k);
  return {
    c: Math.round(c * 100),
    m: Math.round(m * 100),
    y: Math.round(y * 100),
    k: Math.round(k * 100)
  };
}

// CMYK → RGB (para simulación visual)
function _cmykToRgb(c, m, y, k) {
  c /= 100; m /= 100; y /= 100; k /= 100;
  return {
    r: Math.round(255 * (1 - c) * (1 - k)),
    g: Math.round(255 * (1 - m) * (1 - k)),
    b: Math.round(255 * (1 - y) * (1 - k))
  };
}

// Aplica simulación de papel al canvas
function _applyPaperSimulation(canvas, paperType) {
  const cv = document.createElement('canvas');
  cv.width = canvas.width; cv.height = canvas.height;
  const ctx = cv.getContext('2d');

  if (paperType === 'kraft') {
    // Papel kraft: capa marrón semi-transparente
    ctx.drawImage(canvas, 0, 0);
    ctx.globalCompositeOperation = 'multiply';
    ctx.fillStyle = 'rgba(194, 154, 94, 0.35)';
    ctx.fillRect(0, 0, cv.width, cv.height);
  } else if (paperType === 'mate') {
    // Papel mate: desaturar ligeramente, reducir contraste
    ctx.drawImage(canvas, 0, 0);
    ctx.globalCompositeOperation = 'multiply';
    ctx.fillStyle = 'rgba(245, 240, 235, 0.15)';
    ctx.fillRect(0, 0, cv.width, cv.height);
    // Efecto mate: reducir saturación
    const id = ctx.getImageData(0, 0, cv.width, cv.height);
    const d = id.data;
    for (let i = 0; i < d.length; i += 4) {
      const avg = (d[i] + d[i+1] + d[i+2]) / 3;
      d[i]   = d[i]   * 0.85 + avg * 0.15;
      d[i+1] = d[i+1] * 0.85 + avg * 0.15;
      d[i+2] = d[i+2] * 0.85 + avg * 0.15;
    }
    ctx.putImageData(id, 0, 0);
  } else if (paperType === 'brillante') {
    // Papel brillante: aumentar contraste y saturación
    ctx.drawImage(canvas, 0, 0);
    const id = ctx.getImageData(0, 0, cv.width, cv.height);
    const d = id.data;
    for (let i = 0; i < d.length; i += 4) {
      d[i]   = Math.min(255, d[i]   * 1.08);
      d[i+1] = Math.min(255, d[i+1] * 1.08);
      d[i+2] = Math.min(255, d[i+2] * 1.08);
    }
    ctx.putImageData(id, 0, 0);
    // Reflejo brillante sutil
    const grad = ctx.createLinearGradient(0, 0, cv.width * 0.3, cv.height * 0.3);
    grad.addColorStop(0, 'rgba(255,255,255,0.12)');
    grad.addColorStop(1, 'rgba(255,255,255,0)');
    ctx.globalCompositeOperation = 'screen';
    ctx.fillStyle = grad;
    ctx.fillRect(0, 0, cv.width, cv.height);
  } else {
    ctx.drawImage(canvas, 0, 0);
  }
  return cv;
}

// Exportar PDF de imprenta con sangría y marcas de corte
async function _exportPrintPdf(canvas, W, H, options = {}) {
  const {
    dpi = 300,
    bleedMm = 3,
    colorMode = 'rgb',
    paperFormat = 'custom',
    paperW_mm = null,
    paperH_mm = null,
    cropMarks = true,
    cmykSimulation = false,
  } = options;

  // Cargar jsPDF
  if (!window.jspdf) {
    await new Promise((res, rej) => {
      const s = document.createElement('script');
      s.src = 'https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js';
      s.onload = res; s.onerror = rej;
      document.head.appendChild(s);
    });
  }
  const { jsPDF } = window.jspdf;

  // Calcular dimensiones
  // Convertir píxeles del canvas a mm (asumiendo 96ppi pantalla)
  const pxPerMm = dpi / 25.4;
  const docW_mm = paperW_mm || (W * 25.4 / 96);
  const docH_mm = paperH_mm || (H * 25.4 / 96);

  // Documento con sangría
  const totalW = docW_mm + bleedMm * 2 + (cropMarks ? 10 : 0);
  const totalH = docH_mm + bleedMm * 2 + (cropMarks ? 10 : 0);
  const orientation = totalW >= totalH ? 'landscape' : 'portrait';

  const doc = new jsPDF({
    orientation,
    unit: 'mm',
    format: [totalW, totalH]
  });

  // Offset para marcas de corte
  const offsetX = cropMarks ? 5 : 0;
  const offsetY = cropMarks ? 5 : 0;

  // --- Aplicar simulación CMYK si se pidió ---
  let printCanvas = canvas;
  if (cmykSimulation) {
    const cv2 = document.createElement('canvas');
    cv2.width = canvas.width; cv2.height = canvas.height;
    const ctx2 = cv2.getContext('2d');
    ctx2.drawImage(canvas, 0, 0);
    const id = ctx2.getImageData(0, 0, cv2.width, cv2.height);
    const d = id.data;
    // Convertir cada píxel: RGB → CMYK → RGB (simula pérdida de gama)
    for (let i = 0; i < d.length; i += 4) {
      const cmyk = _rgbToCmyk(d[i], d[i+1], d[i+2]);
      // Reducir gama CMYK (los rojos brillantes y verdes fluorescentes no se pueden imprimir)
      cmyk.c = Math.min(100, cmyk.c);
      cmyk.m = Math.min(100, cmyk.m);
      cmyk.y = Math.min(100, cmyk.y);
      cmyk.k = Math.min(85, cmyk.k); // Negro máximo en imprenta ~85%
      const rgb = _cmykToRgb(cmyk.c, cmyk.m, cmyk.y, cmyk.k);
      d[i] = rgb.r; d[i+1] = rgb.g; d[i+2] = rgb.b;
    }
    ctx2.putImageData(id, 0, 0);
    printCanvas = cv2;
  }

  const imgData = printCanvas.toDataURL('image/jpeg', 0.97);

  // Área con sangría (imagen se extiende al área de sangría)
  doc.addImage(
    imgData, 'JPEG',
    offsetX,
    offsetY,
    docW_mm + bleedMm * 2,
    docH_mm + bleedMm * 2
  );

  // --- Marcas de corte ---
  if (cropMarks) {
    doc.setDrawColor(0, 0, 0);
    doc.setLineWidth(0.25);

    const x1 = offsetX + bleedMm; // borde izq del diseño
    const x2 = offsetX + bleedMm + docW_mm; // borde der del diseño
    const y1 = offsetY + bleedMm; // borde sup del diseño
    const y2 = offsetY + bleedMm + docH_mm; // borde inf del diseño

    const markLen = 4; // longitud de marca en mm
    const gap = 1;     // gap entre imagen y marca

    // Esquina superior izquierda
    doc.line(x1 - gap - markLen, y1, x1 - gap, y1); // horizontal
    doc.line(x1, y1 - gap - markLen, x1, y1 - gap); // vertical
    // Esquina superior derecha
    doc.line(x2 + gap, y1, x2 + gap + markLen, y1);
    doc.line(x2, y1 - gap - markLen, x2, y1 - gap);
    // Esquina inferior izquierda
    doc.line(x1 - gap - markLen, y2, x1 - gap, y2);
    doc.line(x1, y2 + gap, x1, y2 + gap + markLen);
    // Esquina inferior derecha
    doc.line(x2 + gap, y2, x2 + gap + markLen, y2);
    doc.line(x2, y2 + gap, x2, y2 + gap + markLen);

    // Texto info técnica (pequeño, fuera del área)
    doc.setFontSize(5);
    doc.setTextColor(120, 120, 120);
    doc.text(`FSF Studio · ${docW_mm.toFixed(1)}×${docH_mm.toFixed(1)}mm · ${dpi}dpi · ${colorMode.toUpperCase()} · Sangría ${bleedMm}mm`, offsetX, totalH - 1.5);
  }

  // Añadir metadata
  doc.setProperties({
    title: 'FSF Studio — Archivo de Imprenta',
    subject: `${docW_mm.toFixed(0)}x${docH_mm.toFixed(0)}mm ${dpi}dpi`,
    author: 'Fe Sin Fronteras Studio',
    creator: 'FSF Studio'
  });

  const fname = `FSF_Imprenta_${docW_mm.toFixed(0)}x${docH_mm.toFixed(0)}mm_${dpi}dpi.pdf`;
  doc.save(fname);
  return fname;
}

