    const getAn=()=>cv.getAnimations({subtree:true});
    getAn().forEach(a=>{try{a.pause();}catch(e){}});
    document.body.classList.remove('fsf-interact');
    const _t0=performance.now();
    for(let i=0;i<N;i++){
