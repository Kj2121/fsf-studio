        </div>
        ${f.id==='custom'?'<span style="font-size:10px;color:rgba(30,123,255,0.6);font-family:var(--ui-font);">✏️ Editar</span>':''}
      </button>`).join('');
  };

  window.printSelFormat = function(fid){
    selFmt = PRINT_FORMATS.find(f=>f.id===fid);
    // Highlight selected
    document.querySelectorAll('[id^="print-fmt-"]').forEach(b=>{
      const bid = b.id.replace('print-fmt-','');
      const on = bid===fid;
      b.style.borderColor = on?'rgba(30,123,255,0.4)':'rgba(255,255,255,0.07)';
      b.style.background  = on?'rgba(30,123,255,0.07)':'rgba(255,255,255,0.02)';
    });
    const customDiv = document.getElementById('print-custom-dims');
    if(customDiv) customDiv.style.display = fid==='custom'?'block':'none';
    printUpdateSummary();
  };

  window.printUpdateCustom = function(){
    const w = parseFloat(document.getElementById('print-custom-w')?.value)||0;
    const h = parseFloat(document.getElementById('print-custom-h')?.value)||0;
    const unit = document.getElementById('print-custom-unit')?.value||'mm';
    const toMm = {mm:1, cm:10, in:25.4, px:25.4/96};
    customW = w * toMm[unit];
    customH = h * toMm[unit];
    if(selFmt?.id==='custom'){ selFmt = {...selFmt, w:Math.round(customW), h:Math.round(customH)}; }
    printUpdateSummary();
  };

  window.printUpdateColorConv = function(hex){
    const r = parseInt(hex.slice(1,3),16);
    const g = parseInt(hex.slice(3,5),16);
    const b = parseInt(hex.slice(5,7),16);
    const cmyk = _rgbToCmyk(r,g,b);
    document.getElementById('print-rgb-val').textContent = `RGB: ${r}, ${g}, ${b}`;
    document.getElementById('print-cmyk-val').textContent = `CMYK: ${cmyk.c}%, ${cmyk.m}%, ${cmyk.y}%, ${cmyk.k}%`;
    document.getElementById('print-color-preview').style.background = hex;
    // Gamut check — si la suma excede 320 (Total Ink Coverage) puede haber problemas
    const tic = cmyk.c + cmyk.m + cmyk.y + cmyk.k;
    const gamutEl = document.getElementById('print-color-gamut');
    if(gamutEl){
      if(tic > 320) {
        gamutEl.style.color = 'rgba(255,100,100,0.8)';
        gamutEl.textContent = `⚠ TIC ${tic}% — excede el límite de tinta (320%). Puede manchar.`;
      } else {
        gamutEl.style.color = 'rgba(74,222,128,0.7)';
        gamutEl.textContent = `✓ TIC ${tic}% — dentro de la gama imprimible`;
      }
    }
  };

  window.printUpdateSummary = function(){
    const el = document.getElementById('print-summary-content');
    if(!el) return;
    const {W,H} = getFmtSize();
    const pxW = Math.round(W * selDpi / 96);
    const pxH = Math.round(H * selDpi / 96);
    const fmt = selFmt;
    const fmtStr = fmt && fmt.id!=='custom' && fmt.w>0 ? `${fmt.w}×${fmt.h}mm` : (customW>0?`${customW.toFixed(0)}×${customH.toFixed(0)}mm`:`${(W*25.4/96).toFixed(0)}×${(H*25.4/96).toFixed(0)}mm`);
    const items = [
      ['Resolución', `${selDpi} DPI`],
      ['Píxeles de salida', `${pxW.toLocaleString()}×${pxH.toLocaleString()}px`],
      ['Modo de color', selColor.toUpperCase()],
      ['Sangría', `${bleedMm} mm`],
      ['Marcas de corte', cropmarks?'✓ Sí':'✕ No'],
      ['Tamaño de impresión', fmtStr],
      ['Simulación papel', selPaper==='normal'?'Sin simular':selPaper],
      ['Peso aprox. PNG', `~${(pxW*pxH*4/1024/1024*0.3).toFixed(1)} MB`],
    ];
    el.innerHTML = items.map(([k,v])=>`
      <div style="padding:3px 0;">
        <div style="font-size:9px;color:var(--txt3);font-family:var(--ui-font);">${k}</div>
        <div style="font-size:11px;font-weight:600;color:rgba(255,255,255,0.65);font-family:var(--ui-font);">${v}</div>
      </div>`).join('');
  };

  window.printExport = async function(){
    const btn = document.getElementById('print-export-btn');
    if(btn){ btn.textContent='⏳ Generando PDF...'; btn.style.opacity='0.7'; btn.disabled=true; }

    try {
      clearSelection();
      await new Promise(r=>setTimeout(r,80));
      const {W,H} = getFmtSize();

      // Render canvas at target DPI
      const scale = selDpi / 96;
      const printCanvas = await captureCanvas(W, H, scale);

      // Apply paper simulation if selected
      const finalCanvas = selPaper!=='normal' ? _applyPaperSimulation(printCanvas, selPaper) : printCanvas;

      // Get target dimensions
      let targetW = null, targetH = null;
      if(selFmt && selFmt.id!=='custom' && selFmt.w>0){
        targetW = selFmt.w; targetH = selFmt.h;
      } else if(customW>0 && customH>0){
        targetW = customW; targetH = customH;
      }

      const fname = await _exportPrintPdf(finalCanvas, W, H, {
        dpi: selDpi,
        bleedMm: bleedMm,
        colorMode: selColor,
        cropMarks: cropmarks,
        cmykSimulation: selColor==='cmyk',
        paperW_mm: targetW,
        paperH_mm: targetH,
      });

      showUndoToast('✅ PDF exportado: ' + fname);
      document.getElementById('print-modal')?.remove();

    } catch(e) {
      showUndoToast('⚠ Error: ' + e.message);
      console.error(e);
    }
    if(btn){ btn.textContent=' Exportar PDF de imprenta'; btn.style.opacity='1'; btn.disabled=false; }
  };

  // Initialize
  printRenderFormats('all');
  printUpdateSummary();
  printUpdateColorConv('#7C5BF0');
}

