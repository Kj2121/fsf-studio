// ── PARSEO ROBUSTO DE JSON DE IA ─────────────────────────────────────
// Los modelos a veces devuelven JSON con markdown, texto extra, o comas finales
function _aiExtractJson(raw){
  if(!raw) return null;
  let s = raw.trim();
  // Quitar bloques markdown ```json ... ```
  s = s.replace(/```json\s*/gi,'').replace(/```\s*/g,'');
  // Buscar el primer { y el último } balanceado
  const start = s.indexOf('{');
  if(start < 0) return null;
  let depth=0, end=-1;
  for(let i=start;i<s.length;i++){
    if(s[i]==='{') depth++;
    else if(s[i]==='}'){ depth--; if(depth===0){ end=i; break; } }
  }
  if(end < 0) return null;
  let jsonStr = s.slice(start, end+1);
  // Reparar comas finales antes de } o ]
  jsonStr = jsonStr.replace(/,(\s*[}\]])/g,'$1');
  try{
    return JSON.parse(jsonStr);
  }catch(e){
    // Segundo intento: reparar comillas simples → dobles en keys
    try{
      const fixed = jsonStr.replace(/([{,]\s*)'([^']+)'(\s*:)/g,'$1"$2"$3');
      return JSON.parse(fixed);
    }catch(e2){
      return null;
    }
  }
}

// ── MOTOR DE COMANDOS DE CANVAS PARA IA ──────────────────────────────
// La IA devuelve acciones específicas que se ejecutan sobre los objetos
// existentes SIN regenerar todo. Rápido, preciso, conversacional.
function _aiExecuteCommands(commands){
  if(!Array.isArray(commands) || !commands.length) return {ok:false, msg:'Sin comandos'};
  pushUndoNow();
  const {W,H} = getFmtSize();
  let applied = 0;
  const log = [];

  // Helper: encontrar objeto por descripción (índice, tipo, texto, o "último/primero")
  function findTarget(sel){
    if(sel==null) return null;
    if(typeof sel==='number') return objects[sel] || null;
    const s=String(sel).toLowerCase();
    // Por id directo
    let o=objects.find(x=>x.id===sel);
    if(o) return o;
    // Por palabras clave
    if(s==='título'||s==='titulo'||s==='title'){
      const txts=objects.filter(x=>x.type==='text').sort((a,b)=>(b.fontSize||0)-(a.fontSize||0));
      return txts[0]||null;
    }
    if(s==='versículo'||s==='versiculo'||s==='verso'||s==='verse'){
      return objects.find(x=>x.type==='text'&&x.italic) || objects.filter(x=>x.type==='text').sort((a,b)=>(b.text||'').length-(a.text||'').length)[0] || null;
    }
    if(s==='referencia'||s==='ref'){
      return objects.find(x=>x.type==='text'&&x.uppercase&&(x.text||'').length<25)||null;
    }
    if(s==='fondo'||s==='background'){
      return objects.find(x=>x.type==='shape'&&x.w>=W*0.9&&x.h>=H*0.9)||null;
    }
    if(s==='foto'||s==='imagen'||s==='image'){
      return objects.find(x=>x.type==='imgZone')||null;
    }
    if(s==='último'||s==='ultimo'||s==='last') return objects[objects.length-1]||null;
    if(s==='primero'||s==='first') return objects[0]||null;
    // Por contenido de texto
    o=objects.find(x=>x.type==='text'&&(x.text||'').toLowerCase().includes(s));
    return o||null;
  }

  for(const cmd of commands){
    try{
      const action=(cmd.action||cmd.type||'').toLowerCase();

      if(action==='settext'||action==='changetext'||action==='edittext'){
        const o=findTarget(cmd.target); if(o){ o.text=cmd.text||cmd.value||o.text; applied++; log.push('texto actualizado'); }
      }
      else if(action==='setcolor'||action==='changecolor'||action==='color'){
        const o=findTarget(cmd.target); if(o){ o.color=cmd.color||cmd.value; if(o.type==='shape'){o.fillColor=cmd.color||cmd.value;} applied++; log.push('color cambiado'); }
      }
      else if(action==='setfont'||action==='changefont'||action==='font'){
        const o=findTarget(cmd.target);
        const fid=(cmd.font||cmd.value||'').toLowerCase();
        const valid=['playfair','lora','crimson','nunito','raleway','montserrat','oswald','dancing','cross','dove'];
        const match=valid.find(f=>fid.includes(f))||fid;
        if(o&&valid.includes(match)){ o.fontId=match; applied++; log.push('fuente cambiada'); }
      }
      else if(action==='setsize'||action==='resize'||action==='size'){
        const o=findTarget(cmd.target);
        if(o){
          if(cmd.fontSize) o.fontSize=Math.max(8,Math.min(400,cmd.fontSize));
          else if(cmd.scale){ if(o.type==='text') o.fontSize=Math.round((o.fontSize||40)*cmd.scale); else {o.w=Math.round(o.w*cmd.scale);o.h=Math.round((o.h||o.w)*cmd.scale);} }
          else if(cmd.w||cmd.h){ if(cmd.w)o.w=cmd.w; if(cmd.h)o.h=cmd.h; }
          applied++; log.push('tamaño ajustado');
        }
      }
      else if(action==='move'||action==='setposition'||action==='position'){
        const o=findTarget(cmd.target);
        if(o){
          if(cmd.x!=null) o.x=Math.max(0,Math.min(cmd.x,W));
          if(cmd.y!=null) o.y=Math.max(0,Math.min(cmd.y,H));
          // Movimientos relativos por dirección
          if(cmd.direction){
            const step=cmd.amount||60;
            const d=cmd.direction.toLowerCase();
            if(d.includes('arriba')||d.includes('up')) o.y-=step;
            if(d.includes('abajo')||d.includes('down')) o.y+=step;
            if(d.includes('izq')||d.includes('left')) o.x-=step;
            if(d.includes('der')||d.includes('right')) o.x+=step;
            if(d.includes('centro')||d.includes('center')){ o.x=Math.round(W/2-(o.w||100)/2); }
          }
          applied++; log.push('movido');
        }
      }
      else if(action==='align'){
        const o=findTarget(cmd.target);
        if(o){
          const a=(cmd.value||cmd.align||'center').toLowerCase();
          if(o.type==='text') o.align=a.includes('izq')||a.includes('left')?'left':a.includes('der')||a.includes('right')?'right':'center';
          if(a.includes('centro')||a.includes('center')){ o.x=Math.round(W/2-(o.w||100)/2); }
          applied++; log.push('alineado');
        }
      }
      else if(action==='setopacity'||action==='opacity'){
        const o=findTarget(cmd.target); if(o){ o.opacity=Math.max(0,Math.min(1,(cmd.value??cmd.opacity??100)/100)); applied++; log.push('opacidad'); }
      }
      else if(action==='setstyle'||action==='style'){
        const o=findTarget(cmd.target);
        if(o){
          if(cmd.bold!=null) o.bold=!!cmd.bold;
          if(cmd.italic!=null) o.italic=!!cmd.italic;
          if(cmd.uppercase!=null) o.uppercase=!!cmd.uppercase;
          applied++; log.push('estilo');
        }
      }
      else if(action==='delete'||action==='remove'){
        const o=findTarget(cmd.target); if(o){ objects=objects.filter(x=>x.id!==o.id); applied++; log.push('eliminado'); }
      }
      else if(action==='duplicate'||action==='clone'){
        const o=findTarget(cmd.target);
        if(o){ const clone={...o,id:'ai_dup_'+Date.now(),x:o.x+40,y:o.y+40,zIndex:objects.length+2}; objects.push(clone); applied++; log.push('duplicado'); }
      }
      else if(action==='addtext'){
        objects.push({id:'ai_txt_'+Date.now(),type:'text',text:cmd.text||'Nuevo texto',fontId:cmd.font||'playfair',fontSize:cmd.fontSize||48,color:cmd.color||'#1A0E06',align:cmd.align||'center',bold:!!cmd.bold,italic:!!cmd.italic,uppercase:!!cmd.uppercase,x:cmd.x??Math.round(W*0.1),y:cmd.y??Math.round(H*0.4),w:cmd.w||Math.round(W*0.8),h:(cmd.fontSize||48)*2.5,rotation:0,opacity:1,zIndex:objects.length+2,visible:true});
        applied++; log.push('texto agregado');
      }
      else if(action==='setbackground'||action==='background'){
        if(cmd.color){ customBgColor=cmd.color; themeIdx=0; applyBackground(); applied++; log.push('fondo'); }
        else if(cmd.themeIdx!=null){ themeIdx=cmd.themeIdx; applyBackground(); applied++; log.push('tema'); }
      }
    }catch(e){ /* comando individual falló, continuar */ }
  }

  renderObjects();
  renderLayersPanel();
  return {ok:applied>0, count:applied, msg:log.join(', ')};
}

