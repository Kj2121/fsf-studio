  for(let i=0;i<256;i++){
    const x=i/255; let j=0; while(j<n-2&&x>xs[j+1]) j++;
    const h=dx[j], u=Math.max(0,Math.min(1,(x-xs[j])/h)), u2=u*u, u3=u2*u;
    const y=(2*u3-3*u2+1)*ys[j]+(u3-2*u2+u)*h*t[j]+(-2*u3+3*u2)*ys[j+1]+(u3-u2)*h*t[j+1];
    L[i]=y<0?0:y>1?1:y;
  }
