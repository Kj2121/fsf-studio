// Build clip path for imgZone in canvas export
function _applyImgMaskPath(ctx, obj) {
  const {x, y, w, h} = obj;
  const bh = h || w;
  if(obj.maskShape) {
    const cx = x+w/2, cy = y+bh/2;
    switch(obj.maskShape) {
      case 'triangle':
        ctx.moveTo(cx, y); ctx.lineTo(x+w, y+bh); ctx.lineTo(x, y+bh); ctx.closePath(); break;
      case 'diamond':
