  '0px 2px 12px rgba(0,0,0,0.9), 0px 0px 4px rgba(0,0,0,1)',
];
const STROKE_PRESETS = [
  null,
  {w:'1px', c:'#000000'},
  {w:'2px', c:'#000000'},
