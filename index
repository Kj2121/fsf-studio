// ── Canvas FX helpers ─────────────────────────────────────

// Capture an element's visual content into a canvas
// Works for shapes (fillColor), imgZone (background-image), text (color)
function _fxCaptureEl(el, obj, W, H, callback) {
  var cv = document.createElement('canvas');
  cv.width = W; cv.height = H;
  var ctx = cv.getContext('2d');

  // 1. Fill background with element's dominant color
  var fillColor = '#888888';
  if (obj.type === 'shape')   fillColor = obj.fillColor || '#7C5BF0';
  else if (obj.type === 'text') fillColor = obj.color   || '#ffffff';
  ctx.fillStyle = fillColor;
  ctx.fillRect(0, 0, W, H);

  // 2. If imgZone with a loaded image, draw it on top
  if (obj.type === 'imgZone' && obj.imgSrc) {
    var img = new Image();
    img.crossOrigin = 'anonymous';
    img.onload  = function(){ ctx.drawImage(img, 0, 0, W, H); callback(cv); };
    img.onerror = function(){ callback(cv); };
    img.src = obj.imgSrc;
    return;
  }
  callback(cv);
}

// Bayer 8×8 ordered dither → canvas overlay pinned over element
function _fxHalftoneRender(el, srcCanvas, W, H, cell, BAYER8, invert, obj) {
  var src = srcCanvas.getContext('2d').getImageData(0, 0, W, H).data;
  var out = document.createElement('canvas');
  out.width = W; out.height = H;
  var od = out.getContext('2d').createImageData(W, H);
  var d  = od.data;

  for (var y = 0; y < H; y++) {
    for (var x = 0; x < W; x++) {
      var i = (y * W + x) * 4;
      var lum = src[i]*0.299 + src[i+1]*0.587 + src[i+2]*0.114;
      var bx  = Math.floor((x % cell) / cell * 8) % 8;
      var by  = Math.floor((y % cell) / cell * 8) % 8;
      var thr = (BAYER8[by*8+bx] / 63) * 255;
      var ink = invert ? (lum > thr) : (lum < thr);
      var val = ink ? 0 : 255;
      d[i] = d[i+1] = d[i+2] = val;
      d[i+3] = 255;
    }
  }
  out.getContext('2d').putImageData(od, 0, 0);

  // Pin canvas overlay over element
  out.className = '_fxht_cv';
  out.style.cssText = 'position:absolute;inset:0;width:100%;height:100%;border-radius:inherit;pointer-events:none;z-index:20;';
  el.style.position = 'relative';
  el.appendChild(out);
}

// Duotone LUT → canvas overlay pinned over element
function _fxDuotoneRender(el, srcCanvas, W, H, c1, c2, obj) {
  var src = srcCanvas.getContext('2d').getImageData(0, 0, W, H).data;
  var out = document.createElement('canvas');
  out.width = W; out.height = H;
  var od  = out.getContext('2d').createImageData(W, H);
  var d   = od.data;

  // Build LUT
  var lutR = new Uint8Array(256);
  var lutG = new Uint8Array(256);
  var lutB = new Uint8Array(256);
  for (var i = 0; i < 256; i++) {
    var t = i / 255;
    lutR[i] = Math.round(c1[0] + (c2[0]-c1[0]) * t);
    lutG[i] = Math.round(c1[1] + (c2[1]-c1[1]) * t);
    lutB[i] = Math.round(c1[2] + (c2[2]-c1[2]) * t);
  }

  for (var j = 0; j < src.length; j += 4) {
    var lum = Math.round(src[j]*0.299 + src[j+1]*0.587 + src[j+2]*0.114);
    d[j]   = lutR[lum];
    d[j+1] = lutG[lum];
    d[j+2] = lutB[lum];
    d[j+3] = 255;
  }
  out.getContext('2d').putImageData(od, 0, 0);

  out.className = '_fxdt_cv';
  out.style.cssText = 'position:absolute;inset:0;width:100%;height:100%;border-radius:inherit;pointer-events:none;z-index:20;';
  el.style.position = 'relative';
  el.appendChild(out);
}

function _fxBS(el,id,val){ if(!el._fxS)el._fxS={}; el._fxS[id]=val; el.style.boxShadow=Object.values(el._fxS).filter(Boolean).join(', '); }
function _fxRBS(el,id){ if(!el._fxS)return; delete el._fxS[id]; el.style.boxShadow=Object.values(el._fxS).filter(Boolean).join(', ')||''; }
// ── Filter merge system — like boxShadow but for CSS filter ──
function _fxBF(el,id,val){ if(!el._fxF)el._fxF={}; el._fxF[id]=val; el.style.filter=Object.values(el._fxF).filter(Boolean).join(' ')||''; }
function _fxRBF(el,id){ if(!el._fxF)return; delete el._fxF[id]; el.style.filter=Object.values(el._fxF).filter(Boolean).join(' ')||''; }
function _fxGet(obj){ return obj._fx||(obj._fx={}); }
function _fxApplyAll(el,obj){ el._fxS={}; el._fxF={}; FX_DEFS.forEach(function(def){ var p=_fxGet(obj)[def.id]; if(p&&p.active)def.apply(el,obj,p); else def.clear(el,obj); }); }

