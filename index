.lottie-name{font-size:8px;font-weight:700;color:rgba(255,255,255,0.4);font-family:var(--ui-font);text-align:center;letter-spacing:.3px;padding:0 4px;}
.lottie-cat{background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.08);border-radius:20px;padding:4px 11px;font-size:9px;font-weight:700;color:rgba(255,255,255,0.4);cursor:pointer;font-family:var(--ui-font);transition:all .15s;white-space:nowrap;}
