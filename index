function _aiAddMsg(role,text,designIdx){
  const chat=document.getElementById('ai-chat');if(!chat)return;
  const empty=document.getElementById('ai-chat-empty');if(empty)empty.style.display='none';

  const wrap=document.createElement('div');
  wrap.className='ai-msg-wrap';
  wrap.style.cssText='display:flex;gap:10px;align-items:flex-end;'+(role==='user'?'flex-direction:row-reverse;':'');

  // Avatar
  const av=document.createElement('div');
  av.style.cssText=role==='user'
    ?'width:30px;height:30px;border-radius:50%;background:rgba(30,123,255,0.12);border:1px solid rgba(30,123,255,0.22);display:flex;align-items:center;justify-content:center;flex-shrink:0;'
    :'width:30px;height:30px;border-radius:50%;background:linear-gradient(135deg,#9B7EF5,#4A2DD4);display:flex;align-items:center;justify-content:center;flex-shrink:0;box-shadow:0 2px 8px rgba(30,123,255,0.2);';
  av.innerHTML=role==='user'
    ?'<svg viewBox="0 0 24 24" fill="none" stroke="rgba(30,123,255,0.8)" stroke-width="2" width="14" height="14"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/></svg>'
    :'<svg viewBox="0 0 24 24" fill="none" width="14" height="14"><path d="M12 2l2.4 7.4H22l-6.2 4.5 2.4 7.4L12 17l-6.2 4.3 2.4-7.4L2 9.4h7.6z" fill="#1a0900"/></svg>';

  const col=document.createElement('div');
  col.style.cssText='display:flex;flex-direction:column;gap:5px;align-items:'+(role==='user'?'flex-end':'flex-start')+';';

  const bubble=document.createElement('div');
  bubble.className=role==='user'?'ai-bubble-user':'ai-bubble-ai';
  if(role==='assistant'){
    bubble.innerHTML=text
      .replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
      .replace(/\*\*(.+?)\*\*/g,'<strong style="color:rgba(255,255,255,0.95);">$1</strong>')
      .replace(/\*(.+?)\*/g,'<em>$1</em>')
      .replace(/^[-•]\s(.+)$/gm,'<div style="display:flex;gap:6px;margin:2px 0;"><span style="color:var(--gold);flex-shrink:0;">✦</span><span>$1</span></div>')
      .replace(/\n/g,'<br>');
  } else {
    bubble.textContent=text;
  }
  col.appendChild(bubble);

  // Design preview card with real canvas render
  if(designIdx!=null){
    const design=_aiChatHistory[designIdx]?.design;
    const card=document.createElement('div');
    card.className='ai-design-card';

    // Render mini preview using canvas
    const previewDiv=document.createElement('div');
    previewDiv.className='ai-design-card-preview';
    if(design){
      const cv=document.createElement('canvas');
      const SIZE=180;
      const F=FMTS[design.fmt||'square']||FMTS.square;
      cv.width=SIZE; cv.height=Math.round(F.H/F.W*SIZE);
      cv.style.cssText='width:100%;height:100%;object-fit:cover;display:block;';
      const ctx=cv.getContext('2d');
      // Background
      const th=THEMES[design.themeIdx||1]||THEMES[1];
      if(th.g&&th.g!=='transparent'){
        try{drawCSSGradient(ctx,th.g,cv.width,cv.height);}
        catch(e){ctx.fillStyle='#1a0f06';ctx.fillRect(0,0,cv.width,cv.height);}
      } else {ctx.fillStyle='#fff';ctx.fillRect(0,0,cv.width,cv.height);}
      const sc=SIZE/F.W;
      // Draw text objects
      (design.objects||[]).filter(o=>o.type==='text'&&o.visible!==false).slice(0,5).forEach(o=>{
        const fs=Math.max(3,o.fontSize*sc);
        ctx.save();
        ctx.font=`${o.italic?'italic ':''}${o.bold?'bold ':''}${fs}px sans-serif`;
        ctx.fillStyle=o.color||'#fff';
        ctx.globalAlpha=o.opacity??0.92;
        ctx.textAlign=o.align==='center'?'center':o.align==='right'?'right':'left';
        ctx.textBaseline='top';
        ctx.shadowColor='rgba(0,0,0,0.6)';ctx.shadowBlur=2;
        const ax=o.align==='center'?(o.x+o.w/2)*sc:o.align==='right'?(o.x+o.w)*sc:o.x*sc;
        (o.text||'').split('\n').slice(0,3).forEach((line,i)=>{
          ctx.fillText((o.uppercase?line.toUpperCase():line).substring(0,28),ax,o.y*sc+i*fs*1.3,o.w*sc);
        });
        ctx.restore();
      });
      previewDiv.appendChild(cv);
    } else {
      previewDiv.style.background='linear-gradient(135deg,#0A0F1C,#141D33)';
    }
    card.appendChild(previewDiv);

    const footer=document.createElement('div');
    footer.className='ai-design-card-footer';
    footer.innerHTML=`<span style="font-size:10px;color:rgba(255,255,255,0.35);font-family:var(--ui-font);">✦ Diseño generado</span><button class="ai-apply-btn" onclick="_aiApplyDesign(${designIdx})">Aplicar →</button>`;
    card.appendChild(footer);
    col.appendChild(card);

    // Update contextual suggestions after design is shown
    setTimeout(()=>_aiUpdateSuggestions(design), 100);
  }

  wrap.appendChild(av);
  wrap.appendChild(col);
  chat.appendChild(wrap);
  chat.scrollTop=chat.scrollHeight;
}

// Contextual suggestions based on current design
function _aiUpdateSuggestions(design){
  const empty=document.getElementById('ai-chat-empty');
  if(empty&&empty.style.display!=='none') return; // only update after chat started
  // Show contextual pills after first design
  const existing=document.getElementById('ai-ctx-pills');
  if(existing)existing.remove();
  const th=THEMES[design?.themeIdx||1]||THEMES[1];
  const isDark=design?.themeIdx>0&&design?.themeIdx!==2&&design?.themeIdx!==5&&design?.themeIdx!==7;
  const fmt=design?.fmt||'square';
  const pills=[
    isDark?'💡 Versión clara':'🌑 Versión oscura',
    '✏️ Cambia el versículo',
    fmt==='square'?'📱 Convertir a Historia':'⬛ Convertir a Post',
    '🎨 Otro color de fondo',
    '✦ Hazlo más elegante',
    '📝 Añade un hashtag',
  ];
  const wrap=document.createElement('div');
  wrap.id='ai-ctx-pills';
  wrap.style.cssText='display:flex;flex-wrap:wrap;gap:6px;padding:4px 0;';
  pills.forEach(p=>{
    const el=document.createElement('span');
    el.className='ai-ex-pill';
    el.textContent=p;
    el.onclick=()=>aiPill(el);
    wrap.appendChild(el);
  });
  const chat=document.getElementById('ai-chat');
  if(chat){chat.appendChild(wrap);chat.scrollTop=chat.scrollHeight;}
}

