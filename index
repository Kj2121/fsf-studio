// TEMPLATE PREVIEW SVG RENDERER
const _tplPreviewCache = {};
const _tplThumbQueue = [];
let _tplThumbRunning = false;

async function _renderTplThumb(t) {
  const SIZE = 320;
  const F = FMTS[t.fmt] || FMTS.square;
  const W = F.W, H = F.H;
  const scale = SIZE / W;
  const cW = SIZE, cH = Math.round(H * scale);

  const cv = document.createElement('canvas');
  cv.width = cW; cv.height = cH;
  const ctx = cv.getContext('2d');

  // 1. Check if any deco covers the full canvas (has its own background)
  const hasFullDeco = !t.customBg && t.objects.some(o => o.type==='deco' && o.decoSvg && o.x===0 && o.y===0 && o.w===W);

  // 2. If no full-canvas deco, paint theme gradient as base
  const th = THEMES[t.themeIdx] || THEMES[0];
  if (t.customBg) {
    ctx.fillStyle = t.customBg; ctx.fillRect(0, 0, cW, cH);
  } else if (!hasFullDeco) {
    if (th.g && th.g !== 'transparent') {
      drawCSSGradient(ctx, th.g, cW, cH);
    } else {
      ctx.fillStyle = '#ffffff';
      ctx.fillRect(0, 0, cW, cH);
    }
  }

  // 2b. imgZone placeholders (bajo las decoraciones)
  t.objects.filter(o => o.type === 'imgZone').forEach(o => {
    const x=o.x*scale, y=o.y*scale, w=o.w*scale, h=(o.h||o.w)*scale;
    ctx.save();
    ctx.fillStyle = 'rgba(140,140,140,0.30)';
    ctx.strokeStyle = 'rgba(140,140,140,0.65)';
    ctx.lineWidth = 0.5;
    ctx.setLineDash([3, 2]);
    const r = o.radius ? Math.min(o.radius*scale, Math.min(w,h)/2) : 4;
    ctx.beginPath();
    if (ctx.roundRect) ctx.roundRect(x, y, w, h, r);
    else ctx.rect(x, y, w, h);
    ctx.fill(); ctx.stroke();
    ctx.restore();
    ctx.font = `${Math.max(8, w*0.18)}px sans-serif`;
    ctx.fillStyle = 'rgba(255,255,255,0.75)';
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';
    ctx.fillText('📷', x+w/2, y+h/2);
  });

  // 3. Draw deco SVGs — use blob URL for reliable rendering
  const decos = t.objects.filter(o => o.type === 'deco' && o.decoSvg);
  for (const deco of decos) {
    try {
      const svgStr = deco.decoSvg;
      const blobUrl = URL.createObjectURL(new Blob([svgStr], {type:'image/svg+xml'}));
      await new Promise(resolve => {
        const img = new Image();
        const cleanup = () => { URL.revokeObjectURL(blobUrl); resolve(); };
        img.onload = () => {
          try {
            ctx.save();
            ctx.globalAlpha = deco.opacity ?? 1;
            const dx = deco.x * scale, dy = deco.y * scale;
            const dw = deco.w * scale, dh = (deco.h || deco.w) * scale;
            ctx.drawImage(img, dx, dy, dw, dh);
            ctx.restore();
          } catch(e) {}
          cleanup();
        };
        img.onerror = cleanup;
        img.src = blobUrl;
        setTimeout(cleanup, 500);
      });
    } catch(e) {}
  }

  // 4. Overlay tint
  if (t.overlayOpacity > 0) {
    const ov = (th.ov||'20,10,4').split(',').map(Number);
    ctx.fillStyle = `rgba(${ov[0]},${ov[1]},${ov[2]},${t.overlayOpacity})`;
    ctx.fillRect(0, 0, cW, cH);
  }

  // 6. Text objects (fuente real, interlineado, saltos y espaciado)
  t.objects.filter(o => o.type === 'text' && o.visible !== false).forEach(o => {
    const fs = Math.max(4, o.fontSize * scale);
    const fam = (FONTS.find(f=>f.id===o.fontId)||{}).family || 'sans-serif';
    ctx.save();
    ctx.font = `${o.italic?'italic ':''}${o.bold?'700 ':'400 '}${fs}px ${fam}`;
    ctx.fillStyle = o.color || '#fff';
    ctx.globalAlpha = o.opacity ?? 1;
    ctx.textAlign = o.align==='center'?'center':o.align==='right'?'right':'left';
    ctx.textBaseline = 'top';
    try{ ctx.letterSpacing = o.letterSpacing ? (parseFloat(o.letterSpacing)*scale)+'px' : '0px'; }catch(e){}
    const maxW = o.w*scale, lh = fs*1.4, maxLines = Math.max(1, Math.floor((o.h*scale)/lh + 0.35));
    const ax = o.align==='center' ? (o.x+o.w/2)*scale : o.align==='right' ? (o.x+o.w)*scale : o.x*scale;
    const lines=[];
    (o.text||'').split('\n').forEach(par=>{
      const p = o.uppercase ? par.toUpperCase() : par;
      let cur='';
      p.split(' ').forEach(wd=>{
        const test = cur ? cur+' '+wd : wd;
        if(cur && ctx.measureText(test).width > maxW){ lines.push(cur); cur=wd; } else cur=test;
      });
      lines.push(cur);
    });
    lines.slice(0,maxLines).forEach((line,i)=> ctx.fillText(line, ax, o.y*scale + i*lh));
    ctx.restore();
  });

  return cv.toDataURL('image/jpeg', 0.85);
}

function tplPreviewHTML(t) {
  if (_tplPreviewCache[t.id]) return _tplPreviewCache[t.id];

  const F = FMTS[t.fmt] || FMTS.square;
  const aspect = F.H / F.W;
  const th = THEMES[t.themeIdx] || THEMES[0];
  const gm = th.g.match(/#[0-9a-fA-F]{3,6}/g) || ['#1a0f06','#2C1A0E'];
  const c1 = gm[0]||'#1a0f06';

  const placeholder = `<div id="tpl_prev_${t.id}" style="position:relative;width:100%;padding-top:${Math.round(aspect*100)}%;background:linear-gradient(145deg,${c1}cc,#00000088);overflow:hidden;">
    <div style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;">
      <div style="width:16px;height:16px;border:2px solid rgba(30,123,255,0.3);border-top-color:#1E7BFF;border-radius:50%;animation:tplSpin .8s linear infinite;"></div>
    </div>
  </div>`;

  // Queue async render
  _tplThumbQueue.push(t);
  if (!_tplThumbRunning) _processTplQueue();

  _tplPreviewCache[t.id] = placeholder;
  return placeholder;
}

async function _processTplQueue() {
  _tplThumbRunning = true;
  while (_tplThumbQueue.length > 0) {
    const t = _tplThumbQueue.shift();
    try {
      const dataUrl = await _renderTplThumb(t);
      const F = FMTS[t.fmt] || FMTS.square;
      const aspect = F.H / F.W;
      const html = `<div style="position:relative;width:100%;padding-top:${Math.round(aspect*100)}%;overflow:hidden;">
        <img src="${dataUrl}" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block;"/>
      </div>`;
      _tplPreviewCache[t.id] = html;
      // Clear card cache so next render uses real image
      delete _tplCardCache.desk[t.id];
      delete _tplCardCache.mob[t.id];
      // Update all visible placeholder divs in the DOM
      document.querySelectorAll(`#tpl_prev_${t.id}`).forEach(el => {
        const tmp = document.createElement('div');
        tmp.innerHTML = html;
        el.replaceWith(tmp.firstElementChild);
      });
    } catch(e) { console.warn('thumb', t.id, e); }
  }
  _tplThumbRunning = false;
}



