    setTimeout(() => {
      if (_deferredInstall && !window.matchMedia('(display-mode: standalone)').matches) {
        _fsfShowInstallBanner();
      }
    }, 3000);
  });

  window.addEventListener('appinstalled', () => {
    _deferredInstall = null;
    const banner = document.getElementById('fsf-install-banner');
    if (banner) banner.remove();
    if (typeof showUndoToast === 'function') showUndoToast('✦ FSF Studio instalada en tu dispositivo');
  });

  function _fsfShowInstallBanner() {
    if (document.getElementById('fsf-install-banner')) return;
    const banner = document.createElement('div');
    banner.id = 'fsf-install-banner';
    banner.style.cssText = 'position:fixed;bottom:76px;left:12px;right:12px;background:rgba(9,13,24,0.97);border:1px solid rgba(30,123,255,0.3);border-radius:20px;padding:14px 16px;z-index:9990;display:flex;align-items:center;gap:12px;box-shadow:0 8px 32px rgba(0,0,0,0.6);backdrop-filter:blur(20px);animation:drawerUp .3s ease;';
    banner.innerHTML = `
      <div style="width:40px;height:40px;border-radius:12px;background:linear-gradient(135deg,#5A9BFF,#1558D6);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
        <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" width="20" height="20"><rect x="9" y="2" width="6" height="20" rx="1.5"/><rect x="2" y="9" width="20" height="6" rx="1.5"/></svg>
      </div>
      <div style="flex:1;min-width:0;">
        <div style="font-size:12px;font-weight:800;color:rgba(235,242,255,0.95);font-family:var(--ui-font,sans-serif);">Instalar FSF Studio</div>
        <div style="font-size:10px;color:rgba(235,242,255,0.4);font-family:var(--ui-font,sans-serif);margin-top:1px;">Acceso rápido · Funciona sin internet</div>
      </div>
      <button onclick="_fsfInstallApp()" style="background:linear-gradient(135deg,#8B6CF5,#4A2DD4);border:none;border-radius:12px;padding:8px 14px;color:#fff;font-size:11px;font-weight:800;font-family:var(--ui-font,sans-serif);cursor:pointer;white-space:nowrap;box-shadow:0 4px 14px rgba(30,123,255,0.4);">Instalar</button>
      <button onclick="this.parentElement.remove()" style="width:28px;height:28px;border-radius:50%;background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.08);cursor:pointer;display:flex;align-items:center;justify-content:center;flex-shrink:0;color:rgba(255,255,255,0.3);font-size:14px;">✕</button>
    `;
    document.body.appendChild(banner);
  }

  window._fsfInstallApp = function() {
    if (!_deferredInstall) return;
    _deferredInstall.prompt();
    _deferredInstall.userChoice.then(choice => {
      if (choice.outcome === 'accepted') {
        const banner = document.getElementById('fsf-install-banner');
        if (banner) banner.remove();
      }
      _deferredInstall = null;
    });
  };

  function _fsfShowUpdateToast() {
    const el = document.createElement('div');
    el.style.cssText = 'position:fixed;top:62px;left:50%;transform:translateX(-50%);background:rgba(9,13,24,0.97);border:1px solid rgba(30,123,255,0.3);border-radius:20px;padding:10px 18px;font-size:11px;font-weight:600;color:rgba(125,176,255,0.9);font-family:var(--ui-font,sans-serif);z-index:9999;display:flex;align-items:center;gap:10px;box-shadow:0 4px 20px rgba(0,0,0,0.5);cursor:pointer;';
    el.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="13" height="13"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg> Nueva versión disponible — toca para actualizar';
    el.onclick = () => { navigator.serviceWorker.controller?.postMessage('skipWaiting'); location.reload(); };
    document.body.appendChild(el);
    setTimeout(() => el.remove(), 8000);
  }

})();
