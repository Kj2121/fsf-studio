    if(!resp.ok){const e=await resp.json().catch(()=>({}));throw new Error(e.error?.message||'Gemini '+resp.status);}
    const data=await resp.json();
    return data.candidates?.[0]?.content?.parts?.map(p=>p.text||'').join('')||'';
  }
  // Claude (Anthropic)
  const resp=await fetch('https://api.anthropic.com/v1/messages',{method:'POST',headers:{'Content-Type':'application/json','anthropic-version':'2023-06-01','anthropic-dangerous-direct-browser-access':'true','x-api-key':apiKey},body:JSON.stringify({model:'claude-sonnet-4-20250514',max_tokens:6000,system,messages})});
  if(!resp.ok){const e=await resp.json().catch(()=>({}));throw new Error(e.error?.message||'API '+resp.status);}
  return (await resp.json()).content?.find(b=>b.type==='text')?.text||'';
}

// ── PERSONAL DESIGN EXAMPLES (few-shot learning) ──
const _AI_PERSONAL_KEY = 'fsf_personal_examples';
const _AI_PERSONAL_MAX = 5;

function _aiGetPersonalExamples(){
  try{ return JSON.parse(_storage.get(_AI_PERSONAL_KEY)||'[]'); }catch(e){ return []; }
}

function _aiSavePersonalExample(design, label){
  const examples = _aiGetPersonalExamples();
  // Avoid duplicates by message
  const exists = examples.some(e=>e.message===design.message);
  if(exists){ showUndoToast('⭐ Ya está guardado como referencia'); return; }
  // Keep only last MAX examples
  const entry = {
    label: label || design.message || 'Diseño personalizado',
    savedAt: new Date().toLocaleDateString('es'),
    design: {fmt:design.fmt,themeIdx:design.themeIdx,overlayOpacity:design.overlayOpacity||0,message:design.message,objects:design.objects}
  };
  examples.unshift(entry);
  if(examples.length > _AI_PERSONAL_MAX) examples.pop();
  _storage.set(_AI_PERSONAL_KEY, JSON.stringify(examples));
  fsfLearnStarred();
  showUndoToast('⭐ Guardado como referencia — la IA aprenderá de este estilo');
}

function _aiDeletePersonalExample(idx){
  const examples = _aiGetPersonalExamples();
  examples.splice(idx, 1);
  _storage.set(_AI_PERSONAL_KEY, JSON.stringify(examples));
}

function _aiPersonalExamplesBlock(){
  const examples = _aiGetPersonalExamples();
  if(!examples.length) return '';
  const block = examples.map((e,i)=>
    `EJEMPLO PERSONAL ${i+1} — "${e.label}" (guardado el ${e.savedAt})\n${JSON.stringify(e.design)}`
  ).join('\n\n');
  return `\n\n════════════════════════════════════════\nEJEMPLOS PERSONALES DE ${examples.length === 1 ? 'KENETH' : 'TU ESTILO'} — MÁXIMA PRIORIDAD\n════════════════════════════════════════\nEstos diseños fueron aprobados por el usuario. Su estilo, paleta y composición son la referencia principal. Imítalos fielmente:\n\n${block}\n\nIMPORTANTE: Los ejemplos personales tienen prioridad sobre los ejemplos genéricos anteriores.`;
}

