  }

  // Estilos disponibles que la IA puede elegir
  const ESTILOS = 'ticket, polaroid, editorial, magazine, cine, quote, diagonal, story, promesa, boldtype';

  const systemPrompt = `Eres un diseñador experto de posts devocionales cristianos para la marca "Fe Sin Fronteras".
Paleta de marca: crema #F5EFE3, naranja quemado #C8591A, verde oliva #2D3D22, tinta oscura #1A0E06.

