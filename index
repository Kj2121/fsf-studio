  if(!imgL){imgL=document.createElement('div');imgL.id='bg-img-layer';imgL.style.cssText='position:absolute;inset:0;z-index:1;background-size:cover;background-position:center;background-repeat:no-repeat;pointer-events:none;';bg.insertBefore(imgL,bg.firstChild);}
  if(!ovL){ovL=document.createElement('div');ovL.id='bg-ov-layer';ovL.style.cssText='position:absolute;inset:0;z-index:2;pointer-events:none;';bg.insertBefore(ovL,bg.firstChild);}
  const t=customBgColor||null;
  const th=THEMES[themeIdx]||THEMES[0];
  const bgStyle=t?`linear-gradient(145deg,${t},${adjustBrightness(t,-30)},${adjustBrightness(t,-55)})`:th.g;
  if(_customGradient)base.style.background=_customGradient;
  else if(t)base.style.background=bgStyle;
  else if(th.g&&th.g!=='transparent')base.style.background=th.g;
  else base.style.background='none';
  const posMap={center:'center center',top:'center top',bottom:'center bottom',left:'left center',right:'right center','top-left':'left top','top-right':'right top','bottom-left':'left bottom','bottom-right':'right bottom'};
  if(bgImgSrc&&!_customGradient){imgL.style.backgroundImage=`url('${bgImgSrc}')`;imgL.style.backgroundPosition=posMap[bgImgPos]||'center';imgL.style.filter=`brightness(${bgFilters.brightness}%) contrast(${bgFilters.contrast}%) saturate(${bgFilters.saturate}%) grayscale(${bgFilters.grayscale}%)`;}
  else{imgL.style.backgroundImage='none';imgL.style.filter='none';}
  if(_customGradient||(!bgImgSrc&&(th.g==='transparent'||!th.g)))ovL.style.background='none';
  else{const ov=th.ov||'20,10,4';ovL.style.background=`rgba(${ov},${overlayOpacity})`;}

  // If custom color, update background rect in full-canvas deco SVGs
  const {W,H}=getFmtSize();
  bg.querySelectorAll('.cv-el').forEach(el=>{
    const id=el.dataset.id;
