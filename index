<script>
/* ══ PDF VIEWER — powered by PDF.js ══ */
let _pdfDoc = null;
let _pdfPage = 1;
let _pdfZoom = 1.0;
let _pdfUrl = null;
let _pdfRendering = false;

// Load PDF.js from CDN on demand
async function _loadPdfJs() {
  if (window.pdfjsLib) return true;
  return new Promise((res) => {
    const script = document.createElement('script');
    script.src = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js';
    script.onload = () => {
      window.pdfjsLib.GlobalWorkerOptions.workerSrc =
        'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
      res(true);
    };
    script.onerror = () => res(false);
    document.head.appendChild(script);
  });
}

async function openPdfViewer(input) {
  const file = input.files[0];
  if (!file) return;
  input.value = ''; // reset so same file can be reopened

  // Show modal immediately
  const modal = document.getElementById('pdf-modal');
  modal.style.display = 'flex';
  document.getElementById('pdf-loading').style.display = 'flex';
  document.getElementById('pdf-filename').textContent = file.name;

  // Load PDF.js
  const ok = await _loadPdfJs();
  if (!ok) {
    alert('No se pudo cargar el lector de PDF. Verifica tu conexión a internet.');
    modal.style.display = 'none';
    return;
  }

  // Read file
  const arrayBuffer = await file.arrayBuffer();

  try {
    _pdfDoc = await pdfjsLib.getDocument({ data: arrayBuffer }).promise;
    _pdfPage = 1;
    document.getElementById('pdf-page-total').textContent = _pdfDoc.numPages;
    _pdfUrl = URL.createObjectURL(file); // for printing
    await _renderPdfPage();
  } catch(e) {
    alert('Error al abrir el PDF: ' + e.message);
    modal.style.display = 'none';
  }

  document.getElementById('pdf-loading').style.display = 'none';
}

async function _renderPdfPage() {
  if (!_pdfDoc || _pdfRendering) return;
  _pdfRendering = true;
  document.getElementById('pdf-loading').style.display = 'flex';

  try {
    const page = await _pdfDoc.getPage(_pdfPage);
    const viewport = page.getViewport({ scale: _pdfZoom * (window.devicePixelRatio || 1) });

    const canvas = document.getElementById('pdf-canvas');
    const ctx = canvas.getContext('2d');
    canvas.width  = viewport.width;
    canvas.height = viewport.height;
    canvas.style.width  = (viewport.width  / (window.devicePixelRatio || 1)) + 'px';
    canvas.style.height = (viewport.height / (window.devicePixelRatio || 1)) + 'px';

    await page.render({ canvasContext: ctx, viewport }).promise;

    // Update UI
    document.getElementById('pdf-page-num').textContent = _pdfPage;
    document.getElementById('pdf-zoom-lbl').textContent = Math.round(_pdfZoom * 100) + '%';
    document.getElementById('pdf-prev').disabled = _pdfPage <= 1;
    document.getElementById('pdf-next').disabled = _pdfPage >= _pdfDoc.numPages;
    document.getElementById('pdf-prev').style.opacity = _pdfPage <= 1 ? '0.35' : '1';
    document.getElementById('pdf-next').style.opacity = _pdfPage >= _pdfDoc.numPages ? '0.35' : '1';

    // Scroll to top on page change
    document.getElementById('pdf-canvas-wrap').scrollTop = 0;
  } catch(e) {
    console.error('PDF render error:', e);
  }

  document.getElementById('pdf-loading').style.display = 'none';
  _pdfRendering = false;
}

async function pdfPage(delta) {
  if (!_pdfDoc) return;
  const newPage = _pdfPage + delta;
  if (newPage < 1 || newPage > _pdfDoc.numPages) return;
  _pdfPage = newPage;
  await _renderPdfPage();
}

async function pdfZoom(delta) {
  _pdfZoom = Math.min(4, Math.max(0.5, _pdfZoom + delta));
  await _renderPdfPage();
}

function closePdfViewer() {
  document.getElementById('pdf-modal').style.display = 'none';
  if (_pdfUrl) { URL.revokeObjectURL(_pdfUrl); _pdfUrl = null; }
  _pdfDoc = null;
}

function printPdf() {
  if (!_pdfUrl) return;
  // Use iframe print — most reliable cross-browser approach
  const frame = document.getElementById('pdf-print-frame');
  frame.src = _pdfUrl;
  frame.onload = () => {
    try {
      frame.contentWindow.focus();
      frame.contentWindow.print();
    } catch(e) {
      // Fallback: open in new tab and print from there
      const tab = window.open(_pdfUrl, '_blank');
      if (tab) setTimeout(() => tab.print(), 800);
    }
  };
}

// Keyboard navigation inside PDF viewer
document.addEventListener('keydown', e => {
  const modal = document.getElementById('pdf-modal');
  if (modal.style.display === 'none') return;
  if (e.key === 'ArrowRight' || e.key === 'ArrowDown') pdfPage(1);
  if (e.key === 'ArrowLeft'  || e.key === 'ArrowUp')   pdfPage(-1);
  if (e.key === 'Escape') closePdfViewer();
  if (e.key === '+' || e.key === '=') pdfZoom(0.25);
  if (e.key === '-') pdfZoom(-0.25);
});
</script>


