// CAPTURE — builds the image manually via Canvas 2D API
async function captureCanvas(W, H, scale) {
  const out = document.createElement('canvas');
  out.width  = Math.round(W * scale);
  out.height = Math.round(H * scale);
  const ctx = out.getContext('2d');
  ctx.scale(scale, scale);

  // 1) Background gradient or solid color
  const th = THEMES[themeIdx] || THEMES[0];
  const bgStyle = customBgColor
    ? 'linear-gradient(145deg,' + customBgColor + ',' + adjustBrightness(customBgColor,-30) + ',' + adjustBrightness(customBgColor,-55) + ')'
    : th.g;

  // Parse and draw the gradient
  await drawCSSGradient(ctx, bgStyle, W, H);

  // 2) Background image (if any)
  if (bgImgSrc) {
    await new Promise(resolve => {
      const img = new Image();
      img.crossOrigin = 'anonymous';
      const t = setTimeout(resolve, 8000); // never block forever
      img.onload = () => {
        clearTimeout(t);
        const f = bgFilters;
        ctx.filter = 'brightness(' + f.brightness + '%) contrast(' + f.contrast + '%) saturate(' + f.saturate + '%) grayscale(' + f.grayscale + '%)';
        const posMap = {center:[.5,.5],top:[.5,0],bottom:[.5,1],left:[0,.5],right:[1,.5],'top-left':[0,0],'top-right':[1,0],'bottom-left':[0,1],'bottom-right':[1,1]};
        const [px,py] = posMap[bgImgPos]||[.5,.5];
        const sw=img.naturalWidth, sh=img.naturalHeight;
        const scale2=Math.max(W/sw, H/sh);
        const dw=sw*scale2, dh=sh*scale2;
        const dx=(W-dw)*px, dy=(H-dh)*py;
        ctx.drawImage(img, dx, dy, dw, dh);
        ctx.filter = 'none';
        resolve();
      };
      img.onerror = () => { clearTimeout(t); resolve(); };
      img.src = bgImgSrc;
    });
  }

  // 3) Dark overlay
  const ovParts = (th.ov||'20,10,4').split(',').map(Number);
  ctx.fillStyle = 'rgba(' + ovParts[0] + ',' + ovParts[1] + ',' + ovParts[2] + ',' + (overlayOpacity||0) + ')';
  ctx.fillRect(0, 0, W, H);

  // 4) Text and sticker objects
  const sorted = [...objects].filter(o=>o.visible).sort((a,b)=>a.zIndex-b.zIndex);
  for (const obj of sorted) {
    ctx.save();
    ctx.globalAlpha = obj.opacity != null ? obj.opacity : 1;
    const cx = obj.x + obj.w/2;
    const cy = obj.y + (obj.h==='auto' ? obj.fontSize*1.4/2 : obj.h/2);
    ctx.translate(cx, cy);
    ctx.rotate((obj.rotation||0) * Math.PI/180);
    ctx.translate(-cx, -cy);

    if (obj.type === 'text') {
      const f = FONTS.find(ff=>ff.id===obj.fontId)||FONTS[0];
      // Strip CSS family quotes for canvas font
      const family = f.family.replace(/['"]/g,'');
      const style = ((obj.italic||obj.fontStyle==='italic')?'italic ':'') + ((obj.bold||obj.fontWeight==='700'||obj.fontWeight==='bold')?'bold ':'') + obj.fontSize + 'px ' + family;
      ctx.font = style;
      ctx.fillStyle = obj.color || '#fff';
      ctx.textAlign = obj.align || 'left';
      ctx.textBaseline = 'top';

      const text = obj.uppercase ? (obj.text||'').toUpperCase() : (obj.text||'');
      const lines = wrapTextCanvas(ctx, text, obj.w, obj.letterSpacing);
      const lineH = obj.fontSize * (obj.lineHeight||1.4);
      let startX = obj.x;
      if (obj.align==='center') startX = obj.x + obj.w/2;
      else if (obj.align==='right') startX = obj.x + obj.w;

      // Text shadow
      if(obj.textShadow){
        const sh = obj.textShadow;
        const parts = sh.match(/([-\d.]+)px\s+([-\d.]+)px\s+([-\d.]+)px\s+(rgba?\([^)]+\)|#\w+)/);
        if(parts){ ctx.shadowOffsetX=parseFloat(parts[1]); ctx.shadowOffsetY=parseFloat(parts[2]); ctx.shadowBlur=parseFloat(parts[3]); ctx.shadowColor=parts[4]; }
      }

      const ls = parseFloat(obj.letterSpacing)||0;
      lines.forEach((line, i) => {
        const y2 = obj.y + i*lineH + (lineH-obj.fontSize*1.4)/2;
        // Text stroke (webkit-text-stroke equivalent)
        if(obj.textStrokeW && obj.textStrokeC){
          ctx.strokeStyle = obj.textStrokeC;
          ctx.lineWidth = parseFloat(obj.textStrokeW)*2;
          ctx.lineJoin = 'round';
          if(ls>0){
            let xPos = obj.align==='center' ? startX - measureWithSpacing(ctx,line,ls)/2
                      : obj.align==='right'  ? startX - measureWithSpacing(ctx,line,ls)
                      : startX;
            for(const ch of line){ ctx.strokeText(ch,xPos,y2); xPos+=ctx.measureText(ch).width+ls; }
          } else { ctx.strokeText(line, startX, y2); }
        }
        if (ls > 0) {
          // Draw char by char for letter spacing
          let xPos = obj.align==='center' ? startX - measureWithSpacing(ctx,line,ls)/2
                    : obj.align==='right'  ? startX - measureWithSpacing(ctx,line,ls)
                    : startX;
          for (const ch of line) {
            ctx.fillText(ch, xPos, y2);
            xPos += ctx.measureText(ch).width + ls;
          }
        } else {
          ctx.fillText(line, startX, y2);
        }
      });
      ctx.shadowOffsetX=0; ctx.shadowOffsetY=0; ctx.shadowBlur=0; ctx.shadowColor='transparent';

    } else if (obj.type === 'imgZone') {
      const bw=obj.w, bh=obj.h||obj.w;
      if(obj.imgSrc){
        await new Promise(resolve=>{
          const img=new Image();
          img.crossOrigin='anonymous';
          const t=setTimeout(resolve,8000);
          img.onload=()=>{
            clearTimeout(t);
            const userScale=(obj.imgScale||100)/100;
            const sc2=Math.max(bw/img.naturalWidth,bh/img.naturalHeight)*userScale;
            const dw=img.naturalWidth*sc2, dh=img.naturalHeight*sc2;
            const ox=(obj.imgOffsetX??50)/100, oy=(obj.imgOffsetY??50)/100;
            const dx=obj.x-(dw-bw)*ox, dy=obj.y-(dh-bh)*oy;
            // Always clip to imgZone bounds (prevents overflow onto other zones)
            ctx.save();
            ctx.beginPath();
            if(obj.radius){ ctx.roundRect(obj.x,obj.y,bw,bh,obj.radius); }
            else if(obj.maskShape){ _applyImgMaskPath(ctx,obj); }
            else { ctx.rect(obj.x,obj.y,bw,bh); }
            ctx.clip();
            if(_fxActive(obj.fx)){ const _s=ctx.getTransform().a; ctx.drawImage(_fxRender(img,obj.fx,obj,Math.round(bw*_s),Math.round(bh*_s),_s),obj.x,obj.y,bw,bh); }
            else ctx.drawImage(img,dx,dy,dw,dh);
            ctx.restore();
            resolve();
          };
          img.onerror=()=>{clearTimeout(t);resolve();};
          img.src=obj.imgSrc;
        });
      } else {
        // Empty imgZone — skip drawing for print zones (white paper = nothing)
        // For regular dark-background designs draw a subtle placeholder
        if(!obj._printZone){
          ctx.fillStyle='rgba(255,255,255,0.07)';
          ctx.strokeStyle='rgba(255,255,255,0.2)';
          ctx.lineWidth=4; ctx.setLineDash([16,10]);
          if(obj.radius){ctx.beginPath();ctx.roundRect(obj.x,obj.y,bw,bh,obj.radius);ctx.fill();ctx.stroke();}
          else{ctx.fillRect(obj.x,obj.y,bw,bh);ctx.strokeRect(obj.x,obj.y,bw,bh);}
          ctx.setLineDash([]);
        }
        // _printZone=true → leave blank (white paper shows through)
      }
    } else if (obj.type === 'arctext') {
      _migrateArcObj(obj);
      const svgExport = _buildArcSvg(obj).replace(
        'style="position:absolute;top:0;left:0;width:100%;height:100%;overflow:visible;"',
        `width="${obj.w}" height="${obj.h}"`
      );
      await new Promise(resolve=>{
        const blob=new Blob([svgExport],{type:'image/svg+xml'});
        const url=URL.createObjectURL(blob);
        const img=new Image();
        img.onload=()=>{
          ctx.save(); ctx.globalAlpha=obj.opacity??1;
          if(obj.rotation){ ctx.translate(obj.x+obj.w/2,obj.y+obj.h/2); ctx.rotate(obj.rotation*Math.PI/180); ctx.drawImage(img,-obj.w/2,-obj.h/2,obj.w,obj.h); }
          else { ctx.drawImage(img,obj.x,obj.y,obj.w,obj.h); }
          ctx.restore(); URL.revokeObjectURL(url); resolve();
        };
        img.onerror=()=>{URL.revokeObjectURL(url);resolve();};
        img.src=url;
      });
    } else if (obj.type === 'glassCard') {
      try {
        const snap = document.createElement('canvas');
        snap.width = Math.round(W*scale); snap.height = Math.round(H*scale);
        snap.getContext('2d').drawImage(out, 0, 0);
        // Scale obj coords for captureCanvas scale factor
        const sObj = Object.assign({}, obj, {_sc:scale, x:obj.x*scale, y:obj.y*scale, w:obj.w*scale, h:obj.h*scale, glassBlur:(obj.glassBlur||20)*scale, glassRadius:(obj.glassRadius||48)*scale});
        _drawGlassToCanvas(ctx, sObj, snap);
      } catch(e){ console.warn('glassCard capture',e); }
    } else if (obj.type === 'shape') {
      try {
        if(!obj.shapeType && obj.shapeName){
          const nm={'line':'line-h','line-h':'line-h','line-v':'line-v','rect':'rect','circle':'circle','cross':'cross'};
          obj.shapeType = nm[obj.shapeName] || 'rect';
        }
        if(obj.glassMode){
          const snap = document.createElement('canvas');
          snap.width = Math.round(W*scale); snap.height = Math.round(H*scale);
          snap.getContext('2d').drawImage(out, 0, 0);
          const sObj = Object.assign({}, obj, {x:obj.x*scale, y:obj.y*scale, w:obj.w*scale, h:obj.h*scale, glassBlur:(obj.glassBlur||18)*scale, cornerRadius:(obj.cornerRadius||12)*scale});
          _drawGlassToCanvas(ctx, sObj, snap);
        } else {
          const sObj = Object.assign({}, obj, {x:obj.x*scale, y:obj.y*scale, w:obj.w*scale, h:obj.h*scale, strokeWidth:(obj.strokeWidth||3)*scale});
          if(obj._fx&&obj._fx.shadow&&obj._fx.shadow.active){ const sh=obj._fx.shadow; ctx.shadowOffsetX=sh.x*scale; ctx.shadowOffsetY=sh.y*scale; ctx.shadowBlur=sh.blur*scale; ctx.shadowColor=sh.color; }
          _drawShapeToCanvas(ctx, sObj);
          ctx.shadowOffsetX=0; ctx.shadowOffsetY=0; ctx.shadowBlur=0; ctx.shadowColor='transparent';
        }
      } catch(e){ console.warn('shape capture',e); }
    } else if (obj.type === 'lottie') {
      const _ls = _lottieStaticSvg(obj);
      if (_ls) await _drawSvgToCanvas(ctx, _ls, obj.x, obj.y, obj.w, (obj.h==='auto'?obj.w:(obj.h||obj.w)), obj.color || '#ffffff');
    } else if (obj.type === 'sticker' || obj.type === 'deco') {
      const svgStr = obj.stickerSvg || obj.decoSvg || '';
      if (svgStr) {
        const objW = obj.w, objH = (obj.h === 'auto' ? obj.w : (obj.h || obj.w));
        const stickerColor = (obj.type === 'sticker' && obj.color) ? obj.color : '#ffffff';
        await _drawSvgToCanvas(ctx, svgStr, obj.x, obj.y, objW, objH, stickerColor);
      }
    }
    ctx.restore();
  }
  return out;
}

function measureWithSpacing(ctx, text, ls) {
  let w = 0;
  for (const ch of text) w += ctx.measureText(ch).width + ls;
  return w - ls;
}

function wrapTextCanvas(ctx, text, maxW, ls) {
  const lines = [];
  const paragraphs = text.split('\n');
  for (const para of paragraphs) {
    const words = para.split(' ');
    let line = '';
    for (const word of words) {
      const test = line ? line + ' ' + word : word;
      if (ctx.measureText(test).width > maxW && line) {
        lines.push(line);
        line = word;
      } else {
        line = test;
      }
    }
    lines.push(line);
  }
  return lines;
}

function drawCSSGradient(ctx, cssStr, W, H) {
  // Parse linear-gradient(angle, color1, color2 stop%, ...)
  const match = cssStr.match(/linear-gradient\(([^,]+),(.*)\)/s);
  if (!match) {
    ctx.fillStyle = cssStr;
    ctx.fillRect(0,0,W,H);
    return;
  }
  const anglePart = match[1].trim();
  const deg = anglePart.includes('deg') ? parseFloat(anglePart) : 180;
  const rad = (deg-90)*Math.PI/180;
  const half = Math.sqrt(W*W+H*H)/2;
  const x0 = W/2 - Math.cos(rad)*half, y0 = H/2 - Math.sin(rad)*half;
  const x1 = W/2 + Math.cos(rad)*half, y1 = H/2 + Math.sin(rad)*half;
  const grad = ctx.createLinearGradient(x0,y0,x1,y1);
  const stops = match[2].split(',').map(s=>s.trim()).filter(Boolean);
  stops.forEach((s,i)=>{
    const pct = stops.length<=1 ? 0 : i/(stops.length-1);
    const stopMatch = s.match(/^(.*?)\s+(\d+(?:\.\d+)?%?)$/);
    const color = stopMatch ? stopMatch[1].trim() : s;
    const pos   = stopMatch ? parseFloat(stopMatch[2])/100 : pct;
    try { grad.addColorStop(pos, color); } catch(e) {}
  });
  ctx.fillStyle = grad;
  ctx.fillRect(0,0,W,H);
}

