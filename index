function mnLerpColor(a,b,t){
  const ah=a.replace('#',''),bh=b.replace('#','');
  const ar=parseInt(ah.slice(0,2),16),ag=parseInt(ah.slice(2,4),16),ab=parseInt(ah.slice(4,6),16);
  const br=parseInt(bh.slice(0,2),16),bg=parseInt(bh.slice(2,4),16),bb=parseInt(bh.slice(4,6),16);
  return'rgb('+Math.round(ar+(br-ar)*t)+','+Math.round(ag+(bg-ag)*t)+','+Math.round(ab+(bb-ab)*t)+')';
}
function mnInitParticles(){
  MN.particles=Array.from({length:35},()=>({
    x:Math.random()*MN.CW,y:Math.random()*MN.CH,
    vx:(Math.random()-.5)*25,vy:(Math.random()-.5)*35,
    r:2+Math.random()*5,alpha:.1+Math.random()*.25,
    color:['#7C5BF0','#ffffff','#4e9af1'][Math.floor(Math.random()*3)]
  }));
}

function mnRenderFrame(t){
  const canvas=document.getElementById('mn-canvas');if(!canvas)return;
  const ctx=canvas.getContext('2d');
  const W=MN.CW,H=MN.CH;
  ctx.clearRect(0,0,W,H);
  if(MN.bgType==='dark'){
    const g=ctx.createLinearGradient(0,0,0,H);g.addColorStop(0,'#08060F');g.addColorStop(1,'#1a0f06');ctx.fillStyle=g;ctx.fillRect(0,0,W,H);
  }else if(MN.bgType==='flow'){
    const colors=[['#08060F','#2C1A0E'],['#05030a','#1a0f2e'],['#030a05','#0f2e1a']];
    const ci=Math.floor(t/3)%colors.length,cn=(ci+1)%colors.length,bl=(t%3)/3;
    const g=ctx.createLinearGradient(0,0,W,H);
    g.addColorStop(0,mnLerpColor(colors[ci][0],colors[cn][0],bl));
    g.addColorStop(1,mnLerpColor(colors[ci][1],colors[cn][1],bl));
    ctx.fillStyle=g;ctx.fillRect(0,0,W,H);
  }else if(MN.bgType==='particles'){
    ctx.fillStyle='#050510';ctx.fillRect(0,0,W,H);
    MN.particles.forEach(p=>{
      const x=(p.x+p.vx*t+W*10)%W,y=(p.y+p.vy*t+H*10)%H;
      ctx.beginPath();ctx.arc(x,y,p.r,0,Math.PI*2);
      ctx.fillStyle=p.color+Math.round(p.alpha*255).toString(16).padStart(2,'0');ctx.fill();
    });
  }else if(MN.bgType==='image'&&MN.bgImg){
    const pr=t/MN.duration,sc=1+.15*pr;
    ctx.save();ctx.translate(W/2,H/2);ctx.scale(sc,sc);
    const ratio=Math.max(W/MN.bgImg.width,H/MN.bgImg.height);
    ctx.drawImage(MN.bgImg,-MN.bgImg.width*ratio/2,-MN.bgImg.height*ratio/2,MN.bgImg.width*ratio,MN.bgImg.height*ratio);
    ctx.restore();
  }
  MN.layers.filter(l=>l.visible!==false&&t>=l.startTime&&t<l.startTime+l.duration)
    .forEach(l=>mnDrawLayer(ctx,l,t));
}

function mnEaseOut(t){return 1-Math.pow(1-t,3);}
function mnEaseIn(t){return t*t*t;}
function mnBounce(t){
  if(t<1/2.75)return 7.5625*t*t;
  else if(t<2/2.75)return 7.5625*(t-=1.5/2.75)*t+.75;
  else if(t<2.5/2.75)return 7.5625*(t-=2.25/2.75)*t+.9375;
  return 7.5625*(t-=2.625/2.75)*t+.984375;
}
function mnComputeAnim(l,localT){
  let tx=0,ty=0,sc=1,op=1;
  const inDur=l.animInDur||.5,outDur=l.animOutDur||.4;
  if(l.animIn&&l.animIn!=='none'&&localT<inDur){
    const tp=Math.max(0,Math.min(1,localT/inDur)),p=mnEaseOut(tp);
    if(l.animIn==='fadeUp'){ty=(1-p)*140;op=p;}
    else if(l.animIn==='fadeIn')op=p;
    else if(l.animIn==='slideLeft'){tx=(1-p)*MN.CW*.6;op=Math.min(1,p*2);}
    else if(l.animIn==='slideRight'){tx=-(1-p)*MN.CW*.6;op=Math.min(1,p*2);}
    else if(l.animIn==='scaleIn'){sc=.2+p*.8;op=p;}
    else if(l.animIn==='bounce'){sc=mnBounce(tp);op=Math.min(1,tp*3);}
    else if(l.animIn==='typewriter')op=1;
    else if(l.animIn==='glitch'){if(tp<.6){tx=(Math.random()-.5)*80*(1-tp);op=tp;}else op=1;}
    else if(l.animIn==='zoomBlur'){sc=2-p;op=p;}
    else if(l.animIn==='flipIn'){sc=Math.abs(Math.cos((1-p)*Math.PI/2));op=p;}
    else if(l.animIn==='dropIn'){ty=-(1-p)*200;sc=.7+p*.3;op=Math.min(1,p*3);}
    else if(l.animIn==='spinIn'){sc=p;op=p;}
  }
  if(l.animOut&&l.animOut!=='none'){
    const tOut=localT-(l.duration-outDur);
    if(tOut>0){const tp=Math.min(1,tOut/outDur),p=mnEaseIn(tp);
      if(l.animOut==='fadeOut')op*=(1-p);
      else if(l.animOut==='slideOutLeft'){tx-=p*MN.CW*.6;op*=(1-p*.5);}
      else if(l.animOut==='scaleOut'){sc*=(1-p*.8);op*=(1-p);}
    }
  }
  return{tx,ty,sc,op};
}

function mnDrawLayer(ctx,l,t){
  const localT=t-l.startTime;
  const{tx,ty,sc,op}=mnComputeAnim(l,localT);
  ctx.save();
  ctx.globalAlpha=(l.opacity||1)*op;
  ctx.translate((l.x||MN.CW/2)+tx,(l.y||MN.CH/2)+ty);
  ctx.rotate((l.rotation||0)*Math.PI/180);
  ctx.scale((l.scale||1)*sc,(l.scale||1)*sc);
  if(l.type==='text'){
    let text=l.text||'';
    if(l.animIn==='typewriter'&&localT<(l.animInDur||.6))
      text=text.slice(0,Math.floor(localT/(l.animInDur||.6)*text.length));
    const size=l.fontSize||80;
    ctx.font='700 '+size+'px "'+(l.font||'Oswald')+'",sans-serif';
    ctx.textAlign='center';ctx.textBaseline='middle';
    if(l.shadow){ctx.shadowColor='rgba(0,0,0,0.8)';ctx.shadowBlur=size*.12;ctx.shadowOffsetX=3;ctx.shadowOffsetY=3;}
    const lines=text.split('\n'),lh=size*1.3,totalH=lines.length*lh,sy=-(totalH/2)+lh/2;
    lines.forEach((line,i)=>{ctx.fillStyle=l.color||'#fff';ctx.fillText(line,0,sy+i*lh);});
    ctx.shadowColor='transparent';ctx.shadowBlur=0;
  }else if(l.type==='emoji'){
    const pulse=1+Math.sin(localT*2*Math.PI)*.05;
    ctx.scale(pulse,pulse);
    ctx.font=(l.emojiSize||200)+'px serif';
    ctx.textAlign='center';ctx.textBaseline='middle';
    ctx.fillText(l.emoji||'✨',0,0);
  }else if(l.type==='image'&&l.imgObj){
    ctx.drawImage(l.imgObj,-(l.iw||MN.CW)/2,-(l.ih||MN.CH)/2,l.iw||MN.CW,l.ih||MN.CH);
  }
  ctx.restore();
}




function mnGetLayer(id){return MN.layers.find(l=>l.id===id);}




function mnDrawTimeline(){
  const container=document.getElementById('mn-layers');if(!container)return;
  const totalW=Math.max(MN.duration*MN.tlPxPerSec+60,300);
  const colors={text:'rgba(30,123,255,0.75)',image:'rgba(78,241,138,0.65)',emoji:'rgba(78,154,241,0.7)'};
