// ── Slide strip thumbnails — solid colour blocks with text, no async canvas ──
function _carUpdateStrip(){
  const strip = document.getElementById('car-strip');
  if(!strip) return;
  strip.innerHTML = '';

  _CAR.slides.forEach((slide, i) => {
    const isActive = i === _CAR.current;
    const F = FMTS[slide.fmt||'square']||FMTS.square;
    const isPortrait = F.H > F.W;

    // Outer wrapper — fixed size card
    const wrap = document.createElement('div');
    wrap.style.cssText = `position:relative;flex-shrink:0;cursor:pointer;border-radius:10px;border:2px solid ${isActive?'#4ade80':'rgba(255,255,255,0.1)'};overflow:hidden;transition:border-color .15s;width:${isPortrait?56:80}px;`;
    wrap.onclick = () => _carGoToSlide(i);

    // Colour block — use CSS background, no Canvas API (works perfectly on iOS)
    const th2 = THEMES[slide.themeIdx||0]||THEMES[0];
    const bgCss = slide.customBgColor
      ? `linear-gradient(145deg,${slide.customBgColor},${adjustBrightness(slide.customBgColor,-40)})`
      : (th2.g && th2.g!=='transparent' ? th2.g : '#0D0A1A');

    const aspectPct = Math.round(F.H/F.W*100);
    const colorBlock = document.createElement('div');
    colorBlock.style.cssText = `width:100%;padding-top:${aspectPct}%;position:relative;background:${bgCss};`;

    // Text preview overlay — first title-ish text object
    const titleObj = [...(slide.objects||[])].sort((a,b)=>b.zIndex-a.zIndex).find(o=>o.type==='text'&&(o.subtype==='title'||o.subtype==='verse'||o.subtype==='body'));
    if(titleObj){
      const preview = document.createElement('div');
      preview.style.cssText = `position:absolute;inset:0;padding:4px 5px;display:flex;align-items:center;justify-content:center;overflow:hidden;`;
      const txt = document.createElement('div');
      txt.style.cssText = `font-size:7px;font-weight:700;color:${titleObj.color||'#fff'};text-align:center;line-height:1.3;word-break:break-word;max-height:100%;overflow:hidden;`;
      txt.textContent = (titleObj.text||'').replace(/\n/g,' ').substring(0,30);
      preview.appendChild(txt);
      colorBlock.appendChild(preview);
    }

    wrap.appendChild(colorBlock);

    // Number badge
    const badge = document.createElement('div');
    badge.style.cssText = `padding:3px 5px;font-size:9px;font-weight:800;color:${isActive?'#4ade80':'rgba(255,255,255,0.5)'};font-family:var(--ui-font);background:rgba(0,0,0,0.5);text-align:center;`;
    badge.textContent = i+1;
    wrap.appendChild(badge);

    strip.appendChild(wrap);
  });

  const countEl = document.getElementById('car-slide-count');
  if(countEl) countEl.textContent = `${_CAR.slides.length} slide${_CAR.slides.length!==1?'s':''}`;

  // Scroll active slide into view
  setTimeout(()=>{
    const strip2 = document.getElementById('car-strip');
    if(!strip2) return;
    const activeCard = strip2.children[_CAR.current];
    if(activeCard) activeCard.scrollIntoView({behavior:'smooth',block:'nearest',inline:'center'});
  }, 50);
}

function _carUpdateNav(){
  const nav = document.getElementById('car-nav-label');
  const lbl = document.getElementById('car-editing-label');
  if(nav) nav.textContent = `${_CAR.current+1} / ${_CAR.slides.length}`;
  if(lbl) lbl.textContent = _CAR.slides[_CAR.current]?.label || `Slide ${_CAR.current+1}`;
}

// ── Navigation ──
function _carGoToSlide(i){
  if(i===_CAR.current) return;
  _carSaveCurrent();
  _CAR.current = i;
  _carRestoreSlide(_CAR.slides[i]);
  _carUpdateStrip();
  _carUpdateNav();
}

function _carNavSlide(dir){
  const next = _CAR.current + dir;
  if(next<0||next>=_CAR.slides.length) return;
  _carGoToSlide(next);
}

// ── Add / duplicate / delete slides ──
function _carAddSlide(){
  _carSaveCurrent();
  const n = _CAR.slides.length+1;
  const s = _carBlankSlide(`Slide ${n}`);
  // Inherit format from current slide
  s.fmt = _CAR.slides[_CAR.current]?.fmt || fmt;
  s.themeIdx = _CAR.slides[_CAR.current]?.themeIdx ?? themeIdx;
  _CAR.slides.push(s);
  _CAR.current = _CAR.slides.length-1;
  _carRestoreSlide(s);
  _carUpdateStrip();
  _carUpdateNav();
}

function _carDuplicateCurrent(){
  _carSaveCurrent();
  const src = _CAR.slides[_CAR.current];
  const copy = JSON.parse(JSON.stringify(src));
  copy.id = _carId();
  copy.label = src.label + ' (copia)';
  _CAR.slides.splice(_CAR.current+1, 0, copy);
  _CAR.current = _CAR.current+1;
  _carRestoreSlide(copy);
  _carUpdateStrip();
  _carUpdateNav();
  showUndoToast('⧉ Slide duplicado');
}

function _carDeleteCurrent(){
  if(_CAR.slides.length<=1){ showUndoToast('⚠ El carrusel debe tener al menos 1 slide'); return; }
  _CAR.slides.splice(_CAR.current,1);
  _CAR.current = Math.min(_CAR.current, _CAR.slides.length-1);
  _carRestoreSlide(_CAR.slides[_CAR.current]);
  _carUpdateStrip();
  _carUpdateNav();
  showUndoToast('Slide eliminado');
}

