const TEXT_TEMPLATE_CATS = ['Todos','Versículo','Impacto','Elegante','Iglesia','Social'];

function applyTextTemplate(id){
  const tpl = TEXT_TEMPLATES.find(t=>t.id===id);
  if(!tpl) return;
  pushUndo();
  const {W,H}=getFmtSize();
  const light=_isBgLight();
  const newObjs = tpl.objects(W,H,light);
  const baseZ = objects.length+2;
  newObjs.forEach((o,i)=>{
    objects.push({
      ...o,
      id: genId(),
      type:'text',
      h:'auto',
      rotation:0,
      opacity:1,
      zIndex:baseZ+i,
      visible:true,
      italic:o.italic||false,
      bold:o.bold||false,
      letterSpacing:o.letterSpacing||'normal',
      uppercase:o.uppercase||false,
    });
  });
  renderObjects();
  renderLayersPanel();
  showUndoToast('✦ Plantilla de texto aplicada');
  // Close drawer on mobile
  const drawer=document.getElementById('mob-drawer');
  if(drawer&&window.innerWidth<=900) drawer.classList.remove('open');
}

