    if(obj.subtype === 'vector' && obj.decoSvg) {
      const svgHash = obj.decoSvg.length + '_' + (obj.decoSvg.slice(100,120)) + '_' + (obj.decoSvg.slice(-20));
      if(el.dataset.svgHash !== svgHash) {
        el.dataset.svgHash = svgHash;
        el.innerHTML = obj.decoSvg;
        const svg = el.querySelector('svg');
        if(svg) {
          svg.style.width  = '100%';
