function buildVerseBank(){
  const modal = document.getElementById('vmodal-body');
  if(!modal) return;
  // Build category buttons
  const cats = Object.keys(VERSE_CATEGORIES);
  let catHtml = '<div class="verse-cats">';
  cats.forEach(cat => {
    catHtml += `<button class="verse-cat-btn${cat===verseCat?' on':''}" onclick="filterVerseCat('${cat}',this)">${cat}</button>`;
  });
  catHtml += '</div>';
  // Build verse list
  const verses = verseCat==='Todos'
    ? Object.values(VERSE_CATEGORIES).filter(Boolean).flat().concat(VERSE_BANK)
    : (VERSE_CATEGORIES[verseCat] || VERSE_BANK);
  const verseHtml = verses.map((v,i)=>`
    <div class="vcard" onclick="applyVerse(${JSON.stringify(i).replace(/"/g,"'")}, '${verseCat}')">
      <div class="vcard-ref">${v.ref}</div>
      <div class="vcard-text">${v.verse}</div>
      ${v.body?`<div class="vcard-body">${v.body}</div>`:''}
    </div>`).join('');
  modal.innerHTML = catHtml + verseHtml;
}
function filterVerseCat(cat, btn){
  verseCat = cat;
  const searchEl = document.getElementById('vbank-search');
  if(searchEl) searchEl.value = '';
  const clearBtn = document.getElementById('vbank-search-clear');
  if(clearBtn) clearBtn.style.display = 'none';
  document.querySelectorAll('.verse-cat-btn').forEach(b=>b.classList.remove('on'));
  if(btn) btn.classList.add('on');
  buildVerseBank();
}

function searchVerseBank(query) {
  const clearBtn = document.getElementById('vbank-search-clear');
  if(clearBtn) clearBtn.style.display = query ? 'block' : 'none';
  const modal = document.getElementById('vmodal-body');
  if(!modal) return;
  if(!query.trim()) { buildVerseBank(); return; }
  const q = query.toLowerCase();
  const allVerses = Object.values(VERSE_CATEGORIES).filter(Boolean).flat().concat(VERSE_BANK);
  const results = allVerses.filter(v =>
    v.verse.toLowerCase().includes(q) ||
    v.ref.toLowerCase().includes(q) ||
    (v.body && v.body.toLowerCase().includes(q))
  );
  const catsEl = modal.querySelector('.verse-cats');
  const catsHtml = catsEl ? catsEl.outerHTML : '';
  if(!results.length) {
    modal.innerHTML = catsHtml + `<div style="text-align:center;padding:32px 16px;color:rgba(255,255,255,0.3);font-size:12px;">Sin resultados para "<strong style="color:var(--gold);">${query}</strong>"</div>`;
    return;
  }
  const esc = query.replace(/[.*+?^${}()|[\]\\]/g,'\\$&');
  const highlight = text => text.replace(new RegExp(esc,'gi'), m=>`<mark style="background:rgba(30,123,255,0.25);color:var(--gold);border-radius:2px;">${m}</mark>`);
  const verseHtml = results.map(v => `
    <div class="vcard" onclick="applyVerseObj(${JSON.stringify(JSON.stringify(v)).slice(1,-1)})">
      <div class="vcard-ref">${highlight(v.ref)}</div>
      <div class="vcard-text">${highlight(v.verse)}</div>
      ${v.body ? `<div class="vcard-body">${v.body}</div>` : ''}
    </div>`).join('');
  modal.innerHTML = catsHtml + `<div style="font-size:10px;color:var(--txt3);padding:6px 2px 4px;letter-spacing:.5px;">${results.length} resultado${results.length!==1?'s':''}</div>` + verseHtml;
}

function clearVerseSearch() {
  const searchEl = document.getElementById('vbank-search');
  if(searchEl) { searchEl.value = ''; searchEl.focus(); }
  const clearBtn = document.getElementById('vbank-search-clear');
  if(clearBtn) clearBtn.style.display = 'none';
  buildVerseBank();
}

async function vbAiSearch() {
  const query = document.getElementById('vbank-ai-input')?.value?.trim();
  if (!query) return;
  const modal = document.getElementById('vmodal-body');
  if (!modal) return;
  const catsEl = modal.querySelector('.verse-cats');
  const catsHtml = catsEl ? catsEl.outerHTML : '';

  // Show loading
  modal.innerHTML = catsHtml + `
    <div style="display:flex;flex-direction:column;align-items:center;justify-content:center;padding:40px 16px;gap:12px;">
      <svg viewBox="0 0 24 24" fill="none" stroke="rgba(125,176,255,0.5)" stroke-width="1.5" width="28" height="28" style="animation:spin 1s linear infinite;"><path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4"/></svg>
      <div style="font-size:12px;color:rgba(125,176,255,0.6);font-family:var(--ui-font);">Buscando versículos con IA...</div>
    </div>`;

  // Get all verses as context
  const allVerses = Object.values(VERSE_CATEGORIES).filter(Boolean).flat().concat(VERSE_BANK);
  const verseList = allVerses.map((v,i) => `${i}. ${v.ref}: ${v.verse.replace(/"/g,'')}`).join('\n');

  const groqKey = _storage.get('fsf_groq_key');
  const aiKey   = _storage.get('fsf_ai_key');

  if (!groqKey && !aiKey) {
    // Fallback: keyword match with smarter scoring
    const q = query.toLowerCase();
    const keywords = q.split(/\s+/).filter(w => w.length > 2);
    const scored = allVerses.map(v => {
      const text = (v.verse + ' ' + v.ref + ' ' + (v.body||'')).toLowerCase();
      const score = keywords.reduce((s, k) => s + (text.includes(k) ? 2 : 0), 0);
      return { v, score };
    }).filter(x => x.score > 0).sort((a,b) => b.score - a.score).slice(0, 8);

    if (!scored.length) {
      modal.innerHTML = catsHtml + `<div style="text-align:center;padding:32px;color:var(--txt3);font-size:12px;">Sin resultados para "<strong style="color:var(--gold);">${query}</strong>"<br><span style="font-size:10px;margin-top:6px;display:block;">Agrega tu clave de Groq para búsqueda con IA</span></div>`;
      return;
    }
    _vbRenderAiResults(catsHtml, scored.map(x=>x.v), query, 'coincidencia');
    return;
  }

  try {
    const prompt = `Eres un asistente bíblico cristiano. El usuario busca versículos para esta situación: "${query}"

Aquí están todos los versículos disponibles (índice. referencia: texto):
${verseList}

Selecciona los 6 más relevantes para la situación del usuario. Responde SOLO con un JSON array de índices numéricos, sin explicación. Ejemplo: [3, 17, 42, 88, 156, 203]`;

    let res, data, content;
    if (groqKey) {
      res = await fetch('https://api.groq.com/openai/v1/chat/completions', {
        method:'POST', headers:{'Content-Type':'application/json','Authorization':'Bearer '+groqKey},
        body: JSON.stringify({ model:'llama-3.3-70b-versatile', messages:[{role:'user',content:prompt}], max_tokens:100, temperature:0.3 })
      });
      data = await res.json();
      content = data.choices?.[0]?.message?.content || '[]';
    } else {
      res = await fetch('https://api.anthropic.com/v1/messages', {
        method:'POST', headers:{'Content-Type':'application/json','x-api-key':aiKey,'anthropic-version':'2023-06-01'},
        body: JSON.stringify({ model:'claude-haiku-4-5-20251001', messages:[{role:'user',content:prompt}], max_tokens:100 })
      });
      data = await res.json();
      content = data.content?.[0]?.text || '[]';
    }

    // Parse indices
    const match = content.match(/\[[\d,\s]+\]/);
    if (!match) throw new Error('No indices');
    const indices = JSON.parse(match[0]);
    const results = indices.map(i => allVerses[i]).filter(Boolean);
    if (!results.length) throw new Error('Empty results');
    _vbRenderAiResults(catsHtml, results, query, 'IA');

  } catch(e) {
    // Fallback to keyword
    const q = query.toLowerCase();
    const results = allVerses.filter(v =>
      (v.verse+v.ref+(v.body||'')).toLowerCase().includes(q.split(' ')[0])
    ).slice(0, 6);
    _vbRenderAiResults(catsHtml, results.length ? results : allVerses.slice(0,6), query, 'sugeridos');
  }
}

function _vbRenderAiResults(catsHtml, verses, query, label) {
  const modal = document.getElementById('vmodal-body');
  if (!modal) return;
  const badge = `<div style="display:flex;align-items:center;gap:6px;padding:6px 2px 8px;">
    <svg viewBox="0 0 24 24" fill="none" stroke="rgba(125,176,255,0.6)" stroke-width="2" width="12" height="12"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
    <span style="font-size:10px;color:rgba(125,176,255,0.6);font-family:var(--ui-font);">${verses.length} versículos (${label}) para <strong style="color:#7DB0FF;">"${query}"</strong></span>
  </div>`;
  const cards = verses.map(v =>
    '<div class="vcard" onclick=\'applyVerseObj(' + JSON.stringify(JSON.stringify(v)) + ')\'>' +
    '<div class="vcard-ref">' + v.ref + '</div>' +
    '<div class="vcard-text">' + v.verse + '</div>' +
    (v.body ? '<div class="vcard-body">' + v.body + '</div>' : '') +
    '</div>'
  ).join('');
  modal.innerHTML = catsHtml + badge + cards;
}



function applyVerseObj(jsonStr) {
  try {
    const v = JSON.parse(jsonStr);
    if(v4Mode) {
      const vEl = document.getElementById('v4-ed-verse');
      const rEl = document.getElementById('v4-ed-ref');
      if(vEl) vEl.value = v.verse;
      if(rEl) rEl.value = v.ref;
      renderV4();
      closeVerseBank();
      return;
    }
    pushUndo();
    const ex = objects.find(o=>o.type==='text'&&o.subtype==='verse');
    if(ex){ ex.text=v.verse; renderObjects(); } else { addTextElementWithText('verse',v.verse); }
    const exR = objects.find(o=>o.type==='text'&&o.subtype==='ref');
    if(exR){ exR.text=v.ref; renderObjects(); } else { addTextElementWithText('ref',v.ref); }
    closeVerseBank();
  } catch(e) {}
}
function applyVerse(idx, cat){
  const verses = cat==='Todos'
    ? Object.values(VERSE_CATEGORIES).filter(Boolean).flat().concat(VERSE_BANK)
    : (VERSE_CATEGORIES[cat] || VERSE_BANK);
  const v = verses[idx]; if(!v) return;
  if(v4Mode) {
    const vEl = document.getElementById('v4-ed-verse');
    const rEl = document.getElementById('v4-ed-ref');
    if(vEl) vEl.value = v.verse;
    if(rEl) rEl.value = v.ref;
    renderV4();
    closeVerseBank();
    return;
  }
  pushUndo();
  // If a specific target element is set (from sel-bar button), insert into it
  if(window._verseBankTarget){
    const targetObj = getObject(window._verseBankTarget);
    if(targetObj && targetObj.type==='text'){
      targetObj.text = v.verse;
      // Also update ref if there's a ref element
      const exR = objects.find(o=>o.type==='text'&&o.subtype==='ref');
      if(exR) exR.text = v.ref;
      renderObjects();
      window._verseBankTarget = null;
      closeVerseBank();
      return;
    }
    window._verseBankTarget = null;
  }
  // Default: find verse subtype or create
  const ex = objects.find(o=>o.type==='text'&&o.subtype==='verse');
  if(ex){ ex.text=v.verse; renderObjects(); } else { addTextElementWithText('verse',v.verse); }
  const exR = objects.find(o=>o.type==='text'&&o.subtype==='ref');
  if(exR){ exR.text=v.ref; renderObjects(); } else { addTextElementWithText('ref',v.ref); }
  closeVerseBank();
}

