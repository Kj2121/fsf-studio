.lottie-on-canvas{position:absolute;pointer-events:none;z-index:100;}
.lottie-sel-overlay{position:absolute;inset:0;border:2px solid rgba(30,123,255,0.6);border-radius:4px;pointer-events:none;display:none;}
/* Export animation button */
.anim-export-row{display:flex;gap:5px;margin-top:8px;}
.anim-export-btn{flex:1;background:rgba(30,123,255,0.08);border:1px solid rgba(30,123,255,0.22);border-radius:10px;padding:8px 6px;cursor:pointer;font-size:9px;font-weight:700;color:#7DB0FF;font-family:var(--ui-font);display:flex;align-items:center;justify-content:center;gap:5px;transition:all .15s;}
.anim-export-btn:hover{background:rgba(30,123,255,0.16);border-color:rgba(30,123,255,0.45);}

/* ══ BG LIBRARY ══ */
.bgl-wrap{margin-bottom:14px;}
.bgl-cats{display:flex;flex-wrap:wrap;gap:5px;margin-bottom:8px;}
.bgl-cat{background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.08);border-radius:20px;padding:4px 11px;font-size:9.5px;font-weight:700;color:rgba(255,255,255,0.45);cursor:pointer;font-family:var(--ui-font);transition:all .15s;white-space:nowrap;}
.bgl-cat.on{background:rgba(30,123,255,0.14);border-color:rgba(30,123,255,0.45);color:#1E7BFF;}
.bgl-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:6px;}
.bgl-thumb{position:relative;border-radius:10px;overflow:hidden;cursor:pointer;border:2px solid transparent;transition:all .18s;aspect-ratio:1;}
