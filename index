  const {W:srcW,H:srcH}=getFmtSize();

  // Group by category
  const cats={};
  RESIZE_FORMATS.filter(f=>f.key!==fmt).forEach(f=>{
    if(!cats[f.cat])cats[f.cat]=[];
    cats[f.cat].push(f);
  });

  grid.innerHTML='';
  Object.entries(cats).forEach(([cat,fmts])=>{
    // Category label
    const lbl=document.createElement('div');
    lbl.style.cssText='font-size:9px;font-weight:800;letter-spacing:2px;text-transform:uppercase;color:rgba(255,255,255,0.18);font-family:var(--ui-font);padding:6px 0 4px;';
