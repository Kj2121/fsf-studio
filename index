(function(){
  const SNAP = [0.28, 0.52, 0.80]; // snap heights as fraction of window
  let _dragging = false, _startY = 0, _startH = 0;

  function getDrawer(){ return document.getElementById('mob-drawer'); }

  function snapTo(frac){
    const d = getDrawer(); if(!d) return;
    const h = Math.round(window.innerHeight * frac);
    d.style.transition = 'height .22s cubic-bezier(.25,0,.1,1)';
    d.style.height = h + 'px';
    setTimeout(()=>{ d.style.transition = ''; }, 250);
  }

  function onHandleDown(e){
    const d = getDrawer(); if(!d) return;
    _dragging = true;
    _startY = (e.touches ? e.touches[0].clientY : e.clientY);
    _startH = d.offsetHeight;
    d.style.transition = 'none';
    d.style.overflow = 'hidden';
    e.preventDefault();
  }

  function onMove(e){
    if(!_dragging) return;
    const y = (e.touches ? e.touches[0].clientY : e.clientY);
    const delta = _startY - y;
    const newH = Math.max(180, Math.min(window.innerHeight * 0.88, _startH + delta));
    const d = getDrawer(); if(!d) return;
    d.style.height = newH + 'px';
  }

  function onUp(e){
    if(!_dragging) return;
    _dragging = false;
    const d = getDrawer(); if(!d) return;
    d.style.overflow = '';
    const frac = d.offsetHeight / window.innerHeight;
    // snap to nearest
    const closest = SNAP.reduce((a,b) => Math.abs(b-frac) < Math.abs(a-frac) ? b : a);
    // if dragged below smallest snap, close drawer
    if(frac < SNAP[0] - 0.08){
      d.style.transition = 'height .2s ease';
      d.style.height = '0px';
      setTimeout(()=>{ d.classList.remove('open'); d.style.height=''; d.style.transition=''; }, 210);
      document.querySelectorAll('.mob-tab').forEach(b=>b.classList.remove('on'));
      window.activeMobTab = '';
    } else {
      snapTo(closest);
    }
  }

  document.addEventListener('touchmove', onMove, {passive:false});
  document.addEventListener('touchend', onUp);
  document.addEventListener('mousemove', onMove);
  document.addEventListener('mouseup', onUp);

  // Attach to handle after drawer opens
  const obs = new MutationObserver(()=>{
    const handle = document.querySelector('.mob-drawer-handle');
    if(handle && !handle._dragBound){
      handle._dragBound = true;
      handle.addEventListener('touchstart', onHandleDown, {passive:false});
      handle.addEventListener('mousedown', onHandleDown);
    }
  });
  document.addEventListener('DOMContentLoaded', ()=>{
    const drawer = document.getElementById('mob-drawer');
    if(drawer) obs.observe(drawer, {childList:true, subtree:true, attributes:true});
    // also bind immediately if handle already exists
    const handle = document.querySelector('.mob-drawer-handle');
    if(handle){ handle._dragBound=true; handle.addEventListener('touchstart',onHandleDown,{passive:false}); handle.addEventListener('mousedown',onHandleDown); }
  });
})();
