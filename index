async function lottieExportMp4(){
  if(!objects.some(o=>o.type==='lottie')){showUndoToast('⚠ Añade una animación primero');return;}
  const cv=document.querySelector('.canvas-bg');if(!cv||!window.html2canvas){showUndoToast('⚠ No se pudo iniciar la exportación');return;}
  _lexCancel=false;
  try{clearSelection();}catch(e){}
  document.body.classList.add('fsf-interact'); // sin hilos/handles de edición
  _lexOverlay();
  const HD=_lexQ==='hd', FPS=HD?24:15, MAXW=HD?1080:720, D=_lexDur, N=FPS*D;
  const {W,H}=getFmtSize();
  const sc=Math.min(1,MAXW/W);
  const OW=Math.round(W*sc/2)*2,OH=Math.round(H*sc/2)*2;
  const frames=[];
  try{
    // 1) capas estáticas (una sola captura lenta) + capas animadas (SVG, rápidas)
