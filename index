function applyTemplate(t, keepBgImg) {
  if(!t) return;
  // Fondos: only replace background, keep existing objects
  if(t.fondo){
    pushUndoNow();
    objects = objects.filter(o=>o.type!=='deco'||!o._isFondoBg);
    customBgColor = null;
    themeIdx = 0;
    bgImgSrc = null;
    bgFilters = {brightness:100,contrast:100,saturate:100,grayscale:0};
    t.objects.forEach(o=>{
      const newObj = {...o, id:'obj_'+Date.now()+'_'+Math.random().toString(36).slice(2), _isFondoBg:true, visible:true};
      objects.unshift(newObj); // place at bottom
    });
    applyBackground();
    renderObjects();
    renderLayersPanel();
    showUndoToast('Fondo: ' + t.name);
    return;
  }
  pushUndoNow();
  const prevBgImg = bgImgSrc; // preserve user photo if keepBgImg
  objects = [];
  fmt = t.fmt || 'square';
  const f = FMTS[fmt]; if(f){ updateCanvasSize(); }
  themeIdx = t.themeIdx ?? 0;
  customBgColor = t.customBg || null;
  bgImgSrc = (keepBgImg && prevBgImg) ? prevBgImg : (t.bgImgSrc || null);
  bgImgPos = t.bgImgPos || 'center';
  overlayOpacity = t.overlayOpacity ?? 0.45;
  bgFilters = {brightness:100,contrast:100,saturate:100,grayscale:0};
  applyBackground();
  const tFmt = FMTS[t.fmt] || FMTS.square;
  const tW = tFmt.W, tH = tFmt.H;
  const {W: cW, H: cH} = getFmtSize();
  const scX = cW / tW, scY = cH / tH;
  const scMin = Math.min(scX, scY);
  t.objects.forEach(o => {
    const scaled = {...o,
      id: 'obj_'+Date.now()+'_'+Math.random().toString(36).slice(2),
      visible: true, label: o.subtype||o.type,
      x: Math.round(o.x * scX), y: Math.round(o.y * scY),
      w: Math.round(o.w * scX),
    };
    if(o.h !== 'auto' && o.h != null) scaled.h = Math.round(o.h * scY);
    if(o.fontSize) scaled.fontSize = Math.max(6, Math.round(o.fontSize * scMin));
    if(o.cornerRadius) scaled.cornerRadius = Math.round(o.cornerRadius * scMin);
    if(o.glassRadius) scaled.glassRadius = Math.round(o.glassRadius * scMin);
    objects.push(scaled);
  });
  selectedId = null;
  renderObjects();
  renderLayersPanel();
  updateCanvasSize();
  lastTplId = t.id;
  showUndoToast('✦ Plantilla: ' + t.name);
}

