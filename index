  const osc=p.oscuro_claro?.oscuro||0,cla=p.oscuro_claro?.claro||0,tot=osc+cla;
  if(tot>3){const pct=Math.round(osc/tot*100);lines.push('• Prefiere fondos '+(pct>=60?'oscuros':'claros')+' ('+pct+'% oscuros)');}
  const fuentes=Object.entries(p.fuentes||{}).sort((a,b)=>b[1]-a[1]);
