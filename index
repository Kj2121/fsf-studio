// ── ZOOM BAR — auto-hide when drawer/panels/modals are open ─────────
(function(){
  const zb = () => document.getElementById('zoom-bar');

  function shouldHideZoomBar() {
    // Hide when any bottom drawer, modal, or panel is open
    const checks = [
      // Mobile drawer open (has content / class)
      () => { const d = document.getElementById('mob-drawer'); return d && d.style.display !== 'none' && d.offsetHeight > 40; },
      // Download panel open
      () => { const d = document.getElementById('dl-panel') || document.querySelector('.dl-sheet'); return d && d.style.display !== 'none'; },
      // Share modal
      () => { const d = document.getElementById('share-modal'); return d && d.style.display !== 'none'; },
      // Pexels modal
      () => { const d = document.getElementById('isrch-modal'); return d && d.classList.contains('open'); },
      // Photo source sheet
      () => document.getElementById('iz-source-sheet') !== null,
      // Video studio
      () => { const d = document.getElementById('vs-modal'); return d && d.style.display !== 'none'; },
      // Verse modal
      () => { const d = document.getElementById('verse-modal'); return d && d.style.display !== 'none'; },
      // Any fixed overlay with high z-index
      () => { const d = document.querySelector('.onb-overlay, #ai-modal, #series-modal'); return d && d.style.display !== 'none'; },
    ];
    return checks.some(fn => { try { return fn(); } catch(e){ return false; } });
  }

  function updateZoomBar() {
    const bar = zb(); if(!bar) return;
    if(shouldHideZoomBar()) bar.classList.add('zb-hidden');
    else bar.classList.remove('zb-hidden');
  }

  // Check on any click or touch (fast response)
  document.addEventListener('click', updateZoomBar, {passive:true});
  document.addEventListener('touchend', updateZoomBar, {passive:true});
  // Also poll lightly for cases where things open/close without clicks
  setInterval(updateZoomBar, 400);
})();


(function(){
  const getCC = () => document.getElementById('canvas-container');

  // Modales que deben recibir scroll/touch libremente
  function anyModalOpen() {
    const modals = [
      'isrch-modal',    // Pexels
      'iz-source-sheet', // Photo source sheet
      'vs-modal',       // Video Studio
      'share-modal',    // Share
      'verse-modal',    // Verse bank
      'layers-panel',   // Layers
    ];
    return modals.some(id => {
      const el = document.getElementById(id);
      if(!el) return false;
      const s = el.style.display;
      const cl = el.classList;
      return s === 'flex' || s === 'block' || cl.contains('open');
    }) || document.getElementById('iz-source-sheet') !== null;
  }

  let _pinchActive = false;
  let _pinchStartDist = 0;
  let _pinchStartZoom = 1;

  function pinchDist(t) {
    const dx = t[0].clientX - t[1].clientX;
    const dy = t[0].clientY - t[1].clientY;
    return Math.sqrt(dx*dx + dy*dy);
  }

  document.addEventListener('touchstart', e => {
    if(e.touches.length === 2) {
      if(anyModalOpen()) return; // dejar pasar — modal abierto
      const cc = getCC(); if(!cc || !cc.contains(e.target)) return;
      _pinchActive = true;
      _pinchStartDist = pinchDist(e.touches);
      _pinchStartZoom = _zoomExtra;
      e.preventDefault();
    }
  }, {passive: false});

  document.addEventListener('touchmove', e => {
    if(!_pinchActive || e.touches.length !== 2) return;
    if(anyModalOpen()) { _pinchActive = false; return; } // soltar si modal se abrió
    e.preventDefault();
    const dist = pinchDist(e.touches);
    const ratio = dist / _pinchStartDist;
    _zoomExtra = Math.min(4, Math.max(0.2, _pinchStartZoom * ratio));
    _applyZoom();
  }, {passive: false});

  document.addEventListener('touchend', e => {
    if(e.touches.length < 2) _pinchActive = false;
  }, {passive: true});
})();

