function _izApplyFile(inp, objId) {
  const obj = getObject(objId); if(!obj) return;
  const file = inp.files[0]; if(!file) return;
  const isVideo = file.type.startsWith('video/');
  if(isVideo) {
    pushUndo();
    if(obj._videoObjectUrl) URL.revokeObjectURL(obj._videoObjectUrl);
    const url = URL.createObjectURL(file);
    obj._videoObjectUrl = url; obj.videoSrc = url;
    obj.imgSrc = null; obj._videoEl = null;
    renderObjects(); showUndoToast('🎬 Video agregado');
  } else {
    const r = new FileReader();
    r.onload = ev => {
      pushUndo();
