    for(const k of kids){
      if(k.obj&&k.obj.type==='lottie'&&k.el.querySelector('svg')){ if(cur){seq.push(cur);cur=null;} seq.push({dyn:k}); }
      else{ if(!cur)cur={stat:[]}; cur.stat.push(k.el); }
