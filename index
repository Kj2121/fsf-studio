.sel-btn,.sb-btn,.sel-shadow-btn,.sel-stroke-btn,.sel-sz-step{background:var(--kf)!important;border:1px solid var(--kb)!important;color:#C9D6F5!important;box-shadow:0 2px 0 var(--ke),inset 0 1px 0 rgba(255,255,255,.1)!important}
.sel-btn:active,.sb-btn:active{transform:translateY(2px)!important;box-shadow:none!important}
.sel-btn.on,.sb-btn.on,.sb-hi{background:linear-gradient(180deg,#5AA2FF,#1E7BFF 55%,#1257D1)!important;border-color:#7DB6FF!important;color:#fff!important;box-shadow:0 2px 0 #0B3A99,0 0 10px rgba(30,123,255,.4)!important}
.sel-btn.red{background:linear-gradient(180deg,#5A2B35,#3A1B24)!important;border-color:#7A3A48!important;color:#FFB3BD!important;box-shadow:0 2px 0 #1C0A10!important}
.sel-sz-input{background:#111A2E!important;border-color:#2A3757!important}
.sb-div{background:#26334F}
/* menú del encabezado */
#hdr-more-menu{background:#0A0F1D!important;border:1px solid #26334F!important;box-shadow:0 18px 50px rgba(0,0,0,.85)!important}
._mitem,._mitem._mitem-ai{background:var(--kf)!important;border:1px solid var(--kb)!important;color:#E8EEFF!important;box-shadow:0 3px 0 var(--ke),inset 0 1px 0 rgba(255,255,255,.1)!important;border-radius:12px!important}
._mitem:active{transform:translateY(3px);box-shadow:none!important}
/* panel izquierdo escritorio */
#ltab-formato>.add-nav{display:grid;grid-template-columns:repeat(4,1fr);gap:6px}
#ltab-formato>.add-nav .add-chip{padding:8px 2px;font-size:11px}
#ltab-marca button,#ltab-export button,#ltab-formato .cp-row button,#ltab-formato .expimp-row button,.mex-download-btn,.filter-reset{background:var(--kf)!important;border:1px solid var(--kb)!important;color:#E8EEFF!important;box-shadow:0 3px 0 var(--ke),inset 0 1px 0 rgba(255,255,255,.12)!important;border-radius:12px!important}
#ltab-marca button:active,#ltab-export button:active{transform:translateY(3px);box-shadow:none!important}
.mex-download-btn{background:linear-gradient(180deg,#5AA2FF,#1E7BFF 55%,#1257D1)!important;border-color:#7DB6FF!important;box-shadow:0 4px 0 #0B3A99,0 6px 16px rgba(30,123,255,.3)!important}

.cv2-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:2px 0 14px}
.cv2{display:flex;flex-direction:column;gap:7px;padding:7px 7px 9px;border-radius:14px;cursor:pointer;font-family:var(--ui-font);color:#E8EEFF;background:linear-gradient(180deg,#2B3858,#1B2540);border:1px solid #3B4A6E;box-shadow:0 3px 0 #09101F,inset 0 1px 0 rgba(255,255,255,.12);transition:transform .08s,box-shadow .08s}
