  #export-panel>div:first-child>div[style*="display:flex;gap:6px"]{flex:0 0 auto;}
  #export-panel #dl-btn-2{height:34px;padding:0 20px;}
  #export-panel .dl-res{font-size:10px!important;color:rgba(235,242,255,.4)!important;font-family:var(--ui-font);}
