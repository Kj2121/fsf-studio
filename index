.add-pane .lottie-cat,.add-pane [class*="cat"]:not(.add-chip){
  background:linear-gradient(180deg,var(--k-face1),var(--k-face2))!important;border:1px solid var(--k-line)!important;border-bottom-color:var(--k-edge)!important;
