  document.getElementById('rmbg-modal')?.remove();
  await _doRemoveBg(objId, key);
}

async function _doRemoveBg(objId, apiKey){
  const obj = getObject(objId);
  if(!obj || !obj.imgSrc) return;

  // Show progress toast
  const toastId = _showRmbgProgress();

  try{
    // Convert dataURL to blob
    const res = await fetch(obj.imgSrc);
    const blob = await res.blob();

    const formData = new FormData();
    formData.append('image_file', blob, 'image.png');
    formData.append('size', 'auto');

    const response = await fetch('https://api.remove.bg/v1.0/removebg', {
      method: 'POST',
      headers: { 'X-Api-Key': apiKey },
      body: formData
    });

    if(response.status === 402){
      _hideRmbgProgress(toastId);
      showUndoToast('⚠ Límite de remove.bg alcanzado (50/mes)');
      return;
    }
    if(response.status === 403){
      _hideRmbgProgress(toastId);
      _storage.remove(RMBG_KEY_STORAGE);
      showUndoToast('⚠ API key inválida — intenta de nuevo');
      _showRmbgKeyModal(objId);
      return;
    }
    if(!response.ok){
      throw new Error('Remove.bg error ' + response.status);
    }

    const resultBlob = await response.blob();
    const reader = new FileReader();
    reader.onload = (e) => {
      pushUndo();
      const o = getObject(objId);
      if(o){
        o.imgSrc = e.target.result;
        o._bgRemoved = true;
        // If rectangular, make it fit content better (no radius override)
        renderObjects();
        showSelBar(true, getObject(objId));
      }
      _hideRmbgProgress(toastId);
      showUndoToast('✅ Fondo eliminado exitosamente');
    };
    reader.readAsDataURL(resultBlob);

  } catch(err){
    _hideRmbgProgress(toastId);
    // Fallback: try simple threshold-based removal on canvas
    _doLocalBgRemove(objId, toastId);
  }
}

// Fallback: simple edge-based removal using canvas (no API needed)
async function _doLocalBgRemove(objId){
  const obj = getObject(objId);
  if(!obj || !obj.imgSrc) return;

  _showRmbgProgress();
  if(_rmbgToastEl) _rmbgToastEl.querySelector('div:last-child') && (_rmbgToastEl.lastChild.textContent = '');

  try {
    // Load @imgly/background-removal from CDN (se cachea después de la primera vez)
    if(!window.imglyRemoveBackground){
      if(_rmbgToastEl) _rmbgToastEl.innerHTML =
        '<div style="width:14px;height:14px;border:2px solid rgba(255,255,255,0.3);border-top-color:#fff;border-radius:50%;animation:tplSpin .7s linear infinite;flex-shrink:0;"></div>' +
        '<span>Cargando motor IA (primera vez ~15s)...</span>';

      await new Promise((res, rej) => {
        // Cargar via ESM desde CDN
        const s = document.createElement('script');
        s.type = 'module';
        s.textContent = `
          import { removeBackground } from 'https://esm.sh/@imgly/background-removal@1.5.8';
          window.imglyRemoveBackground = removeBackground;
          window._imglyReady = true;
        `;
        document.head.appendChild(s);
        const t = setInterval(() => {
          if(window._imglyReady){ clearInterval(t); res(); }
        }, 300);
        setTimeout(() => { clearInterval(t); rej(new Error('Timeout cargando librería')); }, 40000);
      });
    }

    if(_rmbgToastEl) _rmbgToastEl.innerHTML =
      '<div style="width:14px;height:14px;border:2px solid rgba(255,255,255,0.3);border-top-color:#fff;border-radius:50%;animation:tplSpin .7s linear infinite;flex-shrink:0;"></div>' +
      '<span>Eliminando fondo con IA...</span>';

    // Convertir imgSrc a Blob para pasarle a imgly
    const resp = await fetch(obj.imgSrc);
    const inputBlob = await resp.blob();

    // Llamada principal — una sola línea, hace todo
    const resultBlob = await window.imglyRemoveBackground(inputBlob, {
      publicPath: 'https://esm.sh/@imgly/background-removal@1.5.8/',
      model: 'medium', // 'small' más rápido, 'medium' mejor calidad
      output: { format: 'image/png', quality: 0.9 },
    });

    // Convertir resultado a dataURL
    const dataUrl = await new Promise((res, rej) => {
      const r = new FileReader();
      r.onload = e => res(e.target.result);
      r.onerror = rej;
      r.readAsDataURL(resultBlob);
    });

    pushUndo();
    const o = getObject(objId);
    if(o){
      o.imgSrc = dataUrl;
      o._bgRemoved = true;
      renderObjects();
      showSelBar(true, getObject(objId));
    }
    _hideRmbgProgress();
    showUndoToast('✅ Fondo eliminado · Sin key · Sin servidor');

  } catch(e) {
    console.error('imgly bg remove error:', e);
    _hideRmbgProgress();

    // Fallback simple por color de esquina
    const img = new Image();
    img.crossOrigin = 'anonymous';
    img.onload = () => {
      const cv = document.createElement('canvas');
      cv.width = img.naturalWidth; cv.height = img.naturalHeight;
      const ctx = cv.getContext('2d');
      ctx.drawImage(img, 0, 0);
      const id = ctx.getImageData(0, 0, cv.width, cv.height);
      const d = id.data;
      const bgR = d[0], bgG = d[1], bgB = d[2];
      for(let i=0;i<d.length;i+=4){
        if(Math.abs(d[i]-bgR)+Math.abs(d[i+1]-bgG)+Math.abs(d[i+2]-bgB) < 120) d[i+3]=0;
      }
      ctx.putImageData(id, 0, 0);
      pushUndo();
      const o = getObject(objId);
      if(o){ o.imgSrc=cv.toDataURL('image/png'); o._bgRemoved=true; renderObjects(); showSelBar(true,o); }
      showUndoToast('⚠ Modo básico usado — ' + e.message.substring(0,50));
    };
    img.src = obj.imgSrc;
  }
}

let _rmbgToastEl = null;
function _showRmbgProgress(){
  _rmbgToastEl?.remove();
  const t = document.createElement('div');
  t.id = 'rmbg-toast';
  t.style.cssText = 'position:fixed;top:70px;left:50%;transform:translateX(-50%);z-index:99999;background:rgba(96,165,250,0.9);color:#fff;font-family:var(--ui-font);font-size:12px;font-weight:700;padding:10px 20px;border-radius:20px;display:flex;align-items:center;gap:8px;box-shadow:0 4px 20px rgba(96,165,250,0.4);white-space:nowrap;';
  t.innerHTML = '<div style="width:14px;height:14px;border:2px solid rgba(255,255,255,0.3);border-top-color:#fff;border-radius:50%;animation:tplSpin .7s linear infinite;"></div> Eliminando fondo...';
  document.body.appendChild(t);
  _rmbgToastEl = t;
  return t;
}
function _hideRmbgProgress(t){
  (t || _rmbgToastEl)?.remove();
  _rmbgToastEl = null;
}

