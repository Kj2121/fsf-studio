          </div>
        </div>`).join('')}
    </div>` : ''}
  `;
}

// ── Toggle layer editor open/close ──
function mobLayerToggle(id){
  const obj = getObject(id); if(!obj) return;
  const wasSelected = selectedId === id;

  if(wasSelected){
    // Close editor
    selectedId = null;
    clearSelection();
    showSelBar(false);
  } else {
    // Select and open editor
    selectObject(id);
    renderObjects();
  }
  mobRenderLayers();
}

// ── Build editor HTML for a specific layer ──
function mobLayerEditorHTML(o){
  if(!o) return '';
  const SL = (lbl,id,min,max,val,fn,unit='') =>
    `<div style="margin-bottom:10px;">
      <div style="display:flex;justify-content:space-between;margin-bottom:4px;">
        <span style="font-size:9px;font-weight:700;color:rgba(255,255,255,0.4);font-family:var(--ui-font);text-transform:uppercase;letter-spacing:.5px;">${lbl}</span>
        <span id="mob-le-${id}-val" style="font-size:10px;color:rgba(255,255,255,0.5);font-family:var(--ui-font);">${val}${unit}</span>
      </div>
