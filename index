      +'<div style="position:absolute;left:'+x+'px;width:'+w+'px;height:28px;top:4px;background:'+clr+';border-radius:6px;border:'+(isSel?'2px solid white':'1.5px solid rgba(255,255,255,0.15)')+';cursor:pointer;display:flex;align-items:center;padding:0 8px;font-size:9px;font-weight:600;color:rgba(0,0,0,0.8);overflow:hidden;white-space:nowrap;user-select:none;" onclick="mnSelectLayer(\''+l.id+'\')">'
      +l.name+'</div></div>';
  }).join('');
}
function mnDrawRuler(){
  const ruler=document.getElementById('mn-ruler-marks');if(!ruler)return;
  const totalW=Math.max(MN.duration*MN.tlPxPerSec+60,300);
  let html='';
  for(let t=0;t<=MN.duration;t+=(MN.tlPxPerSec>=60?1:2)){
    html+='<div style="position:absolute;left:'+(t*MN.tlPxPerSec)+'px;top:0;bottom:0;border-left:1px solid rgba(255,255,255,0.12);display:flex;align-items:flex-end;padding-bottom:2px;padding-left:2px;font-size:8px;font-family:monospace;color:rgba(255,255,255,0.35);">'+t+'s</div>';
  }
  ruler.innerHTML=html;
  ruler.style.cssText='width:'+totalW+'px;position:relative;height:100%;';
}
function mnSelectLayer(id){
  MN.selId=id;mnDrawTimeline();
