        </div>`;
    }
    if (btn) { btn.disabled=false; btn.textContent='Crear diseño con IA'; btn.style.opacity='1'; }
  };

  document.body.appendChild(modal);
  modal.onclick = e => { if (e.target === modal) modal.remove(); };
}

function _p2tApply(design, imageUrl) {
  pushUndo();

  // Set format and theme
  fmt = design.fmt || 'square';
  const f = FMTS[fmt]; if (f) updateCanvasSize();
  themeIdx = design.themeIdx ?? 1;
  customBgColor = design.customBgColor || null;
  overlayOpacity = design.overlayOpacity ?? 0.35;
  _customGradient = null;
  objects = [];

  // Set photo as background
  bgImgSrc = imageUrl;
  bgImgPos = design.bgPosition || 'center';
  bgFilters = { brightness:100, contrast:100, saturate:100, grayscale:0 };
  applyBackground();

  // Apply text objects
  const { W, H } = getFmtSize();
  (design.objects || []).forEach((o, i) => {
    objects.push({
      ...o,
      id: 'p2t_' + Date.now() + '_' + i,
      visible: true,
      rotation: o.rotation || 0,
      opacity: o.opacity ?? 1,
      zIndex: o.zIndex || (i + 2),
      x: Math.max(0, Math.min(o.x || 50, W - 50)),
      y: Math.max(0, Math.min(o.y || 50, H - 50)),
      w: o.w || Math.round(W * 0.8),
      h: (!o.h || o.h === 'auto') ? (o.type === 'text' ? (o.fontSize || 40) * 2.5 : Math.round(H * 0.3)) : o.h,
    });
  });

  selectedId = null;
  renderObjects();
  renderLayersPanel();
  updateCanvasSize();
  showUndoToast('✦ Foto a Plantilla aplicada — ' + (design.analysis?.substring(0, 40) || 'Diseño listo'));
}

