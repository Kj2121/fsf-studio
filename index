function _colorLibSetMode(mode, btn){
  _colorLibMode = mode;
  ['bg','el'].forEach(m=>{
    const b = document.getElementById('clib-mode-'+m);
    if(!b) return;
    const isOn = (m==='bg'&&mode==='bg')||(m==='el'&&mode==='element');
    b.style.background = isOn ? (m==='bg'?'rgba(74,222,128,0.15)':'rgba(30,123,255,0.15)') : 'rgba(255,255,255,0.05)';
    b.style.borderColor = isOn ? (m==='bg'?'rgba(74,222,128,0.4)':'rgba(30,123,255,0.4)') : 'rgba(255,255,255,0.1)';
    b.style.color = isOn ? (m==='bg'?'#4ade80':'#7DB0FF') : 'rgba(255,255,255,0.4)';
  });
  const lbl = document.querySelector('#color-library-modal span[style*="font-weight:700"]');
  if(lbl){ lbl.style.color = mode==='element'?'#7DB0FF':'#4ade80'; lbl.textContent = mode==='element'?'Elemento seleccionado':'Fondo del canvas'; }
}

let _colorLibActiveCat = 'all';

function _colorLibCat(id, btn){
  _colorLibActiveCat = id;
  document.getElementById('clib-search').value = '';
  document.querySelectorAll('.clib-cat-btn').forEach(b=>{
    const on = b===btn;
    b.style.background = on?'rgba(255,255,255,0.12)':'rgba(255,255,255,0.04)';
    b.style.borderColor = on?'rgba(255,255,255,0.2)':'rgba(255,255,255,0.08)';
    b.style.color = on?'rgba(255,255,255,0.9)':'rgba(255,255,255,0.45)';
  });
  _colorLibRender(id);
}

function _colorLibSearch(q){
  const term = q.toLowerCase().trim();
  if(!term){ _colorLibRender(_colorLibActiveCat); return; }
  const results = [];
  Object.entries(COLOR_LIBRARY).forEach(([catId, cat])=>{
    const matches = cat.colors.filter(c=>c.n.toLowerCase().includes(term)||c.h.toLowerCase().includes(term));
    if(matches.length) results.push({label:cat.label, icon:cat.icon, colors:matches});
  });
  const body = document.getElementById('clib-body'); if(!body) return;
  if(!results.length){ body.innerHTML='<div style="text-align:center;padding:24px;font-size:12px;color:rgba(255,255,255,0.3);">Sin resultados para "'+q+'"</div>'; return; }
  body.innerHTML = results.map(cat=>`
    <div style="margin-bottom:18px;">
      <div style="font-size:10px;font-weight:800;color:rgba(255,255,255,0.35);letter-spacing:1.5px;text-transform:uppercase;margin-bottom:8px;">${cat.icon} ${cat.label}</div>
      <div style="display:grid;grid-template-columns:repeat(8,1fr);gap:5px;">
        ${cat.colors.map(c=>_colorLibSwatch(c)).join('')}
      </div>
    </div>`).join('');
}

function _colorLibSwatch(c){
  return `<div title="${c.n}\n${c.h}" onclick="_colorLibApply('${c.h}')"
    style="position:relative;aspect-ratio:1;border-radius:8px;background:${c.h};cursor:pointer;border:1.5px solid rgba(255,255,255,0.1);transition:transform .12s;-webkit-tap-highlight-color:transparent;"
    onmouseenter="this.style.transform='scale(1.1)';this.style.zIndex='2'"
    onmouseleave="this.style.transform='scale(1)';this.style.zIndex='1'">
    <div style="position:absolute;bottom:100%;left:50%;transform:translateX(-50%);background:rgba(0,0,0,0.85);color:#fff;font-size:8px;padding:2px 5px;border-radius:4px;white-space:nowrap;pointer-events:none;opacity:0;transition:opacity .15s;" class="clib-tip">${c.n}</div>
  </div>`;
}

function _colorLibRender(catId){
  const body = document.getElementById('clib-body'); if(!body) return;
  const cats = catId==='all' ? Object.entries(COLOR_LIBRARY) : [[catId, COLOR_LIBRARY[catId]]].filter(([,v])=>v);
  body.innerHTML = cats.map(([id, cat])=>`
    <div style="margin-bottom:20px;">
      <div style="font-size:10px;font-weight:800;color:rgba(255,255,255,0.35);letter-spacing:1.5px;text-transform:uppercase;margin:12px 0 8px;">${cat.icon} ${cat.label}</div>
      <div style="display:grid;grid-template-columns:repeat(8,1fr);gap:5px;">
        ${cat.colors.map(c=>_colorLibSwatch(c)).join('')}
      </div>
    </div>`).join('');

  // Show tooltips on hover via CSS approach
  body.querySelectorAll('[title]').forEach(el=>{
    el.addEventListener('mouseenter',()=>{ el.querySelector('.clib-tip').style.opacity='1'; });
    el.addEventListener('mouseleave',()=>{ el.querySelector('.clib-tip').style.opacity='0'; });
  });
}

function _colorLibApply(hex){
  document.getElementById('color-library-modal')?.remove();
  // Route through the same apply function for consistent behavior
  _cpApply(hex, window._cpCurrentFn, false);
}
</script>

