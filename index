  cfRenderSavedList();
}

let _cfPendingData = null;
let _cfPendingFormat = null;
let _cfPendingFileName = null;

function cfFileSelected(input){
  const file = input.files[0];
  if(!file) return;

  const ext = file.name.split('.').pop().toLowerCase();
  const formatMap = {ttf:'truetype', otf:'opentype', woff:'woff', woff2:'woff2'};
  _cfPendingFormat = formatMap[ext] || 'truetype';
  _cfPendingFileName = file.name.replace(/\.[^.]+$/, '');

  // Auto-fill name if empty
  const nameInput = document.getElementById('cf-name-input');
  if(nameInput && !nameInput.value){
    nameInput.value = _cfPendingFileName.replace(/[-_]/g,' ');
  }

  const reader = new FileReader();
  reader.onload = e => {
    _cfPendingData = e.target.result;

    // Show preview
    const content = document.getElementById('cf-drop-content');
    if(content){
      // Register temporarily to preview
      const previewStyle = document.createElement('style');
      previewStyle.id = 'cf-preview-face';
      previewStyle.textContent = `@font-face { font-family: '__cf_preview__'; src: url('${_cfPendingData}') format('${_cfPendingFormat}'); }`;
      document.head.appendChild(previewStyle);

      content.innerHTML = `
        <div style="font-size:28px;font-family:'__cf_preview__',sans-serif;color:rgba(255,255,255,0.85);margin-bottom:6px;">Aa Bb Cc 123</div>
        <div style="font-size:11px;color:rgba(74,222,128,0.8);font-weight:700;font-family:var(--ui-font);">✓ ${file.name}</div>
        <div style="font-size:9px;color:rgba(255,255,255,0.3);font-family:var(--ui-font);margin-top:2px;">${(file.size/1024).toFixed(0)} KB</div>`;
    }

    // Enable save
    const btn = document.getElementById('cf-save-btn');
    if(btn){
      btn.disabled = false;
      btn.style.background='rgba(30,123,255,0.2)';
      btn.style.borderColor='rgba(30,123,255,0.45)';
      btn.style.color='#7DB0FF';
      btn.style.cursor='pointer';
    }
  };
  reader.readAsDataURL(file);
}

async function cfSaveFont(){
  if(!_cfPendingData){ showUndoToast('⚠ Selecciona un archivo primero'); return; }
  const name = (document.getElementById('cf-name-input')?.value||'').trim() || _cfPendingFileName || 'Mi Fuente';
  const id = 'cf_'+name.toLowerCase().replace(/\s+/g,'_').replace(/[^a-z0-9_]/g,'')+'_'+Date.now();

  try{
    const font = { id, name, dataUrl: _cfPendingData, format: _cfPendingFormat, addedAt: new Date().toLocaleDateString('es') };
    await _cfSave(font);
    _cfRegisterFontFace(id, name, _cfPendingData, _cfPendingFormat);
    _cfAddToFonts(id, name);
    _cfRefreshAllFontUIs();

    // Cleanup
    document.getElementById('cf-preview-face')?.remove();
    _cfPendingData = null;

    document.querySelector('div[style*="position:fixed"][style*="z-index:10001"]')?.remove();
    showUndoToast('✦ Fuente "'+name+'" añadida');
  }catch(e){
    showUndoToast('⚠ Error guardando: '+e.message);
  }
}

async function cfRenderSavedList(){
  const list = document.getElementById('cf-saved-list');
  if(!list) return;
  try{
    const fonts = await _cfGetAll();
    if(!fonts.length){ list.innerHTML=''; return; }
    list.innerHTML = `
      <div style="font-size:9px;font-weight:800;letter-spacing:2px;text-transform:uppercase;color:rgba(255,255,255,0.2);font-family:var(--ui-font);margin-bottom:8px;">Mis fuentes guardadas</div>
      ${fonts.map(f=>`
        <div style="display:flex;align-items:center;gap:10px;padding:8px 10px;background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.07);border-radius:10px;margin-bottom:5px;">
          <div style="font-family:'${f.name}',sans-serif;font-size:20px;color:rgba(255,255,255,0.8);min-width:40px;">Aa</div>
          <div style="flex:1;">
            <div style="font-size:11px;font-weight:700;color:rgba(255,255,255,0.7);font-family:var(--ui-font);">${f.name}</div>
            <div style="font-size:9px;color:rgba(255,255,255,0.25);font-family:var(--ui-font);">${f.addedAt||''}</div>
          </div>
          <button onclick="cfDeleteFont('${f.id}')" style="width:26px;height:26px;border-radius:50%;background:rgba(239,68,68,0.08);border:1px solid rgba(239,68,68,0.2);color:rgba(239,68,68,0.6);font-size:11px;cursor:pointer;display:flex;align-items:center;justify-content:center;">✕</button>
        </div>`).join('')}`;
  }catch(e){}
}

async function cfDeleteFont(id){
  try{
    await _cfDelete(id);
    // Remove from FONTS array
    const idx = FONTS.findIndex(f=>f.id===id);
    if(idx !== -1) FONTS.splice(idx, 1);
    // Remove @font-face style
    document.getElementById('cf-face-'+id)?.remove();
    _cfRefreshAllFontUIs();
    cfRenderSavedList();
    showUndoToast('Fuente eliminada');
  }catch(e){
    showUndoToast('⚠ '+e.message);
  }
}

