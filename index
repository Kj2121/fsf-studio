// ── APPLY DESIGN TO CANVAS ──
function _aiApplyDesignToCanvas(design){
  try{
    if(!design){ showUndoToast('⚠ No hay diseño'); return; }
    // Normalize objects to array
    if(design.objects && !Array.isArray(design.objects)){
      design.objects = Object.values(design.objects);
    }
    if(!design.objects || !design.objects.length){ showUndoToast('⚠ Diseño vacío'); return; }
    // BUG FIX: usar pushUndoNow para capturar estado ANTES de modificar objects
    pushUndoNow();
    fmt=design.fmt||'square';const f=FMTS[fmt];if(f)updateCanvasSize();
    themeIdx=design.themeIdx??1;customBgColor=design.customBgColor||null;
    overlayOpacity=design.overlayOpacity??0;bgImgSrc=null;_customGradient=null;
    applyBackground();objects=[];
    const {W,H}=getFmtSize();
    design.objects.forEach((o,i)=>{
      // Sanitize AI-generated object to ensure all required fields
      const obj={
        ...o,
        id:'ai_'+Date.now()+'_'+i,
        type:o.type||'text',
        visible:true,
        rotation:o.rotation||0,
        opacity:o.opacity??1,
        zIndex:o.zIndex||(i+2),
        x:Math.max(0,Math.min(Number(o.x)||50,W-20)),
        y:Math.max(0,Math.min(Number(o.y)||50,H-20)),
        w:Number(o.w)||Math.round(W*0.8),
        // Fix h:'auto' — text elements need numeric h for selection box
        h:(!o.h||o.h==='auto')?(o.type==='text'?(Number(o.fontSize)||40)*2.5:Math.round(H*0.3)):Number(o.h),
      };
      // Asegurar campos de texto
      if(obj.type==='text'){
        obj.text=obj.text||'';
        obj.fontId=obj.fontId||'playfair';
        obj.fontSize=Number(obj.fontSize)||40;
        obj.color=obj.color||'#1A0E06';
        obj.align=obj.align||'left';
      }
      if(obj.textGradient&&obj.type==='text'){ obj._hasGradient=true; }
      objects.push(obj);
    });
    selectedId=null;renderObjects();renderLayersPanel();updateCanvasSize();
    try{ fsfLearnDesignApplied(design); }catch(e){}
    showUndoToast('✦ Diseño aplicado');
  }catch(err){
    showUndoToast('⚠ Error al aplicar: '+(err.message||'desconocido'));
    console.error('_aiApplyDesignToCanvas error:',err);
  }
}

// ── RENDER 3 VARIATIONS IN CHAT ──
function _aiAddVariationsMsg(designs,prompt){
  const chat=document.getElementById('ai-chat');if(!chat)return;
  const empty=document.getElementById('ai-chat-empty');if(empty)empty.style.display='none';

  const wrap=document.createElement('div');
  wrap.className='ai-msg-wrap';
  wrap.style.cssText='display:flex;gap:10px;align-items:flex-start;';

  const av=document.createElement('div');
  av.style.cssText='width:30px;height:30px;border-radius:50%;background:linear-gradient(135deg,#5A9BFF,#1558D6);display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:2px;';
  av.innerHTML='<svg viewBox="0 0 24 24" fill="none" width="14" height="14"><path d="M12 2l2.4 7.4H22l-6.2 4.5 2.4 7.4L12 17l-6.2 4.3 2.4-7.4L2 9.4h7.6z" fill="#1a0900"/></svg>';

  const col=document.createElement('div');
  col.style.cssText='display:flex;flex-direction:column;gap:8px;flex:1;min-width:0;';

  const bubble=document.createElement('div');
  bubble.className='ai-bubble-ai';
  bubble.textContent=designs.length>1?`Aquí tienes ${designs.length} variaciones para elegir — toca una para aplicarla:`:'Aquí está tu diseño:';
  col.appendChild(bubble);

  // Variation cards grid
  const grid=document.createElement('div');
  grid.style.cssText='display:grid;grid-template-columns:repeat('+Math.min(designs.length,3)+',1fr);gap:8px;';

  designs.forEach((design,i)=>{
    const card=document.createElement('div');
    card.className='ai-var-card';
    card.style.cssText='background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.08);border-radius:14px;overflow:hidden;cursor:pointer;transition:all .2s;-webkit-tap-highlight-color:transparent;';

    // Mini canvas preview
    const cv=document.createElement('canvas');
    const SIZE=160;
    const F=FMTS[design.fmt||'square']||FMTS.square;
    cv.width=SIZE;cv.height=Math.round(F.H/F.W*SIZE);
    cv.style.cssText='width:100%;display:block;';
    const ctx=cv.getContext('2d');
    const th=THEMES[design.themeIdx||1]||THEMES[1];
    if(th.g&&th.g!=='transparent'){try{drawCSSGradient(ctx,th.g,cv.width,cv.height);}catch(e){ctx.fillStyle='#1a0f06';ctx.fillRect(0,0,cv.width,cv.height);}}
    else{ctx.fillStyle='#fff';ctx.fillRect(0,0,cv.width,cv.height);}
    const sc=SIZE/F.W;
    (design.objects||[]).filter(o=>o.type==='text'&&o.visible!==false).slice(0,4).forEach(o=>{
      const fs=Math.max(3,o.fontSize*sc);
      ctx.save();
      ctx.font=`${o.italic?'italic ':''}${o.bold?'bold ':''}${fs}px sans-serif`;
      ctx.fillStyle=o.color||'#fff';ctx.globalAlpha=o.opacity??0.92;
      ctx.textAlign=o.align==='center'?'center':o.align==='right'?'right':'left';
      ctx.textBaseline='top';ctx.shadowColor='rgba(0,0,0,0.5)';ctx.shadowBlur=2;
      const ax=o.align==='center'?(o.x+o.w/2)*sc:o.align==='right'?(o.x+o.w)*sc:o.x*sc;
      (o.text||'').split('\n').slice(0,2).forEach((line,li)=>{
        ctx.fillText((o.uppercase?line.toUpperCase():line).substring(0,22),ax,o.y*sc+li*fs*1.3,o.w*sc);
      });
      ctx.restore();
    });
    card.appendChild(cv);

    // Label
    const labels=['Clásico','Moderno','Minimalista'];
    const lbl=document.createElement('div');
    lbl.style.cssText='padding:6px 8px;font-size:9px;font-weight:700;color:rgba(255,255,255,0.45);font-family:var(--ui-font);text-align:center;letter-spacing:.5px;background:rgba(0,0,0,0.2);';
    lbl.textContent=(labels[i]||`Variación ${i+1}`).toUpperCase();
    card.appendChild(lbl);

    card.onclick=()=>{
      // Highlight selected
      grid.querySelectorAll('div').forEach(c=>{if(c!==card)c.style.borderColor='rgba(255,255,255,0.08)';});
      card.style.cssText=card.style.cssText.replace('rgba(255,255,255,0.08)','rgba(30,123,255,0.5)');
      card.style.borderColor='rgba(30,123,255,0.5)';
      card.style.boxShadow='0 0 0 2px rgba(30,123,255,0.15)';
      _aiApplyDesignToCanvas(design);
      // Show star button after applying
      const starBtn=card.querySelector('.ai-star-btn');
      if(starBtn)starBtn.style.display='flex';
      setTimeout(()=>_aiUpdateSuggestions(design),200);
      // Cerrar el modal para ver el diseño en el lienzo
      setTimeout(()=>{ if(typeof closeAIModal==='function') closeAIModal(); }, 350);
    };

    // Star button — save as personal reference
    const starBtn=document.createElement('button');
    starBtn.className='ai-star-btn';
    starBtn.title='Guardar como referencia personal';
    starBtn.style.cssText='display:none;position:absolute;top:6px;right:6px;width:28px;height:28px;border-radius:50%;background:rgba(251,191,36,0.15);border:1px solid rgba(251,191,36,0.4);cursor:pointer;align-items:center;justify-content:center;font-size:13px;transition:all .15s;z-index:10;-webkit-tap-highlight-color:transparent;';
    starBtn.innerHTML='⭐';
    starBtn.onclick=(e)=>{
      e.stopPropagation();
      const label=(labels[i]||`Variación ${i+1}`) + (prompt?' — '+prompt.substring(0,30):'');
      _aiSavePersonalExample(design, label);
      starBtn.style.background='rgba(251,191,36,0.35)';
      starBtn.style.borderColor='rgba(251,191,36,0.8)';
    };
    card.style.position='relative';
    card.appendChild(starBtn);

    // Hover effect
    card.addEventListener('touchstart',()=>{card.style.transform='scale(0.97)';},{passive:true});
    card.addEventListener('touchend',()=>{card.style.transform='';},{passive:true});
    // Show star on hover (desktop)
    card.addEventListener('mouseenter',()=>{if(card.style.borderColor.includes('124'))starBtn.style.display='flex';});

    grid.appendChild(card);
  });

  col.appendChild(grid);
  wrap.appendChild(av);
  wrap.appendChild(col);
  chat.appendChild(wrap);
  chat.scrollTop=chat.scrollHeight;

  // AUTO-APLICAR la primera variación al canvas (para ver resultado de inmediato)
  if(designs[0]){
    _aiApplyDesignToCanvas(designs[0]);
    // Marcar la primera card como aplicada
    const firstCard=grid.querySelector('.ai-var-card');
    if(firstCard){
      firstCard.style.borderColor='rgba(74,222,128,0.5)';
      firstCard.style.boxShadow='0 0 0 2px rgba(74,222,128,0.15)';
    }
    // Cerrar el modal para ver el diseño (las otras variaciones siguen en el chat)
    setTimeout(()=>{ if(typeof closeAIModal==='function') closeAIModal(); }, 500);
  }
}

