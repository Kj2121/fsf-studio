// ══════════════════════════════════════════════════════════════
// COLLAGE LAYOUT ENGINE
// Calculates exact x,y,w,h for each zone given canvas size,
// count, layout type, margin and gap.
// ══════════════════════════════════════════════════════════════
function _colCalcZones(W, H, count, layout, margin, gap){
  const zones = [];
  const innerW = W - margin*2;
  const innerH = H - margin*2;
  const ox = margin, oy = margin;

  if(layout === 'grid'){
    // Auto columns: sqrt-ish
    const cols = count<=1?1:count<=2?2:count<=4?2:count<=6?3:count<=9?3:3;
    const rows = Math.ceil(count/cols);
    const cw = Math.floor((innerW - gap*(cols-1)) / cols);
    const ch = Math.floor((innerH - gap*(rows-1)) / rows);
    for(let i=0;i<count;i++){
      const col=i%cols, row=Math.floor(i/cols);
      zones.push({x:ox+col*(cw+gap), y:oy+row*(ch+gap), w:cw, h:ch});
    }

  } else if(layout === 'strips-h'){
    // Equal horizontal strips
    const ch = Math.floor((innerH - gap*(count-1)) / count);
    for(let i=0;i<count;i++){
      zones.push({x:ox, y:oy+i*(ch+gap), w:innerW, h:ch});
    }

  } else if(layout === 'strips-v'){
    // Equal vertical strips
    const cw = Math.floor((innerW - gap*(count-1)) / count);
    for(let i=0;i<count;i++){
      zones.push({x:ox+i*(cw+gap), y:oy, w:cw, h:innerH});
    }

  } else if(layout === 'featured'){
    // First photo is large (left half), rest fill right column
    if(count===1){ zones.push({x:ox,y:oy,w:innerW,h:innerH}); }
    else {
      const rest = count-1;
      const mainW = Math.floor(innerW*0.58);
      const sideW = innerW - mainW - gap;
      zones.push({x:ox, y:oy, w:mainW, h:innerH}); // main
      const sh = Math.floor((innerH - gap*(rest-1))/rest);
      for(let i=0;i<rest;i++){
        zones.push({x:ox+mainW+gap, y:oy+i*(sh+gap), w:sideW, h:sh});
      }
    }

  } else if(layout === 'masonry'){
    // Two-column masonry with alternating heights
    if(count===1){ zones.push({x:ox,y:oy,w:innerW,h:innerH}); }
    else {
      const cols = 2;
      const cw = Math.floor((innerW-gap)/cols);
      const colY = [oy, oy];
      for(let i=0;i<count;i++){
        const c = i%2;
        // Alternate tall/short
        const tall = (i%4===0||i%4===3);
        const ch = Math.floor(tall ? innerH*0.38 : innerH*0.28);
        zones.push({x:ox+c*(cw+gap), y:colY[c], w:cw, h:ch});
        colY[c] += ch+gap;
      }
    }

  } else if(layout === 'panorama'){
    // Single wide panorama, or stacked wide strips if multiple
    if(count===1){
      zones.push({x:ox, y:oy+Math.floor(innerH*0.2), w:innerW, h:Math.floor(innerH*0.6)});
    } else {
      const ch = Math.floor((innerH - gap*(count-1))/count);
      for(let i=0;i<count;i++){
        const slim = i%2===1;
        const padX = slim ? Math.floor(innerW*0.1) : 0;
        zones.push({x:ox+padX, y:oy+i*(ch+gap), w:innerW-padX*2, h:ch});
      }
    }
  }

  return zones;
}

// ── Preview mini-canvas ──
function _colRenderPreview(){
  const cv = document.getElementById('col-preview-cv');
  if(!cv) return;
  const F = FMTS[_COL.fmt==='custom'?'a4v':_COL.fmt]||FMTS.a4v;
  const PW=200, PH=Math.round(F.H/F.W*200);
  cv.width=PW; cv.height=PH;
  const ctx=cv.getContext('2d');
  ctx.fillStyle='#FAFAF8'; ctx.fillRect(0,0,PW,PH);

  const scale=PW/F.W;
  const gapS=Math.round(_COL.gap*scale);
  const marginS=Math.round(_COL.margin*scale);
  const zones=_colCalcZones(PW,PH,_COL.count,_COL.layout,marginS,gapS);

  zones.forEach((z,i)=>{
    const r = _COL.shape==='circle' ? Math.min(z.w,z.h)/2 : _COL.shape==='roundrect'?8:0;
    ctx.fillStyle=`hsl(${40+i*30},60%,75%)`;
    ctx.beginPath();
    if(r){ ctx.roundRect(z.x,z.y,z.w,z.h,r); } else { ctx.rect(z.x,z.y,z.w,z.h); }
    ctx.fill();
    // Number label
    ctx.fillStyle='rgba(0,0,0,0.35)';
    ctx.font=`bold ${Math.max(8,Math.min(14,z.h/3))}px sans-serif`;
    ctx.textAlign='center'; ctx.textBaseline='middle';
    ctx.fillText(i+1, z.x+z.w/2, z.y+z.h/2);
  });
}

// ── Generate collage on canvas ──
function _colGenerate(){
  const fmtKey = _COL.fmt==='custom'?'a4v':_COL.fmt;
  // Switch format if needed
  if(fmt!==fmtKey){ setFmt(fmtKey); }

  const {W,H}=getFmtSize();
  const zones=_colCalcZones(W,H,_COL.count,_COL.layout,_COL.margin,_COL.gap);
  const isCircle=_COL.shape==='circle';
  const isRound=_COL.shape==='roundrect';

  pushUndo();
  // Clear canvas
  objects=[];
  customBgColor=null; bgImgSrc=null; _customGradient=null; overlayOpacity=0;
  themeIdx=0; // white

  // White background deco
  objects.push({
    id:genId(), type:'deco', x:0, y:0, w:W, h:H,
    rotation:0, opacity:1, zIndex:1, visible:true,
    decoSvg:`<svg viewBox="0 0 ${W} ${H}" xmlns="http://www.w3.org/2000/svg"><rect width="${W}" height="${H}" fill="#FFFFFF"/></svg>`
  });

  zones.forEach((z,i)=>{
    const r = isCircle ? Math.round(Math.min(z.w,z.h)/2) : isRound ? Math.round(Math.min(z.w,z.h)*0.1) : 0;
    objects.push({
      id:genId(), type:'imgZone',
      x:Math.round(z.x), y:Math.round(z.y),
      w:Math.round(z.w), h:Math.round(z.h),
      radius:r, label:`Foto ${i+1}`,
      imgSrc:null, opacity:1, rotation:0,
      zIndex:i+2, visible:true,
      _printZone:true, _imgShape:_COL.shape,
    });
  });

  selectedId=null;
  applyBackground();
  renderObjects();
  renderLayersPanel();
  updateCanvasSize();
  showUndoToast(`⊞ Collage de ${_COL.count} fotos creado`);
  document.getElementById('collage-builder-sheet')?.remove();
}

// Re-render preview when gap slider changes
document.addEventListener('input', e=>{
  if(e.target.id==='col-gap-sl') _colRenderPreview();
});
</script>

