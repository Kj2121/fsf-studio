        'x-api-key': apiKey
      },
      body: JSON.stringify({
        model:'claude-sonnet-4-20250514',
        max_tokens:2500,
        system: _PHOTO2TPL_SYS,
        messages:[{ role:'user', content:[
          { type:'image', source:{ type:'base64', media_type:mime, data:base64 } },
          { type:'text', text: userPrompt }
        ]}]
      })
    });
    if(!resp.ok){ const e=await resp.json().catch(()=>({})); throw new Error(e.error?.message||'Claude '+resp.status); }
    text = (await resp.json()).content?.find(b=>b.type==='text')?.text || '';
  }

  const clean = text.replace(/```json|```/g,'').trim();
  // Extract JSON if surrounded by other text
  const match = clean.match(/\{[\s\S]*\}/);
  if(!match) throw new Error('No se pudo parsear el diseño generado');
  return JSON.parse(match[0]);
}

async function _p2tResizeImage(dataUrl, maxSize) {
  return new Promise((resolve) => {
    const img = new Image();
    img.onload = () => {
      const scale = Math.min(1, maxSize / Math.max(img.width, img.height));
      const w = Math.round(img.width * scale);
      const h = Math.round(img.height * scale);
      const cv = document.createElement('canvas');
      cv.width = w; cv.height = h;
      cv.getContext('2d').drawImage(img, 0, 0, w, h);
      resolve(cv.toDataURL('image/jpeg', 0.85));
    };
    img.src = dataUrl;
  });
}

