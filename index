// CAROUSEL AI GENERATION
// ══════════════════════════════════════════════════════════════
async function _carRunAI(){
  const promptEl = document.getElementById('car-ai-prompt');
  const prompt = (promptEl?.value||'').trim();
  if(!prompt){ showUndoToast('⚠ Escribe un tema primero'); return; }

  const sheet  = document.getElementById('car-ai-sheet');
  const qty    = parseInt(sheet?._qty||3);
  const btn    = document.getElementById('car-ai-run-btn');
  const status = document.getElementById('car-ai-status');

  const isGroq = _aiProvider==='groq';
  const keyMap = {groq:'fsf_groq_key',anthropic:'fsf_ai_key',deepseek:'fsf_deepseek_key',gemini:'fsf_gemini_key',openrouter:'fsf_openrouter_key'};
  const apiKey = _storage.get(keyMap[_aiProvider]||'fsf_groq_key')||'';
  if(!apiKey){ showUndoToast('⚠ Configura una API key en Ajustes IA'); return; }

  if(btn){ btn.disabled=true; btn.textContent='⏳ Generando…'; }

  const sys = `Eres el director de arte de Fe Sin Fronteras, comunidad cristiana hispana.
Genera slides para un carrusel de Instagram. Cada slide debe ser visualmente diferente pero coherente con el tema.

RESPONDE SOLO CON UN ARRAY JSON VÁLIDO — sin texto antes ni después. Sin markdown. Sin \`\`\`.
Formato exacto (array de ${qty} objetos):
[
  {"fmt":"square","themeIdx":1,"overlayOpacity":0,"message":"descripción slide","objects":[
    {"type":"text","subtype":"title|verse|ref|body|hashtag","text":"TEXTO","fontId":"oswald","fontSize":120,"color":"#ffffff","align":"center|left|right","x":60,"y":80,"w":960,"h":300,"bold":true,"italic":false,"uppercase":true,"opacity":1,"zIndex":2,"visible":true,"rotation":0}
  ]}
]

TEMAS themeIdx: 0=Blanco 1=OscuroMarrón 2=Crema 3=Tierra 4=Morado 5=MoradoSuave 6=AzulProfundo 7=AzulCielo 8=Verde 9=Rojo
FUENTES: "playfair" "lora" "montserrat" "oswald" "nunito" "raleway" "dancing" "crimson"
REGLAS: mínimo 4 objetos por slide · x≥50 · x+w≤1030 · y≥40 · y+h≤1050 · visible:true en todos
CARRUSEL: cada slide tiene un propósito diferente:
  Slide 1 = portada impactante (título grande, gancho visual)
  Slide 2 = desarrollo/versículo clave
  Slide 3 = aplicación práctica / reflexión
  Slide 4+ = llamado a la acción o cierre inspiracional
Varía themeIdx entre slides para que sean visualmente distintos.`;

  const userMsg = `Crea un carrusel de ${qty} slides sobre: "${prompt}".
Genera exactamente ${qty} slides en un array JSON válido. Cada slide debe tener un propósito claro y diferente.`;

  const designs = [];
  try{
    for(let i=0;i<qty;i++){
      if(status) status.textContent = `Generando slide ${i+1} de ${qty}…`;
      if(i>0) await new Promise(r=>setTimeout(r,6000)); // rate limit pause

      const raw = await _aiCall(apiKey, isGroq, sys, [{role:'user', content: i===0 ? userMsg : `Continúa con el slide ${i+1} de ${qty} del mismo carrusel sobre "${prompt}". Responde SOLO con UN objeto JSON (no array).`}]);

      // Try to parse — handle both array and single object responses
      let parsed;
      try{
        const cleaned = raw.replace(/```json|```/g,'').trim();
        // First attempt: full array
        if(cleaned.startsWith('[')){
          parsed = JSON.parse(cleaned);
          if(Array.isArray(parsed)){ designs.push(...parsed); break; } // got all at once
        }
        // Second attempt: single object
        const m = cleaned.match(/\{[\s\S]*\}/);
        if(m){
          let j = m[0].replace(/,\s*}/g,'}').replace(/,\s*]/g,']');
          parsed = JSON.parse(j);
          if(parsed && Array.isArray(parsed.objects)) designs.push(parsed);
        }
      }catch(e){
        // Try truncation recovery
        const raw2 = raw.replace(/```json|```/g,'').trim();
        const start = raw2.indexOf('{');
        if(start>=0){
          for(let end=raw2.length;end>start+10;end--){
            try{ const p=JSON.parse(raw2.substring(start,end)); if(p&&p.objects){designs.push(p);break;}}catch(_){}
          }
        }
      }
    }

    if(!designs.length) throw new Error('La IA no devolvió diseños válidos');

    // Apply designs as new slides
    _carSaveCurrent();
    const startIdx = _CAR.slides.length;
    designs.forEach((d,i)=>{
      if(!d||!Array.isArray(d.objects)) return;
      const s = _carBlankSlide(`Slide ${startIdx+i+1}`);
      s.objects = d.objects.map(o=>({...o, id:'obj_'+Date.now()+'_'+Math.random().toString(36).slice(2), visible:true}));
      s.themeIdx = d.themeIdx??1;
      s.overlayOpacity = d.overlayOpacity??0;
      s.fmt = d.fmt||fmt;
      _CAR.slides.push(s);
    });

    _CAR.current = startIdx;
    _carRestoreSlide(_CAR.slides[_CAR.current]);
    _carUpdateStrip();
    _carUpdateNav();
    if(status) status.textContent = `✓ ${designs.length} slides generados`;
    showUndoToast(`✦ Carrusel de ${designs.length} slides creado`);
    // Close AI sheet after success
    setTimeout(()=>document.getElementById('car-ai-sheet')?.remove(), 1200);

  }catch(e){
    if(status) status.textContent = '⚠ '+e.message;
    showUndoToast('⚠ Error IA: '+e.message);
  }finally{
    if(btn){ btn.disabled=false; btn.textContent='✦ Generar carrusel'; }
  }
}

