// ── EPS FILE HANDLER ──
// EPS es PostScript binario — el browser no puede renderizarlo directamente.
// Estrategia: extraer preview JPEG/TIFF embebido (Illustrator siempre lo incluye)
// o mostrar modal de conversión con opciones claras.
async function _handleEpsFile(file) {
  showUndoToast('✦ Procesando EPS...');

  try {
    // Strategy 1: Read as ArrayBuffer and look for embedded JPEG preview
    // Illustrator EPS files embed a JPEG/TIFF preview in the binary header
    const buffer = await file.arrayBuffer();
    const bytes = new Uint8Array(buffer);
    const text = new TextDecoder('latin1').decode(bytes);

    // Check if it has embedded SVG (rare but possible)
    if (text.includes('<svg') || text.includes('%!PS-Adobe')) {
      const svgStart = text.search(/<svg/i);
      if (svgStart >= 0) {
        const svgEnd = text.lastIndexOf('</svg>') + 6;
        if (svgEnd > svgStart) {
          const svgString = text.slice(svgStart, svgEnd);
          _addVectorToCanvas(svgString, file.name);
          return;
        }
      }
    }

    // Strategy 2: Look for embedded JPEG preview
    // Illustrator EPS with preview has %BeginPreview / JPEG marker (FFD8FF)
    let jpegStart = -1;
    for (let i = 0; i < Math.min(bytes.length - 2, 65536); i++) {
      if (bytes[i] === 0xFF && bytes[i+1] === 0xD8 && bytes[i+2] === 0xFF) {
        jpegStart = i;
        break;
      }
    }

    if (jpegStart >= 0) {
      // Find JPEG end marker FFD9
      let jpegEnd = bytes.length;
      for (let i = jpegStart; i < bytes.length - 1; i++) {
        if (bytes[i] === 0xFF && bytes[i+1] === 0xD9) {
          jpegEnd = i + 2;
          break;
        }
      }
      const jpegBytes = bytes.slice(jpegStart, jpegEnd);
      const blob = new Blob([jpegBytes], { type: 'image/jpeg' });
      const url = URL.createObjectURL(blob);

      // Verify it's a valid image
      const img = new Image();
      img.onload = () => {
        addImageObj(url, 'rect');
        showUndoToast('✦ Preview del EPS importado — para editar vectores, convierte a SVG');
        URL.revokeObjectURL(url);
      };
      img.onerror = () => {
        URL.revokeObjectURL(url);
        _showEpsConvertModal(file.name);
      };
      img.src = url;
      return;
    }

    // Strategy 3: Try as image/x-eps directly (some browsers support it)
    const epsBlob = new Blob([buffer], { type: 'image/x-eps' });
    const epsUrl = URL.createObjectURL(epsBlob);
    const testImg = new Image();
    testImg.onload = () => {
      addImageObj(epsUrl, 'rect');
      showUndoToast('✦ EPS importado como imagen');
    };
    testImg.onerror = () => {
      URL.revokeObjectURL(epsUrl);
      _showEpsConvertModal(file.name);
    };
    testImg.src = epsUrl;

  } catch(e) {
    console.error('[EPS]', e);
    _showEpsConvertModal(file.name);
  }
}

