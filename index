function applyBrandPalette(i){
  const p = brandPalettes[i]; if(!p) return;
  pushUndo();
  // Apply to all text objects cycling through palette
  objects.forEach((o,idx)=>{
    if(o.type==='text') o.color = p.colors[idx % p.colors.length];
  });
  // Apply first color as bg theme
  customBgColor = p.colors[1]||null;
  applyBackground(); renderObjects();
  showUndoToast('✦ Paleta aplicada');
}
function applyPaletteColor(clr){
  if(!selectedId) return;
  const o=getObject(selectedId); if(!o) return;
  pushUndo(); o.color=clr; renderObjects();
}
function deleteBrandPalette(i){
  brandPalettes.splice(i,1);
  _storage.set('fsf_palettes',JSON.stringify(brandPalettes));
  renderBrandPalettes();
}

