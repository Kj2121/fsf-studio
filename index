// FLOATING TOOLBAR — KEYBOARD SUPPORT

// ZOOM

function zoomStep(delta){
  _zoomExtra = Math.min(4, Math.max(0.2, _zoomExtra + delta));
  _applyZoom();
}

function zoomFit(){
  _zoomExtra = 1.0;
  _applyZoom();
}

function zoom100(){
  const base = _getBaseScale();
  _zoomExtra = base > 0 ? 1 / base : 1;
  _applyZoom();
}

// Mouse wheel zoom — Ctrl/Cmd + wheel
document.addEventListener('wheel', e=>{
  if(!(e.ctrlKey||e.metaKey)) return;
  e.preventDefault();
  zoomStep(e.deltaY < 0 ? 0.1 : -0.1);
},{passive:false});

// Keyboard shortcuts: Ctrl+= / Ctrl+- / Ctrl+0
document.addEventListener('keydown', e=>{
  if(!(e.ctrlKey||e.metaKey)) return;
  if(e.key==='=' || e.key==='+'){ e.preventDefault(); zoomStep(0.1); }
  if(e.key==='-'){               e.preventDefault(); zoomStep(-0.1); }
  if(e.key==='0'){               e.preventDefault(); zoomFit(); }
});

// ALIGNMENT
function alignObj(dir){
  if(!selectedId) return;
  const obj=getObject(selectedId); if(!obj) return;
  const {W,H}=getFmtSize();
  pushUndo();
  const el=document.querySelector(`[data-id="${selectedId}"]`);
  const elW = el ? el.offsetWidth  : (obj.w||100);
  const elH = el ? el.offsetHeight : (obj.h||100);
  switch(dir){
    case 'left':         obj.x=0; break;
    case 'right':        obj.x=W-elW; break;
    case 'hcenter':      obj.x=Math.round((W-elW)/2); break;
    case 'top':          obj.y=0; break;
    case 'bottom':       obj.y=H-elH; break;
    case 'vcenter':      obj.y=Math.round((H-elH)/2); break;
    case 'canvas-center':
      obj.x=Math.round((W-elW)/2);
      obj.y=Math.round((H-elH)/2);
      break;
  }
  renderObjects();
  updateSelectionBox();
  if(obj.type==='text') requestAnimationFrame(positionFloatToolbar);
}

