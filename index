    </button>
    <div style="font-size:14px;font-weight:800;color:var(--gold);font-family:var(--ui-font);letter-spacing:-.2px;white-space:nowrap;">FSF<span style="color:rgba(255,255,255,0.85);font-weight:600;font-style:italic;"> Studio</span></div>
    <button class="hbtn" id="btn-undo" onclick="doUndo()" title="Deshacer" aria-label="Deshacer" style="opacity:.35;padding:5px 6px;margin-left:2px;">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="13" height="13"><path d="M3 7h13a5 5 0 010 10H6"/><polyline points="7 3 3 7 7 11"/></svg>
