// ── SVG TO CANVAS — Robust multi-method renderer ──────────────────────────
// Method 1: HTMLImageElement with blob URL (works on desktop Chrome/Firefox)
// Method 2: OffscreenCanvas with blob URL (Chrome Android)  
// Method 3: DOMParser direct canvas drawing (fallback, works everywhere)
async function _drawSvgToCanvas(ctx, svgStr, x, y, w, h, color) {
  // Inject explicit colors into every SVG element before rendering
  function injectColor(svg, clr) {
    // Add color to svg root
    let s = svg.replace(/(<svg[^>]*?)(\s*\/?>)/i, function(m, tag, end) {
      // Remove existing fill/color on root only if it would conflict
      return tag + ' fill="' + clr + '" color="' + clr + '"' + end;
    });
    // Inject fill/stroke on every shape element that doesn't have them
    s = s.replace(/<(path|rect|polygon|polyline|circle|ellipse|line)([^>]*?)(\/?>)/g,
      function(m, tag, attrs, close) {
        let a = attrs;
        if (!/fill\s*=/.test(a)) a = ' fill="' + clr + '"' + a;
        if (!/stroke\s*=/.test(a)) a = ' stroke="' + clr + '"' + a;
        return '<' + tag + a + close;
      }
    );
    return s;
  }

  const colored = injectColor(svgStr, color);

  // Method 1: Image + blob URL
  const ok = await new Promise(resolve => {
    try {
      const blob = new Blob([colored], {type: 'image/svg+xml;charset=utf-8'});
      const url = URL.createObjectURL(blob);
      const img = new Image();
      img.width = w; img.height = h;
      const timer = setTimeout(() => { URL.revokeObjectURL(url); resolve(false); }, 2000);
      img.onload = () => {
        clearTimeout(timer);
        try { ctx.drawImage(img, x, y, w, h); URL.revokeObjectURL(url); resolve(true); }
        catch(e) { URL.revokeObjectURL(url); resolve(false); }
      };
      img.onerror = () => { clearTimeout(timer); URL.revokeObjectURL(url); resolve(false); };
      img.src = url;
    } catch(e) { resolve(false); }
  });
  if (ok) return;

  // Method 2: data URI (fallback for environments where blob: is blocked for img)
  const ok2 = await new Promise(resolve => {
    try {
      const dataUri = 'data:image/svg+xml;base64,' + btoa(unescape(encodeURIComponent(colored)));
      const img = new Image();
      const timer = setTimeout(() => resolve(false), 2000);
      img.onload = () => {
        clearTimeout(timer);
        try { ctx.drawImage(img, x, y, w, h); resolve(true); }
        catch(e) { resolve(false); }
      };
      img.onerror = () => { clearTimeout(timer); resolve(false); };
      img.src = dataUri;
    } catch(e) { resolve(false); }
  });
  if (ok2) return;

  // Method 3: DOMParser + direct canvas drawing (always works, handles simple SVGs)
  try {
    const parser = new DOMParser();
    const doc = parser.parseFromString(colored, 'image/svg+xml');
    const svgEl = doc.querySelector('svg');
    if (!svgEl) return;

    // Get viewBox for scaling
    const vb = svgEl.getAttribute('viewBox');
    let vbX=0, vbY=0, vbW=100, vbH=100;
    if (vb) { const p=vb.trim().split(/[\s,]+/); vbX=+p[0]; vbY=+p[1]; vbW=+p[2]; vbH=+p[3]; }
    const scX = w / vbW, scY = h / vbH;

    ctx.save();
    ctx.translate(x, y);
    ctx.scale(scX, scY);

    function parseColor(val, def) {
      if (!val || val === 'none') return val||'none';
      return val;
    }

    function drawEl(el, inheritFill, inheritStroke) {
      const fill   = parseColor(el.getAttribute('fill')   || inheritFill,   color);
      const stroke = parseColor(el.getAttribute('stroke') || inheritStroke, 'none');
      const sw     = parseFloat(el.getAttribute('stroke-width') || 0);
      const op     = parseFloat(el.getAttribute('opacity') || 1);
      const tag    = el.tagName.toLowerCase();

      if (tag === 'g') {
        for (const child of el.children) drawEl(child, fill, stroke);
        return;
      }

      ctx.save();
      ctx.globalAlpha *= op;
      ctx.beginPath();

      if (tag === 'rect') {
        const rx2 = el.getAttribute('rx');
        const ex=+el.getAttribute('x')||0, ey=+el.getAttribute('y')||0;
        const ew=+el.getAttribute('width'), eh=+el.getAttribute('height');
        if (rx2) ctx.roundRect(ex, ey, ew, eh, +rx2);
        else ctx.rect(ex, ey, ew, eh);
      } else if (tag === 'circle') {
        const cx2=+el.getAttribute('cx'), cy2=+el.getAttribute('cy'), r=+el.getAttribute('r');
        ctx.arc(cx2, cy2, r, 0, Math.PI*2);
      } else if (tag === 'ellipse') {
        const cx2=+el.getAttribute('cx'), cy2=+el.getAttribute('cy');
        const rx2=+el.getAttribute('rx'), ry2=+el.getAttribute('ry');
        ctx.ellipse(cx2, cy2, rx2, ry2, 0, 0, Math.PI*2);
      } else if (tag === 'polygon' || tag === 'polyline') {
        const pts = (el.getAttribute('points')||'').trim().split(/[\s,]+/);
        if (pts.length >= 2) {
          ctx.moveTo(+pts[0], +pts[1]);
          for (let i=2; i<pts.length-1; i+=2) ctx.lineTo(+pts[i], +pts[i+1]);
          if (tag === 'polygon') ctx.closePath();
        }
      } else if (tag === 'line') {
        ctx.moveTo(+el.getAttribute('x1'), +el.getAttribute('y1'));
        ctx.lineTo(+el.getAttribute('x2'), +el.getAttribute('y2'));
      } else if (tag === 'path') {
        const d = el.getAttribute('d');
        if (d) {
          const p2d = new Path2D(d);
          if (fill && fill !== 'none') {
            ctx.fillStyle = fill;
            try { ctx.fill(p2d); } catch(e) {}
          }
          if (stroke && stroke !== 'none') {
            ctx.strokeStyle = stroke;
            ctx.lineWidth = sw || 1;
            ctx.lineJoin = 'round';
            ctx.lineCap = 'round';
            try { ctx.stroke(p2d); } catch(e) {}
          }
          ctx.restore();
          return;
        }
      }

      if (fill && fill !== 'none') { ctx.fillStyle = fill; ctx.fill(); }
      if (stroke && stroke !== 'none') {
        ctx.strokeStyle = stroke;
        ctx.lineWidth = sw || 2;
        ctx.stroke();
      }
      ctx.restore();
    }

    for (const child of svgEl.children) drawEl(child, color, 'none');
    ctx.restore();
  } catch(e) { console.warn('SVG draw failed:', e); }
}


// Parse CSS gradient string into canvas gradient
function _parseGradientForCanvas(ctx, cssGrad, x, y, w, h) {
  try {
    // linear-gradient(angle, color1, color2, ...)
    const linMatch = cssGrad.match(/linear-gradient\(([^,]+),([\s\S]+)\)/);
    if(linMatch) {
      const anglePart = linMatch[1].trim();
      const deg = anglePart.includes('deg') ? parseFloat(anglePart) : 
                  anglePart === 'to right' ? 90 :
                  anglePart === 'to bottom' ? 180 :
                  anglePart === 'to left' ? 270 : 135;
      const rad = (deg - 90) * Math.PI / 180;
      const half = Math.sqrt(w*w + h*h) / 2;
      const cx = x + w/2, cy = y + h/2;
      const x0 = cx - Math.cos(rad)*half, y0 = cy - Math.sin(rad)*half;
      const x1 = cx + Math.cos(rad)*half, y1 = cy + Math.sin(rad)*half;
      const grad = ctx.createLinearGradient(x0, y0, x1, y1);
      // Parse stops: "color1 pct%, color2 pct%"
      const stops = linMatch[2].split(',').map(s=>s.trim()).filter(Boolean);
      stops.forEach((s,i) => {
        const pctMatch = s.match(/^(.*?)\s+(\d+(?:\.\d+)?%?)$/);
        const color = pctMatch ? pctMatch[1].trim() : s;
        const pos   = pctMatch ? parseFloat(pctMatch[2])/100 : i/(stops.length-1||1);
        try { grad.addColorStop(pos, color); } catch(e){}
      });
      return grad;
    }
  } catch(e){}
  return null;
}


