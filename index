async function applyFsfWatermark(canvas){
  if(!FSF_WATERMARK.enabled) return canvas;
  const ctx = canvas.getContext('2d');
  const W = canvas.width, H = canvas.height;
  const pad = Math.round(W * 0.025);
  ctx.save();
  ctx.globalAlpha = FSF_WATERMARK.opacity;

  if(FSF_WATERMARK.style === 'badge'){
    // Pill badge with "FSF" text
    const fs = Math.round(W * 0.022);
    const text = 'Fe Sin Fronteras';
    ctx.font = `700 ${fs}px Montserrat,sans-serif`;
    const tw = ctx.measureText(text).width;
    const bw = tw + fs * 1.4;
    const bh = fs * 1.8;
    const br = bh / 2;
    const positions = {
      'bottom-right': [W - bw - pad, H - bh - pad],
      'bottom-left':  [pad, H - bh - pad],
      'bottom-center':[W/2 - bw/2, H - bh - pad],
      'top-right':    [W - bw - pad, pad],
      'top-left':     [pad, pad],
    };
    const [bx, by] = positions[FSF_WATERMARK.position] || positions['bottom-right'];
    // Background pill
    ctx.fillStyle = 'rgba(0,0,0,0.55)';
    ctx.beginPath();
    ctx.roundRect(bx, by, bw, bh, br);
    ctx.fill();
    // Star + text
    ctx.fillStyle = '#7C5BF0';
    ctx.textAlign = 'left';
    ctx.textBaseline = 'middle';
    ctx.font = `700 ${fs}px Montserrat,sans-serif`;
    ctx.fillText('✦ ' + text, bx + fs * 0.5, by + bh / 2);
  } else {
    // Simple text watermark
    const fs = Math.round(W * 0.018);
    ctx.font = `700 ${fs}px Montserrat,sans-serif`;
    ctx.fillStyle = '#7C5BF0';
    ctx.textBaseline = 'bottom';
    const positions = {
      'bottom-right': { align:'right',  x: W - pad, y: H - pad },
      'bottom-left':  { align:'left',   x: pad,     y: H - pad },
      'bottom-center':{ align:'center', x: W/2,     y: H - pad },
      'top-right':    { align:'right',  x: W - pad, y: pad + fs },
      'top-left':     { align:'left',   x: pad,     y: pad + fs },
    };
    const p = positions[FSF_WATERMARK.position] || positions['bottom-right'];
    ctx.textAlign = p.align;
    ctx.fillText('✦ Fe Sin Fronteras', p.x, p.y);
  }

  ctx.restore();
  return canvas;
}

