async function aiGenerate(overrideEstilo, overrideTono){
  const prompt = (document.getElementById('ai-prompt-desk')?.value||'').trim();
  if(!prompt){ return; }
  const btn = document.getElementById('ai-gen-btn-desk');
  const resultEl = document.getElementById('ai-result');
  if(!btn || !resultEl) return;

  btn.disabled = true;
  btn.innerHTML = '<div class="ai-thinking"><div class="ai-dot"></div><div class="ai-dot"></div><div class="ai-dot"></div><span>Claude está pensando…</span></div>';
  resultEl.style.display = 'block';
  resultEl.innerHTML = '<div class="ai-thinking"><div class="ai-dot"></div><div class="ai-dot"></div><div class="ai-dot"></div><span>Generando versículos y frases impactantes…</span></div>';

  const _estiloMap = {inspiracional:'inspiracional y esperanzador',evangelistico:'evangelístico con urgencia de salvación',reflexivo:'contemplativo y reflexivo',adoracion:'de adoración y alabanza a Dios',guerreros:'de guerra espiritual y victoria',sanidad:'de sanidad y restauración'};
  const _tonoMap = {poetico:'poético y lírico',directo:'directo y contundente',juvenil:'juvenil y energético',formal:'formal y pastoral',urgente:'urgente y convocante'};
  const _estiloDesc = _estiloMap[overrideEstilo||'inspiracional'] || 'inspiracional';
  const _tonoDesc   = _tonoMap[overrideTono||'poetico'] || 'poético';
  const systemPrompt = `Eres un asistente creativo para una app cristiana de diseño de posts llamada "Fe Sin Fronteras".
Tu rol es generar versículos bíblicos relevantes y frases inspiradoras en español para diseños de redes sociales.

Dado un tema, devuelve EXACTAMENTE 3 resultados en JSON con este formato (solo JSON, sin markdown):
{
  "results": [
    {
      "ref": "Referencia bíblica (libro capítulo:versículo)",
      "verse": "El texto del versículo entre comillas latinas",
      "phrase": "Una frase reflexiva corta, poética, impactante (máx 12 palabras). No cites el versículo, es una frase propia."
    }
  ]
}

Reglas:
- Usa versículos reales y precisos de la Biblia en español (Reina-Valera o NVI)
- Las frases deben ser originales, poéticas y culturalmente resonantes para la iglesia hispana
- Adapta siempre al tema solicitado
- Solo devuelve JSON válido, sin explicaciones
- Estilo del contenido: ${_estiloDesc}
- Tono de las frases: ${_tonoDesc}`;

  try {
    const response = await fetch('https://api.anthropic.com/v1/messages', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        model: 'claude-sonnet-4-20250514',
        max_tokens: 1000,
        system: systemPrompt,
        messages: [{ role: 'user', content: `Tema: ${prompt}` }]
      })
    });

    if(!response.ok) throw new Error('API ' + response.status);
    const data = await response.json();
    const text = data.content?.map(c=>c.text||'').join('') || '';
    const clean = text.replace(/```json|```/g,'').trim();
    const parsed = JSON.parse(clean);
    const results = parsed.results || [];

    if(!results.length) throw new Error('Sin resultados');

    resultEl.innerHTML = results.map((r,i)=>{
      const rs = JSON.stringify(JSON.stringify(r)).slice(1,-1);
      return `<div class="ai-result-item" onclick="applyAiResult('${rs}')" role="button" tabindex="0" aria-label="Aplicar: ${r.ref}">
        <div class="ai-result-ref">✦ ${r.ref}</div>
        <div class="ai-result-verse">${r.verse}</div>
        <div class="ai-result-phrase">${r.phrase}</div>
      </div>`;
    }).join('');

  } catch(err) {
    // Si hay error de red o API, mostrar mensaje claro al usuario
    const isNetworkError = err.message.includes('fetch') || err.message.includes('Failed') || err.message.includes('NetworkError');
    if(isNetworkError){
      resultEl.innerHTML = `<div style="font-size:10px;color:rgba(255,100,100,0.9);background:rgba(255,50,50,0.08);border:1px solid rgba(255,80,80,0.2);border-radius:8px;padding:10px 12px;margin-bottom:8px;line-height:1.5;">
        ⚠ Sin conexión a internet.<br>
        <span style="color:rgba(255,255,255,0.5);font-size:9px;">Mostrando versículos locales como alternativa.</span>
      </div>`;
    }
    // Fallback to local verse bank if API fails
    const keyMap = {
      'fe':['Fe'],'confianza':['Fe'],'creer':['Fe'],
      'salv':['Salvación'],'jesus':['Salvación'],'gracia':['Gracia'],'perdón':['Gracia'],
      'san':['Sanidad'],'enfer':['Sanidad'],'dolor':['Sanidad'],
      'famil':['Familia'],'hijo':['Familia'],'matrimonio':['Familia'],
      'orac':['Oración'],'paz':['Paz'],'ansied':['Paz'],
      'alaba':['Alabanza'],'adorac':['Alabanza'],
    };
    let cats = [];
    for(const [k,v] of Object.entries(keyMap)){ if(prompt.toLowerCase().includes(k)) cats.push(...v); }
    if(!cats.length) cats = Object.keys(VERSE_CATEGORIES).filter(x=>x!=='Todos');
    let pool = [];
    cats.forEach(cat=>{ if(VERSE_CATEGORIES[cat]) pool.push(...VERSE_CATEGORIES[cat]); });
    if(pool.length<3) pool.push(...VERSE_BANK);
    pool = pool.sort(()=>Math.random()-0.5).slice(0,3);
    const phrases = ['Lo que Dios promete, Dios cumple.','Tu historia no ha terminado.','La fe actúa antes de ver el resultado.'];
    resultEl.innerHTML = `<div style="font-size:9px;color:rgba(251,191,36,0.7);background:rgba(251,191,36,0.06);border:1px solid rgba(251,191,36,0.2);border-radius:8px;padding:7px 10px;margin-bottom:8px;">⚠ Modo offline — mostrando versículos locales</div>` +
      pool.map((v,i)=>{
