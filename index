function _isBgLight(){
  // Returns true if the current background is light (needs dark text)
  if(_customGradient) return false; // gradients are dark
  if(bgImgSrc) return false;        // photos — assume dark overlay
  const th = THEMES[themeIdx]||THEMES[0];
  if(themeIdx === 0) return true;    // Blanco
  if(themeIdx === 2) return true;    // Crema
  // Check customBgColor lightness
  if(customBgColor){
    const hex = customBgColor.replace('#','');
    if(hex.length===6){
      const r=parseInt(hex.slice(0,2),16),g=parseInt(hex.slice(2,4),16),b=parseInt(hex.slice(4,6),16);
      return (r*299+g*587+b*114)/1000 > 140;
    }
  }
  return false;
}

