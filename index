  if(!key||!wrap||!obj.imgSrc){ if(cv) cv.remove(); delete el.dataset.fxKey; return; }
  if(cv && el.dataset.fxKey===key) return;
  el.dataset.fxKey=key;
  const token=(el._fxTok=(el._fxTok||0)+1);
  clearTimeout(el._fxT);
  el._fxT=setTimeout(async()=>{
    try{
      const img=await _fxLoadImg(obj.imgSrc);
      if(token!==el._fxTok) return;
      const bw=obj.w, bh=obj.h||obj.w, pv=Math.min(1,760/Math.max(bw,bh));
