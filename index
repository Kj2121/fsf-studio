document.addEventListener('keydown',e=>{
  if(e.target.hasAttribute('contenteditable')||e.target.tagName==='INPUT'||e.target.tagName==='TEXTAREA') return;
  if((e.ctrlKey||e.metaKey)&&e.key==='z'&&!e.shiftKey){e.preventDefault();doUndo();}
  if((e.ctrlKey||e.metaKey)&&(e.key==='y'||(e.key==='z'&&e.shiftKey))){e.preventDefault();doRedo();}
  if(e.key==='Delete'||e.key==='Backspace'){if(selectedId){e.preventDefault();deleteSelected();}}
  if(e.key==='Escape'){clearSelection();document.getElementById('mob-drawer')?.classList.remove('open');}
  if((e.ctrlKey||e.metaKey)&&e.key==='d'){e.preventDefault();duplicateSelected();}
  // Tab — toggle floating toolbar visibility (like Photoshop)
  if(e.key==='Tab' && !e.ctrlKey && !e.metaKey && document.getElementById('float-toolbar').classList.contains('show')){
    e.preventDefault(); ftTogglePanel();
  }
  // arrow keys for nudge
  if(selectedId){
    const obj=getObject(selectedId);if(!obj)return;
    const step=e.shiftKey?10:1;
    // BUG FIX: guardar estado antes del nudge para poder deshacer con Ctrl+Z
    if(e.key==='ArrowLeft'||e.key==='ArrowRight'||e.key==='ArrowUp'||e.key==='ArrowDown'){
      pushUndo();
    }
    if(e.key==='ArrowLeft'){e.preventDefault();obj.x-=step;const el=document.querySelector(`[data-id="${selectedId}"]`);if(el)el.style.left=obj.x+'px';updateSelectionBox();}
    if(e.key==='ArrowRight'){e.preventDefault();obj.x+=step;const el=document.querySelector(`[data-id="${selectedId}"]`);if(el)el.style.left=obj.x+'px';updateSelectionBox();}
    if(e.key==='ArrowUp'){e.preventDefault();obj.y-=step;const el=document.querySelector(`[data-id="${selectedId}"]`);if(el)el.style.top=obj.y+'px';updateSelectionBox();}
    // BUG FIX: ArrowDown usaba style.left en vez de style.top
    if(e.key==='ArrowDown'){e.preventDefault();obj.y+=step;const el=document.querySelector(`[data-id="${selectedId}"]`);if(el)el.style.top=obj.y+'px';updateSelectionBox();}
  }
});

