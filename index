// ── ARCTEXT ─────────────────────────────────────────────────────
// SVG uses a normalized 100×100 viewBox so it scales with the container.
// arcRadiusPct : radius as fraction of half-box (0.3–0.95), default 0.72
// arcFontSizePct: font size as % of viewBox units, default 8

function _buildArcSvg(obj) {
  const VB = 100, cx = 50, cy = 50;
  const rPct = obj.arcRadiusPct != null ? obj.arcRadiusPct : 0.72;
  const r    = rPct * VB / 2;
  const dir    = obj.arcDirection || 'up';
  const spread = obj.arcSpread    || 180;
  const fsPct  = obj.arcFontSizePct != null ? obj.arcFontSizePct : 8;
  const f      = FONTS.find(ff=>ff.id===obj.fontId)||FONTS[0];
  const family = f.family.replace(/['"]/g,'');
  const color  = obj.color || '#C9A84C';
  const ls     = (obj.letterSpacing && obj.letterSpacing !== 'normal') ? parseFloat(obj.letterSpacing)||0 : 0;
  const lsVB   = ls > 0 ? (ls / (obj.w||400)) * VB : 0;
  const text   = obj.uppercase ? (obj.text||'').toUpperCase() : (obj.text||'');
  const fItalic = (obj.fontStyle==='italic'||obj.italic) ? 'italic' : 'normal';
  const fWeight = (obj.fontWeight==='700'||obj.bold)     ? '700'    : '400';

  const startAngle = dir==='up'
    ? (-90 - spread/2) * Math.PI/180
    : ( 90 - spread/2) * Math.PI/180;
  const endAngle = dir==='up'
    ? (-90 + spread/2) * Math.PI/180
    : ( 90 + spread/2) * Math.PI/180;

  const x1 = cx + r * Math.cos(startAngle);
  const y1 = cy + r * Math.sin(startAngle);
  const x2 = cx + r * Math.cos(endAngle);
  const y2 = cy + r * Math.sin(endAngle);
  const largeArc = spread > 180 ? 1 : 0;
  const pid = 'arc_' + (obj.id||'x');
  const pathD = `M ${x1.toFixed(3)} ${y1.toFixed(3)} A ${r.toFixed(3)} ${r.toFixed(3)} 0 ${largeArc} 1 ${x2.toFixed(3)} ${y2.toFixed(3)}`;

  const strokeAttrs = (obj.textStrokeW && obj.textStrokeC)
    ? `paint-order="stroke fill" stroke="${obj.textStrokeC}" stroke-width="${(parseFloat(obj.textStrokeW)*2/((obj.w||400)/VB)).toFixed(2)}" stroke-linejoin="round"`
    : '';

  const escaped = (text||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');

  return `<svg xmlns="http://www.w3.org/2000/svg" style="position:absolute;top:0;left:0;width:100%;height:100%;overflow:visible;" viewBox="0 0 ${VB} ${VB}" preserveAspectRatio="xMidYMid meet"><defs><path id="${pid}" d="${pathD}"/></defs><text font-family="${family.replace(/"/g,"'")}" font-size="${fsPct}" font-style="${fItalic}" font-weight="${fWeight}" fill="${color}" letter-spacing="${lsVB.toFixed(2)}" ${strokeAttrs}><textPath href="#${pid}" startOffset="50%" text-anchor="middle">${escaped}</textPath></text></svg>`;
}

function _migrateArcObj(obj) {
  if(obj.type !== 'arctext') return;
  if(obj.arcRadiusPct == null && obj.arcRadius != null) {
    obj.arcRadiusPct = Math.min(0.95, Math.max(0.3, obj.arcRadius / (Math.min(obj.w,obj.h)/2)));
    delete obj.arcRadius;
  }
  if(obj.arcFontSizePct == null && obj.fontSize != null) {
    obj.arcFontSizePct = Math.min(20, Math.max(2, (obj.fontSize / (obj.w||400)) * 100));
    delete obj.fontSize;
  }
  if(obj.arcRadiusPct  == null) obj.arcRadiusPct  = 0.72;
  if(obj.arcFontSizePct == null) obj.arcFontSizePct = 8;
}

