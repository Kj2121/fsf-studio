    });
    if(!resp.ok){ const e=await resp.json().catch(()=>({})); throw new Error(e.error?.message||'Groq '+resp.status); }
    text = (await resp.json()).choices?.[0]?.message?.content || '';
  }

  // ── GEMINI FLASH (gratis con key de Google AI Studio) ──
  else if(provider === 'gemini'){
    const model = await _geminiDetectModel(apiKey);
    if(!model) throw new Error('No se encontró modelo de Gemini disponible. Verifica tu key en aistudio.google.com');
    const resp = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/${model}:generateContent?key=${apiKey}`, {
      method:'POST',
