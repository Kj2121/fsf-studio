  if(!selectedId) return; // ya no hay nada seleccionado

  const target = e.target;

  // No deseleccionar si el touch fue en:
  const keep = [
    // El elemento seleccionado o sus hijos (handles, texto, etc.)
    target.closest('.cv-el'),
    target.closest('.sel-box'),
    target.closest('.sel-bar'),
    target.closest('.sel-handle'),
    target.closest('.float-toolbar'),
    target.closest('#align-bar'),
    // Paneles de propiedades del lado izquierdo/derecho
    target.closest('.pnl-l'),
    target.closest('.pnl-r'),
    // Panel de capas
    target.closest('#layers-panel'),
    target.closest('.layer-item'),
    // Drawer móvil
    target.closest('#mob-drawer'),
    target.closest('#mob-bar'),
    // Modales abiertos (verse bank, pexels, share, etc.)
    target.closest('.modal'),
    target.closest('#vmodal'),
    target.closest('#isrch-modal'),
    target.closest('#share-modal'),
    target.closest('#_v4vb'),
    target.closest('#_dl_ov'),
    // Barras de herramientas superiores
    target.closest('.topbar'),
    target.closest('.hdr'),
    // Botones de zoom y alineación
    target.closest('.zoom-bar'),
  ].some(Boolean);

  if(!keep) {
    clearSelection();
    renderLayersPanel();
  }
}, { passive: true });

