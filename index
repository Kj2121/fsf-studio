async function kitGenRun(){
  const kit = (() => { try{ return JSON.parse(_storage.get('fsf_brand_kit')||'null'); }catch(e){return null;} })();
  const theme = document.getElementById('kit-theme-val')?.value || 'fe';
  const qty   = parseInt(document.getElementById('kit-qty-val')?.value || '3');
  const note  = (document.getElementById('kit-note')?.value||'').trim();

  const isGroq = _aiProvider==='groq';
  const keyMap = {groq:'fsf_groq_key',anthropic:'fsf_ai_key',deepseek:'fsf_deepseek_key',gemini:'fsf_gemini_key',openrouter:'fsf_openrouter_key'};
  const apiKey = _storage.get(keyMap[_aiProvider]||'fsf_groq_key')||'';
  if(!apiKey){ showUndoToast('⚠ Configura una API key en Ajustes IA'); return; }

  const btn = document.getElementById('kit-gen-btn');
  const result = document.getElementById('kit-gen-result');
  if(btn){ btn.disabled=true; btn.textContent='⏳ Generando 1/'+qty+'...'; btn.style.opacity='0.7'; }

  const kitContext = kit ? `
IDENTIDAD DE MARCA:
- Iglesia: ${kit.name||'Fe Sin Fronteras'}
- Tagline: ${kit.tagline||'Fe · Esperanza · Amor'}
- Colores: ${(kit.colors||[]).join(', ')}
- Fuente: ${kit.font||'playfair'}
USA EXACTAMENTE estos colores. La fuente ${kit.font||'playfair'} en títulos.` : '';

  const themeMap = {
    fe:'fe, confianza y paz', alabanza:'alabanza y adoración',
    esperanza:'esperanza y nueva vida', guerra:'guerra espiritual y victoria',
    familia:'familia cristiana', evento:'evento especial de iglesia',
  };

  // ── ARQUETIPOS para variar los diseños ──
  const arquetipos = [
    'IMPACTO TIPOGRÁFICO: título enorme (150-180px), versículo secundario, fondo oscuro',
    'EDITORIAL ELEGANTE: versículo protagonista en serif, composición refinada, fondo claro o crema',
    'MODERNO GEOMÉTRICO: estructura con bloques, Montserrat/Oswald bold, fondo vibrante',
    'MINIMALISTA: 2-3 elementos solamente, mucho espacio vacío, máximo impacto',
    'CALIDEZ NARRATIVA: fuente script, tono íntimo, colores cálidos',
  ];

  // Kit usa system prompt reducido para no exceder TPM de Groq
  const kitSys = `Eres el director de arte de Fe Sin Fronteras. Genera diseños JSON profesionales.
RESPONDE SOLO CON JSON VÁLIDO. Sin texto extra. Sin markdown.

FORMATO:
{"fmt":"square","themeIdx":1,"overlayOpacity":0,"message":"descripción","objects":[
  {"type":"text","subtype":"title|verse|ref|body|hashtag","text":"TEXTO","fontId":"oswald","fontSize":120,"color":"#ffffff","align":"center|left|right","x":60,"y":80,"w":960,"h":300,"bold":true,"italic":false,"uppercase":true,"opacity":1,"zIndex":2,"visible":true,"rotation":0}
]}

TEMAS: 0=Blanco 1=OscuroMarrón 2=Crema 3=Tierra 4=Morado 5=MoradoSuave 6=AzulProfundo 7=AzulCielo 8=Verde 9=Rojo 10=Esmeralda
FUENTES: "playfair" "lora" "montserrat" "oswald" "nunito" "raleway" "dancing" "crimson"
REGLAS: mínimo 5 objetos · x≥50 · x+w≤1030 · incluir etiqueta editorial + palabra fantasma + firma al pie
${kitContext}`;
  const sys = kitSys;

  // Preparar grid de resultados
  if(result){
    result.innerHTML = '<div style="font-size:12px;font-weight:700;color:rgba(255,255,255,0.7);font-family:var(--ui-font);margin-bottom:10px;">Generando diseños...</div>';
    const grid = document.createElement('div');
    grid.id = 'kit-cards-grid';
    grid.style.cssText = 'display:grid;grid-template-columns:repeat(3,1fr);gap:8px;';
    result.appendChild(grid);
  }

  // ── GENERAR DE UNO EN UNO ──
  const designs = [];
  for(let i = 0; i < qty; i++){
    if(btn) btn.textContent = `⏳ Generando ${i+1}/${qty}...`;

    // Esperar 1.5s entre requests para no golpear el rate limit
    if(i > 0) await new Promise(r => setTimeout(r, 8000)); // 8s pause to avoid rate limit

    const arquetipoActual = arquetipos[i % arquetipos.length];
    const userMsg = `Genera UN SOLO diseño (diseño ${i+1} de ${qty}) sobre "${themeMap[theme]||theme}" para ${kit?.name||'mi iglesia'}.
Arquetipo obligatorio: ${arquetipoActual}.
${note ? 'Contexto: '+note : ''}
RESPONDE SOLO CON JSON VÁLIDO. Sin texto antes o después. Sin arrays. Máximo 6 objetos.`;

    try{
      const raw = await _aiCall(apiKey, isGroq, sys, [{role:'user', content:userMsg}]);
      const m = raw.match(/\{[\s\S]*\}/);
      if(!m) throw new Error('JSON no encontrado');
      // Try to fix common JSON issues before parsing
      let jsonStr = m[0]
        .replace(/,\s*}/g, '}')          // trailing commas
        .replace(/,\s*]/g, ']')          // trailing commas in arrays
        .replace(/([{,]\s*)'([^']+)'(\s*:)/g, '$1"$2"$3')  // single-quoted keys
        .replace(/:\s*'([^']*)'/g, ': "$1"');               // single-quoted values
            let design;
      try { design = JSON.parse(jsonStr); }
      catch(e) {
        // Si falla, intentar extraer solo hasta el cierre del array de objects
        const rawClean = raw.replace(/```json|```/g,'').trim();
        const objStart = rawClean.indexOf('{');
        if(objStart === -1) throw new Error('Sin JSON en respuesta');
        // Try to find a valid JSON object by truncating at different points
        let parsed = null;
        for(let end = rawClean.length; end > objStart+10; end--){
          try{ parsed = JSON.parse(rawClean.substring(objStart, end)); break; }catch(_){}
        }
        if(!parsed) throw new Error('JSON inválido: ' + e.message.substring(0,50));
        design = parsed;
      }
      // Normalize: ensure objects is an array
      if(!design) throw new Error('Sin diseño');
      if(!design.objects) throw new Error('Diseño sin objetos');
      if(!Array.isArray(design.objects)){
        // Sometimes objects comes as {0:{...}, 1:{...}} — convert to array
        design.objects = Object.values(design.objects);
      }
      if(!design.objects.length) throw new Error('Lista de objetos vacía');
      designs.push(design);

      // Añadir card al grid inmediatamente
      const grid = document.getElementById('kit-cards-grid');
      if(grid){
        const card = document.createElement('div');
        card.style.cssText='background:rgba(255,255,255,0.03);border:1.5px solid rgba(255,255,255,0.08);border-radius:14px;overflow:hidden;cursor:pointer;transition:all .2s;animation:aiMsgIn .25s ease;';

        const cv = document.createElement('canvas');
        const SIZE = 140;
        const F = FMTS[design.fmt||'square']||FMTS.square;
        cv.width=SIZE; cv.height=Math.round(F.H/F.W*SIZE);
        cv.style.cssText='width:100%;display:block;';
        const ctx = cv.getContext('2d');
        const th = THEMES[design.themeIdx||1]||THEMES[1];
        if(th.g&&th.g!=='transparent'){try{drawCSSGradient(ctx,th.g,cv.width,cv.height);}catch(e){ctx.fillStyle='#0D0A1A';ctx.fillRect(0,0,cv.width,cv.height);}}
        else{ctx.fillStyle='#fff';ctx.fillRect(0,0,cv.width,cv.height);}
        const sc = SIZE/F.W;
        (design.objects||[]).filter(o=>o.type==='text'&&o.visible!==false).slice(0,4).forEach(o=>{
          const fs=Math.max(3,o.fontSize*sc); ctx.save();
          ctx.font=`${o.italic?'italic ':''}${o.bold?'bold ':''}${fs}px sans-serif`;
          ctx.fillStyle=o.color||'#fff'; ctx.globalAlpha=o.opacity??0.92;
          ctx.textAlign=o.align==='center'?'center':o.align==='right'?'right':'left';
          ctx.textBaseline='top'; ctx.shadowColor='rgba(0,0,0,0.5)'; ctx.shadowBlur=2;
          const ax=o.align==='center'?(o.x+o.w/2)*sc:o.align==='right'?(o.x+o.w)*sc:o.x*sc;
          (o.text||'').split('\n').slice(0,2).forEach((line,li)=>{
            ctx.fillText((o.uppercase?line.toUpperCase():line).substring(0,22),ax,o.y*sc+li*fs*1.3,o.w*sc);
          });
          ctx.restore();
        });
        card.appendChild(cv);

        const label = document.createElement('div');
        label.style.cssText='padding:6px 8px;font-size:9px;font-weight:700;color:rgba(255,255,255,0.45);font-family:var(--ui-font);text-align:center;letter-spacing:.5px;background:rgba(0,0,0,0.25);';
        label.textContent = `DISEÑO ${i+1}`;
        card.appendChild(label);

        const idx = designs.length - 1;
        card.onclick = () => {
          document.querySelectorAll('#kit-cards-grid > div').forEach(c=>c.style.borderColor='rgba(255,255,255,0.08)');
          card.style.borderColor='rgba(30,123,255,0.6)';
          card.style.boxShadow='0 0 0 2px rgba(30,123,255,0.15)';
          _aiApplyDesignToCanvas(designs[idx]);
          fsfLearnDesignApplied(designs[idx]);
          setTimeout(()=>_aiUpdateSuggestions(designs[idx]), 200);
          showUndoToast('✦ Diseño '+(idx+1)+' aplicado');
          // Cerrar el modal del kit para ver el diseño en el lienzo
          setTimeout(()=>{ document.getElementById('kit-gen-modal')?.remove(); }, 300);
        };
        card.addEventListener('touchstart',()=>{card.style.transform='scale(0.97)';},{passive:true});
        card.addEventListener('touchend',()=>{card.style.transform='';},{passive:true});
        grid.appendChild(card);
      }

    }catch(err){
      // Si falla uno, mostrar error en esa posición y continuar
      const grid = document.getElementById('kit-cards-grid');
      if(grid){
        const errCard = document.createElement('div');
        errCard.style.cssText='background:rgba(255,80,80,0.06);border:1px solid rgba(255,80,80,0.2);border-radius:14px;padding:12px;display:flex;align-items:center;justify-content:center;aspect-ratio:1;';
        errCard.innerHTML=`<div style="font-size:9px;color:rgba(255,100,100,0.7);font-family:var(--ui-font);text-align:center;">Error<br>${err.message.substring(0,40)}</div>`;
        grid.appendChild(errCard);
      }
    }
  }

  // Mostrar botón cerrar al terminar
  if(result){
    const done = document.createElement('div');
    done.style.cssText='margin-top:12px;font-size:11px;color:rgba(74,222,128,0.7);font-family:var(--ui-font);text-align:center;';
    done.textContent = `✦ ${designs.length}/${qty} diseños generados — el 1° ya está en tu lienzo`;
    result.appendChild(done);
    const closeBtn = document.createElement('button');
    closeBtn.style.cssText='width:100%;margin-top:8px;height:44px;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:12px;color:rgba(255,255,255,0.45);font-size:12px;font-weight:700;cursor:pointer;font-family:var(--ui-font);';
    closeBtn.textContent='Cerrar y ver diseño';
    closeBtn.onclick=()=>document.getElementById('kit-gen-modal')?.remove();
    result.appendChild(closeBtn);

    // AUTO-APLICAR el primer diseño al lienzo
    if(designs[0]){
      _aiApplyDesignToCanvas(designs[0]);
      try{ fsfLearnDesignApplied(designs[0]); }catch(e){}
      // Marcar primera card
      const firstCard=document.querySelector('#kit-cards-grid > div');
      if(firstCard){ firstCard.style.borderColor='rgba(74,222,128,0.6)'; firstCard.style.boxShadow='0 0 0 2px rgba(74,222,128,0.15)'; }
    }
  }

  if(btn){ btn.disabled=false; btn.textContent='✦ Generar de nuevo'; btn.style.opacity='1'; }

}



