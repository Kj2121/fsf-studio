async function shareToApp(app) {
  if(!shareBlob){ showUndoToast('⏳ Espera que se genere la imagen'); return; }
  const filename = 'FSF_Studio_' + Date.now() + '.png';

  // ── Android/iOS Web Share API — el más directo ──
  if(app === 'native' || app === 'whatsapp' || app === 'instagram' || app === 'telegram' || app === 'facebook') {
    if(navigator.share && navigator.canShare) {
      try {
        const file = new File([shareBlob], filename, {type:'image/png'});
        if(navigator.canShare({files:[file]})) {
          await navigator.share({
            files: [file],
            title: 'Fe Sin Fronteras',
            text: '¡Compartido desde FSF Studio! ✦'
          });
          closeShareModal();
          return;
        }
      } catch(e) {
        if(e.name === 'AbortError') return; // user cancelled
        // Fall through to manual method
      }
    }
  }

  // ── Fallback manual — descarga + instrucciones ──
  const url = URL.createObjectURL(shareBlob);

  if(app === 'whatsapp') {
    // Download then open WhatsApp
    _shareDownloadAndOpen(url, filename, 'whatsapp', '📲 Imagen guardada · Abriendo WhatsApp...', 'https://wa.me/');
  } else if(app === 'instagram') {
    _shareDownloadAndOpen(url, filename, 'instagram', '📲 Imagen guardada · Abriendo Instagram...', 'https://www.instagram.com/');
  } else if(app === 'facebook') {
    _shareDownloadAndOpen(url, filename, 'facebook', '📲 Imagen guardada · Abriendo Facebook...', 'https://www.facebook.com/');
  } else if(app === 'telegram') {
    _shareDownloadAndOpen(url, filename, 'telegram', '📲 Imagen guardada · Abriendo Telegram...', 'https://t.me/');
