  const intentText = intent ? `\n\nINTENCIÓN: "${intent}"\nAdapta el versículo y mensaje a esta intención.` : '';
  const userPrompt = `Analiza esta imagen y crea un diseño cristiano profesional.${intentText}\nResponde SOLO con el JSON.`;

