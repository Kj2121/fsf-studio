let _myElPendingData = null;
let _myElPendingType = null;

function myElFileSelected(input){
  const file = input.files[0];
  if(!file) return;
  const isSvg = file.type === 'image/svg+xml' || file.name.endsWith('.svg');
  const reader = new FileReader();
  reader.onload = e => {
    _myElPendingData = e.target.result;
    _myElPendingType = isSvg ? 'svg' : 'png';
    // Show preview
    const preview = document.getElementById('myel-file-preview');
    if(preview){
      if(isSvg){
        preview.innerHTML = `<div style="width:60px;height:60px;margin:0 auto 8px;">${_myElPendingData}</div>
          <div style="font-size:11px;color:rgba(74,222,128,0.8);font-weight:700;font-family:var(--ui-font);">✓ SVG listo</div>`;
        const svgEl = preview.querySelector('svg');
        if(svgEl) svgEl.style.cssText='width:100%;height:100%;';
      } else {
        preview.innerHTML = `<img src="${_myElPendingData}" style="width:80px;height:80px;object-fit:contain;margin:0 auto 8px;display:block;border-radius:8px;">
          <div style="font-size:11px;color:rgba(74,222,128,0.8);font-weight:700;font-family:var(--ui-font);">✓ Imagen lista</div>`;
      }
    }
    // Enable save button
    const btn = document.getElementById('myel-save-btn');
    if(btn){
      btn.disabled = false;
      btn.style.background = 'linear-gradient(135deg,rgba(30,123,255,0.3),rgba(20,72,180,0.2))';
      btn.style.borderColor = 'rgba(30,123,255,0.5)';
      btn.style.color = '#7DB0FF';
      btn.style.cursor = 'pointer';
    }
  };
  if(isSvg) reader.readAsText(file);
  else reader.readAsDataURL(file);
}

function myElSaveFromModal(){
  if(!_myElPendingData){ showUndoToast('⚠ Selecciona un archivo primero'); return; }
  const name = (document.getElementById('myel-name')?.value||'').trim() || 'Mi elemento';
