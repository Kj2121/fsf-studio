/* ══ AGREGAR · orden por sub-pestañas (Texto · Imagen · Cards · Símbolos · Animados · Mis archivos) — solo organización visual ══ */
const _ADD_TABS=[['texto','Texto'],['imagen','Imagen'],['cards','Cards'],['simbolos','Símbolos'],['animados','Animados'],['archivos','Mis archivos']];
let _addTab='texto';
function _addGroupOf(el){
  if(el.tagName==='DETAILS') return 'simbolos';
  if(!(el.classList.contains('elbl')||(el.tagName==='DIV'&&el.children.length<=2))) return null;
  const t=(el.textContent||'').replace(/NUEVO/i,'').replace(/\s+/g,' ').trim().toLowerCase();
  if(!t||t.length>34) return null;
  const M={'texto':'texto','texto curvo':'texto','agregar texto':'texto','imagen':'imagen','ia':'imagen','agregar imagen':'imagen','vectores svg & illustrator':'imagen','vectores svg · ai':'imagen','imagen de fondo':'imagen','filtros de imagen':'imagen','overlay oscuro':'imagen','formas':'cards','cards':'cards','cards diseñadas':'cards','editorial':'cards','editorial · variaciones':'cards','stickers':'simbolos','elementos sagrados':'simbolos','stickers animados':'animados','animaciones':'animados'};
  if(M[t]) return M[t];
  if(t.indexOf('mis elementos')===0) return 'archivos';
  return null;
}
function _addTabSet(g,btn){
  _addTab=g;
  const nav=btn&&btn.closest('.add-nav'); const root=nav&&nav.parentElement; if(!root) return;
  root.querySelectorAll(':scope>.add-nav .add-chip').forEach(b=>b.classList.toggle('on',b.dataset.g===g));
  root.querySelectorAll(':scope>.add-pane').forEach(p=>p.classList.toggle('on',p.dataset.g===g));
}
function _addOrganize(root){
  if(!root||root.querySelector(':scope>.add-nav')) return;
  const kids=[...root.children], G={}; _ADD_TABS.forEach(t=>G[t[0]]=[]);
  const keep=[]; let cur='texto';
  kids.forEach(el=>{
    if(el.id==='sel-props-panel'||el.id==='svg-upload-section'){keep.push(el);return;}
    if(el.classList.contains('sec-div')||(el.tagName==='DIV'&&el.style&&el.style.height==='1px'&&!el.textContent.trim())){el.remove();return;}
    const g=_addGroupOf(el); if(g) cur=g;
    G[cur].push(el);
  });
  const nav=document.createElement('div'); nav.className='add-nav';
  nav.innerHTML=_ADD_TABS.map(t=>'<button type="button" class="add-chip'+(t[0]===_addTab?' on':'')+'" data-g="'+t[0]+'" onclick="_addTabSet(\''+t[0]+'\',this)">'+t[1]+'</button>').join('');
  root.appendChild(nav);
  _ADD_TABS.forEach(t=>{
    const p=document.createElement('div'); p.className='add-pane'+(t[0]===_addTab?' on':''); p.dataset.g=t[0];
    G[t[0]].forEach(n=>p.appendChild(n)); root.appendChild(p);
    const d=p.querySelector('details'); if(d){d.open=true;}
  });
  keep.forEach(n=>root.appendChild(n));
  _addStrip(root);
  if(!root._addMO){ let tm; root._addMO=new MutationObserver(()=>{clearTimeout(tm);tm=setTimeout(()=>_addStrip(root),60);}); root._addMO.observe(root,{childList:true,subtree:true,characterData:true}); }
}
const _ADD_GLYPH=/^[\s]*(?:[←-⏿─-➿⬀-⯿—“”"️]|[\u{1F000}-\u{1FAFF}])+\s+/u;
function _addStrip(root){
  const w=document.createTreeWalker(root,NodeFilter.SHOW_TEXT); const arr=[]; let n;
  while(n=w.nextNode()){ if(n.nodeValue&&_ADD_GLYPH.test(n.nodeValue)&&!(n.parentElement&&/^(SCRIPT|STYLE)$/.test(n.parentElement.tagName))) arr.push(n); }
  arr.forEach(x=>{x.nodeValue=x.nodeValue.replace(_ADD_GLYPH,'');});
}

