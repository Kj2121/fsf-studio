function cycleTextStroke(){
  if(!selectedId) return;
  const o=getObject(selectedId); if(!o||o.type!=='text') return;
  pushUndo();
  const curIdx = o._strokeIdx||0;
  const nextIdx = (curIdx+1) % STROKE_PRESETS.length;
  o._strokeIdx = nextIdx;
  const preset = STROKE_PRESETS[nextIdx];
  o.textStrokeW = preset ? preset.w : null;
  o.textStrokeC = preset ? preset.c : null;
  const el=document.querySelector(`[data-id="${selectedId}"]`);
  if(el){
    el.style.webkitTextStroke = preset ? `${preset.w} ${preset.c}` : '';
