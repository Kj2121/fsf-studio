function _buildImgZoneContent(el, obj){
  const izR=obj.radius||0;
  const izId='iz_'+obj.id;

  // ── VIDEO MODE ──────────────────────────────────────────────
  if(obj.videoSrc){
    const _f = obj.imgFilters||{};
    const _flt = `brightness(${_f.brightness||100}%) contrast(${_f.contrast||100}%) saturate(${_f.saturate||100}%) grayscale(${_f.grayscale||0}%)`;
    // Reuse existing video element if already present
    const existingVid = el.querySelector('[data-iz-video]');
    if(existingVid && existingVid.dataset.src === obj.videoSrc){
      existingVid.style.filter = _flt;
      return; // already rendered
    }
    el.innerHTML='';
    const wrapper = document.createElement('div');
    wrapper.setAttribute('data-iz-img','1');
    wrapper.style.cssText=`position:absolute;inset:0;overflow:hidden;border-radius:${izR}px;`;
    const vid = document.createElement('video');
    vid.setAttribute('data-iz-video','1');
    vid.dataset.src = obj.videoSrc;
    vid.src = obj.videoSrc;
    vid.autoplay = true;
    vid.loop = true;
    vid.muted = true;
    vid.playsInline = true;
    vid.style.cssText=`position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);min-width:100%;min-height:100%;width:auto;height:auto;object-fit:cover;pointer-events:none;filter:${_flt};`;
    // Store ref on obj for export
    vid.onloadeddata = ()=>{ obj._videoEl = vid; };
    if(obj._videoEl) obj._videoEl = vid;
    wrapper.appendChild(vid);

    // Tap overlay to pause/play
    const overlay = document.createElement('div');
    overlay.style.cssText='position:absolute;inset:0;cursor:pointer;z-index:2;';
    overlay.addEventListener('click', e=>{
      e.stopPropagation();
      if(vid.paused){ vid.play(); overlay.innerHTML=''; }
      else {
        vid.pause();
        overlay.innerHTML=`<div style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:36px;height:36px;background:rgba(0,0,0,0.5);border-radius:50%;display:flex;align-items:center;justify-content:center;"><svg width="14" height="14" viewBox="0 0 24 24" fill="white"><polygon points="5 3 19 12 5 21 5 3"/></svg></div>`;
      }
    });
    wrapper.appendChild(overlay);
    el.appendChild(wrapper);
    vid.play().catch(()=>{});
    return;
  }

  // ── IMAGE MODE ──────────────────────────────────────────────
  if(obj.imgSrc){
    // Image loaded: show image only — NO file input overlay.
    // Tapping selects the object. Change photo = button in sel-bar only.
    const _f   = obj.imgFilters || {};
    const _flt = `brightness(${_f.brightness||100}%) contrast(${_f.contrast||100}%) saturate(${_f.saturate||100}%) grayscale(${_f.grayscale||0}%)`;
    // Framing: offset (%) and scale for adjusting what's shown
    const _ox = obj.imgOffsetX ?? 50; // 0-100, default center
    const _oy = obj.imgOffsetY ?? 50;
    const _scl = obj.imgScale ?? 100; // % zoom, 100 = cover
    const _bgSize = _scl <= 100 ? 'cover' : `${_scl}%`;
    // Use inner wrapper for clipping (cv-el has contain:layout style which breaks overflow)
    el.innerHTML=`<div data-iz-img style="position:absolute;inset:0;overflow:hidden;border-radius:${izR}px;"><div data-iz-imgbg style="position:absolute;inset:0;background:url('${obj.imgSrc}') ${_ox}% ${_oy}%/${_bgSize} no-repeat;pointer-events:none;filter:${_flt};"></div></div>`;
  } else {
    // Empty zone: tap to upload
    // _printZone=true → light background style (visible on white A4)
    const isLight = obj._printZone === true;
    const bgStyle   = isLight ? 'rgba(0,0,0,0.04)'        : 'rgba(255,255,255,0.06)';
    const brdStyle  = isLight ? '2px dashed rgba(0,0,0,0.18)' : '2px dashed rgba(255,255,255,0.22)';
    const iconClr   = isLight ? 'rgba(0,0,0,0.3)'         : 'rgba(255,255,255,0.5)';
    const txtClr    = isLight ? 'rgba(0,0,0,0.35)'        : 'rgba(255,255,255,0.5)';

    const lbl=document.createElement('label');
    lbl.style.cssText=`position:absolute;inset:0;overflow:hidden;border-radius:${izR}px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;background:${bgStyle};border:${brdStyle};box-sizing:border-box;cursor:pointer;`;
    lbl.innerHTML=`
      <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="${iconClr}" stroke-width="1.5" style="pointer-events:none;"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
      <span style="font-size:11px;color:${txtClr};font-weight:600;text-align:center;padding:0 12px;pointer-events:none;">${obj.label||'Toca para agregar foto'}</span>`;
    const _oid=obj.id;
    // Tap → show source sheet (Galería + Pexels)
    const tapOverlay=document.createElement('div');
    tapOverlay.style.cssText='position:absolute;inset:0;cursor:pointer;-webkit-tap-highlight-color:transparent;';
    tapOverlay.addEventListener('click',function(e){
      e.stopPropagation();
      selectObject(_oid);
      _showIzSourceSheet(_oid);
    });
    lbl.appendChild(tapOverlay);
    el.innerHTML='';
    el.appendChild(lbl);
  }
}

function _createObjEl(obj){
  const el=document.createElement('div');
  el.className='cv-el';
  el.dataset.id=obj.id;
  el.style.transformOrigin='center center';
  el.style.willChange='transform';

  if(obj.type==='text'){
    el.style.wordBreak='break-word';
    el.style.whiteSpace='pre-wrap';
    el.style.lineHeight=String(obj.lineHeight||1.4);
    el.style.cursor='move';
    el.setAttribute('data-text','1');
  } else if(obj.type==='imgZone'){
    el.style.width=obj.w+'px';
    el.style.height=(obj.h||obj.w)+'px';
    const _r2=obj.radius||0;
    el.style.borderRadius='0';
    el.style.overflow='visible';
    el.style.clipPath='';
    el.style.cursor='pointer';
    el.style.position='absolute';
    _buildImgZoneContent(el, obj);
  } else if(obj.type==='arctext'){
    _migrateArcObj(obj);
    el.style.contain='none';
    el.style.overflow='visible';
    el.style.cursor='move';
    el.style.width=obj.w+'px';
    el.style.height=obj.h+'px';
    el.innerHTML=_buildArcSvg(obj);
  } else if(obj.type==='sticker'){
    el.style.cursor='move';
    el.style.pointerEvents='all';
    const color=obj.color||'#ffffff';
    el.innerHTML=`<div style="width:100%;height:100%;fill:${color};color:${color};">${obj.stickerSvg||''}</div>`;
    el.querySelector('svg')?.setAttribute('style',`width:100%;height:100%;fill:${color};`);
  } else if(obj.type==='lottie'){
    el.style.cursor='move';
    el.style.overflow='visible';
    el.style.width=obj.w+'px';
    el.style.height=obj.h+'px';
    el.style.pointerEvents='all';
    el.style.setProperty('--c',obj.color||'#ffffff');
    el.style.setProperty('--spd',String(1/(obj.lottieSpeed||1)));
    el.dataset.lmk=_lottieMatKey(obj);
    el.innerHTML=_lottieFinal(obj);
    const svgEl=el.querySelector('svg');
    if(svgEl){svgEl.style.cssText='width:100%;height:100%;display:block;';}
  } else if(obj.type==='deco'){
    el.style.cursor='move';
    el.style.overflow='visible';
    el.style.pointerEvents = obj.subtype === 'vector' ? 'all' : 'none';
    el.innerHTML=obj.decoSvg||'';
    const svg=el.querySelector('svg');
    if(svg){ svg.style.width='100%'; svg.style.height='100%'; svg.style.overflow='visible'; svg.style.pointerEvents='none'; }
  } else if(obj.type==='shape'){
    _buildShapeEl(el, obj);
  } else if(obj.type==='glassCard'){
    _buildGlassEl(el, obj);
  }

  el.addEventListener('pointerdown', e=>{
    if(e.button!==0 && e.pointerType==='mouse') return;
    if(e.target.tagName==='INPUT') return;
    if(e.pointerType==='touch'){
      el._touchMoved=false;
      e.stopPropagation(); e.preventDefault();
      selectObject(obj.id);
      if(obj.locked || obj.type==='imgZone'||obj._isFondoBg) return;
      _startDrag(e.pointerId, e.clientX, e.clientY, obj.id, e.target);
    } else {
      onElMouseDown(e, obj.id);
    }
  },{passive:false});
  el.addEventListener('dblclick', e=>onElDblClick(e,obj.id));
  el.addEventListener('touchend', e=>{
    if(obj.type!=='text') return;
    if(obj.id!==selectedId) return;
    if(el._touchMoved) return;
    clearTimeout(el._tapTimer);
    el._tapTimer=setTimeout(()=>{
      if(obj.id===selectedId && !el.hasAttribute('contenteditable')) onElDblClick(e,obj.id);
    },160);
  },{passive:true});
  return el;
}

function renderObjects(){
  const bg=document.getElementById('canvas-bg');
  if(!bg) return;
  // Schedule autosave after changes
  _db_scheduleAutosave();

  const sorted=[...objects].sort((a,b)=>a.zIndex-b.zIndex);

  // Build set of current object ids
  const currentIds=new Set(sorted.filter(o=>o.visible).map(o=>o.id));

  // Remove elements no longer in objects
  bg.querySelectorAll('.cv-el').forEach(el=>{
    if(!currentIds.has(el.dataset.id)) el.remove();
  });

  // Add or update each object
  sorted.forEach(obj=>{
    if(!obj.visible){ bg.querySelector(`[data-id="${obj.id}"]`)?.remove(); return; }
    let el=bg.querySelector(`[data-id="${obj.id}"]`);
    if(!el){
      // New element — create and append
      el=_createObjEl(obj);
      bg.appendChild(el);
    }
    // Always sync styles (cheap since no layout reads)
    _applyObjStyles(el, obj);
  });

  updateSelectionBox();
  updateEmptyHint();
}

// SELECTION BOX + HANDLES
function updateSelectionBox() {
  const ov=document.getElementById('sel-overlay');
  ov.innerHTML='';
  if(!selectedId) return;
  const obj=getObject(selectedId);
  if(!obj) return;

  const sc=getScale();
  const el=document.querySelector(`[data-id="${selectedId}"]`);
  if(!el) return;
  const elRect=el.getBoundingClientRect();
  const bgRect=document.getElementById('canvas-bg').getBoundingClientRect();

  // position relative to container (which is canvas-container, same size as scaled bg)
  const x=(elRect.left-bgRect.left);
  const y=(elRect.top-bgRect.top);
  const w=elRect.width;
  const h=elRect.height;

  // Build selection box
  const box=document.createElement('div');
  box.className='sel-box';
  box.style.left=x+'px';
  box.style.top=y+'px';
  box.style.width=w+'px';
  box.style.height=h+'px';
  box.style.transform=`rotate(${obj.rotation||0}deg)`;

  // Handles — hide resize/rotate if locked
  const handleDefs=[
    {cls:'tl',cursor:'nw-resize'},{cls:'tm',cursor:'n-resize'},{cls:'tr',cursor:'ne-resize'},
    {cls:'ml',cursor:'w-resize'},{cls:'mr',cursor:'e-resize'},
    {cls:'bl',cursor:'sw-resize'},{cls:'bm',cursor:'s-resize'},{cls:'br',cursor:'se-resize'},
  ];
  if(!obj.locked) {
    handleDefs.forEach(hd=>{
      const h2=document.createElement('div');
      h2.className='sel-handle '+hd.cls;
      h2.style.cursor=hd.cursor;
      h2.addEventListener('pointerdown', e => {
        e.stopPropagation(); e.preventDefault();
        onHandleMouseDown(e, hd.cls);
      }, {passive:false});
      h2.addEventListener('touchstart',e=>{e.stopPropagation();e.preventDefault();},{passive:false});
      box.appendChild(h2);
    });

    // Rotation handle
    const rotLine=document.createElement('div');
    rotLine.className='rot-line';
    const rotHandle=document.createElement('div');
    rotHandle.className='rot-handle';
    rotHandle.title='Rotar';
    rotHandle.addEventListener('pointerdown', e=>{e.stopPropagation();e.preventDefault();onRotateMouseDown(e);},{passive:false});
    rotHandle.addEventListener('touchstart',e=>{e.stopPropagation();e.preventDefault();},{passive:false});
    box.appendChild(rotLine);
    box.appendChild(rotHandle);
  } else {
    // Locked: show dashed border style
    box.style.borderColor = 'rgba(30,123,255,0.5)';
    box.style.borderStyle = 'dashed';
  }

  // Move handle (bottom) — always show so user can still select/move if they unlock
  const moveLine=document.createElement('div');
  moveLine.className='move-line';
  const moveHandle=document.createElement('div');
  moveHandle.className='move-handle';
  moveHandle.title= obj.locked ? 'Bloqueado — desbloquea en la barra' : 'Mover';
  moveHandle.innerHTML= obj.locked ? '🔒' : '✥';
  moveHandle.style.cursor = obj.locked ? 'not-allowed' : '';
  if(!obj.locked) {
    moveHandle.addEventListener('pointerdown', e=>{ e.stopPropagation(); e.preventDefault(); onMoveHandlePointerDown(e); });
  }
  box.appendChild(moveLine);
  box.appendChild(moveHandle);

  ov.appendChild(box);
}

// SELECT / DESELECT
function selectObject(id) {
  selectedId=id;
  updateSelectionBox();
  const obj=getObject(id);
  if(!obj) return;
  showSelBar(true, obj);
  showPropPanel(obj);
  renderLayersPanel();
  if(obj.type === 'text'){
    requestAnimationFrame(positionFloatToolbar);
  } else {
    hideFloatToolbar();
  }
  // Auto-open edit tab on mobile for vector objects
  if(obj.subtype === 'vector' && window.innerWidth <= 900) {
    _svgEditId = id;
    setTimeout(() => mobTab('edit'), 100);
  }
}

function clearSelection() {
  selectedId=null;
  document.querySelectorAll('.cv-el.sel-lottie').forEach(e=>e.classList.remove('sel-lottie'));
  document.getElementById('sel-overlay').innerHTML='';
  showSelBar(false);
  hidePropPanel();
  hideFloatToolbar();
  document.getElementById('mob-quickedit')?.classList.remove('visible');
  if(activeMobTab === 'edit') {
    activeMobTab = '';
    document.getElementById('mob-drawer')?.classList.remove('open');
    document.querySelectorAll('.mob-tab').forEach(b => b.classList.remove('on'));
  }
}

