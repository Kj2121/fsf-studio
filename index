function bkSave() {
  const kit = bkCollect();
  _storage.set('fsf_brand_kit',JSON.stringify(kit));
  _bkRenderSaved();
  showUndoToast('\u2746 Kit de Marca guardado');
}

function bkCollect() {
  return {
    name:     document.getElementById('bk-name')?.value || '',
    tagline:  document.getElementById('bk-tag')?.value || '',
    colors:   ['bk-c1','bk-c2','bk-c3'].map(id => document.getElementById(id)?.value || '#ffffff'),
    font:     bkFont,
    logo:     bkLogoData,
    logoSize: parseInt(document.getElementById('bk-logo-size')?.value || '12'),
