  'Día del Padre':           ['mn-texto','tm-paz','st-tipo-luz'],
  'Avivamiento':             ['st-tipo-luz','bg04','de-amanecer'],
  'Día de Acción de Gracias':['mn-dar','mn-texto','de-amanecer'],
  'Adviento':                ['au-oliva','bg06','tm-paz'],
  'Navidad':                 ['au-oliva','tm-paz','mn-texto'],
  'Nochebuena':              ['au-oliva','bg07','tm-paz'],
  'Fin de Año':              ['tm-esperanza','tm-paz','de-amanecer'],
};
const CAL_MONTH_DAY = {
  'Año Nuevo Cristiano':[0,1],'Día de Reyes':[0,6],
  'Miércoles de Ceniza':[2,5],'Domingo de Ramos':[3,13],
  'Semana Santa':[3,14],'Viernes Santo':[3,18],
  'Domingo de Resurrección':[3,20],'Día de la Madre':[4,11],
  'Pentecostés':[5,8],'Día del Padre':[5,15],
  'Día de Acción de Gracias':[10,27],'Adviento':[11,1],
  'Nochebuena':[11,24],'Navidad':[11,25],'Fin de Año':[11,31],
};
function calDaysUntil(name){
  const md=CAL_MONTH_DAY[name]; if(!md)return null;
  const today=new Date(); today.setHours(0,0,0,0);
  let d=new Date(today.getFullYear(),md[0],md[1]);
  if(d<today) d=new Date(today.getFullYear()+1,md[0],md[1]);
  return Math.round((d-today)/86400000);
}
function calTplName(tid){
  if(typeof TEMPLATES==='undefined') return tid;
  const t=TEMPLATES.find(x=>x.id===tid); return t?t.name:tid;
}
function buildCalendarDrawer(){
  const evts=CHRISTIAN_CALENDAR.map(e=>({...e,days:calDaysUntil(e.name)}))
    .sort((a,b)=>{if(a.days===null)return 1;if(b.days===null)return -1;return a.days-b.days;});
  const near=evts.filter(e=>e.days!==null&&e.days<=60);
  const later=evts.filter(e=>e.days===null||e.days>60);

  // Convert hex color to rgb string
  const hex2rgb=h=>{const r=h.replace('#','').match(/.{2}/g);return r.map(x=>parseInt(x,16)).join(',');};

  const card=e=>{
    const tpls=(CAL_TEMPLATE_MAP[e.name]||['mn-texto','st-tipo-santo']).slice(0,3);
    const es=JSON.stringify(JSON.stringify(e)).slice(1,-1).replace(/'/g,"\\'");
    const isToday=e.days===0, isSoon=e.days!==null&&e.days<=7&&e.days>0;
    const rgb=hex2rgb(e.color);

    const badgeStyle=isToday
      ?'background:rgba(74,222,128,0.18);color:#4ade80;animation:calP 1.4s ease-in-out infinite;'
      :isSoon||e.days===1
      ?'background:rgba(30,123,255,0.15);color:#7C5BF0;'
      :'background:rgba(255,255,255,0.07);color:rgba(255,255,255,0.38);';
    const badgeText=isToday?'✦ Hoy':e.days===1?'Mañana':e.days!==null?e.days+'d':e.date;

    const chips=tpls.map(tid=>
      '<button style="font-size:9px;font-weight:700;background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.1);border-radius:20px;padding:3px 9px;color:rgba(255,255,255,0.5);cursor:pointer;font-family:var(--ui-font);white-space:nowrap;" onclick="event.stopPropagation();calApplyTemplate(\''+tid+'\',\''+es+'\')" data-tid="'+tid+'">'+calTplName(tid)+'</button>'
    ).join('');

    return '<div onclick="calApply(\''+es+'\')" style="display:flex;align-items:stretch;background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.08);border-radius:12px;overflow:hidden;cursor:pointer;-webkit-tap-highlight-color:transparent;margin-bottom:5px;">'+
      '<div style="width:3px;background:'+e.color+';flex-shrink:0;opacity:0.85;"></div>'+
      '<div style="flex:1;padding:10px 10px 9px;min-width:0;">'+
        '<div style="display:flex;align-items:flex-start;justify-content:space-between;gap:8px;margin-bottom:4px;">'+
          '<div style="font-size:12.5px;font-weight:700;color:rgba(255,255,255,0.92);line-height:1.3;">'+e.name+'</div>'+
          '<div style="font-size:9px;font-weight:800;padding:3px 9px;border-radius:20px;white-space:nowrap;flex-shrink:0;font-family:var(--ui-font);'+badgeStyle+'">'+badgeText+'</div>'+
        '</div>'+
        '<div style="display:flex;align-items:center;gap:5px;margin-bottom:8px;">'+
          '<div style="width:14px;height:1px;background:'+e.color+';opacity:0.6;flex-shrink:0;"></div>'+
          '<span style="font-size:10px;color:rgba(255,255,255,0.45);">'+e.verse+' · '+e.desc+'</span>'+
        '</div>'+
        '<div style="display:flex;gap:4px;flex-wrap:wrap;">'+chips+'</div>'+
      '</div>'+
    '</div>';
  };

  // Hero card — next upcoming event
  const hero=evts.find(e=>e.days!==null);
  let heroHtml='';
  if(hero){
    const tpls=(CAL_TEMPLATE_MAP[hero.name]||['mn-texto','st-tipo-santo']).slice(0,2);
    const es=JSON.stringify(JSON.stringify(hero)).slice(1,-1).replace(/'/g,"\\'");
    const rgb=hex2rgb(hero.color);
    const countdown=hero.days===0?'¡Es hoy!':hero.days===1?'Mañana':''+hero.days+' días';
    const chips=tpls.map(tid=>
      '<button style="font-size:10px;font-weight:700;background:rgba('+rgb+',0.18);border:1px solid rgba('+rgb+',0.35);border-radius:20px;padding:5px 12px;color:'+hero.color+';cursor:pointer;font-family:var(--ui-font);white-space:nowrap;" onclick="event.stopPropagation();calApplyTemplate(\''+tid+'\',\''+es+'\')" data-tid="'+tid+'">'+calTplName(tid)+'</button>'
    ).join('');

    heroHtml='<div onclick="calApply(\''+es+'\')" style="background:linear-gradient(135deg,rgba('+rgb+',0.14),rgba('+rgb+',0.05));border:1px solid rgba('+rgb+',0.28);border-radius:16px;padding:15px;cursor:pointer;margin-bottom:16px;-webkit-tap-highlight-color:transparent;">'+
      '<div style="display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:10px;">'+
        '<div>'+
          '<div style="font-size:28px;font-weight:800;color:'+hero.color+';line-height:1;">'+countdown+'</div>'+
          '<div style="font-size:9px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:rgba(255,255,255,0.3);margin-top:3px;">próxima celebración</div>'+
        '</div>'+
        '<div style="width:14px;height:14px;border-radius:50%;background:'+hero.color+';box-shadow:0 0 18px '+hero.color+'88;margin-top:4px;"></div>'+
      '</div>'+
      '<div style="font-size:18px;font-weight:800;color:rgba(255,255,255,0.95);margin-bottom:5px;line-height:1.2;">'+hero.name+'</div>'+
      '<div style="font-size:11px;color:rgba(255,255,255,0.42);margin-bottom:12px;">'+hero.verse+' · '+hero.desc+'</div>'+
      '<div style="display:flex;gap:6px;flex-wrap:wrap;">'+chips+'</div>'+
    '</div>';
  }

  const restNear=near.filter(e=>e!==hero);
  let html=heroHtml;
  if(restNear.length){
    html+='<div style="font-size:9px;font-weight:800;letter-spacing:2px;text-transform:uppercase;color:rgba(255,255,255,0.22);margin-bottom:8px;">📅 PRÓXIMAS</div>'+restNear.map(card).join('');
  }
  if(later.length){
    html+='<div style="font-size:9px;font-weight:800;letter-spacing:2px;text-transform:uppercase;color:rgba(255,255,255,0.22);margin:14px 0 8px;">📆 RESTO DEL AÑO</div>'+later.map(card).join('');
  }

  return '<style>@keyframes calP{0%,100%{opacity:1;}50%{opacity:.45;}}</style><div style="display:flex;flex-direction:column;">'+html+'</div>';
}

function initCalendarDrawer(){
  if(typeof TEMPLATES==='undefined')return;
  document.querySelectorAll('.cal-chip[data-tid]').forEach(btn=>{
    const t=TEMPLATES.find(x=>x.id===btn.dataset.tid);
    if(t)btn.textContent=t.name;
  });
}
function calApply(jsonStr){
  try{
    const e=JSON.parse(jsonStr);
    pushUndo();
    const exT=objects.find(o=>o.type==='text'&&o.subtype==='title');
    if(exT){exT.text=e.name;renderObjects();}else addTextElementWithText('title',e.name);
    const exR=objects.find(o=>o.type==='text'&&o.subtype==='ref');
    if(exR){exR.text=e.verse;renderObjects();}else addTextElementWithText('ref',e.verse);
    showUndoToast('✦ '+e.name+' aplicado');
    document.getElementById('mob-drawer').classList.remove('open');
    document.querySelectorAll('.mob-tab').forEach(b=>b.classList.remove('on'));
    activeMobTab='';
  }catch(err){console.warn(err);}
}
function calApplyTemplate(tid,jsonStr){
  try{
    const e=JSON.parse(jsonStr);
    const t=typeof TEMPLATES!=='undefined'?TEMPLATES.find(x=>x.id===tid):null;
    if(t){applyTemplate(t);setTimeout(()=>calApply(JSON.stringify(e)),120);}
    else calApply(jsonStr);
  }catch(err){console.warn(err);}
}
