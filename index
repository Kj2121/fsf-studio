- Títulos: oswald 100-150px bold uppercase, textShadow siempre presente
- Versículos: playfair o lora 38-52px italic
- Referencias: montserrat 16-18px uppercase letterSpacing:"5px"
- Incluye elemento fantasma grande (opacity 0.05-0.07) como fondo gráfico
- Incluye etiqueta pequeña con nombre de la iglesia (fontSize 13px, opacity 0.35)
- x>=50, x+w<=1030, y>=40, zIndex desde 2, visible:true

RESPONDE SOLO CON ESTE JSON (sin markdown, sin texto adicional):
{
  "iglesia": "nombre",
  "pastor": "nombre",
  "sermon": { "titulo": "...", "versiculo": "...", "referencia": "..." },
  "resumen": "frase corta",
  "designs": [
    {
      "tipo": "sermón",
      "titulo_post": "...",
      "fmt": "square",
      "themeIdx": 1,
      "overlayOpacity": 0,
      "objects": [ ... ]
    }
  ]
}`;

  const resp = await fetch(
    `https://generativelanguage.googleapis.com/v1beta/models/${workingModel}:generateContent?key=${geminiKey}`,
    {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        contents: [{
          parts: [
            { inline_data: { mime_type: 'application/pdf', data: pdfBase64 } },
            { text: singlePrompt }
          ]
        }],
        generationConfig: { maxOutputTokens: 5000, temperature: 0.7 }
      })
    }
  );

  if (!resp.ok) {
    const e = await resp.json().catch(() => ({}));
    throw new Error(`Gemini (${workingModel}): ${e.error?.message || resp.status}`);
  }

  const data = await resp.json();
  const text = data.candidates?.[0]?.content?.parts?.[0]?.text || '';
  const clean = text.replace(/```json|```/g, '').trim();
  const match = clean.match(/\{[\s\S]*\}/);
  if (!match) throw new Error('No se pudo parsear la respuesta de Gemini');
  const result = JSON.parse(match[0]);

  if (!result.designs || !Array.isArray(result.designs) || result.designs.length === 0) {
    throw new Error('Gemini no generó diseños válidos');
  }

  return { content: result, designs: result.designs };
}

// Detecta el modelo de Gemini disponible para esta key
async function _geminiDetectModel(apiKey) {
  // Get list of available models from the API
  try {
    const resp = await fetch(
      `https://generativelanguage.googleapis.com/v1beta/models?key=${apiKey}`,
      { method: 'GET', headers: { 'Content-Type': 'application/json' } }
    );
    if (!resp.ok) return null;
    const data = await resp.json();
    const models = (data.models || []).map(m => m.name.replace('models/', ''));

    // Prefer models that support generateContent and multimodal (PDF)
    const preferred = [
      'gemini-1.5-flash', 'gemini-1.5-flash-latest', 'gemini-1.5-flash-001',
      'gemini-1.5-flash-002', 'gemini-2.0-flash', 'gemini-2.0-flash-001',
      'gemini-2.0-flash-exp', 'gemini-1.5-pro', 'gemini-1.5-pro-latest',
      'gemini-1.5-pro-001', 'gemini-1.5-pro-002',
    ];

    for (const p of preferred) {
      if (models.includes(p)) return p;
    }
    // Return first model that has generateContent in supported methods
    const withGen = (data.models || []).find(m =>
      m.supportedGenerationMethods?.includes('generateContent') &&
      !m.name.includes('embedding') && !m.name.includes('aqa')
    );
    if (withGen) return withGen.name.replace('models/', '');
    return models[0] || null;
  } catch(e) {
    return null;
  }
}

// Exposed to modal button
window.boletinDetectModel = async function() {
  const key = document.getElementById('boletin-gemini-key')?.value?.trim();
  const result = document.getElementById('boletin-model-result');
  if (!key) { if(result) result.textContent = '⚠ Ingresa tu API key primero'; return; }
  if (result) result.textContent = '🔍 Buscando modelos disponibles...';
  try {
    const resp = await fetch(`https://generativelanguage.googleapis.com/v1beta/models?key=${key}`);
    const data = await resp.json();
    if (!resp.ok) {
      if(result) result.innerHTML = `<span style="color:rgba(255,100,100,0.8);">✕ Key inválida: ${data.error?.message||resp.status}</span>`;
      return;
    }
    const models = (data.models || [])
      .filter(m => m.supportedGenerationMethods?.includes('generateContent') && !m.name.includes('embedding') && !m.name.includes('aqa'))
      .map(m => m.name.replace('models/', ''));

    if (models.length === 0) {
      if(result) result.innerHTML = `<span style="color:rgba(255,100,100,0.8);">✕ No hay modelos disponibles con esta key</span>`;
      return;
    }
    _storage.set('fsf_gemini_key',key);
    _storage.set('fsf_gemini_models',JSON.stringify(models));
    if(result) result.innerHTML = `<span style="color:rgba(74,222,128,0.8);">✓ ${models.length} modelos disponibles · Usando: ${models[0]}</span>`;
  } catch(e) {
    if(result) result.innerHTML = `<span style="color:rgba(255,100,100,0.8);">✕ Error: ${e.message}</span>`;
  }
};

