    const seed = Math.floor(Math.random()*99999);
    const enc = encodeURIComponent(fullPrompt);
    // URLs en orden de prioridad — nueva API gen.pollinations.ai primero
    const urls = [
      `https://gen.pollinations.ai/image/${enc}?width=1024&height=1024&seed=${seed}&nologo=true`,
      `https://image.pollinations.ai/prompt/${enc}?model=flux&width=1024&height=1024&seed=${seed}&nologo=true`,
      `https://pollinations.ai/p/${enc}?width=1024&height=1024&seed=${seed}&nologo=true`,
      `https://image.pollinations.ai/prompt/${enc}?width=1024&height=1024&seed=${seed}&nologo=true`,
    ];
    let lastErr = null;
    for(const url of urls){
      try{
        const resp = await tryFetch(url, 60000);
        if(resp.ok){
          const ct = resp.headers.get('content-type')||'';
          if(ct.startsWith('image/')||ct.includes('jpeg')||ct.includes('png')||ct.includes('webp')){
            const blob = await resp.blob();
            if(blob.size > 5000) return await blobToDataUrl(blob);
          }
        }
        lastErr = new Error(`Pollinations HTTP ${resp.status}`);
      }catch(e){
        lastErr = new Error(e.name==='AbortError'?'Pollinations: tiempo agotado (60s)':'Pollinations: '+e.message);
        console.warn('Pollinations URL failed:', url, e.message);
      }
    }
    throw lastErr || new Error('Pollinations no respondió. Prueba Gemini o Stable Horde.');
  }

  // ── GEMINI IMAGE — 500 imágenes/día con key gratuita ──
  if(provider === 'gemini'){
    // Modelos vigentes marzo 2026 — en orden de preferencia
    // RETIRADOS (ya no generan imagen): gemini-2.0-flash-exp, gemini-1.5-flash-latest
    // imagen-3.0/4.0 requiere billing GCP — no funciona con key gratuita de AI Studio
    const models = [
      'gemini-3.1-flash-image-preview',  // Nano Banana 2 — más reciente (feb 2026)
      'gemini-2.5-flash-image',           // Nano Banana — estable, free tier
    ];
    let lastErr = null;
    for(const model of models){
      try{
        // CRÍTICO: responseModalities debe ser ["TEXT","IMAGE"] — TEXT primero
        // Con ["IMAGE","TEXT"] o solo ["IMAGE"] devuelve 200 pero sin imagen (fallo silencioso)
        // CRÍTICO: solo /v1beta/ funciona para imagen — /v1/ da 404
        const resp = await fetch(
          `https://generativelanguage.googleapis.com/v1beta/models/${model}:generateContent?key=${apiKey}`,
          {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              contents: [{ parts: [{ text: fullPrompt }] }],
              generationConfig: { responseModalities: ['TEXT', 'IMAGE'] }
            })
          }
        );
        if(!resp.ok){
          const e = await resp.json().catch(()=>({}));
          const msg = e.error?.message || `HTTP ${resp.status}`;
          lastErr = new Error(`Gemini ${model}: ${msg}`);
          continue;
        }
        const data = await resp.json();
        const parts = data.candidates?.[0]?.content?.parts || [];
        const imgPart = parts.find(p => p.inlineData?.mimeType?.startsWith('image/'));
        if(imgPart) return `data:${imgPart.inlineData.mimeType};base64,${imgPart.inlineData.data}`;
        // 200 pero sin imagen = fallo silencioso por config incorrecta
        const textPart = parts.find(p => p.text);
        lastErr = new Error(`Gemini ${model}: sin imagen — ${textPart?.text?.substring(0,80)||'respuesta vacía'}`);
      } catch(e){ lastErr = new Error(`Gemini ${model}: ${e.message}`); }
    }
    // Mensaje de error útil según el tipo de fallo
    const errMsg = lastErr?.message || '';
    const hint = errMsg.includes('429') ? 'Límite alcanzado — espera unos minutos o revisa tu cuota en aistudio.google.com'
      : errMsg.includes('404')          ? 'Modelo no disponible en tu región — prueba Pollinations'
      : errMsg.includes('PRECONDITION') ? 'Activa billing en console.cloud.google.com'
      : 'Verifica tu key en aistudio.google.com → API Keys → Create API key';
    throw new Error(`${hint}\n\n${errMsg}`);
  }


  // ── STABLE HORDE — Red de GPUs voluntarios ──
  if(provider === 'horde'){
    const genResp = await fetch('https://stablehorde.net/api/v2/generate/async', {
      method:'POST',
      headers:{'Content-Type':'application/json','apikey':'0000000000'},
      body: JSON.stringify({
        prompt: fullPrompt + ' ### lowres, text, watermark, signature, ugly, blurry, bad anatomy',
        params:{
          width:1024, height:1024, steps:30, cfg_scale:7.5,
          sampler_name:'k_dpmpp_2m', n:1, karras:true,
          hires_fix:false, clip_skip:1,
        },
        models:['SDXL 1.0','Juggernaut XL','DreamShaper XL'],
        r2:true, shared:false, slow_workers:true,
      })
    });
    if(!genResp.ok) throw new Error('Stable Horde no disponible (' + genResp.status + ')');
    const genData = await genResp.json();
    if(!genData.id) throw new Error('Horde: ' + (genData.message||'error al iniciar'));
    // Poll hasta completar
    for(let i=0;i<50;i++){
      await new Promise(r=>setTimeout(r,5000));
      const check = await (await fetch(`https://stablehorde.net/api/v2/generate/check/${genData.id}`)).json();
      if(check.faulted) throw new Error('Horde: trabajo fallido');
      if(check.done){
        const sd = await (await fetch(`https://stablehorde.net/api/v2/generate/status/${genData.id}`)).json();
        const img = sd.generations?.[0]?.img;
        if(!img) throw new Error('Horde: sin imagen en resultado');
        if(img.startsWith('data:')) return img;
        return await blobToDataUrl(await (await fetch(img)).blob());
      }
    }
    throw new Error('Horde: tiempo agotado (>4 min)');
  }

  // ── OPENAI DALL-E 3 ──
  if(provider === 'openai'){
    const resp = await fetch('https://api.openai.com/v1/images/generations', {
      method:'POST',
      headers:{'Content-Type':'application/json','Authorization':'Bearer '+apiKey},
      body: JSON.stringify({ model:'dall-e-3', prompt:fullPrompt, n:1, size:'1024x1024', response_format:'b64_json' })
    });
    const data = await resp.json();
    if(!resp.ok) throw new Error('DALL-E: ' + (data.error?.message||resp.status));
    return 'data:image/png;base64,' + data.data?.[0]?.b64_json;
  }

  throw new Error('Proveedor no reconocido: ' + provider);
}


