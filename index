/* ══════════════════════════════════════════════════════
   FE SIN FRONTERAS STUDIO v10 — Glassmorphism UI Enhanced
══════════════════════════════════════════════════════ */
@import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap');

:root{
  /* ── PALETA FSF STUDIO — Índigo · Violeta · Noche ── */
  --gold:#7DB0FF;        /* Violeta claro — acento principal */
  --gold2:#B5D3FF;       /* Violeta muy claro */
  --gold3:#DCEAFF;       /* Lavanda — highlights */
  --cream:#EAF2FF;       /* Blanco violeta */
  --terra:#1448B4;       /* Violeta profundo */
  --terra2:#2F6BFF;      /* Violeta medio */

  --ui:#05080F;           /* Negro violeta base */
  --ui2:#0A0F1C;          /* Nivel 2 */
  --ui3:#0F1626;          /* Nivel 3 — cards */
  --ui4:#141D33;          /* Nivel 4 — elevated */

  --panel:rgba(255,255,255,0.03);
  --panel2:rgba(255,255,255,0.055);
  --panel3:rgba(255,255,255,0.09);
  --glass:rgba(255,255,255,0.035);
  --glass2:rgba(255,255,255,0.06);
  --glass3:rgba(255,255,255,0.02);

  --border:rgba(255,255,255,0.065);
  --border2:rgba(255,255,255,0.04);
  --borderg:rgba(30,123,255,0.35);
  --borderg2:rgba(30,123,255,0.18);

  --accent:#1E7BFF;
  --accent2:rgba(30,123,255,0.12);
  --accent3:rgba(30,123,255,0.07);
  --accentg:rgba(30,123,255,0.25);

  --txt:rgba(235,242,255,0.95);
  --txt2:rgba(235,242,255,0.52);
  --txt3:rgba(235,242,255,0.26);
  --txt4:rgba(235,242,255,0.12);

  --sel-blue:#7DB0FF;
  --ui-font:'Inter','Plus Jakarta Sans',system-ui,sans-serif;
  --r:14px;--r2:10px;

  /* ── TYPOGRAPHY SCALE — Linear/Vercel style ── */
  /* Sizes — tight, purposeful scale */
  --fs-xs:10px;     /* metadata, badges */
  --fs-sm:11px;     /* labels, captions */
  --fs-base:12px;   /* body, descriptions */
  --fs-md:13px;     /* primary UI text */
  --fs-lg:14px;     /* section titles */
  --fs-xl:15px;     /* panel headings */
  --fs-2xl:18px;    /* prominent labels */

  /* Weights — fewer = more intentional */
  --fw-normal:400;
  --fw-medium:500;
  --fw-semi:600;
  --fw-bold:700;

  /* Letter spacing — restrained */
  --ls-tight:-0.01em;
  --ls-normal:0;
  --ls-wide:0.03em;
  --ls-wider:0.06em;
  --ls-caps:0.08em;    /* ONLY for uppercase labels */

  /* Line heights */
  --lh-tight:1.2;
  --lh-normal:1.5;
  --lh-relaxed:1.6;
  --glow:0 0 80px rgba(30,123,255,0.14);
  --glow2:0 0 40px rgba(30,123,255,0.08);
  --shadow:0 16px 48px rgba(0,0,0,0.75);
  --shadow2:0 4px 20px rgba(0,0,0,0.55);
  --shadow3:0 1px 6px rgba(0,0,0,0.4);
  --saved-indicator:#4ADE80;
}
*{margin:0;padding:0;box-sizing:border-box;}
html,body{
  height:100%;
  background:var(--ui);
  background-image:
    radial-gradient(ellipse 80% 50% at 10% -5%, rgba(30,123,255,0.1) 0%, transparent 60%),
    radial-gradient(ellipse 60% 40% at 90% 100%, rgba(20,72,180,0.08) 0%, transparent 60%),
    radial-gradient(ellipse 40% 30% at 50% 50%, rgba(30,123,255,0.03) 0%, transparent 70%);
  color:var(--txt);
  font-family:var(--ui-font);
  overflow:hidden;
  touch-action:manipulation;

  else if (tab === 'cal') {
    // Build calendar from CHRISTIAN_CALENDAR
    const today = new Date();
    const months = ['Enero','Febrero','Marzo','Abril','Mayo','Junio','Julio','Agosto','Septiembre','Octubre','Noviembre','Diciembre'];

    function parseFechaDate(dateStr) {
      // Parse "6 Enero", "Mar/Feb", etc
      const parts = dateStr.split(' ');
      if(parts.length >= 2) {
        const day = parseInt(parts[0]);
        const monthIdx = months.findIndex(m => parts[1].startsWith(m.substring(0,3)));
        if(!isNaN(day) && monthIdx >= 0) {
          const d = new Date(today.getFullYear(), monthIdx, day);
          if(d < today) d.setFullYear(today.getFullYear()+1);
          return d;
        }
      }
      return null;
    }

    function daysUntil(d) {
      if(!d) return 9999;
      const diff = d - today;
      return Math.ceil(diff / (1000*60*60*24));
    }

    // Sort by proximity
    const withDates = CHRISTIAN_CALENDAR.map(f => ({
      ...f,
      dateObj: parseFechaDate(f.date),
      days: daysUntil(parseFechaDate(f.date))
    })).sort((a,b) => a.days - b.days);

    function badge(days) {
      if(days <= 0) return '<span style="background:#22c55e;color:#fff;border-radius:100px;padding:2px 8px;font-size:9px;font-weight:800;">¡Hoy!</span>';
      if(days === 1) return '<span style="background:#f59e0b;color:#fff;border-radius:100px;padding:2px 8px;font-size:9px;font-weight:800;">Mañana</span>';
      if(days <= 7) return '<span style="background:rgba(30,123,255,0.8);color:#fff;border-radius:100px;padding:2px 8px;font-size:9px;font-weight:800;">'+days+'d</span>';
      return '<span style="color:rgba(255,255,255,0.3);font-size:9px;">'+days+' días</span>';
    }

    const hero = withDates[0];
    const rest = withDates.slice(1);

    const heroCard = hero ? `
      <div style="background:linear-gradient(135deg,${hero.color}22,${hero.color}11);border:1.5px solid ${hero.color}44;border-radius:16px;padding:16px;margin-bottom:12px;">
        <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:8px;">
          <div style="font-size:9px;font-weight:800;letter-spacing:1.5px;text-transform:uppercase;color:${hero.color};font-family:var(--ui-font);">Próxima fecha</div>
          ${badge(hero.days)}
        </div>
        <div style="font-size:16px;font-weight:700;color:#fff;font-family:var(--ui-font);margin-bottom:4px;">${hero.name}</div>
        <div style="font-size:11px;color:rgba(255,255,255,0.5);font-family:var(--ui-font);margin-bottom:8px;">${hero.date} · ${hero.desc}</div>
        <div style="font-size:11px;font-style:italic;color:rgba(255,255,255,0.6);font-family:var(--ui-font);margin-bottom:12px;">"${hero.verse}"</div>
        <div style="display:flex;gap:6px;">
          <button onclick="addTextElement('verse');showUndoToast('Versículo agregado')" style="flex:1;background:${hero.color};border:none;border-radius:10px;padding:9px;cursor:pointer;font-size:11px;font-weight:700;color:#000;font-family:var(--ui-font);">+ Usar versículo</button>
          <button onclick="addTextElement('title');document.querySelector('.sel-font')?.focus();showUndoToast('Título listo — escribe el nombre')" style="flex:1;background:rgba(255,255,255,0.08);border:1px solid rgba(255,255,255,0.15);border-radius:10px;padding:9px;cursor:pointer;font-size:11px;font-weight:700;color:rgba(255,255,255,0.7);font-family:var(--ui-font);">+ Diseñar</button>
        </div>
      </div>` : '';

    const restCards = rest.map(f => `
      <div style="background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.08);border-radius:12px;padding:12px;display:flex;align-items:center;gap:10px;">
        <div style="width:4px;height:36px;background:${f.color};border-radius:2px;flex-shrink:0;"></div>
        <div style="flex:1;min-width:0;">
          <div style="font-size:12px;font-weight:700;color:rgba(255,255,255,0.8);font-family:var(--ui-font);">${f.name}</div>
          <div style="font-size:10px;color:rgba(255,255,255,0.4);font-family:var(--ui-font);">${f.date}</div>
        </div>
        ${badge(f.days)}
      </div>`).join('');

    content.innerHTML = `
      <div style="font-size:9px;font-weight:800;letter-spacing:2px;text-transform:uppercase;color:rgba(255,255,255,0.2);margin-bottom:12px;">📅 Calendario Cristiano</div>
      ${heroCard}
      <div style="display:flex;flex-direction:column;gap:6px;">${restCards}</div>
    `;
  }

}


/* ══ LOTTIE ANIMATIONS ══ */
.fsf-interact svg[class^="fa-"] *{animation-play-state:paused!important;shape-rendering:optimizeSpeed!important;}
.fsf-interact svg[class^="fa-"] filter *{shape-rendering:auto!important;}
.fsf-interact svg[class^="fa-"] .h1,.fsf-interact svg[class^="fa-"] .h2,.fsf-interact svg[class^="fa-"] .h3{display:none!important;}
.cv-el.sel-lottie svg:has(.h1) *{animation-play-state:paused!important;}
.lottie-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:6px;margin-top:6px;}
.lottie-card{position:relative;background:rgba(255,255,255,0.04);border:1.5px solid rgba(255,255,255,0.08);border-radius:12px;overflow:hidden;cursor:pointer;transition:all .18s;aspect-ratio:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px;}
