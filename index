/* ══ AI MODAL — NEXT LEVEL ══ */
#ai-modal-overlay{
  position:fixed;inset:0;z-index:10000;
  display:none;flex-direction:column;
}
#ai-modal-overlay.open{
  display:flex;
  animation:aiSlideUp .32s cubic-bezier(.22,1,.36,1);
}
@keyframes aiSlideUp{from{transform:translateY(100%)}to{transform:translateY(0)}}
#ai-modal{
  width:100%;height:100%;
  display:flex;flex-direction:column;
  position:relative;overflow:hidden;
  background:#0A0F1C;
}
#ai-modal::before{
  content:'';position:absolute;inset:0;pointer-events:none;z-index:0;
  background:
    radial-gradient(ellipse 60% 50% at 20% 0%, rgba(30,123,255,0.06) 0%, transparent 60%),
    radial-gradient(ellipse 50% 40% at 80% 100%, rgba(20,72,180,0.05) 0%, transparent 60%);
}
