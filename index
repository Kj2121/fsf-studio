function toggleTextShadow(){
  if(!selectedId) return;
  const o=getObject(selectedId); if(!o||o.type!=='text') return;
  pushUndo();
  const cur = o.textShadow||null;
  const idx = SHADOW_PRESETS.indexOf(cur);
  o.textShadow = SHADOW_PRESETS[(idx+1) % SHADOW_PRESETS.length];
  const el=document.querySelector(`[data-id="${selectedId}"]`);
  if(el) el.style.textShadow = o.textShadow||'none';
