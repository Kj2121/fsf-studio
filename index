// TRANSFORM PANEL — Posición, tamaño y rotación exactos
// ══════════════════════════════════════════════════════════════

function spSetPos(axis, val){
  const obj = getObject(selectedId); if(!obj||obj.locked) return;
  pushUndo();
  obj[axis] = Math.round(val);
  renderObjects();
  updateSelectionBox();
}

function spSetSize(dim, val){
  const obj = getObject(selectedId); if(!obj||obj.locked) return;
  const numVal = parseInt(val)||0;
  if(numVal < 10) return;
  // FIX: obj.h can be 'auto' string — normalize before compare
  pushUndo();
  obj[dim] = Math.round(numVal);
  if(obj.type==='imgZone' && dim==='w') obj.h = obj.h||obj.w;
  renderObjects();
  updateSelectionBox();
}

function spSetRotation(deg){
  const obj = getObject(selectedId); if(!obj||obj.locked) return;
  obj.rotation = Math.round(deg);
  const el = document.querySelector(`[data-id="${obj.id}"]`);
  if(el) el.style.transform = `rotate(${obj.rotation}deg)`;
  updateSelectionBox();
}

function spSyncTransformPanel(obj){
  if(!obj){ document.getElementById('sp-transform-panel')?.style && (document.getElementById('sp-transform-panel').style.display='none'); return; }
  const panel = document.getElementById('sp-transform-panel');
  const lbl   = document.getElementById('sp-transform-lbl');
  if(!panel||!lbl) return;
  panel.style.display = 'block';
  const x  = document.getElementById('sp-pos-x');
  const y  = document.getElementById('sp-pos-y');
  const w  = document.getElementById('sp-size-w');
  const h  = document.getElementById('sp-size-h');
  const rs = document.getElementById('sp-rot-sl');
  const rv = document.getElementById('sp-rot-val');
  if(x) x.value = Math.round(obj.x||0);
  if(y) y.value = Math.round(obj.y||0);
  if(w) w.value = Math.round(obj.w||0);
  if(h) h.value = Math.round(obj.h||obj.w||0);
  if(rs) rs.value = obj.rotation||0;
  if(rv) rv.value = obj.rotation||0;
}



