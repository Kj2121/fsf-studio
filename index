      Object.assign(ref.style, {fontSize:'11px', fontWeight:'800', color:'#7C5BF0', marginBottom:'5px', letterSpacing:'1px'});
      const text = document.createElement('div');
      text.textContent = v.verse;
      Object.assign(text.style, {fontSize:'13px', color:'rgba(255,255,255,0.85)', lineHeight:'1.5'});
