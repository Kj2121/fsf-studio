// SCALE / CANVAS SIZE
function getFmtSize() {
  if(fmt==='custom'){
    return {
      W:Math.max(100,Math.min(4000,parseInt(document.getElementById('cw')?.value)||1080)),
      H:Math.max(100,Math.min(4000,parseInt(document.getElementById('ch')?.value)||1080))
    };
  }
  const f=FMTS[fmt]||FMTS.square;
  return {W:f.W, H:f.H};
}

let _zoomExtra = 1.0;

function _getBaseScale() {
  const {W,H}=getFmtSize();
  const c=document.getElementById('center');
  if(!c) return 1;
  const isMob = window.innerWidth <= 768;
  const aW = c.clientWidth - 16;
  if(isMob){
    // Mobile: only prev-lbl takes space, export is in bottom bar sheet
    const lbl = document.getElementById('prev-lbl');
    const lblH = lbl ? lbl.offsetHeight + 6 : 34;
    const aH = c.clientHeight - lblH - 8;
    return Math.min(aW/W, aH/H, 1);
  }
  // Desktop: measure visible non-canvas elements
  let usedH = 0;
  c.childNodes.forEach(n => {
    if(n.nodeType !== 1) return;
    if(n.id === 'canvas-container') return;
    if(n.id === 'float-toolbar') return;
    const st = window.getComputedStyle(n);
    if(st.display === 'none') return;
    usedH += n.offsetHeight + parseInt(st.marginTop||0) + parseInt(st.marginBottom||0);
  });
  usedH += 10 * 3;
  const aH = c.clientHeight - usedH - 20;
  return Math.min(aW/W, aH/H, 1);
}

function getScale() {
  return _getBaseScale() * _zoomExtra;
}

function _applyZoom(){
  const sc = getScale();
  const {W,H}=getFmtSize();
  const bg=document.getElementById('canvas-bg');
  const cc=document.getElementById('canvas-container');
  if(!bg||!cc) return;
  bg.style.width=W+'px';
  bg.style.height=H+'px';
  bg.style.transform=`scale(${sc})`;
  bg.style.transformOrigin='top left';
  cc.style.width=(W*sc)+'px';
  cc.style.height=(H*sc)+'px';
  cc.style.margin='0 auto';
  const lbl = document.getElementById('zoom-label');
  if(lbl) lbl.textContent=Math.round(sc*100)+'%';
}

function updateCanvasSize() {
  _applyZoom();
}

