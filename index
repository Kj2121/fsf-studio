    </button>
    <button class="dl-btn" id="dl-btn" onclick="window.innerWidth<=768?toggleExportPanel():doDownload()" style="height:32px;padding:0 11px;font-size:11px;border-radius:10px;">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="13" height="13"><path d="M12 15V3m0 12l-4-4m4 4l4-4"/><rect x="3" y="17" width="18" height="4" rx="2"/></svg>
      <span class="hdr-desk-only"> Exportar</span>
