// LOGO HELPER — draw logo watermark on exported canvas
async function applyLogoToCanvas(canvas){
  if(!logoSrc) return canvas;
  return new Promise(resolve=>{
    const img = new Image();
    img.onload = ()=>{
      const ctx = canvas.getContext('2d');
      const W=canvas.width, H=canvas.height;
      const logoW = Math.round(W * logoSizePct/100);
      const logoH = Math.round(img.height * (logoW/img.width));
      const pad = Math.round(W*0.025);
      const pos = {
        'top-left':    [pad, pad],
        'top-center':  [W/2-logoW/2, pad],
        'top-right':   [W-logoW-pad, pad],
        'bottom-left': [pad, H-logoH-pad],
        'bottom-center':[W/2-logoW/2, H-logoH-pad],
        'bottom-right':[W-logoW-pad, H-logoH-pad],
      }[logoPos]||[W-logoW-pad, H-logoH-pad];
      ctx.globalAlpha=0.88;
      ctx.drawImage(img, pos[0], pos[1], logoW, logoH);
      ctx.globalAlpha=1;
      resolve(canvas);
    };
    img.onerror=()=>resolve(canvas);
    img.src=logoSrc;
  });
}

