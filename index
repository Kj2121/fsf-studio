    let s = src;
    if(s.startsWith('http')){
      try{ const r=await fetch(s); const b=await r.blob(); s=await new Promise(res=>{const fr=new FileReader();fr.onload=e=>res(e.target.result);fr.readAsDataURL(b);}); }catch(e){}
