async function copyImageToClipboard(){
  if(!shareBlob){alert('Espera a que la imagen se genere.');return;}
  const btn=document.getElementById('share-copy-btn');
  try{
    if(navigator.clipboard&&window.ClipboardItem){
      await navigator.clipboard.write([new ClipboardItem({'image/png':shareBlob})]);
      btn.textContent='✓ ¡Copiado!';
    }else throw new Error();
  }catch(e){
    const url=URL.createObjectURL(shareBlob);
    const a=document.createElement('a');a.href=url;a.download='FeSinFronteras.png';a.click();URL.revokeObjectURL(url);
