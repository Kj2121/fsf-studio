async function multiExport(){
  const selected = [...document.querySelectorAll('.mex-item.on')].map(el=>el.dataset.fmt);
  if(!selected.length){ showUndoToast('⚠ Selecciona al menos un formato'); return; }
  const origFmt = fmt;
  showUndoToast('⏳ Exportando '+selected.length+' formato(s)...');
  for(const f2 of selected){
    fmt = f2;
    updateCanvasSize();
    applyBackground();
    await new Promise(r=>setTimeout(r,400));
    const {W:mW,H:mH}=getFmtSize();
    let canvas = await captureCanvas(mW, mH, 3);
    if(canvas && logoSrc) canvas = await applyLogoToCanvas(canvas);
    if(!canvas) continue;
    const link = document.createElement('a');
    link.download = `FSF_${f2}_${Date.now()}.png`;
    link.href = canvas.toDataURL('image/png',1);
    link.click();
    await new Promise(r=>setTimeout(r,600));
  }
  fmt = origFmt;
  updateCanvasSize(); applyBackground();
  showUndoToast('✦ Exportación completa: '+selected.length+' archivos');
}

