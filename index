// FSF STUDIO — FUENTES PERSONALIZADAS
// Carga .ttf/.otf/.woff/.woff2 y las registra como @font-face.
// Se guardan en IndexedDB para persistir entre sesiones.
// ══════════════════════════════════════════════════════════════

const CUSTOM_FONTS_DB   = 'fsf_custom_fonts';
const CUSTOM_FONTS_STORE = 'fonts';
let _cfDb = null;

// ── IndexedDB init ──
function _cfOpenDb(){
  return new Promise((resolve, reject) => {
    if(_cfDb){ resolve(_cfDb); return; }
    const req = indexedDB.open(CUSTOM_FONTS_DB, 1);
    req.onupgradeneeded = e => {
      e.target.result.createObjectStore(CUSTOM_FONTS_STORE, {keyPath:'id'});
    };
    req.onsuccess = e => { _cfDb = e.target.result; resolve(_cfDb); };
    req.onerror   = () => reject(req.error);
  });
}

async function _cfSave(font){
  const db = await _cfOpenDb();
  return new Promise((res,rej)=>{
    const tx = db.transaction(CUSTOM_FONTS_STORE,'readwrite');
    tx.objectStore(CUSTOM_FONTS_STORE).put(font);
    tx.oncomplete = res;
    tx.onerror    = ()=>rej(tx.error);
  });
}

async function _cfGetAll(){
  const db = await _cfOpenDb();
  return new Promise((res,rej)=>{
    const tx  = db.transaction(CUSTOM_FONTS_STORE,'readonly');
    const req = tx.objectStore(CUSTOM_FONTS_STORE).getAll();
    req.onsuccess = ()=>res(req.result||[]);
    req.onerror   = ()=>rej(req.error);
  });
}

async function _cfDelete(id){
  const db = await _cfOpenDb();
  return new Promise((res,rej)=>{
    const tx = db.transaction(CUSTOM_FONTS_STORE,'readwrite');
    tx.objectStore(CUSTOM_FONTS_STORE).delete(id);
    tx.oncomplete = res;
    tx.onerror    = ()=>rej(tx.error);
  });
}

// ── Register a font with @font-face ──
function _cfRegisterFontFace(id, name, dataUrl, format){
  // Remove old face if exists
  document.getElementById('cf-face-'+id)?.remove();
  const style = document.createElement('style');
  style.id = 'cf-face-'+id;
  style.textContent = `@font-face {
    font-family: '${name}';
    src: url('${dataUrl}') format('${format}');
    font-display: swap;
  }`;
  document.head.appendChild(style);
}

// ── Add to FONTS array ──
function _cfAddToFonts(id, name){
  // Remove if already exists
  const idx = FONTS.findIndex(f=>f.id===id);
  if(idx !== -1) FONTS.splice(idx, 1);
  FONTS.push({
    id,
    name,
    family: `'${name}', sans-serif`,
    custom: true,
  });
}

// ── Load all saved custom fonts on startup ──
async function customFontsInit(){
  try{
    const fonts = await _cfGetAll();
    for(const f of fonts){
      _cfRegisterFontFace(f.id, f.name, f.dataUrl, f.format);
      _cfAddToFonts(f.id, f.name);
    }
    if(fonts.length) _cfRefreshAllFontUIs();
  }catch(e){}
}

// ── Refresh all font UIs ──
function _cfRefreshAllFontUIs(){
  // Rebuild floating toolbar font select
  if(typeof buildFontSelect === 'function') buildFontSelect();
  // Rebuild selection panel font grid (if text selected)
  if(selectedId){
    const obj = getObject(selectedId);
    if(obj?.type === 'text'){
      const fg = document.getElementById('sel-font-grid');
      if(fg) _cfRebuildFontGrid(fg, obj);
    }
  }
  // Rebuild mobile font chips if visible
  const mobChips = document.querySelector('.mob-font-chips');
  if(mobChips && typeof renderMobProps === 'function') renderMobProps();
}

function _fontSample(obj){
  let t=((obj&&obj.text)||'').split('\n')[0].trim();
  if(!t) t='Fe sin fronteras';
  return t.length>26?t.slice(0,25)+'…':t;
}
function _cfRebuildFontGrid(fg, obj){
  fg.innerHTML = '';
  _fontGroups().forEach(([cat,list])=>{
    const h=document.createElement('div'); h.className='font-cat'; h.textContent=cat; fg.appendChild(h);
    list.forEach(f => {
      const b = document.createElement('button');
      b.className = 'font-btn' + (f.id === obj.fontId ? ' on' : '');
      b.onclick = () => updateSelFont(f.id);
      b.classList.add('font-prev');
      const fam=f.custom?`'${f.name}',sans-serif`:f.family;
      if(f.custom){
        b.style.borderColor = 'rgba(251,191,36,0.25)';
        b.innerHTML = `<div class="fp-s" style="font-family:${fam};"></div><div class="font-name" style="color:rgba(251,191,36,0.7);">${f.name}</div>`;
      } else {
        b.innerHTML = `<div class="fp-s" style="font-family:${fam};"></div><div class="font-name">${f.name}</div>`;
      }
      b.firstChild.textContent=_fontSample(obj);
      fg.appendChild(b);
    });
  });
}

